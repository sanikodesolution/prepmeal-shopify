{%- liquid
  assign tag = block.settings.heading_tag | default: 'h2'
  assign heading = block.settings.heading
  assign hide_class = ''
  if block.settings.hide_on_mobile
    assign hide_class = hide_class | append: ' pm-b--hide-mobile'
  endif
  if block.settings.hide_on_desktop
    assign hide_class = hide_class | append: ' pm-b--hide-desktop'
  endif
-%}
{%- if heading != blank -%}
{%- capture heading_extra -%}
margin:0;line-height:1.15;{% if block.settings.heading_hover_color != blank %}--pm-hover-color:{{ block.settings.heading_hover_color }};{% endif %}
{%- endcapture -%}
<{{ tag }}
  class="pm-b-heading pm-section-bg{% if block.settings.color_scheme != blank %} color-{{ block.settings.color_scheme }}{% endif %}{{ hide_class }}{% if block.settings.custom_class != blank %} {{ block.settings.custom_class | escape }}{% endif %}"
  {{ block.shopify_attributes }}
  {% render 'pm-area-style', block: block, extra: heading_extra %}
>
  {{ heading | escape | newline_to_br }}
</{{ tag }}>
{%- elsif request.design_mode -%}
<div class="pm-b-heading pm-b-heading--empty{{ hide_class }}" {{ block.shopify_attributes }}>{{ 'sections.builder_starters.empty_heading' | t }}</div>
{%- endif -%}

{% stylesheet %}
  .pm-b-heading {
    box-sizing: border-box;
    width: 100%;
  }
  .pm-b-heading:hover {
    color: var(--pm-hover-color, inherit);
  }
  .pm-b--hide-mobile { }
  @media screen and (max-width: 749px) {
    .pm-b--hide-mobile { display: none !important; }
  }
  @media screen and (min-width: 750px) {
    .pm-b--hide-desktop { display: none !important; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.pm-heading.name",
  "settings": [
    {
      "type": "header",
      "content": "t:blocks.shared.headers.content"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "t:blocks.pm-heading.settings.heading",
      "default": "Your heading"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:blocks.pm-heading.settings.heading_tag",
      "info": "t:blocks.pm-heading.settings.heading_tag_info",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" },
        { "value": "p", "label": "Paragraph" }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "t:blocks.shared.headers.style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:blocks.shared.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:blocks.shared.text_color"
    },
    {
      "type": "color",
      "id": "heading_hover_color",
      "label": "t:blocks.shared.text_hover_color",
      "info": "t:blocks.shared.text_hover_color_info"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 14,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "t:blocks.pm-heading.settings.heading_size",
      "default": 36
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "t:blocks.pm-heading.settings.heading_weight",
      "options": [
        { "value": "", "label": "t:blocks.shared.options.theme_default" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra-bold" }
      ],
      "default": "700"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "t:blocks.pm-heading.settings.text_align",
      "options": [
        { "value": "", "label": "t:blocks.shared.options.theme_default" },
        { "value": "left", "label": "t:blocks.shared.options.left" },
        { "value": "center", "label": "t:blocks.shared.options.center" },
        { "value": "right", "label": "t:blocks.shared.options.right" }
      ],
      "default": "left"
    },

    {
      "type": "paragraph",
      "content": "t:blocks.shared.background.paragraph"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:blocks.shared.background.color"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "t:blocks.shared.background.gradient"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:blocks.shared.background.image"
    },
    {
      "type": "select",
      "id": "background_image_fit",
      "label": "t:blocks.shared.background.image_fit",
      "options": [
        { "value": "cover", "label": "t:blocks.shared.background.fit_cover" },
        { "value": "contain", "label": "t:blocks.shared.background.fit_contain" },
        { "value": "auto", "label": "t:blocks.shared.background.fit_auto" }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "background_image_position",
      "label": "t:blocks.shared.background.image_position",
      "options": [
        { "value": "center", "label": "t:blocks.shared.options.center" },
        { "value": "top", "label": "t:blocks.shared.options.top" },
        { "value": "bottom", "label": "t:blocks.shared.options.bottom" },
        { "value": "left", "label": "t:blocks.shared.options.left" },
        { "value": "right", "label": "t:blocks.shared.options.right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "background_repeat",
      "label": "t:blocks.shared.background.repeat",
      "options": [
        { "value": "no-repeat", "label": "t:blocks.shared.background.repeat_none" },
        { "value": "repeat", "label": "t:blocks.shared.background.repeat_all" },
        { "value": "repeat-x", "label": "t:blocks.shared.background.repeat_x" },
        { "value": "repeat-y", "label": "t:blocks.shared.background.repeat_y" }
      ],
      "default": "no-repeat"
    },
    {
      "type": "select",
      "id": "background_attachment",
      "label": "t:blocks.shared.background.attachment",
      "options": [
        { "value": "scroll", "label": "t:blocks.shared.background.attachment_scroll" },
        { "value": "fixed", "label": "t:blocks.shared.background.attachment_fixed" }
      ],
      "default": "scroll"
    },
    {
      "type": "color",
      "id": "background_overlay_color",
      "label": "t:blocks.shared.background.overlay_color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "background_overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "t:blocks.shared.background.overlay_opacity",
      "default": 0
    },
    {
      "type": "select",
      "id": "background_blend_mode",
      "label": "t:blocks.shared.background.blend_mode",
      "options": [
        { "value": "normal", "label": "Normal" },
        { "value": "multiply", "label": "Multiply" },
        { "value": "screen", "label": "Screen" },
        { "value": "overlay", "label": "Overlay" },
        { "value": "soft-light", "label": "Soft light" },
        { "value": "darken", "label": "Darken" },
        { "value": "lighten", "label": "Lighten" }
      ],
      "default": "normal"
    },
    {
      "type": "range",
      "id": "background_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "t:blocks.shared.border.radius",
      "default": 0
    },
    {
      "type": "range",
      "id": "background_min_height",
      "min": 0,
      "max": 800,
      "step": 10,
      "unit": "px",
      "label": "t:blocks.shared.min_height.label",
      "default": 0,
      "info": "t:blocks.shared.min_height.info"
    },

    {
      "type": "header",
      "content": "t:blocks.shared.headers.spacing"
    },
    {
      "type": "range",
      "id": "padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "t:blocks.shared.padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "t:blocks.shared.margin",
      "default": 0
    },

    {
      "type": "header",
      "content": "t:blocks.shared.headers.visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "t:blocks.shared.hide_on_mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "t:blocks.shared.hide_on_desktop",
      "default": false
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "t:blocks.shared.custom_class"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.pm-heading.name",
      "category": "t:blocks.categories.content"
    }
  ]
}
{% endschema %}
