{%- liquid
  assign width = block.settings.width | default: 'page'
  assign custom_max = block.settings.custom_max_width | default: 1200
  assign pad = block.settings.padding | default: 24
  assign margin = block.settings.margin | default: 0
  assign border_w = block.settings.border_width | default: 0

  assign width_class = 'pm-b-container--page'
  case width
    when 'full'
      assign width_class = 'pm-b-container--full'
    when 'narrow'
      assign width_class = 'pm-b-container--narrow'
    when 'custom'
      assign width_class = 'pm-b-container--custom'
  endcase

  assign hide_class = ''
  if block.settings.hide_on_mobile
    assign hide_class = hide_class | append: ' pm-b-container--hide-mobile'
  endif
  if block.settings.hide_on_desktop
    assign hide_class = hide_class | append: ' pm-b-container--hide-desktop'
  endif

  assign box_extra = 'padding:' | append: pad | append: 'px;margin-block:' | append: margin | append: 'px;'
  if width == 'custom' and custom_max > 0
    assign box_extra = box_extra | append: '--pm-container-max:' | append: custom_max | append: 'px;'
  endif
  if border_w > 0
    assign box_extra = box_extra | append: 'border-style:solid;border-width:' | append: border_w | append: 'px;'
    if block.settings.border_color != blank
      assign box_extra = box_extra | append: 'border-color:' | append: block.settings.border_color | append: ';'
    endif
  endif
  if block.settings.text_hover_color != blank
    assign box_extra = box_extra | append: '--pm-hover-color:' | append: block.settings.text_hover_color | append: ';'
  endif
-%}
<div
  class="pm-b-container pm-section-bg {{ width_class }}{% if block.settings.color_scheme != blank %} color-{{ block.settings.color_scheme }}{% endif %}{{ hide_class }}{% if block.settings.custom_class != blank %} {{ block.settings.custom_class | escape }}{% endif %}"
  {{ block.shopify_attributes }}
  {% render 'pm-area-style', block: block, extra: box_extra %}
>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .pm-b-container {
    box-sizing: border-box;
    width: 100%;
    margin-inline: auto;
    min-width: 0;
  }

  .pm-b-container--full {
    max-width: none;
  }

  .pm-b-container--page {
    max-width: var(--page-width);
    padding-inline: 1.5rem;
  }

  .pm-b-container--narrow {
    max-width: 72rem;
    padding-inline: 1.5rem;
  }

  .pm-b-container--custom {
    max-width: var(--pm-container-max, 1200px);
    padding-inline: 1.5rem;
  }

  @media screen and (max-width: 749px) {
    .pm-b-container--hide-mobile {
      display: none !important;
    }
  }

  @media screen and (min-width: 750px) {
    .pm-b-container--hide-desktop {
      display: none !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.pm-container.name",
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:blocks.shared.headers.layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:blocks.pm-container.settings.width.label",
      "options": [
        { "value": "full", "label": "t:blocks.pm-container.settings.width.options__full" },
        { "value": "page", "label": "t:blocks.pm-container.settings.width.options__page" },
        { "value": "narrow", "label": "t:blocks.pm-container.settings.width.options__narrow" },
        { "value": "custom", "label": "t:blocks.pm-container.settings.width.options__custom" }
      ],
      "default": "page"
    },
    {
      "type": "range",
      "id": "custom_max_width",
      "min": 600,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "t:blocks.pm-container.settings.custom_max_width.label",
      "default": 1200,
      "info": "t:blocks.pm-container.settings.custom_max_width.info"
    },
    {
      "type": "header",
      "content": "t:blocks.shared.headers.style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:blocks.shared.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "paragraph",
      "content": "t:blocks.shared.background.paragraph"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:blocks.shared.background.color"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "t:blocks.shared.background.gradient"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:blocks.shared.background.image"
    },
    {
      "type": "select",
      "id": "background_image_fit",
      "label": "t:blocks.shared.background.image_fit",
      "options": [
        { "value": "cover", "label": "t:blocks.shared.background.fit_cover" },
        { "value": "contain", "label": "t:blocks.shared.background.fit_contain" },
        { "value": "auto", "label": "t:blocks.shared.background.fit_auto" }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "background_image_position",
      "label": "t:blocks.shared.background.image_position",
      "options": [
        { "value": "center", "label": "t:blocks.shared.options.center" },
        { "value": "top", "label": "t:blocks.shared.options.top" },
        { "value": "bottom", "label": "t:blocks.shared.options.bottom" },
        { "value": "left", "label": "t:blocks.shared.options.left" },
        { "value": "right", "label": "t:blocks.shared.options.right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "background_repeat",
      "label": "t:blocks.shared.background.repeat",
      "options": [
        { "value": "no-repeat", "label": "t:blocks.shared.background.repeat_none" },
        { "value": "repeat", "label": "t:blocks.shared.background.repeat_all" },
        { "value": "repeat-x", "label": "t:blocks.shared.background.repeat_x" },
        { "value": "repeat-y", "label": "t:blocks.shared.background.repeat_y" }
      ],
      "default": "no-repeat"
    },
    {
      "type": "select",
      "id": "background_attachment",
      "label": "t:blocks.shared.background.attachment",
      "options": [
        { "value": "scroll", "label": "t:blocks.shared.background.attachment_scroll" },
        { "value": "fixed", "label": "t:blocks.shared.background.attachment_fixed" }
      ],
      "default": "scroll"
    },
    {
      "type": "color",
      "id": "background_overlay_color",
      "label": "t:blocks.shared.background.overlay_color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "background_overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "t:blocks.shared.background.overlay_opacity",
      "default": 0
    },
    {
      "type": "select",
      "id": "background_blend_mode",
      "label": "t:blocks.shared.background.blend_mode",
      "options": [
        { "value": "normal", "label": "Normal" },
        { "value": "multiply", "label": "Multiply" },
        { "value": "screen", "label": "Screen" },
        { "value": "overlay", "label": "Overlay" },
        { "value": "soft-light", "label": "Soft light" },
        { "value": "darken", "label": "Darken" },
        { "value": "lighten", "label": "Lighten" }
      ],
      "default": "normal"
    },
    {
      "type": "range",
      "id": "background_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "t:blocks.shared.border.radius",
      "default": 0
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 12,
      "step": 1,
      "unit": "px",
      "label": "t:blocks.shared.border.width",
      "default": 0
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:blocks.shared.border.color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:blocks.shared.text_color"
    },
    {
      "type": "color",
      "id": "text_hover_color",
      "label": "t:blocks.shared.text_hover_color",
      "info": "t:blocks.shared.text_hover_color_info"
    },
    {
      "type": "header",
      "content": "t:blocks.shared.headers.spacing"
    },
    {
      "type": "range",
      "id": "padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "t:blocks.shared.padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "margin",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "t:blocks.shared.margin",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:blocks.shared.headers.visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "t:blocks.shared.hide_on_mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "t:blocks.shared.hide_on_desktop",
      "default": false
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "t:blocks.shared.custom_class"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.pm-container.name",
      "category": "t:blocks.categories.layout"
    }
  ]
}
{% endschema %}
