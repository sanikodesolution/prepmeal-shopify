{{ 'section-cm-thali-wheel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cm-thali-wheel.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings
  assign plates = section.blocks | where: 'type', 'item'
-%}
{%- capture tw_eyebrow_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'eyebrow_' -%}
{%- endcapture -%}
{%- capture tw_heading_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'heading_' -%}
{%- endcapture -%}
{%- capture tw_body_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'body_' -%}
{%- endcapture -%}
{%- capture tw_caption_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'caption_' -%}
{%- endcapture -%}

<section class="tw" id="ThaliWheel-{{ section.id }}" data-thali-wheel style="--tw-bg: {{ s.bg }}; --tw-text: {{ s.text_color }}; --tw-accent: {{ s.accent }};" {{ section.shopify_attributes }}>
  <div class="tw__inner page-width">
    <div class="tw__stage" data-tw-stage>
      <div class="tw__glow" aria-hidden="true"></div>
      <div class="tw__ring" data-tw-ring></div>
      <div class="tw__ring tw__ring--inner" data-tw-ring2></div>
      {%- for block in plates -%}
        {%- if block.settings.image == blank and block.settings.image_asset == blank -%}{%- continue -%}{%- endif -%}
        {%- capture tw_title_style -%}
          {%- render 'pm-block-type-style', block: block, prefix: 'title_' -%}
        {%- endcapture -%}
        <div class="tw__plate" tabindex="0" role="button" aria-label="{{ block.settings.title | escape }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 800 | image_tag: alt: block.settings.title, loading: 'lazy', widths: '300, 500, 800', class: 'tw__photo' }}
          {%- else -%}
            <img class="tw__photo" src="{{ block.settings.image_asset | asset_url }}" alt="{{ block.settings.title | escape }}" width="600" height="600" loading="lazy">
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <span
              class="tw__label"
              {% if tw_title_style != blank %}
                style="{{ tw_title_style | strip }}"
              {% endif %}
            >
              {{ block.settings.title | escape }}
            </span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    <div class="tw__caption" data-tw-caption aria-live="polite">
      <span
        class="tw__caption-label"
        data-tw-caption-text
        {% if tw_caption_style != blank %}
          style="{{ tw_caption_style | strip }}"
        {% endif %}
      ></span>
    </div>
    <div class="tw__content">
      {%- if s.label != blank -%}
        <p
          class="tw__eyebrow"
          {% if tw_eyebrow_style != blank %}
            style="{{ tw_eyebrow_style | strip }}"
          {% endif %}
        >
          {{ s.label | escape }}
        </p>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2
          {% if tw_heading_style != blank %}
            style="{{ tw_heading_style | strip }}"
          {% endif %}
        >
          {%- if s.heading_accent != blank and s.heading contains s.heading_accent -%}
            {%- assign heading_bits = s.heading | split: s.heading_accent -%}
            {{ heading_bits[0] | escape }}<em>{{ s.heading_accent | escape }}</em>{{ heading_bits[1] | escape }}
          {%- else -%}
            {{ s.heading | escape }}
          {%- endif -%}
        </h2>
      {%- endif -%}
      {%- if s.text != blank -%}
        <div
          class="tw__text"
          {% if tw_body_style != blank %}
            style="{{ tw_body_style | strip }}"
          {% endif %}
        >
          {{ s.text }}
        </div>
      {%- endif -%}
      {%- if s.button_label != blank -%}
        {% render 'pm-button', label: s.button_label, link: s.button_link, style: 'light', text_color: s.button_text_color, bg_color: s.button_bg_color, icon_bg: s.button_icon_bg, icon_color: s.button_icon_color, font_size: s.button_font_size %}
      {%- endif -%}
    </div>
  </div>
</section>

