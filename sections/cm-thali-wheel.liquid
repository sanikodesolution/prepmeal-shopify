{{ 'section-cm-thali-wheel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cm-thali-wheel.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings
  assign plates = section.blocks | where: 'type', 'item'
-%}

<section class="tw" id="ThaliWheel-{{ section.id }}" data-thali-wheel style="--tw-bg: {{ s.bg }}; --tw-text: {{ s.text_color }}; --tw-accent: {{ s.accent }};" {{ section.shopify_attributes }}>
  <div class="tw__inner page-width">
    <div class="tw__stage" data-tw-stage>
      <div class="tw__glow" aria-hidden="true"></div>
      <div class="tw__ring" data-tw-ring></div>
      <div class="tw__ring" data-tw-ring2></div>
      {%- for block in plates -%}
        {%- if block.settings.image == blank and block.settings.image_asset == blank -%}{%- continue -%}{%- endif -%}
        <div class="tw__plate" tabindex="0" role="button" aria-label="{{ block.settings.title | escape }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 800 | image_tag: alt: block.settings.title, loading: 'lazy', widths: '300, 500, 800', class: 'tw__photo' }}
          {%- else -%}
            <img class="tw__photo" src="{{ block.settings.image_asset | asset_url }}" alt="{{ block.settings.title | escape }}" width="600" height="600" loading="lazy">
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <span class="tw__label">{{ block.settings.title | escape }}</span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    <div class="tw__content">
      {%- if s.label != blank -%}
        <p class="tw__eyebrow">{{ s.label | escape }}</p>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2>
          {%- if s.heading_accent != blank and s.heading contains s.heading_accent -%}
            {%- assign heading_bits = s.heading | split: s.heading_accent -%}
            {{ heading_bits[0] | escape }}<em>{{ s.heading_accent | escape }}</em>{{ heading_bits[1] | escape }}
          {%- else -%}
            {{ s.heading | escape }}
          {%- endif -%}
        </h2>
      {%- endif -%}
      {%- if s.text != blank -%}
        <div class="tw__text">{{ s.text }}</div>
      {%- endif -%}
      {%- if s.button_label != blank -%}
        <a class="tw__btn" href="{{ s.button_link | default: routes.all_products_collection_url }}">
          {{ s.button_label | escape }}
          <svg width="18" height="12" viewBox="0 0 18 12" fill="none" aria-hidden="true"><path d="M1 6h15m0 0-5-5m5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Thali wheel",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "label", "label": "Eyebrow", "default": "This Week at ChefMatts" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pick Your Flavor" },
    { "type": "text", "id": "heading_accent", "label": "Italic word", "default": "Flavor" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>A new menu every week, cooked by Chef Matt. Choose the plates you want and we bring them to your door.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#20100c" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#fdf3e7" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#f5a623" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Plate",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_asset", "label": "Theme image filename" },
        { "type": "text", "id": "title", "label": "Title", "default": "Meal" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Thali wheel",
      "blocks": [
        { "type": "item", "settings": { "image_asset": "cm-healthy-meals.jpg", "title": "Healthy Meals" } },
        { "type": "item", "settings": { "image_asset": "cm-usp-balance.jpg", "title": "Balanced Nutrition" } },
        { "type": "item", "settings": { "image_asset": "cm-usp-portions.jpg", "title": "Generous Portions" } },
        { "type": "item", "settings": { "image_asset": "cm-usp-eco.jpg", "title": "Eco Packaging" } },
        { "type": "item", "settings": { "image_asset": "cm-hero-banner.jpg", "title": "Global Flavors" } },
        { "type": "item", "settings": { "image_asset": "cm-delivery-banner.jpg", "title": "Delivered Fresh" } }
      ]
    }
  ]
}
{% endschema %}
