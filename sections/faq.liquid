{{ 'prep-content.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign meta_items = section.settings.faq_items
  assign use_meta = false
  if meta_items != blank and meta_items.size > 0
    assign use_meta = true
  endif
-%}

<section class="prep prep__section section-{{ section.id }}-padding" id="Faq-{{ section.id }}">
  <div class="prep__wrap">
    {% render 'pm-section-title',
      section: section,
      eyebrow: section.settings.eyebrow,
      title: section.settings.heading,
      subtitle: section.settings.text,
      richtext: true,
      heading_tag: 'h2',
      align: section.settings.heading_alignment
    %}

    {%- if use_meta -%}
      <div class="prep-faq">
        {%- for item in meta_items -%}
          {% render 'faq-item', item: item %}
        {%- endfor -%}
      </div>
    {%- elsif section.blocks.size > 0 -%}
      <div class="prep-faq">
        {%- for block in section.blocks -%}
          {% render 'faq-item',
            question: block.settings.question,
            answer: block.settings.answer,
            category: block.settings.category,
            shopify_attributes: block.shopify_attributes
          %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="prep-empty">{{ 'sections.prep.empty_state' | t }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "section",
  "max_blocks": 24,
  "settings": [
    {
      "type": "metaobject_list",
      "id": "faq_items",
      "label": "FAQ items (Metaobject)",
      "metaobject_type": "faq_item",
      "info": "When set, Metaobject entries replace blocks."
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Good to know" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Answers about delivery, meals, allergens, and billing.</p>"
    },
    {
      "type": "header",
      "content": "t:sections.pm_section_title.header"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "t:sections.pm_section_title.settings.align.label",
      "options": [
        { "value": "theme", "label": "t:sections.pm_section_title.settings.align.options.theme" },
        { "value": "left", "label": "t:sections.pm_section_title.settings.align.options.left" },
        { "value": "center", "label": "t:sections.pm_section_title.settings.align.options.center" },
        { "value": "right", "label": "t:sections.pm_section_title.settings.align.options.right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "pm_title_size",
      "label": "t:sections.pm_section_title.settings.size.label",
      "options": [
        { "value": "auto", "label": "t:sections.pm_section_title.settings.size.options.auto" },
        { "value": "small", "label": "t:sections.pm_section_title.settings.size.options.small" },
        { "value": "medium", "label": "t:sections.pm_section_title.settings.size.options.medium" },
        { "value": "large", "label": "t:sections.pm_section_title.settings.size.options.large" },
        { "value": "custom", "label": "t:sections.pm_section_title.settings.size.options.custom" }
      ],
      "default": "auto"
    },
    {
      "type": "color",
      "id": "pm_title_color",
      "label": "t:sections.pm_section_title.settings.color.label",
      "info": "t:sections.pm_section_title.settings.color.info"
    },
    {
      "type": "range",
      "id": "pm_title_spacing_below",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "t:sections.pm_section_title.settings.spacing_below.label",
      "info": "t:sections.pm_section_title.settings.spacing_below.info",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "pm_hide_title",
      "label": "t:sections.pm_section_title.settings.hide.label",
      "default": false
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ item",
      "settings": [
        { "type": "text", "id": "category", "label": "Category", "default": "Delivery" },
        { "type": "text", "id": "question", "label": "Question", "default": "When is the order cutoff?" },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Orders need to be in by Friday 8 PM for Sunday delivery.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "category": "Delivery",
            "question": "When is the order cutoff?",
            "answer": "<p>Orders need to be in by Friday 8 PM for Sunday delivery.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "category": "Meals",
            "question": "How long do meals keep in the fridge?",
            "answer": "<p>Enjoy within 4–5 days. Keep refrigerated and reheat until steaming hot.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "category": "Meals",
            "question": "Do you list allergens?",
            "answer": "<p>Yes. Check each meal for allergen details before ordering.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "category": "Billing",
            "question": "Can I skip a week?",
            "answer": "<p>Yes — pause or skip from your account before the cutoff.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
