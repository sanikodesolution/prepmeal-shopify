{{ 'section-cm-gift-card.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cm-gift-card.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign gc_product = section.settings.product
  assign hd_700 = settings.type_header_font | font_modify: 'weight', '700'
  assign hd_800 = settings.type_header_font | font_modify: 'weight', '800'
  assign default_amount = section.settings.default_amount | plus: 0

  assign gc_accent = section.settings.accent | default: '#f5a623'
  assign gc_ink = section.settings.ink | default: '#14213d'
  assign gc_paper = section.settings.paper | default: '#fffdf8'
  if section.settings.accent == blank
    assign gc_accent = '#f5a623'
  endif
  if section.settings.ink == blank
    assign gc_ink = '#14213d'
  endif
  if section.settings.paper == blank
    assign gc_paper = '#fffdf8'
  endif

  assign selected_variant = gc_product.selected_or_first_available_variant
  for variant in gc_product.variants
    assign variant_amount = variant.price | divided_by: 100
    if variant_amount == default_amount and variant.available
      assign selected_variant = variant
      break
    endif
  endfor
-%}

{%- capture gc_heading_style -%}
  {%- render 'pm-block-type-style', settings: section.settings, prefix: 'heading_' -%}
{%- endcapture -%}
{%- capture gc_body_style -%}
  {%- render 'pm-block-type-style', settings: section.settings, prefix: 'body_' -%}
{%- endcapture -%}
{%- capture gc_label_style -%}
  {%- render 'pm-block-type-style', settings: section.settings, prefix: 'label_' -%}
{%- endcapture -%}

{%- style -%}
  {%- if hd_700 -%}{{ hd_700 | font_face: font_display: 'swap' }}{%- endif -%}
  {%- if hd_800 -%}{{ hd_800 | font_face: font_display: 'swap' }}{%- endif -%}
{%- endstyle -%}

<cm-gift-card
  class="cm-gc"
  data-cm="gift-card"
  style="--gc-accent: {{ gc_accent }}; --gc-ink: {{ gc_ink }}; --gc-paper: {{ gc_paper }};"
  data-hints="{{ section.settings.hints | escape }}"
  data-added="{{ section.settings.added_text | escape }}"
  data-unavailable="{{ section.settings.unavailable_text | escape }}"
  data-cart-url="{{ routes.cart_url }}"
>
  <div class="cm-gc__hero">
    <div class="cm-gc__stage" data-gc-stage>
      <div class="cm-gc__label" data-gc-label>
        {% render 'gift-card-visual', card: section.settings, uid: section.id, embedded: true %}
      </div>
    </div>

    <div class="cm-gc__buy">
      {%- if section.settings.heading != blank -%}
        <h3
          class="cm-gc__title"
          {% if gc_heading_style != blank %}
            style="{{ gc_heading_style | strip }}"
          {% endif %}
        >
          {{- section.settings.heading | escape -}}
        </h3>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div
          class="cm-gc__lead"
          {% if gc_body_style != blank %}
            style="{{ gc_body_style | strip }}"
          {% endif %}
        >
          {{ section.settings.text }}
        </div>
      {%- endif -%}

      <div class="cm-gc__price" data-gc-price>
        {%- if selected_variant -%}
          {{ selected_variant.price | money }}
        {%- else -%}
          ${{ default_amount }}.00
        {%- endif %}
        <small>{{ cart.currency.iso_code }}</small>
      </div>

      <form class="cm-gc__form" data-gc-form>
        <fieldset class="cm-gc__fieldset">
          <legend
            {% if gc_label_style != blank %}
              style="{{ gc_label_style | strip }}"
            {% endif %}
          >
            {{- section.settings.amount_legend | escape -}}
          </legend>
          <div class="cm-gc__chips">
            {%- if gc_product != blank -%}
              {%- for variant in gc_product.variants -%}
                <input
                  type="radio"
                  name="id"
                  id="GcAmount-{{ section.id }}-{{ forloop.index }}"
                  value="{{ variant.id }}"
                  data-big="{{ variant.price | money_without_trailing_zeros | escape }}"
                  data-price="{{ variant.price | money | escape }}"
                  data-amount="{{ variant.price | divided_by: 100 }}"
                  {% if variant.id == selected_variant.id %}
                    checked
                  {% endif %}
                  {% unless variant.available %}
                    disabled
                  {% endunless %}
                >
                <label for="GcAmount-{{ section.id }}-{{ forloop.index }}">
                  {{- variant.price | money_without_trailing_zeros -}}
                </label>
              {%- endfor -%}
            {%- else -%}
              {%- assign fallback_amounts = section.settings.fallback_amounts | split: ',' -%}
              {%- for amount in fallback_amounts -%}
                {%- assign amount_value = amount | strip | plus: 0 -%}
                <input
                  type="radio"
                  name="amount"
                  id="GcAmount-{{ section.id }}-{{ forloop.index }}"
                  value="{{ amount_value }}"
                  data-big="${{ amount_value }}"
                  data-price="${{ amount_value }}.00"
                  data-amount="{{ amount_value }}"
                  {% if amount_value == default_amount %}
                    checked
                  {% endif %}
                >
                <label for="GcAmount-{{ section.id }}-{{ forloop.index }}">${{ amount_value }}</label>
              {%- endfor -%}
            {%- endif -%}
          </div>
        </fieldset>

        <p class="cm-gc__hint" data-gc-hint aria-live="polite"></p>

        {%- if gc_product != blank -%}
          <label class="cm-gc__gift">
            <input type="checkbox" data-gc-gift>
            {{ section.settings.gift_label | escape }}
          </label>
          <div class="cm-gc__gf" data-gc-fields hidden>
            <label>
              {{- section.settings.recipient_name_label | escape -}}
              <input type="text" name="properties[Recipient name]" autocomplete="off" disabled>
            </label>
            <label>
              {{- section.settings.recipient_email_label | escape -}}
              <input type="email" name="properties[Recipient email]" autocomplete="off" disabled data-gc-email>
            </label>
            <label>
              {{- section.settings.send_on_label | escape -}}
              <input type="date" name="properties[Send on]" pattern="\d{4}-\d{2}-\d{2}" disabled data-gc-date>
            </label>
            <label>
              {{- section.settings.sender_name_label | escape -}}
              <input type="text" autocomplete="name" disabled data-gc-sender>
            </label>
            <label class="cm-gc__full">
              {{- section.settings.message_label | escape -}}
              <textarea
                name="properties[Message]"
                maxlength="200"
                placeholder="{{ section.settings.message_placeholder | escape }}"
                disabled
                data-gc-message
                {% if section.settings.message_placeholder_color != blank %}
                  style="--pm-field-placeholder:{{ section.settings.message_placeholder_color }};"
                {% endif %}
              ></textarea>
            </label>
            <input type="hidden" name="properties[__shopify_send_gift_card_to_recipient]" value="on" disabled>
            <input type="hidden" name="properties[__shopify_offset]" value="" disabled data-gc-offset>
          </div>
        {%- elsif request.design_mode -%}
          <p class="cm-gc__notice">Select your gift card product in this section's settings to enable checkout.</p>
        {%- endif -%}

        {% render 'pm-button',
          label: section.settings.button_label,
          style: 'brand',
          tag: 'button',
          type: 'submit',
          class: 'cm-gc__cta',
          attributes: 'data-gc-add',
          text_color: section.settings.button_text_color,
          bg_color: section.settings.button_bg_color,
          icon_bg: section.settings.button_icon_bg,
          icon_color: section.settings.button_icon_color,
          font_size: section.settings.button_font_size, hover_text_color: section.settings.button_hover_text_color, hover_bg_color: section.settings.button_hover_bg_color
        %}
      </form>

      {%- if section.settings.fine_print != blank -%}
        <p class="cm-gc__fine">{{ section.settings.fine_print | escape }}</p>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.strip_text != blank -%}
    <div class="cm-gc__strip" aria-hidden="true" style="--gc-strip-speed: {{ section.settings.strip_speed }}s;">
      <div class="cm-gc__strip-track">
        {%- for i in (1..4) -%}
          <span>{{ section.settings.strip_text | escape }}</span>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  <div class="cm-gc__toast" data-gc-toast role="status"></div>
</cm-gift-card>

{% schema %}
{
  "name": "CM gift card",
  "tag": "section",
  "class": "section cm-section",
  "settings": [
    { "type": "product", "id": "product", "label": "Gift card product" },
    { "type": "number", "id": "default_amount", "label": "Default amount", "default": 50 },
    {
      "type": "text",
      "id": "fallback_amounts",
      "label": "Preview amounts",
      "info": "Shown only when no gift card product is selected. Separate with commas.",
      "default": "10, 25, 50, 100"
    },
    { "type": "header", "content": "Gift card visual" },
    { "type": "text", "id": "gift_text", "label": "Big text (line 1)", "default": "Gift" },
    { "type": "text", "id": "card_text", "label": "Big text (line 2)", "default": "Card" },
    { "type": "text", "id": "brand", "label": "Brand name", "default": "MEALS" },
    { "type": "text", "id": "subtitle", "label": "Brand subtitle", "default": "FRESH MEAL PREP" },
    { "type": "text", "id": "badge", "label": "Badge text (when no logo)", "default": "CM" },
    { "type": "text", "id": "note", "label": "Small note", "default": "Redeemable on any meal plan" },
    { "type": "paragraph", "content": "Card uses your theme heading and body fonts." },
    { "type": "range", "id": "text_scale", "label": "Text size", "min": 60, "max": 120, "step": 5, "default": 100, "unit": "%" },
    { "type": "image_picker", "id": "logo", "label": "Logo (replaces badge and brand text)" },
    { "type": "color", "id": "card_bg", "label": "Card background", "info": "Default #FFFDF6. Clear the swatch to reset." },
    { "type": "color", "id": "text_main", "label": "Main text", "info": "Default #14213D. Clear the swatch to reset." },
    { "type": "color", "id": "text_accent", "label": "Accent text", "info": "Default #F5A623. Clear the swatch to reset." },
    { "type": "color", "id": "ribbon_color", "label": "Ribbon", "info": "Default #14213D. Clear the swatch to reset." },
    { "type": "color", "id": "bow_color", "label": "Bow", "info": "Default #F5A623. Clear the swatch to reset." },
    { "type": "range", "id": "tilt", "label": "Tilt (degrees)", "min": -20, "max": 20, "step": 1, "default": -7 },
    { "type": "checkbox", "id": "show_ribbon", "label": "Show ribbon and bow", "default": true },
    { "type": "header", "content": "Text box" },
        { "type": "range", "id": "max_width", "label": "Card max width", "min": 300, "max": 900, "step": 20, "default": 560, "unit": "px" },
    { "type": "header", "content": "Buy panel" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Give someone a week off from cooking." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>A Chef Matt's Meals gift card lets them pick from the rotating menu and get fresh, chef-made meals delivered to their home.</p>"
    },
    { "type": "header", "content": "Heading type" },
    { "type": "color", "id": "heading_color", "label": "Text color" }, { "type": "color", "id": "heading_hover_color", "label": "Hover text color", "info": "Clear to keep default." },
    { "type": "range", "id": "heading_font_size", "min": 0, "max": 72, "step": 1, "unit": "px", "label": "Font size", "default": 0, "info": "0 = theme default. Custom sizes start at 14px." },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "Font weight",
      "options": [
        { "value": "inherit", "label": "Theme default" },
        { "value": "400", "label": "Regular 400" },
        { "value": "500", "label": "Medium 500" },
        { "value": "600", "label": "Semi-bold 600" },
        { "value": "700", "label": "Bold 700" },
        { "value": "800", "label": "Extra-bold 800" }
      ],
      "default": "inherit"
    },
    { "type": "range", "id": "heading_letter_spacing", "min": -4, "max": 12, "step": 1, "unit": "px", "label": "Letter spacing", "default": 0 },
    { "type": "range", "id": "heading_line_height", "min": 0, "max": 2, "step": 0.1, "label": "Line height", "default": 0, "info": "0 = theme default" },
        { "type": "header", "content": "Heading format" },
        { "type": "select", "id": "heading_font_style", "label": "Font style", "options": [{ "value": "inherit", "label": "Theme default" }, { "value": "normal", "label": "Normal" }, { "value": "italic", "label": "Italic" }], "default": "inherit" },
        { "type": "select", "id": "heading_font_family", "label": "Font family", "options": [{ "value": "inherit", "label": "Theme default" }, { "value": "heading", "label": "Heading font" }, { "value": "body", "label": "Body font" }], "default": "inherit" },
        { "type": "range", "id": "heading_word_spacing", "min": -4, "max": 20, "step": 1, "unit": "px", "label": "Word spacing", "default": 0, "info": "0 = theme default" },
        { "type": "select", "id": "heading_text_transform", "label": "Text transform", "options": [{ "value": "inherit", "label": "Theme default" }, { "value": "none", "label": "None" }, { "value": "uppercase", "label": "Uppercase" }, { "value": "lowercase", "label": "Lowercase" }, { "value": "capitalize", "label": "Capitalize" }], "default": "inherit" },
        { "type": "select", "id": "heading_text_decoration", "label": "Text decoration", "options": [{ "value": "inherit", "label": "Theme default" }, { "value": "none", "label": "None" }, { "value": "underline", "label": "Underline" }, { "value": "line-through", "label": "Line through" }], "default": "inherit" },
        { "type": "select", "id": "heading_text_align", "label": "Text align", "options": [{ "value": "inherit", "label": "Theme default" }, { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "inherit" },
        { "type": "range", "id": "heading_opacity", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Opacity", "default": 100, "info": "100 = fully opaque" },
        { "type": "header", "content": "Heading box" },
        { "type": "range", "id": "heading_max_width", "min": 0, "max": 1000, "step": 10, "unit": "px", "label": "Max width", "default": 0, "info": "0 = no limit" },
        { "type": "range", "id": "heading_border_radius", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Corner radius", "default": 0 },
        { "type": "color", "id": "heading_bg_color", "label": "Background color", "info": "Clear swatch to reset." }, { "type": "color", "id": "heading_hover_bg_color", "label": "Hover background color", "info": "Clear to keep default." },
