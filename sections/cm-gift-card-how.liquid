{{ 'section-cm-gift-card.css' | asset_url | stylesheet_tag }}

{%- capture gc_how_heading_style -%}
  {%- render 'pm-block-type-style', settings: section.settings, prefix: 'heading_' -%}
{%- endcapture -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section
  class="cm-gc cm-gc__how section-{{ section.id }}-padding"
  style="--gc-accent: {{ section.settings.accent }}; --gc-ink: {{ section.settings.ink }}; --gc-paper: {{ section.settings.paper }};"
>
  {%- if section.settings.heading != blank -%}
    <h3
      class="cm-gc__t"
      {% if gc_how_heading_style != blank %}
        style="{{ gc_how_heading_style | strip }}"
      {% endif %}
    >
      {{- section.settings.heading | escape -}}
    </h3>
  {%- endif -%}
  {%- if section.blocks.size > 0 -%}
    <ol class="cm-gc__steps" style="--gc-steps: {{ section.blocks.size | at_most: 4 }};">
      {%- for block in section.blocks -%}
        {%- capture gc_step_title_style -%}
          {%- render 'pm-block-type-style', block: block, prefix: 'title_' -%}
        {%- endcapture -%}
        {%- capture gc_step_body_style -%}
          {%- render 'pm-block-type-style', block: block, prefix: 'body_' -%}
        {%- endcapture -%}
        <li {{ block.shopify_attributes }}>
          <b>{{ forloop.index }}</b>
          <h4
            {% if gc_step_title_style != blank %}
              style="{{ gc_step_title_style | strip }}"
            {% endif %}
          >
            {{- block.settings.title | escape -}}
          </h4>
          {%- if block.settings.text != blank -%}
            <p
              {% if gc_step_body_style != blank %}
                style="{{ gc_step_body_style | strip }}"
              {% endif %}
            >
              {{- block.settings.text | escape -}}
            </p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  {%- endif -%}
</section>

