{% render 'cm-section-assets', section: section %}
{{ 'section-cm-meal-plan-page.css' | asset_url | stylesheet_tag }}
{%- if request.design_mode -%}
  <script src="{{ 'cm-meal-plan-editor.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- liquid
  assign plan_product = section.settings.content_product
  assign plan_meta = plan_product.metafields.custom
  assign shared_meta = shop.metafields.custom
  assign benefit_blocks = section.blocks | where: 'type', 'benefit'

  assign c_ben_eyebrow = section.settings.eyebrow | default: plan_meta.ben_eyebrow.value | default: shared_meta.ben_eyebrow.value
  assign c_ben_line_1 = section.settings.line_1 | default: plan_meta.ben_line_1.value
  assign c_ben_line_2 = section.settings.line_2 | default: plan_meta.ben_line_2.value
  assign c_ben_line_3 = section.settings.line_3 | default: plan_meta.ben_line_3.value
  assign c_ben_note = section.settings.note | default: plan_meta.ben_note.value
-%}

<div class="mealplan-page mealplan-a" data-mp-page data-cm="meal-plan-benefits">
  <section class="ben">
    <div class="ben__glow" aria-hidden="true"></div>
    {%- if benefit_blocks.size > 0 -%}
      <div class="ben__marquee">
        <div class="ben__track">
          {%- for pass in (1..4) -%}
            <ul class="ben__group"{% if pass > 1 %} aria-hidden="true"{% endif %}>
              {%- for block in benefit_blocks -%}
                <li class="ben__item"{% if pass == 1 %} {{ block.shopify_attributes }}{% endif %}>
                  <b>{{ block.settings.title | escape }}</b>
                  <span>{{ block.settings.text | escape }}</span>
                </li>
              {%- endfor -%}
            </ul>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
    <div class="ben__inner">
      {%- if c_ben_eyebrow != blank -%}
        <p class="mp-eye ben__eyebrow">{{ c_ben_eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="big">
        <span>{{ c_ben_line_1 | escape }}</span>
        <span>{{ c_ben_line_2 | escape }}</span>
        <span class="out">{{ c_ben_line_3 | escape }}</span>
      </h2>
      {%- if c_ben_note != blank -%}
        <p class="ben__note">{{ c_ben_note | escape }}</p>
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "MP Benefits",
  "tag": "section",
  "class": "section cm-section",
  "settings": [
    { "type": "paragraph", "content": "Click this band in the preview to edit these fields. Stat chips are Benefit blocks below." },
    { "type": "product", "id": "content_product", "label": "Plan product (optional metafields)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Hartland's #1 meal prep chef" },
    { "type": "text", "id": "line_1", "label": "Line 1", "default": "6 meals." },
    { "type": "text", "id": "line_2", "label": "Line 2", "default": "1 week." },
    { "type": "text", "id": "line_3", "label": "Line 3 (outline)", "default": "Zero stress." },
    { "type": "textarea", "id": "note", "label": "Note", "default": "Flexible menu: choose any six from 10+ options, and change your picks each week." },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 0 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 0 }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit chip",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "24oz" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Per container" }
      ]
    }
  ],
  "presets": [
    {
      "name": "MP Benefits",
      "blocks": [
        { "type": "benefit", "settings": { "title": "24oz", "text": "Per container" } },
        { "type": "benefit", "settings": { "title": "2 min", "text": "To reheat" } },
        { "type": "benefit", "settings": { "title": "Fresh", "text": "Never frozen" } }
      ]
    }
  ]
}
{% endschema %}
