{{ 'section-cm-product-details.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cm-product-details.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- assign product = section.settings.product -%}
{%- assign current = product.selected_or_first_available_variant -%}

<section class="mealplan-pd" id="MealplanPd-{{ section.id }}" data-mealplan-pd>
  <div class="mealplan-pd__inner page-width">
    <div class="mealplan-pd__gallery">
      <div class="mealplan-pd__stagewrap">
        {%- if section.settings.badge != blank -%}
          <div class="mealplan-pd__badge" aria-hidden="true">
            <svg class="mealplan-pd__ring" viewBox="0 0 120 120">
              <defs><path id="mealplan-pd-circ-{{ section.id }}" d="M60,60 m-45,0 a45,45 0 1,1 90,0 a45,45 0 1,1 -90,0"/></defs>
              <text><textPath href="#mealplan-pd-circ-{{ section.id }}">{{ section.settings.badge | escape }}</textPath></text>
            </svg>
            <span class="mealplan-pd__badge-core">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 19c0-8 5-13 14-14 0 9-5 14-13 14"/><path d="M5 19c3-5 6-8 10-10"/></svg>
            </span>
          </div>
        {%- endif -%}
        <div class="mealplan-pd__stage" data-pd-stage>
          {%- if product != blank and product.media.size > 0 -%}
            {%- for media in product.media limit: 6 -%}
              {%- if media.media_type == 'image' -%}
                <div class="mealplan-pd__slide{% if forloop.first %} is-active{% endif %}" data-pd-slide data-media-id="{{ media.id }}">
                  {%- assign media_alt = media.alt | default: product.title -%}
                  {{ media | image_url: width: 1200 | image_tag: alt: media_alt, loading: 'lazy', widths: '400, 700, 1000, 1200' }}
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            <div class="mealplan-pd__slide is-active" data-pd-slide>
              <img src="{{ 'cm-healthy-meals.jpg' | asset_url }}" alt="{{ product.title | default: 'Meal' | escape }}" width="900" height="900">
            </div>
          {%- endif -%}
        </div>
        <div class="mealplan-pd__plates" aria-hidden="true">
          {%- if section.settings.plate_1 != blank -%}
            {{ section.settings.plate_1 | image_url: width: 480 | image_tag: alt: '', class: 'mealplan-pd__plate', loading: 'lazy' }}
          {%- else -%}
            <img class="mealplan-pd__plate" src="{{ 'cm-pd-plate-1.png' | asset_url }}" alt="" width="180" height="180">
          {%- endif -%}
          {%- if section.settings.plate_2 != blank -%}
            {{ section.settings.plate_2 | image_url: width: 480 | image_tag: alt: '', class: 'mealplan-pd__plate', loading: 'lazy' }}
          {%- else -%}
            <img class="mealplan-pd__plate" src="{{ 'cm-pd-plate-2.png' | asset_url }}" alt="" width="180" height="180">
          {%- endif -%}
          {%- if section.settings.plate_3 != blank -%}
            {{ section.settings.plate_3 | image_url: width: 480 | image_tag: alt: '', class: 'mealplan-pd__plate', loading: 'lazy' }}
          {%- else -%}
            <img class="mealplan-pd__plate" src="{{ 'cm-pd-plate-3.png' | asset_url }}" alt="" width="180" height="180">
          {%- endif -%}
        </div>
      </div>
      {%- if product != blank and product.images.size > 1 -%}
        <div class="mealplan-pd__thumbs" role="tablist" aria-label="Product images">
          {%- for image in product.images limit: 6 -%}
            <button type="button" class="mealplan-pd__thumb{% if forloop.first %} is-active{% endif %}" role="tab" aria-label="Image {{ forloop.index }}" data-pd-thumb>
              {{ image | image_url: width: 160 | image_tag: alt: '', loading: 'lazy' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="mealplan-pd__info">
      {%- if section.settings.eyebrow != blank -%}
        <span class="mealplan-pd__eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h2 class="mealplan-pd__title">{{ product.title | default: 'Meal plan' | escape }}</h2>
      <div class="mealplan-pd__priceRow">
        <span class="mealplan-pd__price" data-pd-price>{{ current.price | money }}</span>
        <s class="mealplan-pd__compare" data-pd-compare {% unless current.compare_at_price > current.price %}hidden{% endunless %}>
          {%- if current.compare_at_price > current.price -%}{{ current.compare_at_price | money }}{%- endif -%}
        </s>
        <span class="mealplan-pd__save" data-pd-save hidden></span>
        <span class="mealplan-pd__sold" data-pd-sold {% if current.available %}hidden{% endif %}>Sold out</span>
      </div>
      {%- if product.description != blank -%}
        <div class="mealplan-pd__desc">{{ product.description }}</div>
      {%- elsif section.settings.text != blank -%}
        <p class="mealplan-pd__desc">{{ section.settings.text | escape }}</p>
      {%- endif -%}

      <div class="mealplan-pd__chips">
        {%- if section.settings.chip_1 != blank -%}
          <span class="mealplan-pd__chip"><span class="mealplan-pd__chip-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 19c0-8 5-13 14-14 0 9-5 14-13 14"/><path d="M5 19c3-5 6-8 10-10"/></svg></span>{{ section.settings.chip_1 | escape }}</span>
        {%- endif -%}
        {%- if section.settings.chip_2 != blank -%}
          <span class="mealplan-pd__chip"><span class="mealplan-pd__chip-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg></span>{{ section.settings.chip_2 | escape }}</span>
        {%- endif -%}
        {%- if section.settings.chip_3 != blank -%}
          <span class="mealplan-pd__chip"><span class="mealplan-pd__chip-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3c1 3 5 5 5 10a5 5 0 0 1-10 0c0-2 1-3 2-4 0 2 1 3 2 3 0-3-1-6 1-9z"/></svg></span>{{ section.settings.chip_3 | escape }}</span>
        {%- endif -%}
      </div>

      {%- if product != blank -%}
        <product-form class="product-form" data-section-id="{{ section.id }}">
          {%- form 'product', product, class: 'mealplan-pd__form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
            <input type="hidden" name="id" class="product-variant-id" value="{{ current.id }}" data-pd-vid {% unless current.available %}disabled{% endunless %}>
            {%- unless product.has_only_default_variant -%}
              {%- for option in product.options_with_values -%}
                <fieldset class="mealplan-pd__opt" data-pd-option>
                  <legend class="mealplan-pd__optHead">{{ option.name | escape }} <span data-pd-selected>{{ option.selected_value | escape }}</span></legend>
                  <div class="mealplan-pd__vals">
                    {%- for value in option.values -%}
                      <label class="mealplan-pd__val">
                        <input type="radio" name="opt{{ option.position }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                        <span class="mealplan-pd__valBox">{{ value | escape }}</span>
                      </label>
                    {%- endfor -%}
                  </div>
                </fieldset>
              {%- endfor -%}
            {%- endunless -%}
            <div class="mealplan-pd__buy">
              <div class="mealplan-pd__qty">
                <button type="button" class="mealplan-pd__qbtn" data-pd-minus aria-label="Decrease quantity"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M5 12h14"/></svg></button>
                <input class="mealplan-pd__qinput" type="number" name="quantity" value="1" min="1" inputmode="numeric" aria-label="Quantity" data-pd-qty>
                <button type="button" class="mealplan-pd__qbtn" data-pd-plus aria-label="Increase quantity"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></button>
              </div>
              <button type="submit" name="add" class="mealplan-pd__btn" data-pd-btn {% unless current.available %}disabled{% endunless %}>
                <span data-pd-btnlabel>{% if current.available %}Add to cart{% else %}Sold out{% endif %}</span>
                <svg class="mealplan-pd__btnArrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                {%- render 'loading-spinner' -%}
              </button>
            </div>
            <p class="mealplan-pd__msg" role="alert" data-pd-msg></p>
            {%- if section.settings.note != blank -%}
              <p class="mealplan-pd__note"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h11v9H3zM14 9h4l3 3v3h-7"/><circle cx="7" cy="17" r="1.8"/><circle cx="17" cy="17" r="1.8"/></svg>{{ section.settings.note | escape }}</p>
            {%- endif -%}
          {%- endform -%}
        </product-form>
        <script type="application/json" data-pd-variants>
          [
            {%- for variant in product.variants -%}
              {
                "id": {{ variant.id }},
                "options": {{ variant.options | json }},
                "available": {{ variant.available | json }},
                "price": {{ variant.price | money | json }},
                "compare": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},
                "save": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round }}{% else %}0{% endif %},
                "media": {{ variant.featured_media.id | default: 0 }}
              }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]
        </script>
      {%- endif -%}

      <dl class="mealplan-pd__macros">
        <div class="mealplan-pd__macro"><dt>Calories</dt><dd>{{ section.settings.cal | escape }}</dd></div>
        <div class="mealplan-pd__macro"><dt>Protein</dt><dd>{{ section.settings.protein | escape }}</dd></div>
        <div class="mealplan-pd__macro"><dt>Carbs</dt><dd>{{ section.settings.carbs | escape }}</dd></div>
        <div class="mealplan-pd__macro"><dt>Fat</dt><dd>{{ section.settings.fat | escape }}</dd></div>
      </dl>

      {%- if section.blocks.size > 0 -%}
        <div class="mealplan-pd__acc">
          {%- for block in section.blocks -%}
            <div class="mealplan-pd__accItem{% if block.settings.open %} is-open{% endif %}" {{ block.shopify_attributes }}>
              <button type="button" class="mealplan-pd__accBtn" aria-expanded="{% if block.settings.open %}true{% else %}false{% endif %}" data-pd-acc>
                {{ block.settings.title | escape }}<span class="mealplan-pd__plus" aria-hidden="true"></span>
              </button>
              <div class="mealplan-pd__accPanel"><div class="mealplan-pd__accInner"><div class="mealplan-pd__accBody">{{ block.settings.text }}</div></div></div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product details",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Chef cooked, fresh weekly" },
    { "type": "text", "id": "badge", "label": "Badge text", "default": "Fresh • Chef cooked • Never frozen • " },
    { "type": "textarea", "id": "text", "label": "Fallback description", "default": "Cooked fresh by our chefs, packed the same day and ready in minutes." },
    { "type": "text", "id": "chip_1", "label": "Chip 1", "default": "Fresh, never frozen" },
    { "type": "text", "id": "chip_2", "label": "Chip 2", "default": "Ready in 3 minutes" },
    { "type": "text", "id": "chip_3", "label": "Chip 3", "default": "Chef cooked" },
    { "type": "text", "id": "note", "label": "Delivery note", "default": "Free delivery on weekly plans over $60" },
    { "type": "text", "id": "cal", "label": "Calories", "default": "540" },
    { "type": "text", "id": "protein", "label": "Protein", "default": "42g" },
    { "type": "text", "id": "carbs", "label": "Carbs", "default": "48g" },
    { "type": "text", "id": "fat", "label": "Fat", "default": "16g" },
    { "type": "image_picker", "id": "plate_1", "label": "Meal plate 1" },
    { "type": "image_picker", "id": "plate_2", "label": "Meal plate 2" },
    { "type": "image_picker", "id": "plate_3", "label": "Meal plate 3" }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Detail",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "What's included" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Main dish, sides, and rice. Packed fresh in a microwave-safe tray.</p>" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product details",
      "blocks": [
        { "type": "accordion", "settings": { "title": "What's included", "text": "<p>Main dish, sides, basmati rice and 2 roti. Packed fresh in a microwave-safe tray.</p>", "open": true } },
        { "type": "accordion", "settings": { "title": "Reheating", "text": "<p>Microwave for 2 to 3 minutes, stir halfway, and enjoy.</p>" } },
        { "type": "accordion", "settings": { "title": "Storage & allergens", "text": "<p>Keep refrigerated and eat within 5 days. Check the label for allergens.</p>" } }
      ]
    }
  ]
}
{% endschema %}
