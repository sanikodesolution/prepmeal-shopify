{{ 'section-cm-product-details.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cm-product-details.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- assign product = section.settings.product -%}
{%- if product == blank -%}
  {%- assign product = all_products['5-meal-plan'] -%}
{%- endif -%}
{%- assign plan_10 = section.settings.product_10 -%}
{%- if plan_10 == blank -%}
  {%- assign plan_10 = all_products['10-meal-plan'] -%}
{%- endif -%}
{%- assign plan_custom = section.settings.product_custom -%}
{%- if plan_custom == blank -%}
  {%- assign plan_custom = product -%}
{%- endif -%}
{%- assign current = product.selected_or_first_available_variant -%}
{%- assign variant_10 = plan_10.selected_or_first_available_variant | default: current -%}
{%- assign variant_custom = plan_custom.selected_or_first_available_variant | default: current -%}

{%- assign dishes = section.blocks | where: 'type', 'dish' -%}
<section class="mealplan-pd mealplan-pd--plate" id="MealplanPd-{{ section.id }}" data-mealplan-pd data-anim="true">
  <div class="mealplan-pd__inner">
    <div class="mealplan-pd__gallery">
      <div class="mealplan-pd__stagewrap">
        {%- if section.settings.badge != blank -%}
          <div class="mealplan-pd__badge" aria-hidden="true">
            <svg class="mealplan-pd__ring" viewBox="0 0 120 120">
              <defs><path id="mealplan-pd-circ-{{ section.id }}" d="M60,60 m-45,0 a45,45 0 1,1 90,0 a45,45 0 1,1 -90,0"/></defs>
              <text><textPath href="#mealplan-pd-circ-{{ section.id }}" textLength="280">{{ section.settings.badge | escape }}</textPath></text>
            </svg>
            <span class="mealplan-pd__badge-core">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 19c0-8 5-13 14-14 0 9-5 14-13 14"/><path d="M5 19c3-5 6-8 10-10"/></svg>
            </span>
          </div>
        {%- endif -%}
        <div class="mealplan-pd__stage" data-pd-stage>
          {%- if dishes.size > 0 -%}
            {%- for block in dishes -%}
              {%- assign photo = block.settings.image_asset | default: 'mp-food-0.jpg' -%}
              <div class="mealplan-pd__slide{% if forloop.first %} is-active{% endif %}" data-pd-slide>
                <img src="{{ photo | asset_url }}" alt="{{ block.settings.name | escape }}" width="900" height="900"{% unless forloop.first %} loading="lazy"{% endunless %}>
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (0..2) -%}
              <div class="mealplan-pd__slide{% if forloop.first %} is-active{% endif %}" data-pd-slide>
                <img src="{{ 'mp-food-' | append: i | append: '.jpg' | asset_url }}" alt="{{ product.title | default: 'Meal' | escape }}" width="900" height="900"{% unless forloop.first %} loading="lazy"{% endunless %}>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
      <div class="mealplan-pd__thumbs" role="tablist" aria-label="Meal photos">
        {%- if dishes.size > 0 -%}
          {%- for block in dishes -%}
            {%- assign photo = block.settings.image_asset | default: 'mp-food-0.jpg' -%}
            <button type="button" class="mealplan-pd__thumb{% if forloop.first %} is-active{% endif %}" role="tab" aria-label="{{ block.settings.name | escape }}" data-pd-thumb>
              <img src="{{ photo | asset_url }}" alt="" width="120" height="120" loading="lazy">
            </button>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (0..2) -%}
            <button type="button" class="mealplan-pd__thumb{% if forloop.first %} is-active{% endif %}" role="tab" aria-label="Image {{ forloop.index }}" data-pd-thumb>
              <img src="{{ 'mp-food-' | append: i | append: '.jpg' | asset_url }}" alt="" width="120" height="120" loading="lazy">
            </button>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    <div class="mealplan-pd__info">
      {%- if section.settings.eyebrow != blank -%}
        <span class="mealplan-pd__eyebrow" data-pd-reveal>{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h2 class="mealplan-pd__title" data-pd-reveal>{{ section.settings.heading | default: product.title | default: 'Chicken Biryani with Raita' | escape }}</h2>
      <div class="mealplan-pd__priceRow" data-pd-reveal>
        {%- if product != blank -%}
          <span class="mealplan-pd__price" data-pd-price>{{ current.price | money }}</span>
          <s class="mealplan-pd__compare" data-pd-compare {% unless current.compare_at_price > current.price %}hidden{% endunless %}>
            {%- if current.compare_at_price > current.price -%}{{ current.compare_at_price | money }}{%- endif -%}
          </s>
          <span class="mealplan-pd__sold" data-pd-sold {% if current.available %}hidden{% endif %}>Sold out</span>
        {%- else -%}
          <span class="mealplan-pd__price" data-pd-price>$64.99</span>
          <s class="mealplan-pd__compare" data-pd-compare hidden></s>
          <span class="mealplan-pd__sold" data-pd-sold hidden>Sold out</span>
        {%- endif -%}
        <span class="mealplan-pd__save" data-pd-save hidden></span>
      </div>
      {%- if section.settings.text != blank -%}
        <p class="mealplan-pd__desc" data-pd-reveal>{{ section.settings.text | escape }}</p>
      {%- elsif product.description != blank -%}
        <div class="mealplan-pd__desc" data-pd-reveal>{{ product.description }}</div>
      {%- endif -%}

      <div class="mealplan-pd__chips" data-pd-reveal>
        {%- if section.settings.chip_1 != blank -%}
          <span class="mealplan-pd__chip"><span class="mealplan-pd__chip-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 19c0-8 5-13 14-14 0 9-5 14-13 14"/><path d="M5 19c3-5 6-8 10-10"/></svg></span>{{ section.settings.chip_1 | escape }}</span>
        {%- endif -%}
        {%- if section.settings.chip_2 != blank -%}
          <span class="mealplan-pd__chip"><span class="mealplan-pd__chip-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg></span>{{ section.settings.chip_2 | escape }}</span>
        {%- endif -%}
        {%- if section.settings.chip_3 != blank -%}
          <span class="mealplan-pd__chip"><span class="mealplan-pd__chip-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3c1 3 5 5 5 10a5 5 0 0 1-10 0c0-2 1-3 2-4 0 2 1 3 2 3 0-3-1-6 1-9z"/></svg></span>{{ section.settings.chip_3 | escape }}</span>
        {%- endif -%}
      </div>

      {%- capture mealplan_form_id -%}MealplanPdForm-{{ section.id }}{%- endcapture -%}
      {%- capture mealplan_fields -%}
            {%- if product != blank and product.has_only_default_variant == false -%}
              {%- for option in product.options_with_values -%}
                <fieldset class="mealplan-pd__opt" data-pd-reveal data-pd-option>
                  <legend class="mealplan-pd__optHead">{{ option.name | escape }} <span data-pd-selected>{{ option.selected_value | escape }}</span></legend>
                  <div class="mealplan-pd__vals">
                    {%- for value in option.values -%}
                      {%- assign option_variant_id = '' -%}
                      {%- for variant in product.variants -%}
                        {%- liquid
                          case option.position
                            when 1
                              assign option_value_match = variant.option1
                            when 2
                              assign option_value_match = variant.option2
                            else
                              assign option_value_match = variant.option3
                          endcase
                        -%}
                        {%- if option_value_match == value and option_variant_id == blank -%}
                          {%- assign option_variant_id = variant.id -%}
                        {%- endif -%}
                      {%- endfor -%}
                      <label class="mealplan-pd__val">
                        <input type="radio" name="opt{{ option.position }}" value="{{ value | escape }}" data-variant-id="{{ option_variant_id }}" {% if option.selected_value == value %}checked{% endif %}>
                        <span class="mealplan-pd__valBox">{{ value | escape }}</span>
                      </label>
                    {%- endfor -%}
                  </div>
                </fieldset>
              {%- endfor -%}
            {%- else -%}
              <fieldset class="mealplan-pd__opt" data-pd-reveal data-pd-plan>
                <legend class="mealplan-pd__optHead">Meal plan <span data-pd-selected>5 Meals</span></legend>
                <div class="mealplan-pd__vals">
                  <label class="mealplan-pd__val"><input type="radio" name="properties[Meal plan]" value="5 Meals" data-variant-id="{{ current.id | default: 67956374241586 }}" data-available="{% if current == blank or current.available %}true{% else %}false{% endif %}" data-price="{{ current.price | money | escape }}" {% if current.compare_at_price > current.price %}data-compare="{{ current.compare_at_price | money | escape }}"{% endif %} checked><span class="mealplan-pd__valBox">5 Meals</span></label>
                  <label class="mealplan-pd__val"><input type="radio" name="properties[Meal plan]" value="10 Meals" data-variant-id="{{ variant_10.id | default: current.id | default: 67956374241586 }}" data-available="{% if variant_10 == blank or variant_10.available %}true{% else %}false{% endif %}" data-price="{{ variant_10.price | money | escape }}" {% if variant_10.compare_at_price > variant_10.price %}data-compare="{{ variant_10.compare_at_price | money | escape }}"{% endif %}><span class="mealplan-pd__valBox">10 Meals</span></label>
                  <label class="mealplan-pd__val"><input type="radio" name="properties[Meal plan]" value="{{ section.settings.custom_label | escape }}" data-variant-id="{{ variant_custom.id | default: current.id | default: 67956374241586 }}" data-available="{% if variant_custom == blank or variant_custom.available %}true{% else %}false{% endif %}" data-price="{{ variant_custom.price | money | escape }}" {% if variant_custom.compare_at_price > variant_custom.price %}data-compare="{{ variant_custom.compare_at_price | money | escape }}"{% endif %}><span class="mealplan-pd__valBox">{{ section.settings.custom_label | escape }}</span></label>
                </div>
              </fieldset>
            {%- endif -%}
            {%- if dishes.size > 0 -%}
              <div class="mealplan-pd__custom" data-pd-custom data-label="{{ section.settings.custom_label | escape }}" data-min="1" aria-hidden="true">
                <div class="mealplan-pd__customInner">
                <div class="mealplan-pd__customBox">
                  <div class="mealplan-pd__customHead">
                    <strong>{{ section.settings.custom_heading | escape }}</strong>
                    <span class="mealplan-pd__total"><span data-pd-custom-total>0</span> meals selected</span>
                  </div>
                  <ul class="mealplan-pd__dishes">
                    {%- for block in dishes -%}
                      {%- assign photo = block.settings.image_asset | default: 'mp-food-0.jpg' -%}
                      <li class="mealplan-pd__dish" data-dish="{{ block.settings.name | escape }}" data-n="0" {{ block.shopify_attributes }}>
                        <span class="mealplan-pd__dishMain">
                          <img class="mealplan-pd__dishPhoto" src="{{ photo | asset_url }}" alt="" width="84" height="84" loading="lazy">
                          <span class="mealplan-pd__dishName">{{ block.settings.name | escape }}</span>
                        </span>
                        <span class="mealplan-pd__dstep">
                          <button type="button" data-d-minus aria-label="Remove one {{ block.settings.name | escape }}" disabled><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M5 12h14"/></svg></button>
                          <output data-d-count>0</output>
                          <button type="button" data-d-plus aria-label="Add one {{ block.settings.name | escape }}" disabled><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></button>
                        </span>
                      </li>
                    {%- endfor -%}
                  </ul>
                  <input type="hidden" name="properties[Custom order]" value="" data-pd-custom-summary disabled>
                  <label for="MealplanPdNotes-{{ section.id }}">Special requests (optional)</label>
                  <textarea id="MealplanPdNotes-{{ section.id }}" name="properties[Special requests]" rows="3" placeholder="e.g. less spicy, no peanuts, extra roti." data-pd-custom-text disabled></textarea>
                  <p class="mealplan-pd__customHint">Pick the dishes and how many of each. We will confirm your order before cooking.</p>
                </div>
                </div>
              </div>
            {%- endif -%}
            <div class="mealplan-pd__buy" data-pd-reveal>
              <div class="mealplan-pd__qty">
                <button type="button" class="mealplan-pd__qbtn" data-pd-minus aria-label="Decrease quantity"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M5 12h14"/></svg></button>
                <input class="mealplan-pd__qinput" type="number" name="quantity" value="1" min="1" inputmode="numeric" aria-label="Quantity" data-pd-qty>
                <button type="button" class="mealplan-pd__qbtn" data-pd-plus aria-label="Increase quantity"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></button>
              </div>
              <button type="submit" name="add" class="mealplan-pd__btn" data-pd-btn data-label="Add to cart" {% if product != blank and current.available == false %}disabled{% endif %}>
                <span data-pd-btnlabel>{% if product == blank or current.available %}Add to cart{% else %}Sold out{% endif %}</span>
                <svg class="mealplan-pd__btnArrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                {%- render 'loading-spinner' -%}
              </button>
            </div>
            <p class="mealplan-pd__msg" role="alert" data-pd-msg></p>
            {%- if section.settings.note != blank -%}
              <p class="mealplan-pd__note" data-pd-reveal><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h11v9H3zM14 9h4l3 3v3h-7"/><circle cx="7" cy="17" r="1.8"/><circle cx="17" cy="17" r="1.8"/></svg>{{ section.settings.note | escape }}</p>
            {%- endif -%}
      {%- endcapture -%}
      {%- if product != blank -%}
        <product-form class="product-form" data-section-id="{{ section.id }}">
          {%- form 'product', product, id: mealplan_form_id, class: 'mealplan-pd__form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
            <input type="hidden" name="id" class="product-variant-id" value="{{ current.id | default: 67956374241586 }}" data-pd-vid>
            {{ mealplan_fields }}
          {%- endform -%}
        </product-form>
        <script type="application/json" data-pd-variants>
          [
            {%- for variant in product.variants -%}
              {
                "id": {{ variant.id }},
                "options": {{ variant.options | json }},
                "available": {{ variant.available | json }},
                "price": {{ variant.price | money | json }},
                "compare": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},
                "save": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round }}{% else %}0{% endif %},
                "media": {{ variant.featured_media.id | default: 0 }}
              }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]
        </script>
      {%- else -%}
        <form class="mealplan-pd__form" id="{{ mealplan_form_id }}" action="{{ routes.cart_add_url }}" method="post">
          <input type="hidden" name="id" value="{{ current.id | default: 67956374241586 }}" data-pd-vid>
          {{ mealplan_fields }}
        </form>
        <script type="application/json" data-pd-variants>[{"id":{{ current.id | default: 67956374241586 }},"options":["5 Meals"],"available":true,"price":{{ current.price | money | default: '$64.99' | json }},"compare":null,"save":0,"media":0},{"id":{{ variant_10.id | default: current.id | default: 67956374241586 }},"options":["10 Meals"],"available":true,"price":{{ variant_10.price | money | default: '$119.99' | json }},"compare":null,"save":0,"media":0},{"id":{{ variant_custom.id | default: current.id | default: 67956374241586 }},"options":[{{ section.settings.custom_label | json }}],"available":true,"price":{{ variant_custom.price | money | default: '$99.99' | json }},"compare":null,"save":0,"media":0}]</script>
      {%- endif -%}

      <dl class="mealplan-pd__macros" data-pd-reveal>
        <div class="mealplan-pd__macro"><dt>Calories</dt><dd data-pd-count>{{ section.settings.cal | escape }}</dd></div>
        <div class="mealplan-pd__macro"><dt>Protein</dt><dd data-pd-count>{{ section.settings.protein | escape }}</dd></div>
        <div class="mealplan-pd__macro"><dt>Carbs</dt><dd data-pd-count>{{ section.settings.carbs | escape }}</dd></div>
        <div class="mealplan-pd__macro"><dt>Fat</dt><dd data-pd-count>{{ section.settings.fat | escape }}</dd></div>
      </dl>

      {%- assign details = section.blocks | where: 'type', 'accordion' -%}
      {%- if details.size > 0 -%}
        <div class="mealplan-pd__acc" data-pd-reveal>
          {%- for block in details -%}
            <div class="mealplan-pd__accItem{% if block.settings.open %} is-open{% endif %}" {{ block.shopify_attributes }}>
              <button type="button" class="mealplan-pd__accBtn" aria-expanded="{% if block.settings.open %}true{% else %}false{% endif %}" data-pd-acc>
                {{ block.settings.title | escape }}<span class="mealplan-pd__plus" aria-hidden="true"></span>
              </button>
              <div class="mealplan-pd__accPanel"><div class="mealplan-pd__accInner"><div class="mealplan-pd__accBody">{{ block.settings.text }}</div></div></div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product details",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "5 meal product", "info": "Added when 5 Meals is selected. Defaults to the 5-meal-plan product." },
    { "type": "product", "id": "product_10", "label": "10 meal product", "info": "Added when 10 Meals is selected. Defaults to the 10-meal-plan product." },
    { "type": "product", "id": "product_custom", "label": "Custom meal product", "info": "Added for Custom Meal, with the chosen dishes. Defaults to the 5 meal product." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Chef cooked, fresh weekly" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Chicken Biryani with Raita" },
    { "type": "text", "id": "badge", "label": "Badge text", "default": "Fresh • Chef cooked • Never frozen • " },
    { "type": "textarea", "id": "text", "label": "Fallback description", "default": "Cooked fresh by our chefs, packed the same day and ready in minutes." },
    { "type": "text", "id": "chip_1", "label": "Chip 1", "default": "Fresh, never frozen" },
    { "type": "text", "id": "chip_2", "label": "Chip 2", "default": "Ready in 3 minutes" },
    { "type": "text", "id": "chip_3", "label": "Chip 3", "default": "Chef cooked" },
    { "type": "text", "id": "note", "label": "Delivery note", "default": "Free delivery on weekly plans over $60" },
    { "type": "text", "id": "custom_label", "label": "Custom option name", "default": "Custom Meal", "info": "The variant option value that opens the dish picker." },
    { "type": "text", "id": "custom_heading", "label": "Custom picker heading", "default": "Build your custom meal" },
    { "type": "text", "id": "cal", "label": "Calories", "default": "540" },
    { "type": "text", "id": "protein", "label": "Protein", "default": "42g" },
    { "type": "text", "id": "carbs", "label": "Carbs", "default": "48g" },
    { "type": "text", "id": "fat", "label": "Fat", "default": "16g" }
  ],
  "blocks": [
    {
      "type": "dish",
      "name": "Dish",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Chicken Biryani with Raita" },
        { "type": "text", "id": "image_asset", "label": "Theme image filename", "default": "mp-food-0.jpg", "info": "File in the theme assets folder, such as mp-food-0.jpg." }
      ]
    },
    {
      "type": "accordion",
      "name": "Detail",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "What's included" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Main dish, sides, and rice. Packed fresh in a microwave-safe tray.</p>" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product details",
      "blocks": [
        { "type": "accordion", "settings": { "title": "What's included", "text": "<p>Main dish, sides, basmati rice and 2 roti. Packed fresh in a microwave-safe tray.</p>", "open": true } },
        { "type": "accordion", "settings": { "title": "Reheating", "text": "<p>Microwave for 2 to 3 minutes, stir halfway, and enjoy.</p>" } },
        { "type": "accordion", "settings": { "title": "Storage & allergens", "text": "<p>Keep refrigerated and eat within 5 days. Check the label for allergens.</p>" } }
      ]
    }
  ]
}
{% endschema %}
