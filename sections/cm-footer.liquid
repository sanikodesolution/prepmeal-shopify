{% render 'cm-section-assets', section: section %}
{{ 'section-cm-footer.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign logo = section.settings.logo | default: settings.logo
  assign s = section.settings

  assign social_keys = 'facebook,instagram,youtube,tiktok,twitter,pinterest,snapchat,tumblr,vimeo' | split: ','
  assign social_count = 0
  for key in social_keys
    assign setting_key = 'social_' | append: key | append: '_link'
    if settings[setting_key] != blank
      assign social_count = social_count | plus: 1
    endif
  endfor

  assign has_policies = false
  for policy in shop.policies
    if policy != blank
      assign has_policies = true
      break
    endif
  endfor

  assign col_count = 0
  for block in section.blocks
    unless block.type == 'cta'
      assign col_count = col_count | plus: 1
    endunless
  endfor
-%}
{%- capture cmf_about_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'about_' -%}
{%- endcapture -%}
{%- capture cmf_news_heading_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'news_' -%}
{%- endcapture -%}
{%- capture cmf_news_body_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'newsbody_' -%}
{%- endcapture -%}
{%- capture cmf_note_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'note_' -%}
{%- endcapture -%}
{%- capture cmf_copy_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'copy_' -%}
{%- endcapture -%}

<footer
  class="cm cm-footer section-{{ section.id }}-padding"
  data-cm="footer"
  style="--cmf-bg: {{ section.settings.background }}; --cmf-accent: {{ section.settings.accent }}; --cmf-cols: {{ col_count }}; --cmf-logo: {{ section.settings.logo_width }}px;"
>
  <div class="cm-footer__glow" aria-hidden="true"></div>

  <div class="page-width cm-footer__inner">
    {%- for block in section.blocks -%}
      {%- if block.type == 'cta' -%}
        {%- liquid
          assign cta = block.settings
          assign phone_digits = cta.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | remove: '.'
        -%}
        {%- capture cmf_eyebrow_style -%}
          {%- render 'pm-block-type-style', block: block, prefix: 'eyebrow_' -%}
        {%- endcapture -%}
        {%- capture cmf_heading_style -%}
          {%- render 'pm-block-type-style', block: block, prefix: 'heading_' -%}
        {%- endcapture -%}
        {%- capture cmf_body_style -%}
          {%- render 'pm-block-type-style', block: block, prefix: 'body_' -%}
        {%- endcapture -%}
        {%- capture cmf_promise_style -%}
          {%- render 'pm-block-type-style', block: block, prefix: 'promise_' -%}
        {%- endcapture -%}
        <div class="cm-footer__cta" {{ block.shopify_attributes }}>
        <div class="cm-footer__cta-copy">
            {%- if cta.eyebrow != blank -%}
              <p
                class="cm-footer__eyebrow"
                {% if cmf_eyebrow_style != blank %}
                  style="{{ cmf_eyebrow_style | strip }}"
                {% endif %}
              >{{ cta.eyebrow | escape }}</p>
          {%- endif -%}
            {%- if cta.heading != blank -%}
              <h2
                class="cm-footer__cta-title"
                {% if cmf_heading_style != blank %}
                  style="{{ cmf_heading_style | strip }}"
                {% endif %}
              >{{ cta.heading | escape }}</h2>
          {%- endif -%}
            {%- if cta.text != blank -%}
              <div
                class="cm-footer__cta-text"
                {% if cmf_body_style != blank %}
                  style="{{ cmf_body_style | strip }}"
                {% endif %}
              >{{ cta.text }}</div>
          {%- endif -%}

            {%- if cta.promise_1 != blank or cta.promise_2 != blank or cta.promise_3 != blank -%}
              <ul
                class="cm-footer__promises"
                role="list"
                {% if cmf_promise_style != blank %}
                  style="{{ cmf_promise_style | strip }}"
                {% endif %}
              >
                {%- if cta.promise_1 != blank -%}
                  <li>{% render 'cm-footer-icon', icon: 'chef' %}{{ cta.promise_1 | escape }}</li>
              {%- endif -%}
                {%- if cta.promise_2 != blank -%}
                  <li>{% render 'cm-footer-icon', icon: 'leaf' %}{{ cta.promise_2 | escape }}</li>
              {%- endif -%}
                {%- if cta.promise_3 != blank -%}
                  <li>{% render 'cm-footer-icon', icon: 'truck' %}{{ cta.promise_3 | escape }}</li>
              {%- endif -%}
            </ul>
          {%- endif -%}
        </div>

        <div class="cm-footer__cta-actions">
            {%- if cta.button_label != blank -%}
            {% render 'pm-button',
                label: cta.button_label,
                link: cta.button_link,
              style: 'ink',
                class: 'cm-footer__pm',
                text_color: cta.button_text_color,
                bg_color: cta.button_bg_color,
                icon_bg: cta.button_icon_bg,
                icon_color: cta.button_icon_color,
                font_size: cta.button_font_size, hover_text_color: cta.button_hover_text_color, hover_bg_color: cta.button_hover_bg_color
            %}
          {%- endif -%}
            {%- if cta.phone != blank -%}
            <a class="cm-footer__btn cm-footer__btn--ghost" href="tel:{{ phone_digits }}">
              {% render 'cm-footer-icon', icon: 'phone' %}
                <span>{{ cta.phone | escape }}</span>
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
    {%- endfor -%}

    <div class="cm-footer__grid{% unless section.settings.show_newsletter %} cm-footer__grid--no-news{% endunless %}">
      <div class="cm-footer__col cm-footer__brand">
        <a href="{{ routes.root_url }}" class="cm-footer__logo">
          {%- if logo != blank -%}
            {%- assign logo_sizes = section.settings.logo_width | append: 'px' -%}
            {{
              logo
              | image_url: width: 520
              | image_tag:
                widths: '160, 260, 390, 520',
                sizes: logo_sizes,
                alt: shop.name,
                loading: 'lazy'
            }}
          {%- elsif settings.logo_asset != blank -%}
            <img
              src="{{ settings.logo_asset | asset_img_url: '400x' }}"
              srcset="{{ settings.logo_asset | asset_img_url: '200x' }} 200w, {{ settings.logo_asset | asset_img_url: '400x' }} 400w"
              sizes="{{ section.settings.logo_width }}px"
              width="{{ section.settings.logo_width }}"
              height="{{ section.settings.logo_width }}"
              alt="{{ shop.name | escape }}"
              loading="lazy"
            >
          {%- else -%}
            <span class="cm-footer__wordmark">{{ shop.name }}</span>
          {%- endif -%}
        </a>

        {%- if section.settings.about != blank -%}
          <div
            class="cm-footer__about"
            {% if cmf_about_style != blank %}
              style="{{ cmf_about_style | strip }}"
            {% endif %}
          >{{ section.settings.about }}</div>
        {%- endif -%}

        {%- if section.settings.show_social and social_count > 0 -%}
          <ul class="cm-footer__social" role="list">
            {%- for key in social_keys -%}
              {%- assign setting_key = 'social_' | append: key | append: '_link' -%}
              {%- if settings[setting_key] != blank -%}
                {%- assign icon_file = 'icon-' | append: key | append: '.svg' -%}
                <li>
                  <a
                    href="{{ settings[setting_key] }}"
                    class="cm-footer__social-link"
                    target="_blank"
                    rel="noopener"
                    aria-label="{{ key | capitalize }}"
                  >
                    {{- icon_file | inline_asset_content -}}
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- unless block.type == 'cta' -%}
        {%- capture cmf_col_heading_style -%}
          {%- render 'pm-block-type-style', block: block, prefix: 'title_' -%}
        {%- endcapture -%}
        {%- capture cmf_col_body_style -%}
          {%- render 'pm-block-type-style', block: block, prefix: 'body_' -%}
        {%- endcapture -%}
        <div class="cm-footer__col cm-footer__col--{{ block.type }}" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <h5
              class="cm-footer__heading"
              {% if cmf_col_heading_style != blank %}
                style="{{ cmf_col_heading_style | strip }}"
              {% endif %}
            >{{ block.settings.heading | escape }}</h5>
          {%- endif -%}

          {%- case block.type -%}
            {%- when 'links' -%}
              <ul class="cm-footer__links" role="list">
                {%- for i in (1..6) -%}
                  {%- assign label_key = 'label_' | append: i -%}
                  {%- assign url_key = 'link_' | append: i -%}
                  {%- if block.settings[label_key] != blank and block.settings[url_key] != blank -%}
                    <li>
                      <a
                        href="{{ block.settings[url_key] }}"
                        class="cm-footer__link"
                        {% if cmf_col_body_style != blank %}
                          style="{{ cmf_col_body_style | strip }}"
                        {% endif %}
                      >
                        {{- block.settings[label_key] | escape -}}
                      </a>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>

            {%- when 'menu' -%}
              {%- assign menu = linklists[block.settings.menu] -%}
              {%- if menu.links.size > 0 -%}
                <ul class="cm-footer__links" role="list">
                  {%- for link in menu.links -%}
                    <li>
                      <a
                        href="{{ link.url }}"
                        class="cm-footer__link"
                        {% if link.current %}
                          aria-current="page"
                        {% endif %}
                        {% if cmf_col_body_style != blank %}
                          style="{{ cmf_col_body_style | strip }}"
                        {% endif %}
                      >
                        {{- link.title | escape -}}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}

            {%- when 'contact' -%}
              <ul
                class="cm-footer__contact"
                role="list"
                {% if cmf_col_body_style != blank %}
                  style="{{ cmf_col_body_style | strip }}"
                {% endif %}
              >
                {%- if block.settings.phone != blank -%}
                  {%- assign block_phone = block.settings.phone
                    | remove: ' '
                    | remove: '('
                    | remove: ')'
                    | remove: '-'
                    | remove: '.'
                  -%}
                  <li>
                    <span class="cm-footer__contact-icon">{% render 'cm-footer-icon', icon: 'phone' %}</span>
                    <a href="tel:{{ block_phone }}" class="cm-footer__link">{{ block.settings.phone | escape }}</a>
                  </li>
                {%- endif -%}
                {%- if block.settings.email != blank -%}
                  <li>
                    <span class="cm-footer__contact-icon">{% render 'cm-footer-icon', icon: 'mail' %}</span>
                    <a href="mailto:{{ block.settings.email | escape }}" class="cm-footer__link">
                      {{- block.settings.email | escape -}}
                    </a>
                  </li>
                {%- endif -%}
                {%- if block.settings.area != blank -%}
                  <li>
                    <span class="cm-footer__contact-icon">{% render 'cm-footer-icon', icon: 'pin' %}</span>
                    <span>{{ block.settings.area | escape | newline_to_br }}</span>
                  </li>
                {%- endif -%}
                {%- if block.settings.hours != blank -%}
                  <li>
                    <span class="cm-footer__contact-icon">{% render 'cm-footer-icon', icon: 'clock' %}</span>
                    <span>{{ block.settings.hours | escape | newline_to_br }}</span>
                  </li>
                {%- endif -%}
              </ul>
          {%- endcase -%}
        </div>
        {%- endunless -%}
      {%- endfor -%}

      {%- if section.settings.show_newsletter -%}
        <div class="cm-footer__col cm-footer__news">
          {%- if section.settings.newsletter_heading != blank -%}
            <h5
              class="cm-footer__heading"
              {% if cmf_news_heading_style != blank %}
                style="{{ cmf_news_heading_style | strip }}"
              {% endif %}
            >{{ section.settings.newsletter_heading | escape }}</h5>
          {%- endif -%}
          {%- if section.settings.newsletter_text != blank -%}
            <div
              class="cm-footer__news-text"
              {% if cmf_news_body_style != blank %}
                style="{{ cmf_news_body_style | strip }}"
              {% endif %}
            >{{ section.settings.newsletter_text }}</div>
          {%- endif -%}

          {%- form 'customer', id: 'CmFooterNewsletter', class: 'cm-footer__form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="cm-footer__field">
              <label class="visually-hidden" for="CmFooterEmail-{{ section.id }}">
                {{- 'newsletter.label' | t -}}
              </label>
              <input
                id="CmFooterEmail-{{ section.id }}"
                type="email"
                name="contact[email]"
                class="cm-footer__input"
                value="{{ form.email }}"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                placeholder="{{ 'newsletter.label' | t }}"
                required
                {% if form.errors %}
                  aria-invalid="true" aria-describedby="CmFooterNewsletter-error"
                {% elsif form.posted_successfully? %}
                  aria-describedby="CmFooterNewsletter-success"
                {% endif %}
              >
              <button type="submit" class="cm-footer__submit" name="commit">
                <span>{{ section.settings.newsletter_button | default: 'Subscribe' | escape }}</span>
                {% render 'cm-footer-icon', icon: 'arrow-right' %}
              </button>
            </div>
            {%- if form.errors -%}
              <p class="cm-footer__msg cm-footer__msg--error" id="CmFooterNewsletter-error">
                {{- form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email -}}
              </p>
            {%- elsif form.posted_successfully? -%}
              <p class="cm-footer__msg" id="CmFooterNewsletter-success" tabindex="-1" autofocus>
                {% render 'cm-footer-icon', icon: 'check' %}
                {{- 'newsletter.success' | t -}}
              </p>
            {%- endif -%}
          {%- endform -%}

          {%- if section.settings.newsletter_note != blank -%}
            <p
              class="cm-footer__note"
              {% if cmf_note_style != blank %}
                style="{{ cmf_note_style | strip }}"
              {% endif %}
            >{{ section.settings.newsletter_note | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.watermark != blank -%}
      <p class="cm-footer__watermark" aria-hidden="true">{{ section.settings.watermark | escape }}</p>
    {%- endif -%}

    <div class="cm-footer__bottom">
      <p
        class="cm-footer__copy"
        {% if cmf_copy_style != blank %}
          style="{{ cmf_copy_style | strip }}"
        {% endif %}
      >
        &copy; {{ 'now' | date: '%Y' }}
        {{ shop.name | link_to: routes.root_url }}. {{ section.settings.copyright_text | escape }}
      </p>

      {%- if section.settings.show_policies and has_policies -%}
        <ul class="cm-footer__policies" role="list">
          {%- for policy in shop.policies -%}
            {%- if policy != blank -%}
              <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="cm-footer__bottom-end">
        {%- if section.settings.show_payment and shop.enabled_payment_types.size > 0 -%}
          <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
          <ul class="cm-footer__payments" role="list">
            {%- for type in shop.enabled_payment_types -%}
              <li>{{ type | payment_type_svg_tag: class: 'cm-footer__pay' }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if section.settings.show_back_to_top -%}
          <a href="#" class="cm-footer__top" aria-label="Back to top">
            {% render 'cm-footer-icon', icon: 'arrow-up' %}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Chef Matt footer",
  "tag": "div",
  "class": "section cm-footer-section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "max_blocks": 6,
  "blocks": [
    {
      "type": "cta",
      "name": "Call to action",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Fresh every week" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Ready to eat better this week?" },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Chef-made, portion-controlled meals prepared fresh and delivered to your door.</p>"
        },
        { "type": "text", "id": "promise_1", "label": "Promise 1", "default": "Chef-made weekly" },
        { "type": "text", "id": "promise_2", "label": "Promise 2", "default": "Locally sourced" },
        { "type": "text", "id": "promise_3", "label": "Promise 3", "default": "Local delivery" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "View meal plans" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "header", "content": "Button style" },
        { "type": "color", "id": "button_text_color", "label": "Text color" },
        { "type": "color", "id": "button_bg_color", "label": "Background color" }, { "type": "color", "id": "button_hover_text_color", "label": "Hover text color", "info": "Clear to keep the style preset hover." }, { "type": "color", "id": "button_hover_bg_color", "label": "Hover background color", "info": "Clear to keep the style preset hover." },
        { "type": "color", "id": "button_icon_bg", "label": "Icon background" },
        { "type": "color", "id": "button_icon_color", "label": "Icon color" },
        { "type": "range", "id": "button_font_size", "min": 12, "max": 24, "step": 1, "unit": "px", "label": "Font size", "default": 16 },
        { "type": "text", "id": "phone", "label": "Phone button", "info": "Leave empty to hide the call button." },
        { "type": "header", "content": "Eyebrow type" },
        { "type": "color", "id": "eyebrow_color", "label": "Text color" }, { "type": "color", "id": "eyebrow_hover_color", "label": "Hover text color", "info": "Clear to keep default." },
        { "type": "range", "id": "eyebrow_font_size", "min": 0, "max": 48, "step": 1, "unit": "px", "label": "Font size", "default": 0, "info": "0 = theme default. Custom sizes start at 14px." },
        { "type": "select", "id": "eyebrow_font_weight", "label": "Font weight", "options": [{ "value": "inherit", "label": "Theme default" }, { "value": "400", "label": "Regular 400" }, { "value": "500", "label": "Medium 500" }, { "value": "600", "label": "Semi-bold 600" }, { "value": "700", "label": "Bold 700" }, { "value": "800", "label": "Extra-bold 800" }], "default": "inherit" },
        { "type": "range", "id": "eyebrow_letter_spacing", "min": -4, "max": 12, "step": 1, "unit": "px", "label": "Letter spacing", "default": 0 },
        { "type": "range", "id": "eyebrow_line_height", "min": 0, "max": 2, "step": 0.1, "label": "Line height", "default": 0, "info": "0 = theme default" },
        { "type": "header", "content": "Eyebrow format" },
        { "type": "select", "id": "eyebrow_font_style", "label": "Font style", "options": [{ "value": "inherit", "label": "Theme default" }, { "value": "normal", "label": "Normal" }, { "value": "italic", "label": "Italic" }], "default": "inherit" },
        { "type": "select", "id": "eyebrow_font_family", "label": "Font family", "options": [{ "value": "inherit", "label": "Theme default" }, { "value": "heading", "label": "Heading font" }, { "value": "body", "label": "Body font" }], "default": "inherit" },
        { "type": "range", "id": "eyebrow_word_spacing", "min": -4, "max": 20, "step": 1, "unit": "px", "label": "Word spacing", "default": 0, "info": "0 = theme default" },
        { "type": "select", "id": "eyebrow_text_transform", "label": "Text transform", "options": [{ "value": "inherit", "label": "Theme default" }, { "value": "none", "label": "None" }, { "value": "uppercase", "label": "Uppercase" }, { "value": "lowercase", "label": "Lowercase" }, { "value": "capitalize", "label": "Capitalize" }], "default": "inherit" },
        { "type": "select", "id": "eyebrow_text_decoration", "label": "Text decoration", "options": [{ "value": "inherit", "label": "Theme default" }, { "value": "none", "label": "None" }, { "value": "underline", "label": "Underline" }, { "value": "line-through", "label": "Line through" }], "default": "inherit" },
        { "type": "select", "id": "eyebrow_text_align", "label": "Text align", "options": [{ "value": "inherit", "label": "Theme default" }, { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "inherit" },
        { "type": "range", "id": "eyebrow_opacity", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Opacity", "default": 100, "info": "100 = fully opaque" },
        { "type": "header", "content": "Eyebrow box" },
        { "type": "range", "id": "eyebrow_max_width", "min": 0, "max": 1000, "step": 10, "unit": "px", "label": "Max width", "default": 0, "info": "0 = no limit" },
        { "type": "range", "id": "eyebrow_border_radius", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Corner radius", "default": 0 },
        { "type": "color", "id": "eyebrow_bg_color", "label": "Background color", "info": "Clear swatch to reset." }, { "type": "color", "id": "eyebrow_hover_bg_color", "label": "Hover background color", "info": "Clear to keep default." },
        { "type": "image_picker", "id": "eyebrow_bg_image", "label": "Background image" },
        { "type": "header", "content": "Eyebrow space" },
        { "type": "range", "id": "eyebrow_padding_top", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Padding top", "default": 0 },
        { "type": "range", "id": "eyebrow_padding_bottom", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Padding bottom", "default": 0 },
        { "type": "range", "id": "eyebrow_padding_left", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Padding left", "default": 0 },
        { "type": "range", "id": "eyebrow_padding_right", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Padding right", "default": 0 },
        { "type": "range", "id": "eyebrow_margin_top", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Margin top", "default": 0 },
        { "type": "range", "id": "eyebrow_margin_bottom", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Margin bottom", "default": 0 },
        { "type": "range", "id": "eyebrow_margin_left", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Margin left", "default": 0 },
        { "type": "range", "id": "eyebrow_margin_right", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Margin right", "default": 0 },
