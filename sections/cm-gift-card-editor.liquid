{{ 'section-cm-gift-card-editor.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cm-gift-card-editor.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign gce_body = settings.type_body_font
  assign gce_heading = settings.type_header_font
  assign gce_heading_bold = gce_heading | font_modify: 'weight', 'bold'
  if gce_heading_bold == blank
    assign gce_heading_bold = gce_heading
  endif
-%}
{%- style -%}
  {{ gce_body | font_face: font_display: 'swap' }}
  {{ gce_heading | font_face: font_display: 'swap' }}
  {{ gce_heading_bold | font_face: font_display: 'swap' }}
  .gce {
    --gce-font-body: {{ gce_body.family }}, {{ gce_body.fallback_families }};
    --gce-font-heading: {{ gce_heading_bold.family }}, {{ gce_heading_bold.fallback_families }};
  }
{%- endstyle -%}

<section
  class="gce"
  data-gce
  data-gce-theme-body="{{ gce_body.family | escape }}, {{ gce_body.fallback_families | escape }}"
  data-gce-theme-heading="{{ gce_heading_bold.family | escape }}, {{ gce_heading_bold.fallback_families | escape }}"
>
  <div class="gce__wrap">
    <div class="gce__preview">
      <div class="gce__stage" data-gce-stage>
        <svg class="gce__svg" data-gce-svg viewBox="0 0 800 680" role="img" aria-label="Gift Card"></svg>
      </div>
      <p class="gce__hint">বাঁদিকে লাইভ প্রিভিউ। ডানদিকের customization বদলালে কার্ড সাথে সাথে আপডেট হবে।</p>
    </div>

    <aside class="gce__panel" data-gce-panel>
      <h1 class="gce__title">Gift Card Editor</h1>

      <div class="gce__group">
        <p class="gce__group-title">লেখা</p>
        <div class="gce__field">
          <label for="GceGift-{{ section.id }}">বড় লেখা (১ম লাইন)</label>
          <input id="GceGift-{{ section.id }}" type="text" data-gce-field="gift" value="Gift">
        </div>
        <div class="gce__field">
          <label for="GceCard-{{ section.id }}">বড় লেখা (২য় লাইন)</label>
          <input id="GceCard-{{ section.id }}" type="text" data-gce-field="card" value="Card">
        </div>
        <div class="gce__field">
          <label for="GceBrand-{{ section.id }}">ব্র্যান্ডের নাম</label>
          <input id="GceBrand-{{ section.id }}" type="text" data-gce-field="brand" value="MEALS">
        </div>
        <div class="gce__field">
          <label for="GceSub-{{ section.id }}">ব্র্যান্ডের নিচের লেখা</label>
          <input id="GceSub-{{ section.id }}" type="text" data-gce-field="subtitle" value="FRESH MEAL PREP">
        </div>
        <div class="gce__field">
          <label for="GceBadge-{{ section.id }}">ব্যাজের লেখা (লোগো না থাকলে)</label>
          <input id="GceBadge-{{ section.id }}" type="text" data-gce-field="badge" value="CM">
        </div>
        <div class="gce__field">
          <label for="GceNote-{{ section.id }}">নিচের ছোট নোট</label>
          <input id="GceNote-{{ section.id }}" type="text" data-gce-field="note" value="Redeemable on any meal plan">
        </div>
      </div>

      <div class="gce__group">
        <p class="gce__group-title">টাইপোগ্রাফি</p>
        <div class="gce__field">
          <label for="GceFont-{{ section.id }}">ফন্ট ফ্যামিলি</label>
          <select id="GceFont-{{ section.id }}" data-gce-field="fontFamily">
            <option value="theme" selected>Theme default</option>
            <option value="Inter">Inter</option>
            <option value="Montserrat">Montserrat</option>
            <option value="Roboto">Roboto</option>
            <option value="Open Sans">Open Sans</option>
            <option value="Lato">Lato</option>
            <option value="Nunito">Nunito</option>
            <option value="Raleway">Raleway</option>
            <option value="Oswald">Oswald</option>
            <option value="DM Sans">DM Sans</option>
            <option value="Space Grotesk">Space Grotesk</option>
            <option value="Playfair Display">Playfair Display</option>
            <option value="Merriweather">Merriweather</option>
            <option value="Libre Baskerville">Libre Baskerville</option>
            <option value="system-ui">System UI</option>
            <option value="Georgia">Georgia</option>
            <option value="Arial">Arial</option>
          </select>
        </div>
        <div class="gce__row">
          <div class="gce__field">
            <label for="GceWeightHead-{{ section.id }}">হেডিং ওয়েট</label>
            <select id="GceWeightHead-{{ section.id }}" data-gce-field="weightHead">
              <option value="400">Regular 400</option>
              <option value="500">Medium 500</option>
              <option value="600">Semi-bold 600</option>
              <option value="700" selected>Bold 700</option>
              <option value="800">Extra-bold 800</option>
            </select>
          </div>
          <div class="gce__field">
            <label for="GceWeightBody-{{ section.id }}">বডি ওয়েট</label>
            <select id="GceWeightBody-{{ section.id }}" data-gce-field="weightBody">
              <option value="400" selected>Regular 400</option>
              <option value="500">Medium 500</option>
              <option value="600">Semi-bold 600</option>
              <option value="700">Bold 700</option>
            </select>
          </div>
        </div>
        <div class="gce__field">
          <div class="gce__meta">
            <label for="GceGiftSize-{{ section.id }}">১ম লাইন সাইজ</label>
            <span data-gce-val="giftSize">84px</span>
          </div>
          <input id="GceGiftSize-{{ section.id }}" type="range" min="14" max="120" step="1" value="84" data-gce-field="giftSize">
        </div>
        <div class="gce__field">
          <div class="gce__meta">
            <label for="GceCardSize-{{ section.id }}">২য় লাইন সাইজ</label>
            <span data-gce-val="cardSize">62px</span>
          </div>
          <input id="GceCardSize-{{ section.id }}" type="range" min="14" max="100" step="1" value="62" data-gce-field="cardSize">
        </div>
        <div class="gce__field">
          <div class="gce__meta">
            <label for="GceBrandSize-{{ section.id }}">ব্র্যান্ড সাইজ</label>
            <span data-gce-val="brandSize">15px</span>
          </div>
          <input id="GceBrandSize-{{ section.id }}" type="range" min="14" max="40" step="1" value="15" data-gce-field="brandSize">
        </div>
        <div class="gce__field">
          <div class="gce__meta">
            <label for="GceSubSize-{{ section.id }}">সাবটাইটেল সাইজ</label>
            <span data-gce-val="subSize">14px</span>
          </div>
          <input id="GceSubSize-{{ section.id }}" type="range" min="14" max="28" step="1" value="14" data-gce-field="subSize">
        </div>
        <div class="gce__field">
          <div class="gce__meta">
            <label for="GceBadgeSize-{{ section.id }}">ব্যাজ সাইজ</label>
            <span data-gce-val="badgeSize">22px</span>
          </div>
          <input id="GceBadgeSize-{{ section.id }}" type="range" min="14" max="40" step="1" value="22" data-gce-field="badgeSize">
        </div>
        <div class="gce__field">
          <div class="gce__meta">
            <label for="GceNoteSize-{{ section.id }}">নোট সাইজ</label>
            <span data-gce-val="noteSize">14px</span>
          </div>
          <input id="GceNoteSize-{{ section.id }}" type="range" min="14" max="28" step="1" value="14" data-gce-field="noteSize">
        </div>
        <div class="gce__field">
          <div class="gce__meta">
            <label for="GceTracking-{{ section.id }}">লেটার স্পেসিং</label>
            <span data-gce-val="tracking">-2</span>
          </div>
          <input id="GceTracking-{{ section.id }}" type="range" min="-4" max="8" step="1" value="-2" data-gce-field="tracking">
        </div>
      </div>

      <div class="gce__group">
        <p class="gce__group-title">কার্ড সাইজ</p>
        <div class="gce__field">
          <div class="gce__meta">
            <label for="GceCardWidth-{{ section.id }}">প্রিভিউ প্রস্থ</label>
            <span data-gce-val="cardWidth">560px</span>
          </div>
          <input id="GceCardWidth-{{ section.id }}" type="range" min="300" max="900" step="20" value="560" data-gce-field="cardWidth">
        </div>
      </div>

      <div class="gce__group">
        <p class="gce__group-title">রং</p>
        <div class="gce__colors">
          <div class="gce__color">
            <label for="GceCardBg-{{ section.id }}">কার্ড</label>
            <input id="GceCardBg-{{ section.id }}" type="color" value="#FFFDF6" data-gce-field="cardBg">
          </div>
          <div class="gce__color">
            <label for="GceSectionBg-{{ section.id }}">ব্যাকগ্রাউন্ড</label>
            <input id="GceSectionBg-{{ section.id }}" type="color" value="#E6E6E3" data-gce-field="sectionBg">
          </div>
          <div class="gce__color">
            <label for="GceMain-{{ section.id }}">বড় লেখা</label>
            <input id="GceMain-{{ section.id }}" type="color" value="#14213D" data-gce-field="textMain">
          </div>
          <div class="gce__color">
            <label for="GceAccent-{{ section.id }}">২য় লেখা</label>
            <input id="GceAccent-{{ section.id }}" type="color" value="#F5A623" data-gce-field="textAccent">
          </div>
          <div class="gce__color">
            <label for="GceRibbon-{{ section.id }}">রিবন</label>
            <input id="GceRibbon-{{ section.id }}" type="color" value="#14213D" data-gce-field="ribbon">
          </div>
          <div class="gce__color">
            <label for="GceBow-{{ section.id }}">বো</label>
            <input id="GceBow-{{ section.id }}" type="color" value="#F5A623" data-gce-field="bow">
          </div>
        </div>
      </div>

      <div class="gce__group">
        <p class="gce__group-title">লেআউট</p>
        <div class="gce__field">
          <div class="gce__meta">
            <label for="GceTilt-{{ section.id }}">কাত করা (ডিগ্রি)</label>
            <span data-gce-val="tilt">-7°</span>
          </div>
          <input id="GceTilt-{{ section.id }}" type="range" min="-20" max="20" step="1" value="-7" data-gce-field="tilt">
        </div>
        <label class="gce__check">
          <input type="checkbox" checked data-gce-field="showRibbon">
          রিবন ও বো দেখাও
        </label>
        <label class="gce__check">
          <input type="checkbox" data-gce-field="transparentBg">
          ব্যাকগ্রাউন্ড স্বচ্ছ
        </label>
      </div>

      <div class="gce__group">
        <p class="gce__group-title">লোগো</p>
        <div class="gce__logo">
          <div class="gce__logo-row">
            <label class="gce__file">
              Choose File
              <input type="file" accept="image/*" data-gce-field="logo">
            </label>
            <button type="button" class="gce__btn gce__btn--ghost" data-gce-remove-logo>লোগো সরাও</button>
          </div>
          <span class="gce__logo-name" data-gce-logo-name>কোনো ফাইল নেই</span>
          <p class="gce__note">লোগো দিলে CM ব্যাজ ও ব্র্যান্ড টেক্সট হাইড হবে।</p>
        </div>
      </div>

      <div class="gce__actions">
        <button type="button" class="gce__btn gce__btn--primary" data-gce-png>PNG ডাউনলোড</button>
        <button type="button" class="gce__btn gce__btn--ghost" data-gce-svg>SVG ডাউনলোড</button>
        <button type="button" class="gce__btn gce__btn--ghost" data-gce-reset>রিসেট</button>
      </div>
      <p class="gce__note">PNG ২× সাইজে (১৬০০×১৩৬০) সেভ হবে — Shopify gift card product media তে আপলোড করুন। সব ফন্ট সাইজ সর্বনিম্ন ১৪px।</p>
    </aside>
  </div>
</section>

{% schema %}
{
  "name": "Gift card editor",
  "tag": "section",
  "class": "section-gift-card-editor",
  "settings": [],
  "presets": [
    { "name": "Gift card editor" }
  ]
}
{% endschema %}
