{% render 'cm-section-assets', section: section %}

{%- liquid
  assign s = section.settings
-%}
{%- capture usp_eyebrow_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'eyebrow_' -%}
{%- endcapture -%}
{%- capture usp_heading_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'heading_' -%}
{%- endcapture -%}

<div class="cm cm-usp cm--{{ section.settings.background }}" data-cm="usp">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.label != blank or section.settings.heading != blank -%}
      <div class="cm-usp__intro cm-center">
        {%- if s.label != blank -%}
          <span
            class="cm-label"
            {% if usp_eyebrow_style != blank %}
              style="{{ usp_eyebrow_style | strip }}"
            {% endif %}
          >
            {{- s.label | escape -}}
          </span>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2
            class="cm-heading"
            {% if usp_heading_style != blank %}
              style="{{ usp_heading_style | strip }}"
            {% endif %}
          >
            {{- s.heading | escape | newline_to_br -}}
          </h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="cm-usp__rows">
      {%- for block in section.blocks -%}
        {%- capture row_label_style -%}
          {%- render 'pm-block-type-style', block: block, prefix: 'label_' -%}
        {%- endcapture -%}
        {%- capture row_title_style -%}
          {%- render 'pm-block-type-style', block: block, prefix: 'title_' -%}
        {%- endcapture -%}
        {%- capture row_body_style -%}
          {%- render 'pm-block-type-style', block: block, prefix: 'body_' -%}
        {%- endcapture -%}
        {%- liquid
          assign alt = block.settings.image_alt | default: block.settings.title
          assign asset_ext = block.settings.image_asset | split: '.' | last | downcase
        -%}
        <div class="cm-usp__row" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank or block.settings.image_asset != blank -%}
            <div class="cm-usp__media">
              {%- if asset_ext == 'gif' and block.settings.image_asset != blank -%}
                <img
                  src="{{ block.settings.image_asset | asset_url }}"
                  alt="{{ alt | escape }}"
                  width="{{ block.settings.image_width }}"
                  height="{{ block.settings.image_height }}"
                  loading="lazy"
                >
              {%- elsif block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1400
                  | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', alt: alt
                }}
              {%- else -%}
                {%- render 'asset-image',
                  src: block.settings.image_asset,
                  widths: '375, 550, 750, 1100, 1400',
                  sizes: '(min-width: 750px) 50vw, 100vw',
                  alt: alt,
                  width: block.settings.image_width,
                  height: block.settings.image_height
                -%}
              {%- endif -%}
            </div>
          {%- endif -%}
          <div class="cm-usp__text">
            {%- if block.settings.label != blank -%}
              <span
                class="cm-label"
                {% if row_label_style != blank %}
                  style="{{ row_label_style | strip }}"
                {% endif %}
              >
                {{- block.settings.label | escape -}}
              </span>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3
                class="cm-usp__title"
                {% if row_title_style != blank %}
                  style="{{ row_title_style | strip }}"
                {% endif %}
              >
                {{- block.settings.title | escape -}}
              </h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div
                class="cm-body"
                {% if row_body_style != blank %}
                  style="{{ row_body_style | strip }}"
                {% endif %}
              >
                {{ block.settings.text }}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

