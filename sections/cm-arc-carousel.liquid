{% render 'cm-section-assets', section: section %}
<script src="{{ 'cm-arc-carousel.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings
  assign source = 'blocks'
  if section.blocks.size == 0 and section.settings.collection != blank
    assign source = 'collection'
  endif

  assign item_count = 0
  if source == 'collection'
    for product in section.settings.collection.products limit: section.settings.products_limit
      if product.featured_image != blank
        assign item_count = item_count | plus: 1
      endif
    endfor
  else
    for block in section.blocks
      if block.settings.image != blank or block.settings.image_asset != blank or request.design_mode
        assign item_count = item_count | plus: 1
      endif
    endfor
  endif
-%}
{%- capture arc_eyebrow_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'eyebrow_' -%}
{%- endcapture -%}
{%- capture arc_heading_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'heading_' -%}
{%- endcapture -%}
{%- capture arc_body_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'body_' -%}
{%- endcapture -%}
{%- capture arc_note_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'note_' -%}
{%- endcapture -%}
{%- if item_count > 0 -%}

<div
  class="cm cm-arc cm-arc--orbit cm-arc--{{ section.settings.image_style }}"
  data-cm="arc"
  style="
    --cm-arc-bg-1: {{ section.settings.bg_color_1 }};
    --cm-arc-bg-2: {{ section.settings.bg_color_2 }};
    --cm-arc-text: {{ section.settings.text_color }};
    --cm-arc-accent: {{ section.settings.accent }};
    --cm-arc-w-max: {{ section.settings.item_width }}px;
    --cm-arc-ratio: {{ section.settings.item_shape }};
    --cm-arc-curve: {{ section.settings.curve | abs }}px;
  "
>
  <div class="cm-arc__spot" aria-hidden="true"></div>
  <div class="cm-arc__glow" aria-hidden="true"></div>
  {%- if section.settings.show_frame -%}
    <div class="cm-arc__frame" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
  {%- endif -%}
  <div class="cm-arc__content section-{{ section.id }}-padding">
    <div class="cm-arc__layout page-width">
    <cm-arc-carousel
      data-orbit="1"
      data-gap="{{ section.settings.gap }}"
      data-curve="{{ section.settings.curve }}"
      data-tilt="{{ section.settings.tilt }}"
      data-autoplay="{% if section.settings.autoplay %}{{ section.settings.autoplay_speed }}{% else %}0{% endif %}"
      data-accent="{{ section.settings.accent }}"
    >
      <div class="cm-arc__stage-wrap">
        <div
          class="cm-arc__stage"
          tabindex="0"
          role="region"
          aria-roledescription="carousel"
          aria-label="{{ section.settings.heading | default: 'Products' | escape }}"
        >
          {%- if source == 'collection' -%}
            {%- for product in section.settings.collection.products limit: section.settings.products_limit -%}
              {%- if product.featured_image == blank -%}{%- continue -%}{%- endif -%}
              {%- assign product_price = product.price | money -%}
              {%- render 'cm-arc-item',
                image: product.featured_image,
                title: product.title,
                subtitle: product_price,
                link: product.url,
                accent: section.settings.accent,
                index: forloop.index0
              -%}
            {%- endfor -%}
          {%- else -%}
            {%- for block in section.blocks -%}
              {%- if block.settings.image == blank and block.settings.image_asset == blank -%}
                {%- unless request.design_mode -%}{%- continue -%}{%- endunless -%}
              {%- endif -%}
              {%- render 'cm-arc-item',
                image: block.settings.image,
                image_asset: block.settings.image_asset,
                title: block.settings.title,
                subtitle: block.settings.subtitle,
                link: block.settings.link,
                accent: block.settings.accent,
                index: forloop.index0,
                attrs: block.shopify_attributes
              -%}
            {%- endfor -%}
          {%- endif -%}
        </div>

        {%- if section.settings.show_arrows -%}
          <button type="button" class="cm-arc__nav cm-arc__nav--prev" data-arc-prev aria-label="Previous">
            <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 6l-6 6 6 6M19 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button type="button" class="cm-arc__nav cm-arc__nav--next" data-arc-next aria-label="Next">
            <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 6l6 6-6 6M5 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        {%- endif -%}
      </div>

      <p class="cm-arc__orbit-name" aria-live="polite"></p>
      <div class="cm-arc__info" hidden aria-live="polite">
        <h3 class="cm-arc__title"></h3>
        <p class="cm-arc__subtitle"></p>
        <div class="cm-arc__progress" aria-hidden="true">
          <span class="cm-arc__progress-fill"></span>
          <span class="cm-arc__progress-dot"></span>
        </div>
        {%- if section.settings.button_label != blank or section.settings.button_label_2 != blank -%}
          <div class="cm-arc__actions">
            {%- if section.settings.button_label != blank -%}
              {% render 'pm-button',
                label: section.settings.button_label,
                link: '#',
                style: 'light',
                class: 'cm-arc__btn',
                hidden: true,
                text_color: section.settings.button_text_color,
                bg_color: section.settings.button_bg_color,
                icon_bg: section.settings.button_icon_bg,
                icon_color: section.settings.button_icon_color,
                font_size: section.settings.button_font_size
              %}
            {%- endif -%}
            {%- if section.settings.button_label_2 != blank -%}
              {% render 'pm-button',
                label: section.settings.button_label_2,
                link: section.settings.button_link_2,
                style: 'brand',
                class: 'cm-arc__btn-2',
                text_color: section.settings.button_text_color_2,
                bg_color: section.settings.button_bg_color_2,
                icon_bg: section.settings.button_icon_bg_2,
                icon_color: section.settings.button_icon_color_2,
                font_size: section.settings.button_font_size_2
              %}
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if s.hint != blank -%}
          <p
            class="cm-arc__hint"
            {% if arc_note_style != blank %}
              style="{{ arc_note_style | strip }}"
            {% endif %}
          >
            {{- s.hint | escape -}}
          </p>
        {%- endif -%}
      </div>
    </cm-arc-carousel>
    <div class="cm-arc__copy">
      {%- if s.label != blank -%}
        <span
          class="cm-label"
          {% if arc_eyebrow_style != blank %}
            style="{{ arc_eyebrow_style | strip }}"
          {% endif %}
        >
          {{- s.label | escape -}}
        </span>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2
          class="cm-heading"
          {% if arc_heading_style != blank %}
            style="{{ arc_heading_style | strip }}"
          {% endif %}
        >
          {%- if section.settings.heading_accent != blank and section.settings.heading contains section.settings.heading_accent -%}
            {%- assign heading_bits = section.settings.heading | split: section.settings.heading_accent -%}
            {{ heading_bits[0] | escape }}<em>{{ section.settings.heading_accent | escape }}</em>{{ heading_bits[1] | escape }}
          {%- else -%}
            {{ section.settings.heading | escape | newline_to_br }}
          {%- endif -%}
        </h2>
      {%- endif -%}
      {%- if s.text != blank -%}
        <div
          class="cm-body"
          {% if arc_body_style != blank %}
            style="{{ arc_body_style | strip }}"
          {% endif %}
        >
          {{ s.text }}
        </div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="cm-arc__orbit-btn" href="{{ section.settings.button_link | default: section.settings.button_link_2 | default: '#' }}">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "CM 3D product carousel",
  "tag": "section",
  "class": "section cm-section",
  "max_blocks": 20,
  "blocks": [
    {
      "type": "item",
      "name": "Product",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Use a transparent PNG cut-out for the best 3D look."
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Theme asset image",
          "info": "Filename in the theme assets folder, used when no image is picked."
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Chicken Teriyaki" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "High protein" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "color", "id": "accent", "label": "Glow color", "default": "#f5a623" },
        { "type": "header", "content": "Title typography" },
        { "type": "color", "id": "title_color", "label": "Text color" },
        { "type": "range", "id": "title_font_size", "min": 0, "max": 48, "step": 1, "unit": "px", "label": "Font size", "default": 0, "info": "0 = theme default. Custom sizes start at 14px." },
        {
          "type": "select",
          "id": "title_font_weight",
          "label": "Font weight",
          "options": [
            { "value": "inherit", "label": "Theme default" },
            { "value": "400", "label": "Regular 400" },
            { "value": "500", "label": "Medium 500" },
            { "value": "600", "label": "Semi-bold 600" },
            { "value": "700", "label": "Bold 700" },
            { "value": "800", "label": "Extra-bold 800" }
          ],
          "default": "inherit"
        },
        { "type": "range", "id": "title_letter_spacing", "min": -4, "max": 12, "step": 1, "unit": "px", "label": "Letter spacing", "default": 0 },
        { "type": "range", "id": "title_line_height", "min": 0, "max": 2, "step": 0.1, "label": "Line height", "default": 0, "info": "0 = theme default" },
        { "type": "header", "content": "Title spacing" },
        { "type": "range", "id": "title_padding_top", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Padding top", "default": 0 },
        { "type": "range", "id": "title_padding_bottom", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Padding bottom", "default": 0 },
        { "type": "range", "id": "title_padding_left", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Padding left", "default": 0 },
        { "type": "range", "id": "title_padding_right", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Padding right", "default": 0 },
        { "type": "range", "id": "title_margin_top", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Margin top", "default": 0 },
        { "type": "range", "id": "title_margin_bottom", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Margin bottom", "default": 0 },
        { "type": "range", "id": "title_margin_left", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Margin left", "default": 0 },
        { "type": "range", "id": "title_margin_right", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Margin right", "default": 0 },
        { "type": "header", "content": "Title background" },
        { "type": "color", "id": "title_bg_color", "label": "Background color", "info": "Clear swatch to reset." },
        { "type": "image_picker", "id": "title_bg_image", "label": "Background image" },
        { "type": "select", "id": "title_bg_size", "label": "Image size", "options": [
          { "value": "cover", "label": "Cover" },
          { "value": "contain", "label": "Contain" },
          { "value": "auto", "label": "Auto" }
        ], "default": "cover" },
        { "type": "select", "id": "title_bg_position", "label": "Image position", "options": [
          { "value": "center", "label": "Center" },
          { "value": "top", "label": "Top" },
          { "value": "bottom", "label": "Bottom" },
          { "value": "left", "label": "Left" },
          { "value": "right", "label": "Right" }
        ], "default": "center" },
        { "type": "select", "id": "title_bg_mask", "label": "Image mask", "options": [
          { "value": "none", "label": "None" },
          { "value": "fade", "label": "Fade bottom" },
          { "value": "fade_edges", "label": "Fade edges" },
          { "value": "circle", "label": "Circle" },
          { "value": "soft", "label": "Soft vignette" },
          { "value": "rounded", "label": "Rounded box" },
          { "value": "custom", "label": "Custom mask image" }
        ], "default": "none" },
        { "type": "image_picker", "id": "title_bg_mask_image", "label": "Custom mask image", "info": "Used when Image mask = Custom." },
        { "type": "checkbox", "id": "title_bg_clip_text", "label": "Clip background to letters", "default": false, "info": "Fills letter shapes with the background color/image." },
        { "type": "header", "content": "Subtitle typography" },
        { "type": "color", "id": "body_color", "label": "Text color" },
        { "type": "range", "id": "body_font_size", "min": 0, "max": 48, "step": 1, "unit": "px", "label": "Font size", "default": 0, "info": "0 = theme default. Custom sizes start at 14px." },
        {
          "type": "select",
          "id": "body_font_weight",
          "label": "Font weight",
          "options": [
            { "value": "inherit", "label": "Theme default" },
            { "value": "400", "label": "Regular 400" },
            { "value": "500", "label": "Medium 500" },
            { "value": "600", "label": "Semi-bold 600" },
            { "value": "700", "label": "Bold 700" },
            { "value": "800", "label": "Extra-bold 800" }
          ],
          "default": "inherit"
        },
        { "type": "range", "id": "body_letter_spacing", "min": -4, "max": 12, "step": 1, "unit": "px", "label": "Letter spacing", "default": 0 },
        { "type": "range", "id": "body_line_height", "min": 0, "max": 2, "step": 0.1, "label": "Line height", "default": 0, "info": "0 = theme default" },
        { "type": "header", "content": "Subtitle spacing" },
        { "type": "range", "id": "body_padding_top", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Padding top", "default": 0 },
        { "type": "range", "id": "body_padding_bottom", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Padding bottom", "default": 0 },
        { "type": "range", "id": "body_padding_left", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Padding left", "default": 0 },
        { "type": "range", "id": "body_padding_right", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Padding right", "default": 0 },
        { "type": "range", "id": "body_margin_top", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Margin top", "default": 0 },
        { "type": "range", "id": "body_margin_bottom", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Margin bottom", "default": 0 },
        { "type": "range", "id": "body_margin_left", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Margin left", "default": 0 },
        { "type": "range", "id": "body_margin_right", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Margin right", "default": 0 },
        { "type": "header", "content": "Text background" },
        { "type": "color", "id": "body_bg_color", "label": "Background color", "info": "Clear swatch to reset." },
        { "type": "image_picker", "id": "body_bg_image", "label": "Background image" },
        { "type": "select", "id": "body_bg_size", "label": "Image size", "options": [
          { "value": "cover", "label": "Cover" },
          { "value": "contain", "label": "Contain" },
          { "value": "auto", "label": "Auto" }
        ], "default": "cover" },
        { "type": "select", "id": "body_bg_position", "label": "Image position", "options": [
          { "value": "center", "label": "Center" },
          { "value": "top", "label": "Top" },
          { "value": "bottom", "label": "Bottom" },
          { "value": "left", "label": "Left" },
          { "value": "right", "label": "Right" }
        ], "default": "center" },
        { "type": "select", "id": "body_bg_mask", "label": "Image mask", "options": [
          { "value": "none", "label": "None" },
          { "value": "fade", "label": "Fade bottom" },
          { "value": "fade_edges", "label": "Fade edges" },
          { "value": "circle", "label": "Circle" },
          { "value": "soft", "label": "Soft vignette" },
          { "value": "rounded", "label": "Rounded box" },
          { "value": "custom", "label": "Custom mask image" }
        ], "default": "none" },
        { "type": "image_picker", "id": "body_bg_mask_image", "label": "Custom mask image", "info": "Used when Image mask = Custom." },
        { "type": "checkbox", "id": "body_bg_clip_text", "label": "Clip background to letters", "default": false, "info": "Fills letter shapes with the background color/image." }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "This Week's Menu" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Pick Your Flavor" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent word", "info": "This word in the heading is shown in gold italic." },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "richtext", "id": "text", "label": "Text" },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Used only when the section has no product blocks."
    },
    { "type": "range", "id": "products_limit", "min": 3, "max": 20, "step": 1, "label": "Products to show", "default": 9 },
    { "type": "text", "id": "button_label", "label": "Primary button (white)", "default": "Shop now" },
    { "type": "header", "content": "Button style" },
    { "type": "color", "id": "button_text_color", "label": "Text color" },
    { "type": "color", "id": "button_bg_color", "label": "Background color" },
    { "type": "color", "id": "button_icon_bg", "label": "Icon background" },
    { "type": "color", "id": "button_icon_color", "label": "Icon color" },
    { "type": "range", "id": "button_font_size", "min": 12, "max": 24, "step": 1, "unit": "px", "label": "Font size", "default": 16 },
    { "type": "text", "id": "button_label_2", "label": "Secondary button (theme)", "default": "How it works" },
    { "type": "url", "id": "button_link_2", "label": "Secondary button link" },
    { "type": "header", "content": "Button 2 style" },
    { "type": "color", "id": "button_text_color_2", "label": "Text color" },
    { "type": "color", "id": "button_bg_color_2", "label": "Background color" },
    { "type": "color", "id": "button_icon_bg_2", "label": "Icon background" },
    { "type": "color", "id": "button_icon_color_2", "label": "Icon color" },
    { "type": "range", "id": "button_font_size_2", "min": 12, "max": 24, "step": 1, "unit": "px", "label": "Font size", "default": 16 },
    {
      "type": "header",
      "content": "Carousel"
    },
    {
      "type": "select",
      "id": "item_shape",
      "label": "Product shape",
      "options": [
        { "value": "2", "label": "Tall (cans, bottles)" },
        { "value": "1.5", "label": "Portrait" },
        { "value": "1.2", "label": "Box" },
        { "value": "1", "label": "Square (plates, bowls)" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "image_style",
      "label": "Image style",
      "options": [
        { "value": "cutout", "label": "Cut-out (transparent PNG)" },
        { "value": "card", "label": "Photo card" }
      ],
      "default": "cutout"
    },
    { "type": "checkbox", "id": "full_width", "label": "Full page width", "default": true },
    { "type": "range", "id": "item_width", "min": 100, "max": 420, "step": 10, "unit": "px", "label": "Product width", "default": 280 },
    { "type": "range", "id": "gap", "min": 0, "max": 160, "step": 5, "unit": "px", "label": "Gap between products", "default": 60 },
    { "type": "range", "id": "curve", "min": -100, "max": 150, "step": 5, "unit": "px", "label": "Wave height", "default": 50 },
    { "type": "range", "id": "tilt", "min": 0, "max": 30, "step": 1, "unit": "°", "label": "Product tilt", "default": 12 },
    { "type": "checkbox", "id": "autoplay", "label": "Auto-rotate", "default": true },
    { "type": "range", "id": "autoplay_speed", "min": 2, "max": 10, "step": 1, "unit": "s", "label": "Change every", "default": 4 },
    { "type": "checkbox", "id": "show_arrows", "label": "Show arrows", "default": true },
    { "type": "checkbox", "id": "show_frame", "label": "Show corner frame", "default": true },
    { "type": "text", "id": "hint", "label": "Hint text", "default": "Drag to explore" },
    {
      "type": "header",
      "content": "Colors"
    },
    { "type": "color", "id": "bg_color_1", "label": "Background center", "default": "#3a3a3a" },
    { "type": "color", "id": "bg_color_2", "label": "Background edge", "default": "#070707" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" },
    { "type": "color", "id": "accent", "label": "Default glow and button", "default": "#f5a623" },
    { "type": "header", "content": "Label typography" },
    { "type": "color", "id": "eyebrow_color", "label": "Text color" },
    { "type": "range", "id": "eyebrow_font_size", "min": 0, "max": 48, "step": 1, "unit": "px", "label": "Font size", "default": 0, "info": "0 = theme default. Custom sizes start at 14px." },
    {
      "type": "select",
      "id": "eyebrow_font_weight",
      "label": "Font weight",
      "options": [
        { "value": "inherit", "label": "Theme default" },
        { "value": "400", "label": "Regular 400" },
        { "value": "500", "label": "Medium 500" },
        { "value": "600", "label": "Semi-bold 600" },
        { "value": "700", "label": "Bold 700" },
        { "value": "800", "label": "Extra-bold 800" }
      ],
      "default": "inherit"
    },
    { "type": "range", "id": "eyebrow_letter_spacing", "min": -4, "max": 12, "step": 1, "unit": "px", "label": "Letter spacing", "default": 0 },
