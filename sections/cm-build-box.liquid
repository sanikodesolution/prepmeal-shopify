{{ 'section-cm-build-box.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cm-build-box.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings
  assign plan = section.settings.product
  assign plan_handles = '5-meal-plan,6-meal-plan,7-meal-plan,10-meal-plan,15-meal-plan' | split: ','
  if plan == blank and product != blank and plan_handles contains product.handle
    assign plan = product
  endif
  if plan == blank
    assign plan = all_products['10-meal-plan']
  endif
  assign heading = section.settings.heading | default: plan.title
  assign lede = section.settings.lede | default: 'Pick five dishes and every plate gets 15% cheaper. Pick ten and it’s 20%. Each plate fills a slot in your box.'
  assign min_plates = section.settings.min_plates | default: 5
  assign nutrition = '633|38|37|37,684|62|37|32,676|55|42|32,421|45|40|12,430|36|32|10,623|52|34|31,435|38|36|11,550|38|37|31,585|36|35|33,581|61|53|15' | split: ','
-%}
{%- capture bb_heading_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'heading_' -%}
{%- endcapture -%}
{%- capture bb_body_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'body_' -%}
{%- endcapture -%}

<section class="byb" id="build-box" data-byb data-plan="{{ plan.title | default: '10 Meal Plan' | escape }}" data-money="{{ 0 | money | escape }}" data-min-plates="{{ min_plates }}">
  <div class="byb__wrap">
    <h1{% if bb_heading_style != blank %} style="{{ bb_heading_style | strip }}"{% endif %}>{{ heading | escape }}</h1>
    <p class="byb__lede"{% if bb_body_style != blank %} style="{{ bb_body_style | strip }}"{% endif %}>{{ lede | escape }}</p>
    <div class="byb__layout">
      <section class="byb__grid" data-byb-grid aria-label="Meals">
        {%- assign meal_i = 0 -%}
        {%- for variant in plan.variants -%}
          {%- unless variant.title == 'Default Title' -%}
            {%- assign meal_name = variant.title | split: ',' | first | strip -%}
            {%- assign meal_sides = variant.title | remove_first: meal_name | remove_first: ',' | strip -%}
            {%- assign food_i = meal_i | modulo: 10 -%}
            {%- assign food_file = 'mp-food-' | append: food_i | append: '.jpg' -%}
            {%- assign meal_image = variant.image | default: variant.featured_media.preview_image -%}
            {%- if meal_image != blank -%}
              {%- assign photo = meal_image | image_url: width: 480 -%}
            {%- else -%}
              {%- assign photo = food_file | asset_url -%}
            {%- endif -%}
            <article class="byb__meal">
              <div class="byb__plate has-photo"><img src="{{ photo }}" alt="{{ meal_name | escape }}" width="150" height="150"></div>
              <div class="byb__body">
                <h4>{{ meal_name | escape }}</h4>
                <p>{% if meal_sides != blank %}With {{ meal_sides | escape }}.{% else %}&nbsp;{% endif %}</p>
                {%- assign stat = nutrition[meal_i] | split: '|' -%}
                <ul class="byb__facts">
                  <li><b>{{ stat[0] }}</b><span>cal</span></li>
                  <li><b>{{ stat[1] }}g</b><span>protein</span></li>
                  <li><b>{{ stat[2] }}g</b><span>carbs</span></li>
                  <li><b>{{ stat[3] }}g</b><span>fat</span></li>
                </ul>
                <div class="byb__row">
                  <span class="byb__price">{{ variant.price | money }}</span>
                  <button type="button" class="byb__add" data-ch="{{ meal_i }}" data-d="1">Add</button>
                </div>
              </div>
            </article>
            {%- assign meal_i = meal_i | plus: 1 -%}
          {%- endunless -%}
        {%- endfor -%}
      </section>
      <aside class="byb__box" data-byb-box aria-live="polite">
        <h2>Your box</h2>
        <p class="byb__hint">{% if min_plates > 5 %}{{ min_plates }} plates to fill your box.{% else %}{{ min_plates }} more plates to unlock 15% off.{% endif %}</p>
        {%- assign slot_span = min_plates -%}
        {%- if slot_span < 10 -%}{%- assign slot_span = 10 -%}{%- endif -%}
        <div class="byb__slots">
          {%- for slot in (1..slot_span) -%}
            <div class="byb__slot{% if slot == 5 or slot == 10 %} is-mark{% endif %}"{% if slot == 5 %} data-m="15%"{% endif %}{% if slot == 10 %} data-m="20%"{% endif %}></div>
          {%- endfor -%}
        </div>
        <div class="byb__tiers">
          <div class="byb__tier"><span>5 plates</span><b>15% off</b></div>
          <div class="byb__tier"><span>10 plates</span><b>20% off</b></div>
        </div>
        <div class="byb__sum">
          <div class="byb__tot"><span>Total</span><span>{{ 0 | money }}</span></div>
        </div>
        <button type="button" class="byb__cta" data-byb-cta disabled>Add {{ min_plates }} more plates</button>
        <p class="byb__note">Each meal is added at its menu price.</p>
      </aside>
    </div>
    <p class="byb__status" data-byb-status role="status"></p>
  </div>
  <div class="byb__mbar">
    <span data-byb-mtxt></span>
    <button type="button" data-byb-view>View box</button>
  </div>
  <script type="application/json" data-byb-meals>
    [
    {%- assign first_meal = true -%}
    {%- for variant in plan.variants -%}
      {%- unless variant.title == 'Default Title' -%}
        {%- unless first_meal -%},{%- endunless -%}
        {%- assign first_meal = false -%}
        {%- assign meal_name = variant.title | split: ',' | first | strip -%}
        {%- assign meal_sides = variant.title | remove_first: meal_name | remove_first: ',' | strip -%}
        {%- assign meal_text = '' -%}
        {%- if meal_sides != blank -%}
          {%- assign meal_text = 'With ' | append: meal_sides | append: '.' -%}
        {%- endif -%}
        {%- assign stat = nutrition[forloop.index0] | split: '|' -%}
        {%- assign food_i = forloop.index0 | modulo: 10 -%}
        {%- assign food_file = 'mp-food-' | append: food_i | append: '.jpg' -%}
        {%- assign meal_image = variant.image | default: variant.featured_media.preview_image -%}
        {%- if meal_image != blank -%}
          {%- assign photo = meal_image | image_url: width: 480 -%}
        {%- else -%}
          {%- assign photo = food_file | asset_url -%}
        {%- endif -%}
        {"id":{{ variant.id }},"name":{{ meal_name | json }},"text":{{ meal_text | json }},"price":{{ variant.price | money | json }},"cents":{{ variant.price }},"cal":{{ stat[0] | json }},"protein":"{{ stat[1] }}g","carbs":"{{ stat[2] }}g","fat":"{{ stat[3] }}g","image":{{ photo | json }}}
      {%- endunless -%}
    {%- endfor -%}
    ]
  </script>
</section>

{% schema %}
{
  "name": "CM build your box",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "10 Meal Plan" },
    { "type": "textarea", "id": "lede", "label": "Text", "default": "Pick five dishes and every plate gets 15% cheaper. Pick ten and it’s 20%. Each plate fills a slot in your box." },
    { "type": "product", "id": "product", "label": "Meal plan product", "info": "Used on pages. On a product template, that product is used." },
    { "type": "number", "id": "min_plates", "label": "Plates needed before checkout", "default": 5, "info": "How many plates the box needs before the button unlocks. Discount tiers stay at 5 and 10." },
    { "type": "header", "content": "Heading typography" },
    { "type": "color", "id": "heading_color", "label": "Text color" },
    { "type": "range", "id": "heading_font_size", "min": 0, "max": 72, "step": 1, "unit": "px", "label": "Font size", "default": 0, "info": "0 = theme default. Custom sizes start at 14px." },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "Font weight",
      "options": [
        { "value": "inherit", "label": "Theme default" },
        { "value": "400", "label": "Regular 400" },
        { "value": "500", "label": "Medium 500" },
        { "value": "600", "label": "Semi-bold 600" },
        { "value": "700", "label": "Bold 700" },
        { "value": "800", "label": "Extra-bold 800" }
      ],
      "default": "inherit"
    },
    { "type": "range", "id": "heading_letter_spacing", "min": -4, "max": 12, "step": 1, "unit": "px", "label": "Letter spacing", "default": 0 },
    { "type": "range", "id": "heading_line_height", "min": 0, "max": 2, "step": 0.1, "label": "Line height", "default": 0, "info": "0 = theme default" },
    { "type": "header", "content": "Heading spacing" },
    { "type": "range", "id": "heading_padding_top", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Padding top", "default": 0 },
    { "type": "range", "id": "heading_padding_bottom", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Padding bottom", "default": 0 },
    { "type": "range", "id": "heading_padding_left", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Padding left", "default": 0 },
    { "type": "range", "id": "heading_padding_right", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Padding right", "default": 0 },
    { "type": "range", "id": "heading_margin_top", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Margin top", "default": 0 },
    { "type": "range", "id": "heading_margin_bottom", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Margin bottom", "default": 0 },
    { "type": "range", "id": "heading_margin_left", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Margin left", "default": 0 },
    { "type": "range", "id": "heading_margin_right", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Margin right", "default": 0 },
    { "type": "header", "content": "Text typography" },
    { "type": "color", "id": "body_color", "label": "Text color" },
    { "type": "range", "id": "body_font_size", "min": 0, "max": 48, "step": 1, "unit": "px", "label": "Font size", "default": 0, "info": "0 = theme default. Custom sizes start at 14px." },
    {
      "type": "select",
      "id": "body_font_weight",
      "label": "Font weight",
      "options": [
        { "value": "inherit", "label": "Theme default" },
        { "value": "400", "label": "Regular 400" },
        { "value": "500", "label": "Medium 500" },
        { "value": "600", "label": "Semi-bold 600" },
        { "value": "700", "label": "Bold 700" },
        { "value": "800", "label": "Extra-bold 800" }
      ],
      "default": "inherit"
    },
    { "type": "range", "id": "body_letter_spacing", "min": -4, "max": 12, "step": 1, "unit": "px", "label": "Letter spacing", "default": 0 },
    { "type": "range", "id": "body_line_height", "min": 0, "max": 2, "step": 0.1, "label": "Line height", "default": 0, "info": "0 = theme default" },
    { "type": "header", "content": "Text spacing" },
    { "type": "range", "id": "body_padding_top", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Padding top", "default": 0 },
    { "type": "range", "id": "body_padding_bottom", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Padding bottom", "default": 0 },
    { "type": "range", "id": "body_padding_left", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Padding left", "default": 0 },
    { "type": "range", "id": "body_padding_right", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Padding right", "default": 0 },
    { "type": "range", "id": "body_margin_top", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Margin top", "default": 0 },
    { "type": "range", "id": "body_margin_bottom", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Margin bottom", "default": 0 },
    { "type": "range", "id": "body_margin_left", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Margin left", "default": 0 },
    { "type": "range", "id": "body_margin_right", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Margin right", "default": 0 }
  ],
  "presets": [
    { "name": "CM build your box" }
  ]
}
{% endschema %}
