    },
    {
      "type": "text",
      "id": "allergen_label",
      "label": "Allergen label",
      "default": "Contains"
    },
    {
      "type": "text",
      "id": "reheat_label",
      "label": "Heating label",
      "default": "Heating"
    },
    {
      "type": "text",
      "id": "protein_label",
