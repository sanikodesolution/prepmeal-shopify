{{ 'prep-content.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign calories = product.metafields.custom.calories.value | default: product.metafields.custom.calories
  assign protein = product.metafields.custom.protein.value | default: product.metafields.custom.protein
  assign carbs = product.metafields.custom.carbs.value | default: product.metafields.custom.carbs
  assign fat = product.metafields.custom.fat.value | default: product.metafields.custom.fat
  assign ingredients = product.metafields.custom.ingredients.value | default: product.metafields.custom.ingredients
  assign allergens = product.metafields.custom.allergens.value | default: product.metafields.custom.allergens
  assign diet_tags = product.metafields.custom.diet_tags.value | default: product.metafields.custom.diet_tags
  assign reheat = product.metafields.custom.reheat_instructions.value | default: product.metafields.custom.reheat_instructions

  assign has_nutrition = false
  if calories != blank or protein != blank or carbs != blank or fat != blank
    assign has_nutrition = true
  endif

  assign has_content = false
  if has_nutrition or ingredients != blank or allergens != blank or diet_tags != blank or reheat != blank
    assign has_content = true
  endif
-%}

{%- if has_content or request.design_mode -%}
  <section class="prep prep__section section-{{ section.id }}-padding" id="PrepMealDetails-{{ section.id }}">
    <div class="prep__wrap">
      {% render 'section-heading',
        eyebrow: section.settings.eyebrow,
        title: section.settings.heading,
        text: section.settings.text,
        richtext: true,
        align: 'left'
      %}

      {%- unless has_content -%}
        <p class="prep-empty">{{ 'sections.prep.empty_state' | t }}</p>
      {%- else -%}
        <div class="prep-meal-details">
          {%- if has_nutrition and section.settings.show_nutrition -%}
            <div class="prep-meal-details__panel">
              <h3>{{ 'sections.prep.nutrition_heading' | t }}</h3>
              <ul class="prep__nutrition" role="list">
                {%- if calories != blank -%}
                  <li>
                    <strong>{{ calories }}</strong>
                    <span>{{ 'sections.prep.calories' | t }}</span>
                  </li>
                {%- endif -%}
                {%- if protein != blank -%}
                  <li>
                    <strong>{{ protein }}g</strong>
                    <span>{{ 'sections.prep.protein' | t }}</span>
                  </li>
                {%- endif -%}
                {%- if carbs != blank -%}
                  <li>
                    <strong>{{ carbs }}g</strong>
                    <span>{{ 'sections.prep.carbs' | t }}</span>
                  </li>
                {%- endif -%}
                {%- if fat != blank -%}
                  <li>
                    <strong>{{ fat }}g</strong>
                    <span>{{ 'sections.prep.fat' | t }}</span>
                  </li>
                {%- endif -%}
              </ul>
            </div>
          {%- endif -%}

          {%- if diet_tags != blank and section.settings.show_diet_tags -%}
            <div class="prep-meal-details__panel">
              <h3>{{ 'sections.prep.diet_tags_heading' | t }}</h3>
              <ul class="prep__tags" role="list">
                {%- for tag in diet_tags -%}
                  <li class="prep__tag">{{ tag | escape }}</li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          {%- if ingredients != blank and section.settings.show_ingredients -%}
            <div class="prep-meal-details__panel">
              <h3>{{ 'sections.prep.ingredients_heading' | t }}</h3>
              <p>{{ ingredients | escape | newline_to_br }}</p>
            </div>
          {%- endif -%}

          {%- if allergens != blank and section.settings.show_allergens -%}
            <div class="prep-meal-details__panel">
              <h3>{{ 'sections.prep.allergens_heading' | t }}</h3>
              <ul class="prep__tags" role="list">
                {%- for allergen in allergens -%}
                  <li class="prep__tag">{{ allergen | escape }}</li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          {%- if reheat != blank and section.settings.show_reheat -%}
            <div class="prep-meal-details__panel">
              <h3>{{ 'sections.prep.reheat_heading' | t }}</h3>
              <p>{{ reheat | escape | newline_to_br }}</p>
            </div>
          {%- endif -%}
        </div>
      {%- endunless -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Prep meal details",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Meal details" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What's inside" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Nutrition, ingredients, allergens, and reheat guidance from product metafields.</p>"
    },
    { "type": "checkbox", "id": "show_nutrition", "label": "Show nutrition", "default": true },
    { "type": "checkbox", "id": "show_diet_tags", "label": "Show diet tags", "default": true },
    { "type": "checkbox", "id": "show_ingredients", "label": "Show ingredients", "default": true },
    { "type": "checkbox", "id": "show_allergens", "label": "Show allergens", "default": true },
    { "type": "checkbox", "id": "show_reheat", "label": "Show reheat instructions", "default": true },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 36 }
  ],
  "presets": [
    {
      "name": "Prep meal details"
    }
  ]
}
{% endschema %}
