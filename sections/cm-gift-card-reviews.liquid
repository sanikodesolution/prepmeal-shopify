{{ 'section-cm-gift-card.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cm-gift-card.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign review_total = section.blocks.size
  assign review_sum = 0
  for block in section.blocks
    assign review_sum = review_sum | plus: block.settings.rating
  endfor
  if review_total > 0
    assign review_avg = review_sum | times: 1.0 | divided_by: review_total
  endif
-%}

{%- capture gc_rv_heading_style -%}
  {%- render 'pm-block-type-style', settings: section.settings, prefix: 'heading_' -%}
{%- endcapture -%}
{%- capture gc_rv_label_style -%}
  {%- render 'pm-block-type-style', settings: section.settings, prefix: 'label_' -%}
{%- endcapture -%}
{%- capture gc_rv_body_style -%}
  {%- render 'pm-block-type-style', settings: section.settings, prefix: 'body_' -%}
{%- endcapture -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<cm-gift-card-reviews
  class="cm-gc cm-gc__reviews section-{{ section.id }}-padding"
  id="GiftCardReviews-{{ section.id }}"
  data-gc-reviews
  data-thanks="{{ section.settings.review_thanks | escape }}"
  data-cart-url="{{ routes.cart_url }}"
  style="--gc-accent: {{ section.settings.accent }}; --gc-ink: {{ section.settings.ink }}; --gc-paper: {{ section.settings.paper }};"
>
  <div class="cm-gc__rv-head">
    {%- if section.settings.heading != blank -%}
      <h3
        class="cm-gc__t"
        {% if gc_rv_heading_style != blank %}
          style="{{ gc_rv_heading_style | strip }}"
        {% endif %}
      >
        {{- section.settings.heading | escape -}}
      </h3>
    {%- endif -%}
    <div class="cm-gc__rv-sum" data-gc-rv-sum aria-live="polite">
      {%- if review_total > 0 -%}
        <strong>{{ review_avg | round: 1 }}</strong>
        <span class="cm-gc__stars" aria-hidden="true">
          {%- assign avg_round = review_avg | round -%}
          {%- for i in (1..5) -%}
            {%- if i <= avg_round -%}★{%- else -%}☆{%- endif -%}
          {%- endfor -%}
        </span>
        <span>
          {{- review_total -}}
          {%- if review_total == 1 %} review{% else %} reviews{% endif -%}
        </span>
      {%- else -%}
        {{ section.settings.reviews_empty_summary | escape }}
      {%- endif -%}
    </div>
  </div>

  <div class="cm-gc__rv-wrap">
    <div class="cm-gc__rv-list" data-gc-rv-list>
      {%- if section.blocks.size == 0 -%}
        <p
          class="cm-gc__rv-empty"
          data-gc-rv-empty
          {% if gc_rv_body_style != blank %}
            style="{{ gc_rv_body_style | strip }}"
          {% endif %}
        >
          {{- section.settings.reviews_empty_text | escape -}}
        </p>
      {%- endif -%}
      {%- for block in section.blocks -%}
        {%- capture gc_rv_title_style -%}
          {%- render 'pm-block-type-style', block: block, prefix: 'title_' -%}
        {%- endcapture -%}
        {%- capture gc_rv_card_body_style -%}
          {%- render 'pm-block-type-style', block: block, prefix: 'body_' -%}
        {%- endcapture -%}
        <article class="cm-gc__rv-card" data-gc-rv-card data-rating="{{ block.settings.rating }}" {{ block.shopify_attributes }}>
          <div class="cm-gc__rv-top">
            <b
              {% if gc_rv_title_style != blank %}
                style="{{ gc_rv_title_style | strip }}"
              {% endif %}
            >
              {{- block.settings.author | escape -}}
            </b>
            {%- if block.settings.date != blank -%}
              <time>{{ block.settings.date | escape }}</time>
            {%- endif -%}
          </div>
          <div class="cm-gc__stars" role="img" aria-label="{{ block.settings.rating }} out of 5 stars">
            {%- for i in (1..5) -%}
              {%- if i <= block.settings.rating -%}★{%- else -%}☆{%- endif -%}
            {%- endfor -%}
          </div>
          {%- if block.settings.text != blank -%}
            <p
              {% if gc_rv_card_body_style != blank %}
                style="{{ gc_rv_card_body_style | strip }}"
              {% endif %}
            >
              {{- block.settings.text | escape -}}
            </p>
          {%- endif -%}
          {%- if block.settings.photo_1 != blank or block.settings.photo_2 != blank or block.settings.photo_3 != blank -%}
            <div class="cm-gc__rv-photos">
              {%- if block.settings.photo_1 != blank -%}
                {{
                  block.settings.photo_1
                  | image_url: width: 240
                  | image_tag: loading: 'lazy', widths: '96, 192, 240', sizes: '96px', alt: block.settings.author
                }}
              {%- endif -%}
              {%- if block.settings.photo_2 != blank -%}
                {{
                  block.settings.photo_2
                  | image_url: width: 240
                  | image_tag: loading: 'lazy', widths: '96, 192, 240', sizes: '96px', alt: block.settings.author
                }}
              {%- endif -%}
              {%- if block.settings.photo_3 != blank -%}
                {{
                  block.settings.photo_3
                  | image_url: width: 240
                  | image_tag: loading: 'lazy', widths: '96, 192, 240', sizes: '96px', alt: block.settings.author
                }}
              {%- endif -%}
            </div>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>

    {%- if section.settings.show_review_form -%}
      <form class="cm-gc__rv-form" data-gc-rv-form novalidate>
        <h4
          class="cm-gc__rv-heading"
          {% if gc_rv_label_style != blank %}
            style="{{ gc_rv_label_style | strip }}"
          {% endif %}
        >
          {{- section.settings.review_form_heading | escape -}}
        </h4>
        <fieldset>
          <legend>{{ section.settings.review_rating_label | escape }}</legend>
          <div class="cm-gc__rate">
            {%- assign rate_values = '5,4,3,2,1' | split: ',' -%}
            {%- for i in rate_values -%}
              <input
                type="radio"
                name="gc-rate-{{ section.id }}"
                id="GcRate-{{ section.id }}-{{ i }}"
                value="{{ i }}"
                data-gc-rate
              >
              <label for="GcRate-{{ section.id }}-{{ i }}" title="{{ i }} stars">
                <span aria-hidden="true">★</span>
                <span class="visually-hidden">{{ i }} stars</span>
              </label>
            {%- endfor -%}
          </div>
        </fieldset>
        <label class="cm-gc__rv-f">
          {{- section.settings.review_name_label | escape -}}
          <input type="text" maxlength="40" autocomplete="name" data-gc-rv-name>
        </label>
        <label class="cm-gc__rv-f">
          {{- section.settings.review_text_label | escape -}}
          <textarea
            maxlength="500"
            placeholder="{{ section.settings.review_text_placeholder | escape }}"
            data-gc-rv-text
          ></textarea>
        </label>
        <label class="cm-gc__drop">
          <span>{{ section.settings.review_photos_label | escape }}</span>
          <small>{{ section.settings.review_photos_help | escape }}</small>
          <input type="file" accept="image/jpeg,image/png,image/webp" multiple data-gc-rv-files>
        </label>
        <div class="cm-gc__thumbs" data-gc-rv-thumbs></div>
        <p class="cm-gc__rv-err" data-gc-rv-err role="alert"></p>
        {% render 'pm-button',
          label: section.settings.review_button_label,
          style: 'brand',
          tag: 'button',
          type: 'submit',
          class: 'cm-gc__cta',
          text_color: section.settings.review_button_text_color,
          bg_color: section.settings.review_button_bg_color,
          icon_bg: section.settings.review_button_icon_bg,
          icon_color: section.settings.review_button_icon_color,
          font_size: section.settings.review_button_font_size
        %}
      </form>
    {%- endif -%}
  </div>

  <div class="cm-gc__toast" data-gc-toast role="status"></div>
</cm-gift-card-reviews>

{% schema %}
{
