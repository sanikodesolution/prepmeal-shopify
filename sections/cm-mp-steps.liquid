{% render 'cm-section-assets', section: section %}
{{ 'section-cm-meal-plan-page.css' | asset_url | stylesheet_tag }}
{%- if request.design_mode -%}
  <script src="{{ 'cm-meal-plan-editor.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{% comment %} include (not render) so assigns leak into this section {% endcomment %}
{% include 'cm-mp-context' %}
{%- liquid
  assign s = section.settings
-%}
{%- capture mp_eyebrow_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'eyebrow_' -%}
{%- endcapture -%}
{%- capture mp_heading_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'heading_' -%}
{%- endcapture -%}
{%- capture mp_body_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'body_' -%}
{%- endcapture -%}


<div class="mealplan-page" data-mp-page data-cm="meal-plan-steps" {% render 'pm-section-style', section: section %}>
  <div class="mealplan">
    <section class="mealplan-sec mealplan-steps">
      <div class="mealplan-wrap">
        {%- if c_steps_eyebrow != blank -%}
          <p class="mp-eye"
        {% if mp_eyebrow_style != blank %}
          style="{{ mp_eyebrow_style | strip }}"
        {% endif %}
      >{{ c_steps_eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="mealplan-h"
        {% if mp_heading_style != blank %}
          style="{{ mp_heading_style | strip }}"
        {% endif %}
      >{{ c_steps_heading | escape }}</h2>
        <ol class="mealplan-list">
          {%- if step_blocks.size > 0 -%}
            {%- for block in step_blocks -%}
              {%- assign step_extra = '--i:' | append: forloop.index0 | append: ';' -%}
              <li class="mp-gs" {{ block.shopify_attributes }}{% render 'pm-area-style', block: block, extra: step_extra %}>
                {%- capture step_title_style -%}
                  {%- render 'pm-block-type-style', block: block, prefix: 'title_' -%}
                {%- endcapture -%}
                {%- capture step_body_style -%}
                  {%- render 'pm-block-type-style', block: block, prefix: 'body_' -%}
                {%- endcapture -%}
                <span class="mealplan-num">{{ forloop.index }}</span>
                <h3
                  {% if step_title_style != blank %}
                    style="{{ step_title_style | strip }}"
                  {% endif %}
                >{{ block.settings.title | escape }}</h3>
                <p
                  {% if step_body_style != blank %}
                    style="{{ step_body_style | strip }}"
                  {% endif %}
                >{{ block.settings.text | escape }}</p>
              </li>
            {%- endfor -%}
          {%- else -%}
            {%- for row in step_rows -%}
              {%- assign cells = row | split: '|' -%}
              <li class="mp-gs" style="--i:{{ forloop.index0 }}">
                <span class="mealplan-num">{{ forloop.index }}</span>
                <h3>{{ cells[0] | escape }}</h3>
                <p>{{ cells[1] | escape }}</p>
              </li>
            {%- endfor -%}
          {%- endif -%}
        </ol>
      </div>
    </section>
  </div>
</div>

