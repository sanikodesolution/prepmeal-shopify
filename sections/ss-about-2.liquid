{{ 'pm-split-styles.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
{%- capture badge_style -%}{%- render 'pm-block-type-style', settings: s, prefix: 'badge_' -%}{%- endcapture -%}
{%- capture heading_style -%}{%- render 'pm-block-type-style', settings: s, prefix: 'heading_' -%}{%- endcapture -%}
{%- capture label_style -%}{%- render 'pm-block-type-style', settings: s, prefix: 'label_' -%}{%- endcapture -%}
{%- capture body_style -%}{%- render 'pm-block-type-style', settings: s, prefix: 'body_' -%}{%- endcapture -%}
{%- capture panel_title_style -%}{%- render 'pm-block-type-style', settings: s, prefix: 'panel_title_' -%}{%- endcapture -%}
{%- capture panel_text_style -%}{%- render 'pm-block-type-style', settings: s, prefix: 'panel_text_' -%}{%- endcapture -%}

<section
  id="AboutSplit-{{ section.id }}" class="section-{{ section.id }} pm-about-split ps ps-b{% if s.reverse %} ps--rev{% endif %}"
  style="--ps-accent: {{ s.accent }}; --ps-ink: {{ s.ink }}; --ps-bg: {{ s.bg }}; --ps-pt: {{ s.padding_top }}px; --ps-pb: {{ s.padding_bottom }}px; margin-top: {{ s.margin_top }}px; margin-bottom: {{ s.margin_bottom }}px;"
>
  <div class="ps__wrap{% unless s.full_width %} page-width{% endunless %}">
<div class="ps__grid">
  <div class="ps-b__media">
    <div class="ps-b__figure">{%- if s.image != blank -%}
  {{ s.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000, 1400', sizes: '(min-width: 990px) 560px, 100vw', class: 'ps__img' }}
{%- else -%}
  {{ 'lifestyle-1' | placeholder_svg_tag: 'ps__img ps__placeholder' }}
{%- endif -%}</div>
    {%- if s.panel_title != blank or s.panel_text != blank -%}
<div class="ps__panel">
  {%- if s.panel_title != blank -%}<h3 class="ps__panel-title"{% if panel_title_style != blank %} style="{{ panel_title_style | strip }}"{% endif %}>{{ s.panel_title | escape | newline_to_br }}</h3>{%- endif -%}
  {%- if s.panel_text != blank -%}<p class="ps__panel-text"{% if panel_text_style != blank %} style="{{ panel_text_style | strip }}"{% endif %}>{{ s.panel_text | escape | newline_to_br }}</p>{%- endif -%}
</div>
{%- endif -%}
  </div>
  <div class="ps-b__content">
  {%- if s.badge != blank -%}
<p class="ps__badge"{% if badge_style != blank %} style="{{ badge_style | strip }}"{% endif %}><span class="ps__dot" aria-hidden="true"></span>{{ s.badge | escape }}</p>
{%- endif -%}
  {%- if s.heading != blank -%}
<h2 class="ps__heading"{% if heading_style != blank %} style="{{ heading_style | strip }}"{% endif %}>{{ s.heading | escape }}</h2>
{%- endif -%}
  <ul class="ps__points" role="list">
{%- for block in section.blocks -%}
  <li class="ps-b__point ps__point" {{ block.shopify_attributes }}>
    <span class="ps__check" aria-hidden="true"></span>
    <p class="ps__body"{% if body_style != blank %} style="{{ body_style | strip }}"{% endif %}>
      {%- if block.settings.label != blank -%}<strong class="ps__label"{% if label_style != blank %} style="{{ label_style | strip }}"{% endif %}>{{ block.settings.label | escape }}</strong>{%- endif -%}
      {%- if block.settings.text != blank %} &ndash; {{ block.settings.text | escape }}{%- endif -%}
    </p>
  </li>
{%- endfor -%}
</ul>
  {%- if s.button_label != blank -%}
  <div class="ps__btn-wrap">
    {% render 'pm-button',
      label: s.button_label,
      link: s.button_link,
      style: 'brand',
      text_color: s.button_text_color,
      bg_color: s.button_bg_color,
      hover_text_color: s.button_hover_text_color,
      hover_bg_color: s.button_hover_bg_color,
      icon_bg: s.button_icon_bg,
      icon_color: s.button_icon_color,
      font_size: s.button_font_size
    %}
  </div>
{%- endif -%}
</div>
</div>
  </div>
</section>

