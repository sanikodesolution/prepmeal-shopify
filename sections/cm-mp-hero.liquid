      "id": "text",
      "label": "Text",
      "default": "Calorie counted. High protein. Low oil. Pick six meals from this week's menu and we cook and deliver them."
    },
    {
      "type": "text",
      "id": "fact_1_label",
      "label": "Fact 1 label",
      "default": "Price"
    },
    {
      "type": "text",
      "id": "fact_1_value",
      "label": "Fact 1 value",
      "default": "From $00.00"
    },
    {
      "type": "text",
      "id": "fact_2_label",
      "label": "Fact 2 label",
      "default": "Meals"
    },
    {
      "type": "text",
      "id": "fact_2_value",
      "label": "Fact 2 value",
      "default": "6 per week"
    },
    {
      "type": "text",
      "id": "fact_3_label",
