{% render 'cm-section-assets', section: section %}
{{ 'section-cm-meal-plan-page.css' | asset_url | stylesheet_tag }}
{%- if request.design_mode -%}
  <script src="{{ 'cm-meal-plan-editor.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{% comment %} include (not render) so assigns leak into this section {% endcomment %}
{% include 'cm-mp-context' %}
{%- liquid
  assign s = section.settings
-%}
{%- capture mp_eyebrow_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'eyebrow_' -%}
{%- endcapture -%}
{%- capture mp_heading_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'heading_' -%}
{%- endcapture -%}
{%- capture mp_body_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'body_' -%}
{%- endcapture -%}


<div class="mealplan-page" data-mp-page data-cm="meal-plan-thali" {% render 'pm-section-style', section: section %}>
  {{ 'section-cm-thali-story.css' | asset_url | stylesheet_tag }}
  {%- liquid
    # Standalone section uses badge/heading/intro/stats/chips/cards;
    # cm-thali-story also reads thali_* keys — mirror short ids into those.
    if section.settings.thali_badge == blank and section.settings.badge != blank
      assign thali_badge_bridge = section.settings.badge
    else
      assign thali_badge_bridge = section.settings.thali_badge
    endif
  -%}
  {% render 'cm-thali-story',
    eyebrow_style: mp_eyebrow_style,
    heading_style: mp_heading_style,
    body_style: mp_body_style,
    section: section,
    s: section.settings,
    meta: plan_meta,
    features: mo_features,
    stats: mo_stats_thali,
    facts: mo_facts,
    shared: shared_meta,
    area: blank,
    card_blocks: thali_card_blocks
  %}
</div>

