        { "type": "range", "id": "margin_right", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Margin right", "default": 0 },
        { "type": "header", "content": "Background" },
        { "type": "select", "id": "bg_size", "label": "Image size", "options": [
          { "value": "cover", "label": "Cover" },
          { "value": "contain", "label": "Contain" },
