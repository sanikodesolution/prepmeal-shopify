{% render 'cm-section-assets', section: section %}
{{ 'section-cm-meal-plan-page.css' | asset_url | stylesheet_tag }}
{%- if request.design_mode -%}
  <script src="{{ 'cm-meal-plan-editor.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{% comment %} include (not render) so assigns leak into this section {% endcomment %}
{% include 'cm-mp-context' %}
{%- liquid
  assign s = section.settings
-%}
{%- capture mp_eyebrow_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'eyebrow_' -%}
{%- endcapture -%}
{%- capture mp_heading_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'heading_' -%}
{%- endcapture -%}
{%- capture mp_body_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'body_' -%}
{%- endcapture -%}


<div class="mealplan-page pm-section-bg" data-mp-page data-cm="meal-plan-delivery" {% render 'pm-section-style', section: section %}>
  <div class="mealplan">
    <section class="mealplan-sec"><div class="mealplan-wrap">
      {%- if section.settings.delivery_style == 'plate' -%}
        {% render 'cm-delivery-area', section: section, eyebrow_style: mp_eyebrow_style, heading_style: mp_heading_style, body_style: mp_body_style, meta: plan_meta, areas: mo_areas, shared: shared_meta %}
      {%- elsif section.settings.delivery_checker -%}
        {% render 'cm-delivery-checker', section: section, eyebrow_style: mp_eyebrow_style, heading_style: mp_heading_style, body_style: mp_body_style, meta: plan_meta, shared: shared_meta, areas: mo_areas %}
      {%- else -%}
        <div class="mealplan-del">
          {%- liquid
            assign map_query = c_delivery_map_query | default: 'Hartland Wisconsin'
            assign map_src = section.settings.map_embed_url
            if map_src == blank
              assign map_q = map_query | url_encode
              assign map_src = 'https://maps.google.com/maps?q=' | append: map_q | append: '&z=15&output=embed'
            endif
          -%}
          <div class="mealplan-map mp-gs">
            <iframe
              class="mealplan-map__frame"
              title="{{ c_delivery_map_title | default: map_query | escape }}"
              src="{{ map_src }}"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
            ></iframe>
            {%- if c_delivery_map_title != blank -%}
              <p class="mealplan-map__label">{{ c_delivery_map_title | escape }}</p>
            {%- endif -%}
          </div>
          <div class="mealplan-del__copy mp-gs">
            {%- if c_delivery_eyebrow != blank -%}
              <p class="mp-eye"
        {% if mp_eyebrow_style != blank %}
          style="{{ mp_eyebrow_style | strip }}"
        {% endif %}
      >{{ c_delivery_eyebrow | escape }}</p>
            {%- endif -%}
            <h2 class="mealplan-h"
        {% if mp_heading_style != blank %}
          style="{{ mp_heading_style | strip }}"
        {% endif %}
      >{{ c_delivery_heading | escape }}</h2>
            {%- if c_delivery_text != blank -%}
            <p class="mealplan-p"
        {% if mp_body_style != blank %}
          style="{{ mp_body_style | strip }}"
        {% endif %}
      >{{ c_delivery_text | escape }}</p>
            {%- endif -%}
            <div class="mealplan-del__actions">
              {%- if c_delivery_areas.size > 0 -%}
                <ul class="mealplan-areas">
                  {%- for area in c_delivery_areas -%}
                    <li>
                      <span class="mealplan-areas__pin" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M12 2C8.1 2 5 5.1 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7zm0 9.5c-1.4 0-2.5-1.1-2.5-2.5S10.6 6.5 12 6.5s2.5 1.1 2.5 2.5S13.4 11.5 12 11.5z"/></svg>
                      </span>
                      {{ area | strip | escape }}
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
              {%- if section.settings.delivery_button_label != blank -%}
                {%- assign delivery_link = section.settings.delivery_button_link | default: '#' -%}
                {% render 'pm-button', label: section.settings.delivery_button_label, link: delivery_link, style: 'brand', text_color: section.settings.delivery_button_text_color, bg_color: section.settings.delivery_button_bg_color, icon_bg: section.settings.delivery_button_icon_bg, icon_color: section.settings.delivery_button_icon_color, font_size: section.settings.delivery_button_font_size, hover_text_color: section.settings.delivery_button_hover_text_color, hover_bg_color: section.settings.delivery_button_hover_bg_color %}
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endif -%}
    </div></section>
  </div>
</div>

{% schema %}
{
  "name": "MP Delivery",
  "tag": "section",
  "class": "section cm-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Delivery band — plate map, street checker, or embed."
    },
    {
      "type": "product",
      "id": "content_product",
      "label": "Plan product",
      "info": "Optional. Meals/copy can come from this product's variants and metafields. On a product template the current product is used when blank."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "We deliver"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Fresh meals, delivered to your door."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "We deliver across Hartland and the towns around it."
    },
    {
      "type": "select",
      "id": "delivery_style",
      "label": "Delivery style",
      "options": [
        {
          "value": "plate",
          "label": "Plate map + area checker"
        },
        {
          "value": "leaflet",
          "label": "Interactive street map"
        },
        {
          "value": "embed",
          "label": "Google Maps embed"
        }
      ],
      "default": "plate",
      "info": "Plate map is the stylised SVG map with town chips. Interactive street map uses Leaflet. Google Maps embed is the plain iframe."
    },
    {
      "type": "checkbox",
      "id": "delivery_checker",
      "label": "Use the street-map checker",
      "default": false,
      "info": "Only used when Delivery style is the interactive street map."
    },
    {
      "type": "text",
      "id": "delivery_areas",
      "label": "Areas (plain block only)",
      "info": "Comma-separated. Used when the checker is off.",
      "default": "Hartland, Nearby areas"
    },
    {
      "type": "text",
      "id": "delivery_button_label",
      "label": "Button label (plain block only)",
      "default": "Check my area"
    },
    {
      "type": "url",
      "id": "delivery_button_link",
      "label": "Button link (plain block only)"
    },
    {
      "type": "color",
      "id": "delivery_button_text_color",
      "label": "Text color"
    },
    {
      "type": "color",
      "id": "delivery_button_bg_color",
      "label": "Background color"
    },
    { "type": "color", "id": "delivery_button_hover_text_color", "label": "Hover text color", "info": "Clear to keep the style preset hover." },
    { "type": "color", "id": "delivery_button_hover_bg_color", "label": "Hover background color", "info": "Clear to keep the style preset hover." },
    {
      "type": "color",
      "id": "delivery_button_icon_bg",
      "label": "Icon background"
    },
    {
      "type": "color",
      "id": "delivery_button_icon_color",
      "label": "Icon color"
    },
    {
      "type": "range",
      "id": "delivery_button_font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 16
    },
    {
      "type": "text",
      "id": "map_title",
      "label": "Map label (plain block only)",
      "default": "Richmond Station � Toronto, Canada"
    },
    {
      "type": "text",
      "id": "map_query",
      "label": "Google Maps search (plain block only)",
      "default": "Richmond Station Toronto Ontario Canada",
      "info": "Used when Embed URL is empty."
    },
    {
      "type": "text",
      "id": "map_embed_url",
      "label": "Google Maps embed URL (plain block only)",
      "info": "Optional. Paste full embed src from Google Maps ? Share ? Embed a map."
    },
    {
      "type": "text",
      "id": "delivery_placeholder",
      "label": "Search placeholder",
      "default": "Enter your town or ZIP code"
    },
    {
      "type": "text",
      "id": "delivery_button",
      "label": "Check button label",
      "default": "Check my area"
    },
    {
      "type": "text",
      "id": "delivery_msg_yes",
      "label": "Found message",
