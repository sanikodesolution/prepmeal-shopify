{% render 'cm-section-assets', section: section %}

{%- liquid
  assign s = section.settings
-%}
{%- capture story_eyebrow_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'eyebrow_' -%}
{%- endcapture -%}
{%- capture story_heading_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'heading_' -%}
{%- endcapture -%}
{%- capture story_body_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'body_' -%}
{%- endcapture -%}
{%- capture story_quote_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'quote_' -%}
{%- endcapture -%}
{%- capture story_author_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'author_' -%}
{%- endcapture -%}

<div
  class="cm cm-story cm--{{ section.settings.background }}{% if section.settings.media_position == 'left' %} cm-story--media-left{% endif %}"
  data-cm="story"
>
  <div class="page-width section-{{ section.id }}-padding">
    <div class="cm-story__grid">
      <div class="cm-story__text">
        {%- if s.label != blank -%}
          <span
            class="cm-label"
            {% if story_eyebrow_style != blank %}
              style="{{ story_eyebrow_style | strip }}"
            {% endif %}
          >{{ s.label | escape }}</span>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2
            class="cm-heading"
            {% if story_heading_style != blank %}
              style="{{ story_heading_style | strip }}"
            {% endif %}
          >{{ s.heading | escape | newline_to_br }}</h2>
        {%- endif -%}
        {%- if s.text != blank -%}
          <div
            class="cm-body"
            {% if story_body_style != blank %}
              style="{{ story_body_style | strip }}"
            {% endif %}
          >{{ s.text }}</div>
        {%- endif -%}
      </div>

      {%- if s.video != blank or s.video_url != blank or s.image != blank -%}
        <div class="cm-story__media">
          {%- if s.video != blank -%}
            {{
              s.video
              | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '1100x'
            }}
          {%- elsif s.video_url != blank -%}
            <video
              src="{{ s.video_url | escape }}"
              {% if s.image != blank %}
                poster="{{ s.image | image_url: width: 1100 }}"
              {% endif %}
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
            ></video>
          {%- else -%}
            {{ s.image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 55vw, 100vw' }}
          {%- endif -%}

          {%- if s.quote != blank -%}
            <blockquote
              class="cm-story__quote"
              {% if story_quote_style != blank %}
                style="{{ story_quote_style | strip }}"
              {% endif %}
            >
              <p>{{ s.quote | escape }}</p>
              {%- if s.author != blank -%}
                <cite
                  {% if story_author_style != blank %}
                    style="{{ story_author_style | strip }}"
                  {% endif %}
                >{{ s.author | escape }}</cite>
              {%- endif -%}
            </blockquote>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

