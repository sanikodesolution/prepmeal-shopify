{% render 'cm-section-assets', section: section %}

<div class="cm cm-cta cm--{{ section.settings.background }}" data-cm="cta">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="cm-center">
      {%- if section.settings.label != blank -%}
        <span class="cm-label">{{ section.settings.label | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="cm-heading">{{ section.settings.heading | escape | newline_to_br }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="cm-body">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        {%- assign cta_btn_link = section.settings.button_link | default: routes.root_url -%}
        {% render 'pm-button',
          label: section.settings.button_label,
          link: cta_btn_link,
          style: 'brand',
          text_color: section.settings.button_text_color,
          bg_color: section.settings.button_bg_color,
          icon_bg: section.settings.button_icon_bg,
          icon_color: section.settings.button_icon_color,
          font_size: section.settings.button_font_size
        %}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CM contact CTA",
  "tag": "section",
  "class": "section cm-section",
  "settings": [
    { "type": "text", "id": "label", "label": "Label" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Have a Question?" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Not sure which plan to pick? Just reach out. We will help you.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Contact Us" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Button style" },
    { "type": "color", "id": "button_text_color", "label": "Text color" },
    { "type": "color", "id": "button_bg_color", "label": "Background color" },
    { "type": "color", "id": "button_icon_bg", "label": "Icon background" },
    { "type": "color", "id": "button_icon_color", "label": "Icon color" },
    { "type": "range", "id": "button_font_size", "min": 12, "max": 24, "step": 1, "unit": "px", "label": "Font size", "default": 16 },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "cream", "label": "Cream" },
        { "value": "warm", "label": "Warm" },
        { "value": "white", "label": "White" }
      ],
      "default": "warm"
    },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 56 }
  ],
  "presets": [
    {
      "name": "CM contact CTA"
    }
  ]
}
{% endschema %}
