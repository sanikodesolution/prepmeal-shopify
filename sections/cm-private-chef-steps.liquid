{{ 'section-cm-private-chef.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
-%}
{%- capture pc_eyebrow_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'eyebrow_' -%}
{%- endcapture -%}
{%- capture pc_heading_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'heading_' -%}
{%- endcapture -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section class="cm cm-pc cm-pc__section section-{{ section.id }}-padding" id="pc-how">
  <div class="cm-pc__wrap">
    <div class="cm-pc__head">
      {%- if s.label != blank -%}
        <span
          class="cm-label"
          {% if pc_eyebrow_style != blank %}
            style="{{ pc_eyebrow_style | strip }}"
          {% endif %}
        >{{ s.label | escape }}</span>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2
          class="cm-heading"
          {% if pc_heading_style != blank %}
            style="{{ pc_heading_style | strip }}"
          {% endif %}
        >{{ s.heading | escape }}</h2>
      {%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <div class="cm-pc__steps" style="--pc-cols: {{ section.blocks.size | at_most: 4 }};">
        {%- for block in section.blocks -%}
          {%- capture pc_step_title_style -%}
            {%- render 'pm-block-type-style', block: block, prefix: 'title_' -%}
          {%- endcapture -%}
          {%- capture pc_step_body_style -%}
            {%- render 'pm-block-type-style', block: block, prefix: 'body_' -%}
          {%- endcapture -%}
          <div class="cm-pc__step" {{ block.shopify_attributes }}>
            <i>{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</i>
            <h3
              {% if pc_step_title_style != blank %}
                style="{{ pc_step_title_style | strip }}"
              {% endif %}
            >{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}
              <p
                {% if pc_step_body_style != blank %}
                  style="{{ pc_step_body_style | strip }}"
                {% endif %}
              >{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

