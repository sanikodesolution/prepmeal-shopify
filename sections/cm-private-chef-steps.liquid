{{ 'section-cm-private-chef.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section class="cm cm-pc cm-pc__section section-{{ section.id }}-padding" id="pc-how">
  <div class="cm-pc__wrap">
    <div class="cm-pc__head">
      {%- if section.settings.label != blank -%}
        <span class="cm-label">{{ section.settings.label | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="cm-heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <div class="cm-pc__steps" style="--pc-cols: {{ section.blocks.size | at_most: 4 }};">
        {%- for block in section.blocks -%}
          <div class="cm-pc__step" {{ block.shopify_attributes }}>
            <i>{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</i>
            <h3>{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}
              <p>{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "PC steps",
  "tag": "section",
  "class": "section cm-section",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Submit details" },
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "How it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Four easy steps to your evening" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 84 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 84 }
  ],
  "presets": [
    {
      "name": "PC steps",
      "blocks": [
        { "type": "step", "settings": { "title": "Submit details", "text": "Tell us about your event, guests and tastes." } },
        { "type": "step", "settings": { "title": "We design your menu", "text": "A custom menu tailored to your occasion." } },
        { "type": "step", "settings": { "title": "Chef Matt cooks", "text": "He prepares and serves in your home." } },
        { "type": "step", "settings": { "title": "You relax", "text": "Enjoy the evening. We handle the rest." } }
      ]
    }
  ]
}
{% endschema %}
