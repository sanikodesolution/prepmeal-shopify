{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}
{%- if section.settings.hero_style == 'prep' -%}
  {{ 'section-banner-prep.css' | asset_url | stylesheet_tag }}
{%- endif -%}
{%- if section.settings.hero_style == 'editorial' -%}
  {{ 'section-banner-editorial.css' | asset_url | stylesheet_tag }}
{%- endif -%}
{%- if section.settings.hero_style == 'studio' -%}
  {{ 'section-banner-studio.css' | asset_url | stylesheet_tag }}
{%- endif -%}
{%- if section.settings.hero_style == 'market' -%}
  {{ 'section-banner-market.css' | asset_url | stylesheet_tag }}
{%- endif -%}
{%- if section.settings.hero_style == 'table' -%}
  {{ 'section-banner-table.css' | asset_url | stylesheet_tag }}
{%- endif -%}
{%- if section.settings.hero_style == 'selection' -%}
  {{ 'section-banner-selection.css' | asset_url | stylesheet_tag }}
{%- endif -%}
{%- if section.settings.hero_style == 'chef-pick' -%}
  {{ 'section-banner-chef-pick.css' | asset_url | stylesheet_tag }}
{%- endif -%}
{%- if section.settings.hero_style == 'plate-studio' -%}
  {{ 'section-banner-plate-studio.css' | asset_url | stylesheet_tag }}
{%- endif -%}
{%- if section.settings.hero_style == 'harvest-letter' -%}
  {{ 'section-banner-harvest-letter.css' | asset_url | stylesheet_tag }}
{%- endif -%}
{%- if section.settings.hero_style == 'bistro-split' -%}
  {{ 'section-banner-bistro-split.css' | asset_url | stylesheet_tag }}
{%- endif -%}
{%- if section.settings.hero_style == 'full-bleed' -%}
  {{ 'section-banner-full-bleed.css' | asset_url | stylesheet_tag }}
{%- endif -%}
{%- if section.settings.hero_style == 'editorial-card' -%}
  {{ 'section-banner-editorial-card.css' | asset_url | stylesheet_tag }}
{%- endif -%}
{%- if section.settings.hero_style == 'twin-table' -%}
  {{ 'section-banner-twin-table.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- if section.settings.image_height == 'adapt' and section.settings.image != blank -%}
  {%- style -%}
    @media screen and (max-width: 749px) {
      #Banner-{{ section.id }}::before,
      #Banner-{{ section.id }} .banner__media::before,
      #Banner-{{ section.id }}:not(.banner--mobile-bottom) .banner__content::before {
        padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }

    @media screen and (min-width: 750px) {
      #Banner-{{ section.id }}::before,
      #Banner-{{ section.id }} .banner__media::before {
        padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }
  {%- endstyle -%}
{%- endif -%}

{%- style -%}
  #Banner-{{ section.id }}::after {
    opacity: {{ section.settings.image_overlay_opacity | divided_by: 100.0 }};
  }

  #Banner-{{ section.id }} {
    {% if section.settings.background_color != blank %}
      background-color: {{ section.settings.background_color }};
    {% endif %}
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    padding-left: {{ section.settings.padding_left | times: 0.75 | round: 0 }}px;
    padding-right: {{ section.settings.padding_right | times: 0.75 | round: 0 }}px;
  }

  {% if section.settings.content_background_color != blank %}
    #Banner-{{ section.id }} .banner__box {
      background-color: {{ section.settings.content_background_color }};
    }
  {% endif %}

  @media screen and (min-width: 750px) {
    #Banner-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      padding-left: {{ section.settings.padding_left }}px;
      padding-right: {{ section.settings.padding_right }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign full_width = '100vw'
  assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'

  if section.settings.image_behavior == 'ambient'
    assign half_width = '60vw'
    assign full_width = '120vw'
    assign stacked_sizes = '(min-width: 750px) 60vw, 120vw'
    assign widths = '450, 660, 900, 1320, 1800, 2136, 2400, 3600, 7680'
  elsif section.settings.image_behavior == 'fixed' or section.settings.image_behavior == 'zoom-in'
    assign half_width = '100vw'
    assign stacked_sizes = '100vw'
  else
    assign half_width = '50vw'
    assign stacked_sizes = '(min-width: 750px) 50vw, 100vw'
  endif
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}

<div
  id="Banner-{{ section.id }}"
  class="pm-section-bg banner banner--content-align-{{ section.settings.desktop_content_alignment }} banner--content-align-mobile-{{ section.settings.mobile_content_alignment }} banner--{{ section.settings.image_height }}{% if section.settings.stack_images_on_mobile and section.settings.image != blank and section.settings.image_2 != blank %} banner--stacked{% endif %}{% if section.settings.image_height == 'adapt' and section.settings.image != blank %} banner--adapt{% endif %}{% if section.settings.show_text_below %} banner--mobile-bottom{%- endif -%}{% if section.settings.show_text_box == false %} banner--desktop-transparent{% endif %}{% if section.settings.hero_style == 'prep' %} banner--prep{% if section.settings.show_visual %} banner--prep-plates{% endif %}{% elsif section.settings.hero_style == 'editorial' %} banner--editorial{% elsif section.settings.hero_style == 'studio' %} banner--studio{% elsif section.settings.hero_style == 'market' %} banner--market{% elsif section.settings.hero_style == 'table' %} banner--table{% elsif section.settings.hero_style == 'selection' %} banner--selection{% elsif section.settings.hero_style == 'chef-pick' %} banner--chef-pick{% elsif section.settings.hero_style == 'plate-studio' %} banner--plate-studio{% elsif section.settings.hero_style == 'harvest-letter' %} banner--harvest-letter{% elsif section.settings.hero_style == 'bistro-split' %} banner--bistro-split{% elsif section.settings.hero_style == 'full-bleed' %} banner--full-bleed{% elsif section.settings.hero_style == 'editorial-card' %} banner--editorial-card{% elsif section.settings.hero_style == 'twin-table' %} banner--twin-table{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
  {% render 'pm-section-style', section: section %}
>
  {%- if section.settings.image != blank -%}
    <div class="banner__media media{% if section.settings.image == blank and section.settings.image_2 == blank %} placeholder{% endif %}{% if section.settings.image_2 != blank %} banner__media-half{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {%- liquid
        assign image_height = section.settings.image.width | divided_by: section.settings.image.aspect_ratio
        if section.settings.image_2 != blank
          assign image_class = 'banner__media-image-half'
        endif
        if section.settings.image_2 != blank and section.settings.stack_images_on_mobile
          assign sizes = stacked_sizes
        elsif section.settings.image_2 != blank
          assign sizes = half_width
        else
          assign sizes = full_width
        endif
      -%}
      {{
        section.settings.image
        | image_url: width: 3840
        | image_tag:
          width: section.settings.image.width,
          height: image_height,
          class: image_class,
          sizes: sizes,
          widths: widths,
          fetchpriority: fetch_priority
      }}
    </div>
  {%- elsif section.settings.image_asset != blank and section.settings.image_2 == blank -%}
    <div class="banner__media media{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {%- liquid
        assign asset_loading = 'lazy'
        if section.index == 1
          assign asset_loading = 'eager'
        endif
        render 'asset-image', src: section.settings.image_asset, widths: '375, 750, 1100, 1500, 1800', sizes: full_width, width: section.settings.image_asset_width, height: section.settings.image_asset_height, alt: section.settings.image_asset_alt, loading: asset_loading, fetchpriority: fetch_priority
      -%}
    </div>
  {%- elsif section.settings.image_2 == blank -%}
    <div class="banner__media media{% if section.settings.image == blank and section.settings.image_2 == blank %} placeholder{% endif %}{% if section.settings.image_2 != blank %} banner__media-half{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
  {%- endif -%}
  {%- if section.settings.image_2 != blank -%}
    <div class="banner__media media{% if section.settings.image != blank %} banner__media-half{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {%- liquid
        assign image_height_2 = section.settings.image_2.width | divided_by: section.settings.image_2.aspect_ratio
        if section.settings.image != blank
          assign image_class_2 = 'banner__media-image-half'
        endif
        if section.settings.image != blank and section.settings.stack_images_on_mobile
          assign sizes = stacked_sizes
        elsif section.settings.image_2 != blank
          assign sizes = half_width
        else
          assign sizes = full_width
        endif
      -%}
      {{
        section.settings.image_2
        | image_url: width: 3840
        | image_tag:
          width: section.settings.image_2.width,
          height: image_height_2,
          class: image_class_2,
          sizes: sizes,
          widths: widths,
          fetchpriority: fetch_priority
      }}
    </div>
  {%- endif -%}
  <div class="banner__content banner__content--{{ section.settings.desktop_content_position }} page-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    <div class="pm-section-bg banner__box content-container content-container--full-width-mobile color-{{ section.settings.color_scheme }} gradient" {% render 'pm-section-style', section: section %}>
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            {%- capture banner_type_style -%}
              {%- render 'pm-block-type-style', block: block -%}
            {%- endcapture -%}
            <h2
              class="banner__heading inline-richtext {{ block.settings.heading_size }}"
              {% if banner_type_style != blank %}
                style="{{ banner_type_style | strip }}"
              {% endif %}
              {{ block.shopify_attributes }}
            >
              {{ block.settings.heading }}
            </h2>
          {%- when 'text' -%}
            {%- capture banner_type_style -%}
              {%- render 'pm-block-type-style', block: block -%}
            {%- endcapture -%}
            <div
              class="banner__text rte {{ block.settings.text_style }}"
              {% if banner_type_style != blank %}
                style="{{ banner_type_style | strip }}"
              {% endif %}
              {{ block.shopify_attributes }}
            >
              <p>{{ block.settings.text }}</p>
            </div>
          {%- when 'buttons' -%}
            <div
              class="banner__buttons{% if block.settings.button_label_1 != blank and block.settings.button_label_2 != blank %} banner__buttons--multiple{% endif %}"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.button_label_1 != blank and block.settings.button_animated_1 -%}
                {%- liquid
                  assign pm_style = 'brand'
                  if section.settings.hero_style == 'prep'
                    assign pm_style = 'light'
                  endif
                  render 'pm-button', label: block.settings.button_label_1, link: block.settings.button_link_1, style: pm_style, text_color: block.settings.button_text_1, bg_color: block.settings.button_bg_1, icon_bg: block.settings.button_icon_bg_1, icon_color: block.settings.button_icon_color_1, font_size: block.settings.button_font_size_1, hover_text_color: block.settings.button_hover_text_1, hover_bg_color: block.settings.button_hover_bg_1
                -%}
              {%- elsif block.settings.button_label_1 != blank -%}
                <a
                  {% if block.settings.button_link_1 == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ block.settings.button_link_1 }}"
                  {% endif %}
                  class="button{% if block.settings.button_style_secondary_1 %} button--secondary{% else %} button--primary{% endif %}"
                  {% if block.settings.button_bg_1 != blank or block.settings.button_text_1 != blank or block.settings.button_font_size_1 != blank %}
                    style="{% if block.settings.button_bg_1 != blank %}background-color:{{ block.settings.button_bg_1 }};{% endif %}{% if block.settings.button_text_1 != blank %}color:{{ block.settings.button_text_1 }};{% endif %}{% if block.settings.button_font_size_1 != blank %}font-size:{{ block.settings.button_font_size_1 }}px;{% endif %}"
                  {% endif %}
                >
                  {{- block.settings.button_label_1 | escape -}}
                </a>
              {%- endif -%}
              {%- if block.settings.button_label_2 != blank and block.settings.button_animated_2 -%}
                {%- liquid
                  assign pm_style_2 = 'outline'
                  if section.settings.hero_style == 'prep'
                    assign pm_style_2 = 'brand'
                  elsif section.settings.hero_style == 'studio'
                    assign pm_style_2 = 'ink'
                  elsif section.settings.hero_style == 'market'
                    assign pm_style_2 = 'light'
                  elsif section.settings.hero_style == 'table'
                    assign pm_style_2 = 'light'
                  elsif section.settings.hero_style == 'selection'
                    assign pm_style_2 = 'light'
                  elsif section.settings.hero_style == 'chef-pick'
                    assign pm_style_2 = 'light'
                  elsif section.settings.hero_style == 'plate-studio'
                    assign pm_style_2 = 'light'
                  elsif section.settings.hero_style == 'harvest-letter'
                    assign pm_style_2 = 'light'
                  endif
                  render 'pm-button', label: block.settings.button_label_2, link: block.settings.button_link_2, style: pm_style_2, text_color: block.settings.button_text_2, bg_color: block.settings.button_bg_2, icon_bg: block.settings.button_icon_bg_2, icon_color: block.settings.button_icon_color_2, font_size: block.settings.button_font_size_2, hover_text_color: block.settings.button_hover_text_2, hover_bg_color: block.settings.button_hover_bg_2
                -%}
              {%- elsif block.settings.button_label_2 != blank -%}
                <a
                  {% if block.settings.button_link_2 == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ block.settings.button_link_2 }}"
                  {% endif %}
                  class="button{% if block.settings.button_style_secondary_2 %} button--secondary{% else %} button--primary{% endif %}"
                  {% if block.settings.button_bg_2 != blank or block.settings.button_text_2 != blank or block.settings.button_font_size_2 != blank %}
                    style="{% if block.settings.button_bg_2 != blank %}background-color:{{ block.settings.button_bg_2 }};{% endif %}{% if block.settings.button_text_2 != blank %}color:{{ block.settings.button_text_2 }};{% endif %}{% if block.settings.button_font_size_2 != blank %}font-size:{{ block.settings.button_font_size_2 }}px;{% endif %}"
                  {% endif %}
                >
                  {{- block.settings.button_label_2 | escape -}}
                </a>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
  {%- if section.settings.hero_style == 'table' -%}
    {%- liquid
      assign table_background = section.settings.image
      if table_background != blank
        assign table_background_url = table_background | image_url: width: 2400
      elsif section.settings.image_asset != blank
        assign table_background_url = section.settings.image_asset | asset_url
      else
        assign table_background_url = 'cm-hero-banner.jpg' | asset_url
      endif
    -%}
    <div class="banner-table__background" aria-hidden="true">
      <img
        class="banner-table__background-image"
        src="{{ table_background_url }}"
        alt=""
        width="2400"
        height="1400"
        loading="eager"
        fetchpriority="high"
      >
    </div>
  {%- endif -%}
  {%- if section.settings.hero_style == 'prep' -%}
    {%- if section.settings.show_visual or section.settings.badge_text != blank -%}
      <div class="banner-prep__visual{% if section.settings.show_visual %} banner-prep__visual--plates{% endif %}">
        {%- if section.settings.show_visual -%}
          <span class="banner-prep__blob" aria-hidden="true"></span>
          {%- for i in (1..3) -%}
            {%- liquid
              assign plate_key = 'visual_image_' | append: i
              assign plate_image = section.settings[plate_key]
              if plate_image != blank
                assign plate_url = plate_image | image_url: width: 700
                assign plate_class = ''
              else
                assign plate_url = 'cm-hero-banner.jpg' | asset_img_url: '1800x'
                assign plate_class = ' banner-prep__plate-img--d' | append: i
              endif
            -%}
            <span class="banner-prep__plate banner-prep__plate--{{ i }}" aria-hidden="true">
              <span
                class="banner-prep__plate-img{{ plate_class }}"
                style="background-image: url('{{ plate_url }}');"
              ></span>
            </span>
          {%- endfor -%}
        {%- endif -%}
        {%- if section.settings.badge_text != blank -%}
          <div class="banner-prep__badge">
            <span class="banner-prep__badge-inner">{{ section.settings.badge_text | escape }}</span>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endif -%}
  {%- if section.settings.hero_style == 'studio' and section.settings.badge_text != blank -%}
    <div class="banner-studio__badge" aria-label="{{ section.settings.badge_text | escape }}">
      <span class="banner-studio__badge-dot" aria-hidden="true"></span>
      <span>{{ section.settings.badge_text | escape }}</span>
    </div>
  {%- endif -%}
  {%- if section.settings.hero_style == 'market' and section.settings.show_visual -%}
    <div class="banner-market__visual" aria-label="Chef-prepared meals">
      <span class="banner-market__backdrop" aria-hidden="true"></span>
      <div class="banner-market__grid">
        {%- for i in (1..3) -%}
          {%- liquid
            assign market_image_key = 'visual_image_' | append: i
            assign market_image = section.settings[market_image_key]
            if market_image != blank
              assign market_image_url = market_image | image_url: width: 900
            else
              assign market_image_url = 'cm-hero-banner.jpg' | asset_img_url: '1800x'
            endif
          -%}
          <span class="banner-market__tile banner-market__tile--{{ i }}" style="background-image:url('{{ market_image_url }}')" aria-hidden="true"></span>
        {%- endfor -%}
      </div>
      {%- if section.settings.badge_text != blank -%}
        <span class="banner-market__badge"><span aria-hidden="true"></span>{{ section.settings.badge_text | escape }}</span>
      {%- endif -%}
    </div>
  {%- endif -%}
  {%- if section.settings.hero_style == 'selection' and section.settings.show_visual -%}
    <div class="banner-selection__visual" aria-label="Chef's selection of prepared meals">
      <span class="banner-selection__halo" aria-hidden="true"></span>
      {%- for i in (1..3) -%}
        {%- liquid
          assign selection_image_key = 'visual_image_' | append: i
          assign selection_image = section.settings[selection_image_key]
          if selection_image != blank
            assign selection_image_url = selection_image | image_url: width: 1100
          else
            assign selection_image_url = 'cm-hero-banner.jpg' | asset_img_url: '1800x'
          endif
        -%}
        <span class="banner-selection__dish banner-selection__dish--{{ i }}" style="background-image:url('{{ selection_image_url }}')" aria-hidden="true"></span>
      {%- endfor -%}
      <span class="banner-selection__seal"><span>CHEF'S</span><strong>SELECTION</strong><span>MADE FRESH · EVERY WEEK</span></span>
      <span class="banner-selection__caption"><span>THE MENU</span><strong>Good food, thoughtfully made.</strong></span>
    </div>
  {%- endif -%}
  {%- if section.settings.hero_style == 'chef-pick' and section.settings.show_visual -%}
    {%- liquid
      assign chef_pick_image = section.settings.visual_image_1
      if chef_pick_image != blank
        assign chef_pick_image_url = chef_pick_image | image_url: width: 1800
      else
        assign chef_pick_image_url = 'cm-hero-banner.jpg' | asset_img_url: '1800x'
      endif
    -%}
    <div class="banner-chef-pick__visual" aria-label="Chef's weekly pick">
      <span class="banner-chef-pick__orbit" aria-hidden="true"></span>
      <span class="banner-chef-pick__photo" style="background-image:url('{{ chef_pick_image_url }}')" aria-hidden="true"></span>
      <span class="banner-chef-pick__stamp"><span>THIS WEEK</span><strong>01</strong><span>CHEF'S PICK</span></span>
      <span class="banner-chef-pick__caption"><span>PREPARED WITH PURPOSE</span><strong>A little something special.</strong></span>
    </div>
  {%- endif -%}
  {%- if section.settings.hero_style == 'plate-studio' and section.settings.show_visual -%}
    {%- liquid
      assign plate_studio_image = section.settings.visual_image_1
      if plate_studio_image != blank
        assign plate_studio_image_url = plate_studio_image | image_url: width: 1800
      else
        assign plate_studio_image_url = 'cm-hero-banner.jpg' | asset_img_url: '1800x'
      endif
    -%}
    <div class="banner-plate-studio__visual" aria-label="A chef-prepared meal, plated fresh">
      <span class="banner-plate-studio__orbit banner-plate-studio__orbit--outer" aria-hidden="true"></span>
      <span class="banner-plate-studio__orbit banner-plate-studio__orbit--inner" aria-hidden="true"></span>
      <span class="banner-plate-studio__plate" style="background-image:url('{{ plate_studio_image_url }}')" aria-hidden="true"></span>
      <span class="banner-plate-studio__note"><span>ON THE MENU</span><strong>Fresh this week</strong></span>
      <span class="banner-plate-studio__number" aria-hidden="true">08</span>
    </div>
  {%- endif -%}
  {%- if section.settings.hero_style == 'harvest-letter' and section.settings.show_visual -%}
    {%- liquid
      assign harvest_image = section.settings.visual_image_1
      if harvest_image != blank
        assign harvest_image_url = harvest_image | image_url: width: 1800
      else
        assign harvest_image_url = 'cm-hero-banner.jpg' | asset_img_url: '1800x'
      endif
    -%}
    <div class="banner-harvest__visual" aria-label="A fresh chef-prepared meal">
      <span class="banner-harvest__photo" style="background-image:url('{{ harvest_image_url }}')" aria-hidden="true"></span>
      <span class="banner-harvest__edge" aria-hidden="true"></span>
      <span class="banner-harvest__badge"><span aria-hidden="true">✳</span> FRESH FROM OUR KITCHEN</span>
      <span class="banner-harvest__vertical">MADE TO EAT WELL</span>
    </div>
    <span class="banner-harvest__number" aria-hidden="true">09</span>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.image-banner.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "hero_style",
      "label": "Banner style",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "prep", "label": "Prep meal (text left, navy gradient)" },
        { "value": "editorial", "label": "Style 2 — Editorial" },
