{% render 'cm-section-assets', section: section %}
{{ 'section-cm-meal-plan-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cm-meal-plan-page.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign meal_blocks = section.blocks | where: 'type', 'meal'
  assign benefit_blocks = section.blocks | where: 'type', 'benefit'
  assign step_blocks = section.blocks | where: 'type', 'step'
  assign quality_blocks = section.blocks | where: 'type', 'quality'
  assign menu_blocks = section.blocks | where: 'type', 'menu_item'
  assign review_blocks = section.blocks | where: 'type', 'review'
  assign faq_blocks = section.blocks | where: 'type', 'faq'
  assign related_blocks = section.blocks | where: 'type', 'related'
-%}

{%- capture foods_json -%}
[
{%- for i in (0..9) -%}
  {%- assign key = 'mp-food-' | append: i | append: '.jpg' -%}
  "{{ key | asset_url }}"{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]
{%- endcapture -%}

{%- capture alts_json -%}
[
{%- for block in meal_blocks -%}
  {{ block.settings.name | json }}{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]
{%- endcapture -%}

{%- capture meals_json -%}
[
{%- for block in meal_blocks -%}
  {
    "name": {{ block.settings.name | json }},
    "description": {{ block.settings.description | json }},
    "calories": {{ block.settings.calories | json }},
    "protein": {{ block.settings.protein | json }},
    "carbs": {{ block.settings.carbs | json }},
    "fat": {{ block.settings.fat | json }},
    "tags": {{ block.settings.tags | json }},
    "ingredients": {{ block.settings.ingredients | json }},
    "badge": {{ block.settings.badge | json }},
    "gluten_free": {{ block.settings.gluten_free | json }},
    "dairy_free": {{ block.settings.dairy_free | json }},
    "imageIndex": {{ block.settings.image_index | default: forloop.index0 | json }},
    "image": {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 900 | json }}{% else %}null{% endif %}
  }{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]
{%- endcapture -%}

<main
  class="mealplan-page"
  data-mp-page
  data-cm="meal-plan-page"
>
  <script type="application/json" data-mp-foods>{{ foods_json }}</script>
  <script type="application/json" data-mp-alts>{{ alts_json }}</script>
  <script type="application/json" data-mp-meals>{{ meals_json }}</script>

  <section class="mph">
    <div class="mph__inner">
      <div class="mph__copy">
        {%- if section.settings.plan_label != blank -%}
          <p class="mph__plan">{{ section.settings.plan_label | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h1 class="mph__title">{{ section.settings.heading | escape | newline_to_br }}</h1>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="mph__text">{{ section.settings.text | escape }}</p>
        {%- endif -%}
        <dl class="mph__facts">
          {%- if section.settings.fact_1_label != blank -%}
            <div><dt>{{ section.settings.fact_1_label | escape }}</dt><dd>{{ section.settings.fact_1_value | escape }}</dd></div>
          {%- endif -%}
          {%- if section.settings.fact_2_label != blank -%}
            <div><dt>{{ section.settings.fact_2_label | escape }}</dt><dd>{{ section.settings.fact_2_value | escape }}</dd></div>
          {%- endif -%}
          {%- if section.settings.fact_3_label != blank -%}
            <div><dt>{{ section.settings.fact_3_label | escape }}</dt><dd>{{ section.settings.fact_3_value | escape }}</dd></div>
          {%- endif -%}
        </dl>
        <div class="mph__actions">
          {%- if section.settings.button_label != blank -%}
            <a class="mph__btn mph__btn--primary" href="{{ section.settings.button_link | default: '#menu' }}">{{ section.settings.button_label | escape }}</a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a class="mph__btn mph__btn--ghost" href="{{ section.settings.button_link_2 | default: '#menu' }}">{{ section.settings.button_label_2 | escape }}</a>
          {%- endif -%}
        </div>
      </div>
      <div class="mph__visual">
        <div class="mph__main" role="img" aria-label="{{ section.settings.hero_image_1_alt | escape }}">
          {%- if section.settings.hero_image_1 != blank -%}
            {{ section.settings.hero_image_1 | image_url: width: 900 | image_tag: class: 'mp-food', loading: 'eager', widths: '400, 700, 900', sizes: '(min-width: 990px) 40vw, 80vw', alt: section.settings.hero_image_1_alt }}
          {%- else -%}
            <img class="mp-food" data-f="5" alt="{{ section.settings.hero_image_1_alt | escape }}" width="700" height="700" fetchpriority="high">
          {%- endif -%}
        </div>
        <div class="mph__second" role="img" aria-label="{{ section.settings.hero_image_2_alt | escape }}">
          {%- if section.settings.hero_image_2 != blank -%}
            {{ section.settings.hero_image_2 | image_url: width: 700 | image_tag: class: 'mp-food', loading: 'lazy', widths: '300, 500, 700', sizes: '30vw', alt: section.settings.hero_image_2_alt }}
          {%- else -%}
            <img class="mp-food" data-f="6" alt="{{ section.settings.hero_image_2_alt | escape }}" width="700" height="700">
          {%- endif -%}
        </div>
        <div class="mph__badge"><strong>{{ section.settings.badge_value | escape }}</strong><span>{{ section.settings.badge_label | escape }}</span></div>
      </div>
    </div>
  </section>

  <div class="mealplan-a">
    <section class="ben"><div class="wrap">
      <p class="big">
        <span>{{ section.settings.ben_line_1 | escape }}</span>
        <span>{{ section.settings.ben_line_2 | escape }}</span>
        <span class="out">{{ section.settings.ben_line_3 | escape }}</span>
      </p>
      {%- if benefit_blocks.size > 0 -%}
        <ul>
          {%- for block in benefit_blocks -%}
            <li {{ block.shopify_attributes }}><b>{{ block.settings.title | escape }}</b><span>{{ block.settings.text | escape }}</span></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.ben_note != blank -%}
        <p style="margin:1rem 0 0;opacity:.8">{{ section.settings.ben_note | escape }}</p>
      {%- endif -%}
    </div></section>

    <section><div class="wrap">
      <div class="menu-head">
        <h2>{{ section.settings.menu_heading | escape }}</h2>
        <p>{{ section.settings.menu_text | escape }}</p>
      </div>
      <div class="mg" id="menu"></div>
    </div></section>

    <section class="ex"><div class="wrap">
      <h2>{{ section.settings.explore_heading | escape }}</h2>
      <div class="filters" id="filters" role="group" aria-label="Filter meals"></div>
      <div class="eg" id="grid"></div>
      <div class="more"><button type="button" class="btn" id="more">{{ section.settings.load_more_label | escape }}</button></div>
    </div></section>

    <section id="detail"><div class="wrap dt-grid dt">
      <div class="dt-img" id="dImg"></div>
      <div>
        <h2 id="dName"></h2>
        <p id="dDesc"></p>
        <ul class="ing" id="dIng"></ul>
        <div class="nut">
          <div class="ring" id="ring"><div><span id="dCal"></span><small>calories</small></div></div>
          <div class="bars" id="bars"></div>
        </div>
        <p class="note">{{ section.settings.detail_note | escape }}</p>
      </div>
    </div></section>
  </div>

  <div class="mealplan">
    <section class="mealplan-sec"><div class="mealplan-wrap mealplan-chef">
      <div class="mealplan-img mealplan-big mp-gs" data-p="0"></div>
      <div class="mealplan-txt mp-gs">
        <h2 class="mealplan-h">{{ section.settings.chef_heading | escape | newline_to_br }}</h2>
        <p class="mealplan-p">{{ section.settings.chef_text | escape }}</p>
      </div>
      <div class="mealplan-img mealplan-small mp-gs" data-p="1"></div>
    </div></section>

    <section class="mealplan-sec mealplan-steps"><div class="mealplan-wrap">
      <h2 class="mealplan-h">{{ section.settings.steps_heading | escape }}</h2>
      <ol class="mealplan-list">
        {%- for block in step_blocks -%}
          <li class="mp-gs" style="--i:{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <span class="mealplan-num">{{ forloop.index }}</span>
            <h3>{{ block.settings.title | escape }}</h3>
            <p>{{ block.settings.text | escape }}</p>
          </li>
        {%- endfor -%}
      </ol>
    </div></section>

    <section class="mealplan-sec"><div class="mealplan-wrap mealplan-q">
      <div class="mealplan-img mp-gs" id="qImg" data-p="2" aria-live="polite"></div>
      <div class="mp-gs mealplan-q__copy">
        <h2 class="mealplan-h">{{ section.settings.quality_heading | escape }}</h2>
        <div class="mealplan-q__split">
          <ul class="mealplan-terms" id="qTerms">
            {%- for block in quality_blocks -%}
              <li data-detail="{{ block.settings.detail | default: block.settings.text | escape }}"{% if menu_blocks.size > 0 %}{% if forloop.index == 2 %} data-show-menu="1"{% endif %}{% endif %} {{ block.shopify_attributes }}>
                <b>{{ block.settings.title | escape }}</b>
                <span>{{ block.settings.text | escape }}</span>
              </li>
            {%- endfor -%}
          </ul>
          <aside class="mealplan-q__detail" id="qDetail">
            <div class="mealplan-q__note"><b></b><p></p></div>
            {%- if menu_blocks.size > 0 -%}
              <ol class="mealplan-q__menu" hidden>
                {%- for block in menu_blocks -%}
                  <li {{ block.shopify_attributes }}>{{ block.settings.name | escape }}</li>
                {%- endfor -%}
              </ol>
            {%- endif -%}
          </aside>
        </div>
      </div>
    </div></section>

    <section class="mealplan-sec" style="padding-inline:0"><div>
      <div class="mealplan-gal-h mealplan-wrap" style="padding-inline:clamp(1.25rem,4vw,4rem)">
        <h2 class="mealplan-h">{{ section.settings.gallery_heading | escape | newline_to_br }}</h2>
        <div class="mealplan-arrows">
          <button type="button" aria-label="Previous" data-g="-1">&larr;</button>
          <button type="button" aria-label="Next" data-g="1">&rarr;</button>
        </div>
      </div>
      <div class="mealplan-track" id="gal"></div>
    </div></section>

    <section class="mealplan-sec"><div class="mealplan-wrap mealplan-del">
      {%- liquid
        assign map_query = section.settings.map_query | default: 'Richmond Station Toronto Ontario Canada'
        assign map_src = section.settings.map_embed_url
        if map_src == blank
          assign map_q = map_query | url_encode
          assign map_src = 'https://maps.google.com/maps?q=' | append: map_q | append: '&z=15&output=embed'
        endif
      -%}
      <div class="mealplan-map mp-gs">
        <iframe
          class="mealplan-map__frame"
          title="{{ section.settings.map_title | default: map_query | escape }}"
          src="{{ map_src }}"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
        {%- if section.settings.map_title != blank -%}
          <p class="mealplan-map__label">{{ section.settings.map_title | escape }}</p>
        {%- endif -%}
      </div>
      <div class="mealplan-del__copy mp-gs">
        <h2 class="mealplan-h">{{ section.settings.delivery_heading | escape }}</h2>
        <p class="mealplan-p">{{ section.settings.delivery_text | escape }}</p>
        <div class="mealplan-del__actions">
          {%- if section.settings.delivery_areas != blank -%}
            <ul class="mealplan-areas">
              {%- assign areas = section.settings.delivery_areas | split: ',' -%}
              {%- for area in areas -%}
                <li>
                  <span class="mealplan-areas__pin" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M12 2C8.1 2 5 5.1 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7zm0 9.5c-1.4 0-2.5-1.1-2.5-2.5S10.6 6.5 12 6.5s2.5 1.1 2.5 2.5S13.4 11.5 12 11.5z"/></svg>
                  </span>
                  {{ area | strip | escape }}
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
          {%- if section.settings.delivery_button_label != blank -%}
            <a class="mealplan-btn mealplan-btn--delivery" href="{{ section.settings.delivery_button_link | default: '#' }}">
              {{ section.settings.delivery_button_label | escape }}
              <span class="mealplan-btn__arrow" aria-hidden="true">→</span>
            </a>
          {%- endif -%}
        </div>
      </div>
    </div></section>

    <section class="mealplan-sec mealplan-rev"><div class="mealplan-wrap">
      <h2 class="mealplan-h">{{ section.settings.reviews_heading | escape }}</h2>
      <div class="mealplan-cols" id="rev">
        {%- for block in review_blocks -%}
          <article class="mealplan-r {% if block.settings.show_image == false %}mealplan-r--text{% endif %} mp-gs" {{ block.shopify_attributes }}>
            {%- if block.settings.show_image -%}
              <div class="mealplan-img" style="--ar:{{ block.settings.aspect | default: 1 }}">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 700 | image_tag: class: 'mp-food mealplan-ph', loading: 'lazy', alt: block.settings.name }}
                {%- else -%}
                  <img class="mp-food mealplan-ph" src="{{ 'mp-food-' | append: forloop.index0 | append: '.jpg' | asset_url }}" alt="{{ block.settings.name | escape }}" width="700" height="700" loading="lazy">
                {%- endif -%}
              </div>
            {%- endif -%}
            <div>
              <span class="mealplan-stars" aria-label="{{ block.settings.rating }} stars">{%- for i in (1..5) -%}★{%- endfor -%}</span>
              <q>{{ block.settings.review | escape }}</q>
              <small>{{ block.settings.name | escape }}</small>
            </div>
          </article>
        {%- endfor -%}
      </div>
    </div></section>

    <section class="mealplan-sec"><div class="mealplan-wrap mealplan-faq">
      <div><h2 class="mealplan-h">{{ section.settings.faq_heading | escape }}</h2></div>
      <div id="faq">
        {%- for block in faq_blocks -%}
          <div class="mealplan-qi" {{ block.shopify_attributes }}>
            <button type="button" class="mealplan-qb" aria-expanded="false" aria-controls="mp-a-{{ section.id }}-{{ forloop.index }}">
              {{ block.settings.question | escape }}<i></i>
            </button>
            <div class="mealplan-qa" id="mp-a-{{ section.id }}-{{ forloop.index }}"><div><p>{{ block.settings.answer | escape }}</p></div></div>
          </div>
        {%- endfor -%}
      </div>
    </div></section>

    <section class="mealplan-sec" style="padding-inline:0"><div>
      <h2 class="mealplan-h mealplan-wrap" style="padding-inline:clamp(1.25rem,4vw,4rem);margin-bottom:2rem">{{ section.settings.related_heading | escape }}</h2>
      <div class="mealplan-track" id="plans">
        {%- for block in related_blocks -%}
          <article class="mealplan-card" {{ block.shopify_attributes }}>
            <div class="mealplan-img">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 700 | image_tag: class: 'mp-food mealplan-ph', loading: 'lazy', alt: block.settings.title }}
              {%- else -%}
                <img class="mp-food mealplan-ph" src="{{ 'mp-food-' | append: forloop.index | append: '.jpg' | asset_url }}" alt="{{ block.settings.title | escape }}" width="700" height="700" loading="lazy">
              {%- endif -%}
            </div>
            <h3>{{ block.settings.title | escape }}</h3>
            <p>{{ block.settings.text | escape }}</p>
            {%- if block.settings.price_note != blank -%}<b>{{ block.settings.price_note | escape }}</b>{%- endif -%}
            <a class="mealplan-btn" href="{{ block.settings.link | default: '#' }}">{{ block.settings.button_label | default: 'View plan' | escape }}</a>
          </article>
        {%- endfor -%}
      </div>
    </div></section>

    <section class="mealplan-sec"><div class="mealplan-wrap"><div class="mealplan-cta">
      <div class="mealplan-img" data-p="3"></div>
      <div class="mealplan-cta-in">
        <h2 class="mealplan-h">{{ section.settings.cta_heading | escape }}</h2>
        <p class="mealplan-p">{{ section.settings.cta_text | escape }}</p>
        {%- if section.settings.cta_button_label != blank -%}
          <a class="mealplan-btn mealplan-btn--solid" href="{{ section.settings.cta_button_link | default: '#' }}">{{ section.settings.cta_button_label | escape }}</a>
        {%- endif -%}
      </div>
    </div></div></section>
  </div>
</main>

{% schema %}
{
  "name": "CM meal plan page",
  "tag": "section",
  "class": "section cm-section",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "plan_label", "label": "Plan label", "default": "5 Meal Plan" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Chef-prepared meals.\\nMade for your week." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Calorie counted. High protein. Low oil. Pick five meals from this week's menu and we cook and deliver them." },
    { "type": "text", "id": "fact_1_label", "label": "Fact 1 label", "default": "Price" },
    { "type": "text", "id": "fact_1_value", "label": "Fact 1 value", "default": "From $00.00" },
    { "type": "text", "id": "fact_2_label", "label": "Fact 2 label", "default": "Meals" },
    { "type": "text", "id": "fact_2_value", "label": "Fact 2 value", "default": "5 per week" },
    { "type": "text", "id": "fact_3_label", "label": "Fact 3 label", "default": "Menu" },
    { "type": "text", "id": "fact_3_value", "label": "Fact 3 value", "default": "10+ options" },
    { "type": "text", "id": "button_label", "label": "Primary button", "default": "Build my 5 meals" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "button_label_2", "label": "Secondary button", "default": "View this week's menu" },
    { "type": "url", "id": "button_link_2", "label": "Secondary button link" },
    { "type": "image_picker", "id": "hero_image_1", "label": "Hero image (main)" },
    { "type": "text", "id": "hero_image_1_alt", "label": "Hero image 1 alt", "default": "Chimichurri Steak" },
    { "type": "image_picker", "id": "hero_image_2", "label": "Hero image (secondary)" },
    { "type": "text", "id": "hero_image_2_alt", "label": "Hero image 2 alt", "default": "Orange Basil Salmon" },
    { "type": "text", "id": "badge_value", "label": "Badge value", "default": "10+" },
    { "type": "text", "id": "badge_label", "label": "Badge label", "default": "meal options" },

    { "type": "header", "content": "Benefits" },
    { "type": "text", "id": "ben_line_1", "label": "Line 1", "default": "5 meals." },
    { "type": "text", "id": "ben_line_2", "label": "Line 2", "default": "1 week." },
    { "type": "text", "id": "ben_line_3", "label": "Line 3 (outline)", "default": "Zero stress." },
    { "type": "textarea", "id": "ben_note", "label": "Note", "default": "Flexible menu: choose any five from 10+ options, and change your picks each week." },

    { "type": "header", "content": "Menu" },
    { "type": "text", "id": "menu_heading", "label": "Menu heading", "default": "This week's menu" },
    { "type": "textarea", "id": "menu_text", "label": "Menu text", "default": "Featured meals from the weekly rotation. Hover or tap a meal for the details." },
    { "type": "text", "id": "explore_heading", "label": "Explore heading", "default": "Explore all meals" },
    { "type": "text", "id": "load_more_label", "label": "Load more label", "default": "Load more" },
    { "type": "text", "id": "detail_note", "label": "Detail note", "default": "Meal names and nutrition values are from the current menu." },

    { "type": "header", "content": "Chef / Steps / Quality" },
    { "type": "textarea", "id": "chef_heading", "label": "Chef heading", "default": "40 years in the kitchen. Now cooking for you." },
    { "type": "textarea", "id": "chef_text", "label": "Chef text", "default": "Chef Matt has spent four decades cooking. Now he cooks calorie-counted, high-protein, low-oil meals for you." },
    { "type": "text", "id": "steps_heading", "label": "Steps heading", "default": "How it works" },
    { "type": "text", "id": "quality_heading", "label": "Quality heading", "default": "Fresh in, quality out." },
    { "type": "textarea", "id": "gallery_heading", "label": "Gallery heading", "default": "10+\\nmeal options" },

    { "type": "header", "content": "Delivery" },
    { "type": "text", "id": "delivery_heading", "label": "Heading", "default": "Fresh meals, delivered to your door." },
    { "type": "textarea", "id": "delivery_text", "label": "Text", "default": "We deliver across Hartland and nearby areas. Enter your postcode at checkout to confirm we deliver to you." },
    { "type": "text", "id": "delivery_areas", "label": "Areas", "info": "Comma-separated", "default": "Hartland, Nearby areas" },
    { "type": "text", "id": "delivery_button_label", "label": "Button label", "default": "Check my area" },
    { "type": "url", "id": "delivery_button_link", "label": "Button link" },
    { "type": "text", "id": "map_title", "label": "Map label", "default": "Richmond Station · Toronto, Canada" },
    { "type": "text", "id": "map_query", "label": "Google Maps search", "default": "Richmond Station Toronto Ontario Canada", "info": "Used when Embed URL is empty." },
    { "type": "text", "id": "map_embed_url", "label": "Google Maps embed URL", "info": "Optional. Paste full embed src from Google Maps → Share → Embed a map." },

    { "type": "header", "content": "Reviews / FAQ / CTA" },
    { "type": "text", "id": "reviews_heading", "label": "Reviews heading", "default": "Loved by people who love good food" },
    { "type": "text", "id": "faq_heading", "label": "FAQ heading", "default": "Questions, answered" },
    { "type": "text", "id": "related_heading", "label": "Related heading", "default": "Other ways to eat well" },
    { "type": "text", "id": "cta_heading", "label": "CTA heading", "default": "Your week just got easier." },
    { "type": "textarea", "id": "cta_text", "label": "CTA text", "default": "Five chef-prepared meals, delivered. Choose yours and we handle the rest." },
    { "type": "text", "id": "cta_button_label", "label": "CTA button", "default": "Build my meal plan" },
    { "type": "url", "id": "cta_button_link", "label": "CTA button link" },

    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 0 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 0 }
  ],
  "blocks": [
    {
      "type": "meal",
      "name": "Meal",
      "settings": [

        { "type": "text", "id": "name", "label": "Name" },
        { "type": "textarea", "id": "description", "label": "Description" },
