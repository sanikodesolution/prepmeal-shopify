    },
    { "type": "checkbox", "id": "delivery_checker", "label": "Use the street-map checker", "default": false, "info": "Only used when Delivery style is the interactive street map." },
    { "type": "text", "id": "delivery_eyebrow", "label": "Delivery eyebrow", "default": "We deliver" },
    { "type": "text", "id": "delivery_heading", "label": "Heading", "default": "Fresh meals, delivered to your door." },
    { "type": "textarea", "id": "delivery_text", "label": "Text", "default": "We deliver across Hartland and nearby areas. Enter your postcode at checkout to confirm we deliver to you." },
    { "type": "text", "id": "delivery_areas", "label": "Areas (plain block only)", "info": "Comma-separated. Used when the checker is off.", "default": "Hartland, Nearby areas" },
    { "type": "text", "id": "delivery_button_label", "label": "Button label (plain block only)", "default": "Check my area" },
    { "type": "url", "id": "delivery_button_link", "label": "Button link (plain block only)" },
    { "type": "text", "id": "map_title", "label": "Map label (plain block only)", "default": "Richmond Station � Toronto, Canada" },
    { "type": "text", "id": "map_query", "label": "Google Maps search (plain block only)", "default": "Richmond Station Toronto Ontario Canada", "info": "Used when Embed URL is empty." },
    { "type": "text", "id": "map_embed_url", "label": "Google Maps embed URL (plain block only)", "info": "Optional. Paste full embed src from Google Maps ? Share ? Embed a map." },

    { "type": "header", "content": "Delivery checker: search" },
    { "type": "text", "id": "delivery_placeholder", "label": "Search placeholder", "default": "Enter your town or ZIP code" },
    { "type": "text", "id": "delivery_button", "label": "Check button label", "default": "Check my area" },
    { "type": "text", "id": "delivery_msg_yes", "label": "Found message", "default": "Yes, we deliver to {town}.", "info": "{town} is replaced with the town name." },
    { "type": "text", "id": "delivery_msg_yes_sub", "label": "Found message follow-up", "default": "Add your plan and confirm your address at checkout." },
    { "type": "text", "id": "delivery_msg_no", "label": "Not-found message", "default": "We do not deliver to \"{query}\" yet.", "info": "{query} is replaced with what the visitor typed." },
    { "type": "url", "id": "delivery_contact_url", "label": "Not-found link" },
    { "type": "text", "id": "delivery_contact_label", "label": "Not-found link label", "default": "Ask us about your area" },
    { "type": "text", "id": "delivery_lookup_row", "label": "Place-lookup suggestion row", "default": "Look up \"{query}\" on the map", "info": "{query} is replaced with what the visitor typed. Shown under the town list when the text is not a town you listed." },
    { "type": "text", "id": "delivery_lookup_loading", "label": "Place-lookup loading text", "default": "Looking up \"{query}\"�" },
    { "type": "text", "id": "delivery_msg_lookup_yes", "label": "Place lookup: inside zone", "default": "{place} sits inside our delivery zone.", "info": "{place} is the resolved place, {distance} the distance from your kitchen." },
    { "type": "text", "id": "delivery_msg_lookup_no", "label": "Place lookup: outside zone", "default": "{place} is about {distance} from our kitchen, outside the delivery zone." },
    { "type": "text", "id": "delivery_msg_lookup_fail", "label": "Place lookup: not found", "default": "We could not find \"{query}\". Try a town, a ZIP code or a nearby landmark." },
    { "type": "text", "id": "delivery_show_all", "label": "Show-all label", "default": "Show all" },
    { "type": "text", "id": "delivery_show_less", "label": "Show-less label", "default": "Show less" },
    { "type": "range", "id": "delivery_initial_chips", "label": "Towns shown before \"Show all\"", "min": 4, "max": 24, "step": 1, "default": 10 },

    { "type": "header", "content": "Delivery checker: map" },
    { "type": "textarea", "id": "delivery_towns", "label": "Delivery towns", "info": "One per line. Name|lat|lng|ZIP,ZIP for exact placement, or just Name|ZIP,ZIP to let the theme look the place up automatically. Leave empty for the built-in Hartland list." },
    { "type": "text", "id": "delivery_kitchen_lat", "label": "Kitchen latitude or place name", "default": "43.1051", "info": "Numbers place the pin exactly. A place name such as \"Hartland, Wisconsin\" is looked up automatically." },
    { "type": "text", "id": "delivery_kitchen_lng", "label": "Kitchen longitude", "default": "-88.3420", "info": "Ignored when the latitude field holds a place name." },
    { "type": "text", "id": "delivery_country", "label": "Country hint for place lookup", "info": "Optional, for example United States or United Kingdom. Narrows results when a town name is ambiguous." },
    { "type": "range", "id": "delivery_radius_km", "label": "Delivery zone radius (km)", "min": 0, "max": 80, "step": 1, "default": 0, "info": "0 fits the circle to the farthest town automatically." },
    { "type": "text", "id": "delivery_legend_kitchen", "label": "Legend: kitchen", "default": "Our kitchen" },
    { "type": "text", "id": "delivery_legend_areas", "label": "Legend: areas", "default": "Delivery areas" },
    { "type": "text", "id": "delivery_legend_zone", "label": "Legend: zone", "default": "Delivery zone" },
    { "type": "text", "id": "delivery_reset_label", "label": "Reset link label", "default": "Show full zone" },

    { "type": "header", "content": "Plate map" },
    { "type": "textarea", "id": "plate_towns", "label": "Delivery towns", "info": "One per line. Only the name is required: write \"Waukesha|53186\" and the place is looked up automatically. Add |left%|top%|lat|lng columns only for exact placement. Add the word kitchen as the fifth column on your base row. Leave empty for the built-in Hartland list." },
    { "type": "text", "id": "plate_areas_title", "label": "Town list title", "default": "We deliver to" },
    { "type": "range", "id": "plate_visible", "label": "Towns shown before \"show all\"", "min": 6, "max": 30, "step": 1, "default": 12 },
    { "type": "text", "id": "plate_more_label", "label": "Show-all label", "info": "Use {count} for the total.", "default": "Show all {count} areas" },
    { "type": "text", "id": "plate_less_label", "label": "Show-fewer label", "default": "Show fewer" },
    { "type": "text", "id": "plate_map_label", "label": "Map accessible label", "default": "Map of our delivery area" },
    { "type": "text", "id": "plate_kitchen_label", "label": "Kitchen label", "default": "Our kitchen" },
    { "type": "text", "id": "plate_kitchen_address", "label": "Kitchen address", "default": "Hartland, Wisconsin" },
    { "type": "url", "id": "plate_maps_url", "label": "\"Open in Maps\" link" },
    { "type": "text", "id": "plate_maps_label", "label": "Maps link label", "default": "Open in Maps" },
    { "type": "range", "id": "plate_zone_radius", "label": "Delivery zone size", "min": 22, "max": 34, "step": 1, "default": 22, "info": "The town list is fitted inside this ring, so the pins always stay within the zone. Bigger values zoom the map out." },
    { "type": "text", "id": "plate_legend_kitchen", "label": "Legend: kitchen", "default": "Our kitchen" },
    { "type": "text", "id": "plate_legend_area", "label": "Legend: area", "default": "Delivery areas" },
    { "type": "text", "id": "plate_legend_zone", "label": "Legend: zone", "default": "Delivery zone" },
    { "type": "text", "id": "plate_msg_yes", "label": "Message: we deliver", "info": "Use {area} for the matched town.", "default": "Good news, we deliver to {area}." },
