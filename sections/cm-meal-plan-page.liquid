{% render 'cm-section-assets', section: section %}
{{ 'section-cm-meal-plan-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cm-meal-plan-page.js' | asset_url }}" defer="defer"></script>
{%- if request.design_mode -%}
  <script src="{{ 'cm-meal-plan-editor.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- liquid
  assign meal_blocks = section.blocks | where: 'type', 'meal'
  assign benefit_blocks = section.blocks | where: 'type', 'benefit'
  assign step_blocks = section.blocks | where: 'type', 'step'
  assign quality_blocks = section.blocks | where: 'type', 'quality'
  assign menu_blocks = section.blocks | where: 'type', 'menu_item'
  assign review_blocks = section.blocks | where: 'type', 'review'
  assign faq_blocks = section.blocks | where: 'type', 'faq'
  assign related_blocks = section.blocks | where: 'type', 'related'
  assign hero_button_blocks = section.blocks | where: 'type', 'hero_button'
  # Clickable theme-editor regions — selecting one opens its settings sidebar
  # and highlights that block in the left panel (requires shopify_attributes).
  assign area_hero = section.blocks | where: 'type', 'area_hero' | first
  assign area_benefits = section.blocks | where: 'type', 'area_benefits' | first
  assign area_menu = section.blocks | where: 'type', 'area_menu' | first
  assign area_explore = section.blocks | where: 'type', 'area_explore' | first
  assign area_chef = section.blocks | where: 'type', 'area_chef' | first
  assign area_steps = section.blocks | where: 'type', 'area_steps' | first
  assign area_delivery = section.blocks | where: 'type', 'area_delivery' | first
  assign area_reviews = section.blocks | where: 'type', 'area_reviews' | first
  assign area_faq = section.blocks | where: 'type', 'area_faq' | first
  assign area_related = section.blocks | where: 'type', 'area_related' | first
  assign area_cta = section.blocks | where: 'type', 'area_cta' | first
  assign area_thali = section.blocks | where: 'type', 'area_thali' | first
  assign thali_card_blocks = section.blocks | where: 'type', 'thali_card'

  # ---------------------------------------------------------------
  # Content source
  #
  # The Meals product (or plan product) is the single source of truth for
  # the weekly menu. Its Meal variants feed BOTH the numbered list and the
  # order dropdowns. custom.* metafields hold the page copy. Theme editor
  # settings and menu_item blocks are fallbacks only when variants are absent.
  # ---------------------------------------------------------------
  assign plan_product = section.settings.content_product
  if plan_product == blank
    # All three settings are `product` pickers, so they already hold a product
    # object: `.metafields`, `.variants` and `.price` all work on them directly.
    # Do not wrap these in `all_products` - passing a product object to it
    # returns nil, which would blank the meals, the order box price and every
    # metafield on the page at once.
    assign plan_product = section.settings.plan_product
  endif
  if plan_product == blank
    assign plan_product = section.settings.meals_product
  endif
  assign plan_meta = plan_product.metafields.custom

  # ---------------------------------------------------------------
  # Order box: how many MEAL 1..N dropdowns the customer fills.
  #
  # Product admin (metafield) is the easy place for a merchant to change this.
  # Priority: custom.meal_slots → theme "Order dropdowns" → number in the
  # product title (e.g. "6 Meal Plan" → 6). Cap at 15.
  #
  # Theme Meal 1…N is default. King/YMQ can still inject while Draft, so only
  # opt-in (tag app-options / king-options or metafield) hands the box to the app.
  # ---------------------------------------------------------------
  assign use_app_options = false
  if plan_product != blank
    if plan_product.tags contains 'app-options' or plan_product.tags contains 'king-options'
      assign use_app_options = true
    endif
    if plan_meta.use_app_options.value == true or plan_meta.use_app_options.value == 'true'
      assign use_app_options = true
    endif
    if plan_meta.use_king_options.value == true or plan_meta.use_king_options.value == 'true'
      assign use_app_options = true
    endif
  endif
  assign use_king_options = use_app_options

  assign picker_count = 0
  if plan_meta.meal_slots.value != blank
    assign picker_count = plan_meta.meal_slots.value | plus: 0
  endif
  if picker_count <= 0
    assign picker_count = section.settings.picker_count | plus: 0
  endif
  if picker_count <= 0 and plan_product != blank
    assign title_lead = plan_product.title | split: ' ' | first | plus: 0
    if title_lead > 0 and title_lead <= 15
      assign picker_count = title_lead
    endif
  endif
  if picker_count > 30
    assign picker_count = 30
  endif
  assign show_order_box = false
  if picker_count > 0
    assign show_order_box = true
  endif
  assign meal_slot_label = plan_meta.meal_slot_label.value | default: 'Meal' | strip
  if meal_slot_label == blank
    assign meal_slot_label = 'Meal'
  endif

  # Shop-level shared content. FAQ, testimonials, steps and delivery areas are
  # the same on every plan, so they are entered once here and reused. A plan
  # that needs its own version fills the matching product metafield, which wins.
  assign shared_meta = shop.metafields.custom

  # Metaobject lists. A plan product can override any of these by filling the
  # same key on the product; the shop-level entry is the shared default. Keys
  # are deliberately distinct from the legacy text lists (benefits, faq,
  # reviews, related_plans, delivery_areas) so both can exist at once.
  assign mo_meals = plan_meta.meals.value | default: shared_meta.meals.value
  assign mo_stats = plan_meta.stats.value | default: shared_meta.stats.value
  assign mo_steps = plan_meta.how_it_works.value | default: shared_meta.how_it_works.value
  assign mo_faq = plan_meta.faq_items.value | default: shared_meta.faq_items.value
  assign mo_testimonials = plan_meta.testimonials.value | default: shared_meta.testimonials.value
  assign mo_plans = plan_meta.plan_cards.value | default: shared_meta.plan_cards.value
  assign mo_features = plan_meta.feature_cards.value | default: shared_meta.feature_cards.value
  assign mo_areas = plan_meta.delivery_area_list.value | default: shared_meta.delivery_area_list.value
  assign mo_stats_thali = plan_meta.thali_stat_items.value | default: shared_meta.thali_stat_items.value
  assign mo_facts = plan_meta.thali_fact_items.value | default: shared_meta.thali_fact_items.value

  # Copy: metafield → area block (theme editor click target) → section setting.
  assign area_hero_plan = ''
  assign area_hero_heading = ''
  assign area_hero_text = ''
  assign area_hero_fact_1_label = ''
  assign area_hero_fact_1_value = ''
  assign area_hero_fact_2_label = ''
  assign area_hero_fact_2_value = ''
  assign area_hero_fact_3_label = ''
  assign area_hero_fact_3_value = ''
  assign area_hero_button = ''
  assign area_hero_button_2 = ''
  assign area_hero_badge_value = ''
  assign area_hero_badge_label = ''
  if area_hero != blank
    assign area_hero_plan = area_hero.settings.plan_label
    assign area_hero_heading = area_hero.settings.heading
    assign area_hero_text = area_hero.settings.text
    assign area_hero_fact_1_label = area_hero.settings.fact_1_label
    assign area_hero_fact_1_value = area_hero.settings.fact_1_value
    assign area_hero_fact_2_label = area_hero.settings.fact_2_label
    assign area_hero_fact_2_value = area_hero.settings.fact_2_value
    assign area_hero_fact_3_label = area_hero.settings.fact_3_label
    assign area_hero_fact_3_value = area_hero.settings.fact_3_value
    assign area_hero_button = area_hero.settings.button_label
    assign area_hero_button_2 = area_hero.settings.button_label_2
    assign area_hero_badge_value = area_hero.settings.badge_value
    assign area_hero_badge_label = area_hero.settings.badge_label
  endif
  # In Customize, area block settings win so click-to-edit matches the preview.
  # On the live storefront, product metafields still win when present.
  if request.design_mode and area_hero != blank
    assign c_plan_label = area_hero_plan | default: plan_meta.plan_label.value | default: section.settings.plan_label
    assign c_heading = area_hero_heading | default: plan_meta.heading.value | default: section.settings.heading
    assign c_text = area_hero_text | default: plan_meta.subheading.value | default: section.settings.text
    assign c_fact_1_label = area_hero_fact_1_label | default: plan_meta.fact_1_label.value | default: section.settings.fact_1_label
    assign c_fact_1_value = area_hero_fact_1_value | default: plan_meta.fact_1_value.value | default: section.settings.fact_1_value
    assign c_fact_2_label = area_hero_fact_2_label | default: plan_meta.fact_2_label.value | default: section.settings.fact_2_label
    assign c_fact_2_value = area_hero_fact_2_value | default: plan_meta.fact_2_value.value | default: section.settings.fact_2_value
    assign c_fact_3_label = area_hero_fact_3_label | default: plan_meta.fact_3_label.value | default: section.settings.fact_3_label
    assign c_fact_3_value = area_hero_fact_3_value | default: plan_meta.fact_3_value.value | default: section.settings.fact_3_value
    assign c_button_label = area_hero_button | default: plan_meta.button_label.value | default: section.settings.button_label
    assign c_button_label_2 = area_hero_button_2 | default: plan_meta.button_label_2.value | default: section.settings.button_label_2
    assign c_badge_value = area_hero_badge_value | default: plan_meta.badge_value.value | default: section.settings.badge_value
    assign c_badge_label = area_hero_badge_label | default: plan_meta.badge_label.value | default: section.settings.badge_label
  else
    assign c_plan_label = plan_meta.plan_label.value | default: area_hero_plan | default: section.settings.plan_label
    assign c_heading = plan_meta.heading.value | default: area_hero_heading | default: section.settings.heading
    assign c_text = plan_meta.subheading.value | default: area_hero_text | default: section.settings.text
    assign c_fact_1_label = plan_meta.fact_1_label.value | default: area_hero_fact_1_label | default: section.settings.fact_1_label
    assign c_fact_1_value = plan_meta.fact_1_value.value | default: area_hero_fact_1_value | default: section.settings.fact_1_value
    assign c_fact_2_label = plan_meta.fact_2_label.value | default: area_hero_fact_2_label | default: section.settings.fact_2_label
    assign c_fact_2_value = plan_meta.fact_2_value.value | default: area_hero_fact_2_value | default: section.settings.fact_2_value
    assign c_fact_3_label = plan_meta.fact_3_label.value | default: area_hero_fact_3_label | default: section.settings.fact_3_label
    assign c_fact_3_value = plan_meta.fact_3_value.value | default: area_hero_fact_3_value | default: section.settings.fact_3_value
    assign c_button_label = plan_meta.button_label.value | default: area_hero_button | default: section.settings.button_label
    assign c_button_label_2 = plan_meta.button_label_2.value | default: area_hero_button_2 | default: section.settings.button_label_2
    assign c_badge_value = plan_meta.badge_value.value | default: area_hero_badge_value | default: section.settings.badge_value
    assign c_badge_label = plan_meta.badge_label.value | default: area_hero_badge_label | default: section.settings.badge_label
  endif

  assign area_ben_eyebrow = ''
  assign area_ben_line_1 = ''
  assign area_ben_line_2 = ''
  assign area_ben_line_3 = ''
  assign area_ben_note = ''
  if area_benefits != blank
    assign area_ben_eyebrow = area_benefits.settings.eyebrow
    assign area_ben_line_1 = area_benefits.settings.line_1
    assign area_ben_line_2 = area_benefits.settings.line_2
    assign area_ben_line_3 = area_benefits.settings.line_3
    assign area_ben_note = area_benefits.settings.note
  endif
  if request.design_mode and area_benefits != blank
    assign c_ben_eyebrow = area_ben_eyebrow | default: plan_meta.ben_eyebrow.value | default: shared_meta.ben_eyebrow.value | default: section.settings.ben_eyebrow
    assign c_ben_line_1 = area_ben_line_1 | default: plan_meta.ben_line_1.value | default: section.settings.ben_line_1
    assign c_ben_line_2 = area_ben_line_2 | default: plan_meta.ben_line_2.value | default: section.settings.ben_line_2
    assign c_ben_line_3 = area_ben_line_3 | default: plan_meta.ben_line_3.value | default: section.settings.ben_line_3
    assign c_ben_note = area_ben_note | default: plan_meta.ben_note.value | default: section.settings.ben_note
  else
    assign c_ben_eyebrow = plan_meta.ben_eyebrow.value | default: shared_meta.ben_eyebrow.value | default: area_ben_eyebrow | default: section.settings.ben_eyebrow
    assign c_ben_line_1 = plan_meta.ben_line_1.value | default: area_ben_line_1 | default: section.settings.ben_line_1
    assign c_ben_line_2 = plan_meta.ben_line_2.value | default: area_ben_line_2 | default: section.settings.ben_line_2
    assign c_ben_line_3 = plan_meta.ben_line_3.value | default: area_ben_line_3 | default: section.settings.ben_line_3
    assign c_ben_note = plan_meta.ben_note.value | default: area_ben_note | default: section.settings.ben_note
  endif

  assign area_menu_eyebrow = ''
  assign area_menu_heading = ''
  assign area_menu_text = ''
  assign area_menu_button = ''
  assign area_menu_order_title = ''
  if area_menu != blank
    assign area_menu_eyebrow = area_menu.settings.eyebrow
    assign area_menu_heading = area_menu.settings.heading
    assign area_menu_text = area_menu.settings.text
    assign area_menu_button = area_menu.settings.button
    assign area_menu_order_title = area_menu.settings.order_title
  endif
  if request.design_mode and area_menu != blank
    assign c_menu_eyebrow = area_menu_eyebrow | default: plan_meta.menu_eyebrow.value | default: shared_meta.menu_eyebrow.value | default: section.settings.menu_eyebrow
    assign c_menu_heading = area_menu_heading | default: plan_meta.menu_heading.value | default: shared_meta.menu_heading.value | default: section.settings.menu_heading
    assign c_menu_text = area_menu_text | default: plan_meta.menu_text.value | default: shared_meta.menu_text.value | default: section.settings.menu_text
    assign c_menu_button = area_menu_button | default: plan_meta.menu_button.value | default: section.settings.quality_button
  else
    assign c_menu_eyebrow = plan_meta.menu_eyebrow.value | default: shared_meta.menu_eyebrow.value | default: area_menu_eyebrow | default: section.settings.menu_eyebrow
    assign c_menu_heading = plan_meta.menu_heading.value | default: shared_meta.menu_heading.value | default: area_menu_heading | default: section.settings.menu_heading
    assign c_menu_text = plan_meta.menu_text.value | default: shared_meta.menu_text.value | default: area_menu_text | default: section.settings.menu_text
    assign c_menu_button = plan_meta.menu_button.value | default: area_menu_button | default: section.settings.quality_button
  endif
  assign area_explore_heading = ''
  if area_explore != blank
    assign area_explore_heading = area_explore.settings.heading
  endif
  if area_explore_heading != blank
    assign c_explore_heading = area_explore_heading
  elsif request.design_mode and area_explore != blank
    assign c_explore_heading = area_explore_heading | default: plan_meta.explore_heading.value | default: shared_meta.explore_heading.value | default: section.settings.explore_heading
  else
    assign c_explore_heading = plan_meta.explore_heading.value | default: shared_meta.explore_heading.value | default: area_explore_heading | default: section.settings.explore_heading
  endif
  assign c_detail_note = plan_meta.detail_note.value | default: section.settings.detail_note
  assign c_total_label = plan_meta.total_label.value | default: section.settings.total_label
  assign c_load_more_label = plan_meta.load_more_label.value | default: section.settings.load_more_label

  # Copy for the menu stage and the order form. These used to be hard-coded in
  # the markup, which left them uneditable from the product in Admin.
  assign c_menu_modal_heading = plan_meta.menu_modal_heading.value | default: "This Week's Menu"
  assign c_menu_caption = plan_meta.menu_caption.value | default: 'Fresh, ready to heat'
  assign c_picker_placeholder = plan_meta.picker_placeholder.value | default: 'Choose a meal'
  assign c_order_panel_title = plan_meta.order_panel_title.value | default: area_menu_order_title | default: section.settings.detail_title | strip

  assign area_chef_eyebrow = ''
  assign area_chef_heading = ''
  assign area_chef_text = ''
  if area_chef != blank
    assign area_chef_eyebrow = area_chef.settings.eyebrow
    assign area_chef_heading = area_chef.settings.heading
    assign area_chef_text = area_chef.settings.text
  endif
  if request.design_mode and area_chef != blank
    assign c_chef_eyebrow = area_chef_eyebrow | default: plan_meta.chef_eyebrow.value | default: shared_meta.chef_eyebrow.value | default: section.settings.chef_eyebrow
    assign c_chef_heading = area_chef_heading | default: plan_meta.chef_heading.value | default: shared_meta.chef_heading.value | default: section.settings.chef_heading
    assign c_chef_text = area_chef_text | default: plan_meta.chef_text.value | default: shared_meta.chef_text.value | default: section.settings.chef_text
  else
    assign c_chef_eyebrow = plan_meta.chef_eyebrow.value | default: shared_meta.chef_eyebrow.value | default: area_chef_eyebrow | default: section.settings.chef_eyebrow
    assign c_chef_heading = plan_meta.chef_heading.value | default: shared_meta.chef_heading.value | default: area_chef_heading | default: section.settings.chef_heading
    assign c_chef_text = plan_meta.chef_text.value | default: shared_meta.chef_text.value | default: area_chef_text | default: section.settings.chef_text
  endif
  assign area_steps_eyebrow = ''
  assign area_steps_heading = ''
  if area_steps != blank
    assign area_steps_eyebrow = area_steps.settings.eyebrow
    assign area_steps_heading = area_steps.settings.heading
  endif
  if request.design_mode and area_steps != blank
    assign c_steps_eyebrow = area_steps_eyebrow | default: plan_meta.steps_eyebrow.value | default: shared_meta.steps_eyebrow.value | default: section.settings.steps_eyebrow
    assign c_steps_heading = area_steps_heading | default: plan_meta.steps_heading.value | default: shared_meta.steps_heading.value | default: section.settings.steps_heading
  else
    assign c_steps_eyebrow = plan_meta.steps_eyebrow.value | default: shared_meta.steps_eyebrow.value | default: area_steps_eyebrow | default: section.settings.steps_eyebrow
    assign c_steps_heading = plan_meta.steps_heading.value | default: shared_meta.steps_heading.value | default: area_steps_heading | default: section.settings.steps_heading
  endif

  assign area_delivery_eyebrow = ''
  assign area_delivery_heading = ''
  assign area_delivery_text = ''
  if area_delivery != blank
    assign area_delivery_eyebrow = area_delivery.settings.eyebrow
    assign area_delivery_heading = area_delivery.settings.heading
    assign area_delivery_text = area_delivery.settings.text
  endif
  assign c_delivery_eyebrow = plan_meta.delivery_eyebrow.value | default: shared_meta.delivery_eyebrow.value | default: area_delivery_eyebrow | default: section.settings.delivery_eyebrow
  assign c_delivery_heading = plan_meta.delivery_heading.value | default: shared_meta.delivery_heading.value | default: area_delivery_heading | default: section.settings.delivery_heading
  assign c_delivery_text = plan_meta.delivery_text.value | default: shared_meta.delivery_text.value | default: area_delivery_text | default: section.settings.delivery_text
  assign c_delivery_areas = plan_meta.delivery_areas.value
  if c_delivery_areas == blank
    assign c_delivery_areas = section.settings.delivery_areas | split: ','
  endif
  assign c_delivery_map_query = plan_meta.delivery_map_query.value | default: section.settings.map_query
  assign c_delivery_map_title = plan_meta.delivery_map_title.value | default: section.settings.map_title

  assign area_reviews_eyebrow = ''
  assign area_reviews_heading = ''
  if area_reviews != blank
    assign area_reviews_eyebrow = area_reviews.settings.eyebrow
    assign area_reviews_heading = area_reviews.settings.heading
  endif
  assign c_reviews_eyebrow = plan_meta.reviews_eyebrow.value | default: shared_meta.reviews_eyebrow.value | default: area_reviews_eyebrow | default: section.settings.reviews_eyebrow
  assign c_reviews_heading = plan_meta.reviews_heading.value | default: shared_meta.reviews_heading.value | default: area_reviews_heading | default: section.settings.reviews_heading
  assign area_faq_eyebrow = ''
  assign area_faq_heading = ''
  if area_faq != blank
    assign area_faq_eyebrow = area_faq.settings.eyebrow
    assign area_faq_heading = area_faq.settings.heading
  endif
  assign c_faq_eyebrow = plan_meta.faq_eyebrow.value | default: shared_meta.faq_eyebrow.value | default: area_faq_eyebrow | default: section.settings.faq_eyebrow
  assign c_faq_heading = plan_meta.faq_heading.value | default: shared_meta.faq_heading.value | default: area_faq_heading | default: section.settings.faq_heading
  assign area_related_eyebrow = ''
  assign area_related_heading = ''
  if area_related != blank
    assign area_related_eyebrow = area_related.settings.eyebrow
    assign area_related_heading = area_related.settings.heading
  endif
  if request.design_mode and area_related != blank
    assign c_related_eyebrow = area_related_eyebrow | default: plan_meta.related_eyebrow.value | default: shared_meta.related_eyebrow.value | default: section.settings.related_eyebrow
    assign c_related_heading = area_related_heading | default: plan_meta.related_heading.value | default: shared_meta.related_heading.value | default: section.settings.related_heading
  else
    assign c_related_eyebrow = plan_meta.related_eyebrow.value | default: shared_meta.related_eyebrow.value | default: area_related_eyebrow | default: section.settings.related_eyebrow
    assign c_related_heading = plan_meta.related_heading.value | default: shared_meta.related_heading.value | default: area_related_heading | default: section.settings.related_heading
  endif

  assign area_cta_eyebrow = ''
  assign area_cta_heading = ''
  assign area_cta_text = ''
  assign area_cta_button = ''
  assign area_cta_link = ''
  if area_cta != blank
    assign area_cta_eyebrow = area_cta.settings.eyebrow
    assign area_cta_heading = area_cta.settings.heading
    assign area_cta_text = area_cta.settings.text
    assign area_cta_button = area_cta.settings.button_label
    assign area_cta_link = area_cta.settings.button_link
  endif
  assign c_cta_eyebrow = plan_meta.cta_eyebrow.value | default: shared_meta.cta_eyebrow.value | default: area_cta_eyebrow | default: section.settings.cta_eyebrow
  assign c_cta_heading = plan_meta.cta_heading.value | default: shared_meta.cta_heading.value | default: area_cta_heading | default: section.settings.cta_heading
  assign c_cta_text = plan_meta.cta_text.value | default: shared_meta.cta_text.value | default: area_cta_text | default: section.settings.cta_text
  assign c_cta_button_label = plan_meta.cta_button_label.value | default: area_cta_button | default: section.settings.cta_button_label
  assign c_cta_button_link = plan_meta.cta_button_link.value | default: area_cta_link | default: section.settings.cta_button_link

  # Hero photos and their alt text. A file_reference metafield and an
  # image_picker setting both support image_url, so either source renders the
  # same tag. Blank keeps the bundled photo the script swaps in by index.
  assign c_hero_image_1 = plan_meta.hero_image_1.value | default: shared_meta.hero_image_1.value | default: section.settings.hero_image_1
  assign c_hero_image_2 = plan_meta.hero_image_2.value | default: shared_meta.hero_image_2.value | default: section.settings.hero_image_2
  assign c_hero_image_1_alt = plan_meta.hero_image_1_alt.value | default: section.settings.hero_image_1_alt
  assign c_hero_image_2_alt = plan_meta.hero_image_2_alt.value | default: section.settings.hero_image_2_alt

  # Copy inside the meal gallery and the small labels on the page. These were
  # the last strings a merchant could not reach from the product in Admin.
  assign c_gallery_eyebrow = plan_meta.gallery_eyebrow.value | default: shared_meta.gallery_eyebrow.value | default: section.settings.gallery_eyebrow
  assign c_gallery_heading = plan_meta.gallery_heading.value | default: shared_meta.gallery_heading.value | default: section.settings.gallery_heading
  assign c_calories_label = plan_meta.calories_label.value | default: 'calories'

  # Quality-points block. It sat after Section 1 in the markup and still read
  # the theme editor directly, so its eyebrow could not be changed from the
  # product like every other section heading. Resolved the same way now.
  assign c_quality_eyebrow = plan_meta.quality_eyebrow.value | default: shared_meta.quality_eyebrow.value | default: section.settings.quality_eyebrow

  # Accessibility-only labels. These are never seen on screen, but a screen
  # reader announces them, so they belong to the same content model: edit the
  # product, not the theme. Defaults are byte-identical to the old literals.
  assign c_filter_label = plan_meta.filter_meals_label.value | default: 'Filter meals'
  assign c_gallery_prev_label = plan_meta.gallery_prev_label.value | default: 'Previous'
  assign c_gallery_next_label = plan_meta.gallery_next_label.value | default: 'Next'

  # Repeatable rows. A metaobject list wins, then the plan product's metafield
  # list, then the shop shared list, then the theme editor blocks. The row
  # renderer walks them in that order, so a store can migrate one section at a time.
  assign row_benefits = mo_stats
  assign row_steps = mo_steps
  assign row_faq = mo_faq
  assign row_reviews = mo_testimonials
  assign row_related = mo_plans
  assign row_quality = plan_meta.quality_points.value

  # Legacy metafield lists, kept so a store already filled in keeps working.
  assign legacy_benefits = plan_meta.benefits.value | default: shared_meta.benefits.value
  assign legacy_steps = plan_meta.steps.value | default: shared_meta.steps.value
  assign legacy_faq = plan_meta.faq.value | default: shared_meta.faq.value
  assign legacy_reviews = plan_meta.reviews.value | default: shared_meta.reviews.value
  assign legacy_related = plan_meta.related_plans.value | default: shared_meta.related_plans.value

  # Meals: one product catalog drives every preview (numbered list, dropdowns,
  # slides, modal). Prefer the Meals product picker; fall back to the plan
  # product. Theme menu_item blocks are only used when this catalog has no
  # real variants — so editing the product updates both preview sections.
  assign meals_catalog = section.settings.meals_product
  if meals_catalog == blank
  assign meals_catalog = plan_product
  endif
  assign variant_menu = false
  if meals_catalog != blank and meals_catalog.variants.size > 0
    for variant in meals_catalog.variants
      unless variant.title == 'Default Title'
        assign variant_menu = true
        break
      endunless
    endfor
  endif

  # Prices are in cents so they format with the store currency.
  # meal_base_cents = cheapest meal — used to show "+$2" on pricier options.
  assign any_price = false
  assign meal_base_cents = 0
  if variant_menu
    for variant in meals_catalog.variants
      unless variant.title == 'Default Title'
      if variant.price > 0
        assign any_price = true
          if meal_base_cents == 0 or variant.price < meal_base_cents
            assign meal_base_cents = variant.price
      endif
        endif
      endunless
    endfor
  endif
  assign plan_price = section.settings.meal_price | default: 0
  if plan_price > 0
    assign any_price = true
  endif
  for block in menu_blocks
    assign block_price = block.settings.price | default: 0
    if block_price > 0
      assign any_price = true
      break
    endif
  endfor

  assign first_meal_label = menu_blocks.first.settings.short | default: menu_blocks.first.settings.name
-%}
{%- if variant_menu -%}
  {%- for variant in meals_catalog.variants -%}
    {%- unless variant.title == 'Default Title' -%}
      {%- capture first_meal_label -%}{% render 'cm-meal-option-label', variant: variant, base_cents: meal_base_cents %}{%- endcapture -%}
      {%- assign first_meal_label = first_meal_label | strip -%}
      {%- break -%}
    {%- endunless -%}
  {%- endfor -%}
{%- endif -%}

{%- capture foods_json -%}
[
{%- for i in (0..9) -%}
  {%- assign key = 'mp-food-' | append: i | append: '.jpg' -%}
  "{{ key | asset_url }}"{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]
{%- endcapture -%}

{%- capture alts_json -%}
[
{%- if variant_menu -%}
  {%- for variant in meals_catalog.variants -%}
    {%- unless variant.title == 'Default Title' -%}
      {{ variant.title | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endunless -%}
  {%- endfor -%}
{%- else -%}
  {%- for block in meal_blocks -%}
    {{ block.settings.name | json }}{%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
{%- endif -%}
]
{%- endcapture -%}

{%- comment -%}
  Meals come from the plan product's variants (each with its own variant
  metafields for nutrition, ingredients and photos). Meal blocks remain the
  fallback for pages where the product has no per-meal variants yet.
{%- endcomment -%}
{%- capture meals_json -%}
{%- render 'cm-plan-meals', plan: meals_catalog, meals: mo_meals, blocks: meal_blocks, food_count: 10 -%}
{%- endcapture -%}

{%- comment -%}
  Repeatable copy. Each capture holds rows separated by "~~~", each row a
  "|"-separated list, so one markup path renders every source. A blank capture
  splits into a single empty string, so each list is reset to empty here.

  `items` is the metaobject list and wins; `meta` is the legacy pipe-delimited
  product metafield; `blocks` is the theme editor. The renderer walks them in
  that order, so a store can migrate one section at a time.
{%- endcomment -%}
{%- capture rows_benefits -%}
{%- render 'cm-plan-rows', kind: 'benefit', items: row_benefits, meta: legacy_benefits, blocks: benefit_blocks -%}
{%- endcapture -%}
{%- assign benefit_rows = '' -%}
{%- if rows_benefits != blank -%}{%- assign benefit_rows = rows_benefits | split: '~~~' -%}{%- endif -%}

{%- capture rows_steps -%}
{%- render 'cm-plan-rows', kind: 'step', items: row_steps, meta: legacy_steps, blocks: step_blocks -%}
{%- endcapture -%}
{%- assign step_rows = '' -%}
{%- if rows_steps != blank -%}{%- assign step_rows = rows_steps | split: '~~~' -%}{%- endif -%}

{%- capture rows_faq -%}
{%- render 'cm-plan-rows', kind: 'faq', items: row_faq, meta: legacy_faq, blocks: faq_blocks -%}
{%- endcapture -%}
{%- assign faq_rows = '' -%}
{%- if rows_faq != blank -%}{%- assign faq_rows = rows_faq | split: '~~~' -%}{%- endif -%}

{%- capture rows_reviews -%}
{%- render 'cm-plan-rows', kind: 'review', items: row_reviews, meta: legacy_reviews, blocks: review_blocks -%}
{%- endcapture -%}
{%- assign review_rows = '' -%}
{%- if rows_reviews != blank -%}{%- assign review_rows = rows_reviews | split: '~~~' -%}{%- endif -%}

{%- capture rows_related -%}
{%- render 'cm-plan-rows', kind: 'related', items: row_related, meta: legacy_related, blocks: related_blocks, exclude_product: plan_product -%}
{%- endcapture -%}
{%- assign related_rows = '' -%}
{%- if rows_related != blank -%}{%- assign related_rows = rows_related | split: '~~~' -%}{%- endif -%}

{%- capture rows_quality -%}
{%- render 'cm-plan-rows', kind: 'quality', meta: row_quality, blocks: quality_blocks -%}
{%- endcapture -%}
{%- assign quality_rows = '' -%}
{%- if rows_quality != blank -%}{%- assign quality_rows = rows_quality | split: '~~~' -%}{%- endif -%}

<main
  class="mealplan-page"
  data-mp-page
  data-cm="meal-plan-page"
  data-mp-menu-count="{{ section.settings.menu_count | default: 5 }}"
  data-mp-grid-page="{{ section.settings.grid_page_size | default: 6 }}"
  data-mp-view-label="{{ section.settings.view_meal_label | default: 'View meal' | escape }}"
  data-mp-all-label="{{ section.settings.filter_all_label | default: 'All' | escape }}"
  data-mp-allergen-label="{{ section.settings.allergen_label | default: 'Contains' | escape }}"
  data-mp-reheat-label="{{ section.settings.reheat_label | default: 'Heating' | escape }}"
  data-mp-protein-label="{{ section.settings.protein_label | default: 'Protein' | escape }}"
  data-mp-carbs-label="{{ section.settings.carbs_label | default: 'Carbs' | escape }}"
  data-mp-fat-label="{{ section.settings.fat_label | default: 'Fat' | escape }}"
  data-mp-diet-gluten-label="{{ plan_meta.diet_gluten_label.value | default: 'Gluten free' | escape }}"
  data-mp-diet-dairy-label="{{ plan_meta.diet_dairy_label.value | default: 'Dairy free' | escape }}"
>
  <script type="application/json" data-mp-foods>{{ foods_json }}</script>
  <script type="application/json" data-mp-alts>{{ alts_json }}</script>
  <script type="application/json" data-mp-meals>{{ meals_json }}</script>

  {%- if menu_blocks.size > 0 or variant_menu -%}
    <div class="mealplan">
      <section class="mealplan-sec mealplan-menu" id="mealplan-menu-{{ section.id }}">
        <div class="mealplan-wrap mealplan-menu__inner">
          {%- comment -%}
            Header row: heading and tagline left, eyebrow pill centred on the
            section, plan price right. One row, vertically centred together.
          {%- endcomment -%}
          <div class="mealplan-menu__top">
          {%- if show_order_box -%}
            {%- liquid
              # The cart charges the variant's own price, so a $0 variant makes
              # the whole plan free. Prefer the selected variant, then the first
              # available one, then the first variant that actually has a price.
              assign plan_variant = plan_product.selected_or_first_available_variant
              if plan_variant == blank or plan_variant.price == 0
                for variant in plan_product.variants
                  if variant.available and variant.price > 0
                    assign plan_variant = variant
                    break
                  endif
                endfor
              endif
              if plan_variant == blank
                assign plan_variant = plan_product.variants.first
              endif
            -%}
            {%- liquid
              # Product-style header in the top right: the plan title and price
              # sit above the order card, the way a product page shows them.
              assign detail_title = c_order_panel_title
              if detail_title == blank
                assign detail_title = plan_product.title
              endif
              assign detail_price = 0
              assign detail_compare = 0
              # King / options-app mode: theme must NOT paint product-variant
              # prices ($17 Biryani, meal sums, …). The app owns displayed price.
              unless use_app_options
                if plan_variant != blank
                  assign detail_price = plan_variant.price
                  assign detail_compare = plan_variant.compare_at_price | default: 0
                endif
                # Cart adds each chosen meal as its own line, so the plan total is
                # the SUM of meal prices — never one meal price × slot count.
                if section.settings.detail_use_plan_total and picker_count > 0
                  assign detail_price = 0
                  assign detail_compare = 0
                  assign detail_meals_counted = 0
                  assign price_source = meals_catalog
                  if price_source == blank
                    assign price_source = plan_product
                  endif
                  if price_source != blank
                    for variant in price_source.variants
                      if detail_meals_counted >= picker_count
                        break
                      endif
                      unless variant.title == 'Default Title'
                        if variant.price > 0
                          assign detail_price = detail_price | plus: variant.price
                          assign v_compare = variant.compare_at_price | default: 0
                          assign detail_compare = detail_compare | plus: v_compare
                          assign detail_meals_counted = detail_meals_counted | plus: 1
                        endif
                      endunless
                    endfor
                  endif
                  if detail_meals_counted == 0 and plan_variant != blank
                    assign detail_price = plan_variant.price | times: picker_count
                    assign detail_compare = plan_variant.compare_at_price | default: 0 | times: picker_count
                  endif
                endif
              endunless
              assign detail_on_sale = false
              if detail_compare > detail_price and detail_price > 0
                assign detail_on_sale = true
              endif
            -%}
            {%- if detail_title != blank or detail_price > 0 -%}
              <div class="mealplan-menu__buy" data-mp-buy-price{% if use_app_options %} data-mp-buy-app="1"{% endif %}>
                {%- if detail_title != blank -%}
                  <h3 class="mealplan-menu__buy-title">{{ detail_title | escape }}</h3>
                {%- endif -%}
                {%- if detail_price > 0 -%}
                  <div class="mealplan-menu__buy-price">
                    {%- if detail_on_sale -%}
                      <s class="mealplan-menu__buy-was" data-mp-buy-was>{{ detail_compare | money }}</s>
                    {%- endif -%}
                    <span class="mealplan-menu__buy-now" data-mp-buy-now data-mp-money="{{ 0 | money | escape }}" data-mp-base-cents="{{ detail_price }}">{{ detail_price | money }}</span>
                    {%- if detail_on_sale -%}
                      <span class="mealplan-menu__buy-save">{{ section.settings.detail_sale_label | default: 'Sale' | escape }}</span>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endif -%}
          {%- comment -%}
            Eyebrow pill: a direct child of the header row, so it can centre
            between the heading block and the plan price.
          {%- endcomment -%}
          {%- if c_menu_eyebrow != blank -%}
            <p class="mp-eye">{{ c_menu_eyebrow | escape }}</p>
          {%- endif -%}
          <div class="mealplan-menu__head">
            {%- if show_order_box -%}
              <h4 class="mealplan-h">
                <button type="button" class="mealplan-menu__title" data-mp-poster>{{ c_menu_heading | escape }}</button>
              </h4>
            {%- else -%}
              <h4 class="mealplan-h">{{ c_menu_heading | escape }}</h4>
            {%- endif -%}
            {%- if c_menu_text != blank -%}
              <p class="mealplan-menu__sub">{{ c_menu_text | escape }}</p>
            {%- endif -%}
          </div>
          </div>
          <div class="mealplan-menu__stage">
            <div class="mealplan-menu__frame is-all mp-float-frame" data-mp-frame role="button" tabindex="0" aria-label="Open meal gallery">
              <div class="mealplan-menu__slide is-active" data-mp-all>
                <img src="{{ '10-meal-together.png' | asset_url }}" alt="This week's menu with all meals" width="800" height="860" fetchpriority="high">
              </div>
              {%- if variant_menu -%}
                {%- for variant in meals_catalog.variants -%}
                  {%- unless variant.title == 'Default Title' -%}
                    <div class="mealplan-menu__slide" data-mp-slide>
                      <img src="{% if variant.image != blank %}{{ variant.image | image_url: width: 800 }}{% else %}{{ 'mp-food-' | append: forloop.index0 | append: '.jpg' | asset_url }}{% endif %}" alt="{{ variant.title | escape }}" width="800" height="860"{% unless forloop.first %} loading="lazy"{% endunless %}>
                    </div>
                  {%- endunless -%}
                {%- endfor -%}
              {%- else -%}
                {%- for block in menu_blocks -%}
                  <div class="mealplan-menu__slide" data-mp-slide>
                    <img src="{{ 'mp-food-' | append: forloop.index0 | append: '.jpg' | asset_url }}" alt="{{ block.settings.short | default: block.settings.name | escape }}" width="800" height="860"{% unless forloop.first %} loading="lazy"{% endunless %}>
                  </div>
                {%- endfor -%}
              {%- endif -%}
              {%- if show_order_box -%}
                <div class="mealplan-menu__sheet" data-mp-sheet hidden>
                  <img src="{{ '10-meal-together.png' | asset_url }}" alt="This week's menu with all 10 meals" width="800" height="1400">
                </div>
              {%- endif -%}
              <div class="mealplan-menu__caption" aria-hidden="true">
                <span class="mealplan-menu__count" data-mp-count>1</span>
                <span class="mealplan-menu__caption-text">
                  <span class="mealplan-menu__caption-name" data-mp-caption>{{ first_meal_label | escape }}</span>
                  <span class="mealplan-menu__caption-sub">{{ c_menu_caption | escape }}</span>
                </span>
              </div>
            </div>
          </div>
          <ol class="mealplan-menu__list" role="tablist">
            {%- if variant_menu -%}
              {%- for variant in meals_catalog.variants -%}
                {%- unless variant.title == 'Default Title' -%}
                  {%- capture meal_label -%}{% render 'cm-meal-option-label', variant: variant, base_cents: meal_base_cents %}{%- endcapture -%}
                  <li>
                    <button type="button" class="mealplan-menu__item" role="tab" aria-selected="false" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}" data-mp-item data-mp-variant="{{ variant.id }}">
                      <span class="mealplan-menu__num">{{ forloop.index }}</span>
                      <span class="mealplan-menu__name">{{ meal_label | strip | escape }}</span>
                    </button>
                  </li>
                {%- endunless -%}
              {%- endfor -%}
            {%- else -%}
              {%- for block in menu_blocks -%}
                <li {{ block.shopify_attributes }}>
                  <button type="button" class="mealplan-menu__item" role="tab" aria-selected="false" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}" data-mp-item>
                    <span class="mealplan-menu__num">{{ forloop.index }}</span>
                    <span class="mealplan-menu__name">{{ block.settings.short | default: block.settings.name | escape }}</span>
                  </button>
                </li>
              {%- endfor -%}
            {%- endif -%}
          </ol>
          <div class="mealplan-menu__detail">
            {%- if show_order_box -%}
              <form
                class="mealplan-menu__order product-form{% unless use_app_options %} mealplan-menu__order--theme-lock{% endunless %}"
                data-mp-order
                {% if use_app_options %}data-mp-allow-app="1"{% else %}data-mp-theme-lock="1"{% endif %}
                data-mp-plan="{{ plan_product.title | default: 'Meal plan' | escape }}"
                data-product-id="{{ plan_product.id }}"
                action="{{ routes.cart_add_url }}"
                method="post"
              >
                <input type="hidden" name="id" value="{{ plan_variant.id }}">
                {%- comment -%}
                  Theme Meal 1…N always render. King/YMQ Draft still injects on
                  storefront — without app-options tag, JS hides the app UI and
                  keeps these fields. Tag the product app-options to use King.
                {%- endcomment -%}
                {%- for slot in (1..picker_count) -%}
                  <label class="mealplan-menu__field">
                    <span>{{ meal_slot_label | escape }} {{ slot }}</span>
                    <select name="properties[{{ meal_slot_label | escape }} {{ slot }}]" data-mp-pick required>
                      <option value="" selected>{{ c_picker_placeholder | escape }}</option>
                      {%- if variant_menu -%}
                        {%- for variant in meals_catalog.variants -%}
                          {%- unless variant.title == 'Default Title' -%}
                            {%- capture opt_label -%}{% render 'cm-meal-option-label', variant: variant, base_cents: meal_base_cents %}{%- endcapture -%}
                            <option value="{{ variant.title | escape }}"{% if variant.price > 0 %} data-price="{{ variant.price | money | escape }}" data-price-cents="{{ variant.price }}"{% endif %} data-variant-id="{{ variant.id }}">{{ opt_label | strip | escape }}</option>
                          {%- endunless -%}
                        {%- endfor -%}
                      {%- else -%}
                        {%- for block in menu_blocks -%}
                          {%- liquid
                            assign meal_variant = blank
                            assign meal_source = block.settings.product | default: section.settings.meals_product
                            if meal_source != blank
                              for variant in meal_source.variants
                                if variant.title == block.settings.name
                                  assign meal_variant = variant
                                  break
                                endif
                              endfor
                              if meal_variant == blank and block.settings.product != blank
                                assign meal_variant = block.settings.product.selected_or_first_available_variant
                              endif
                            endif
                            assign opt_price = 0
                            if meal_variant != blank
                              assign opt_price = meal_variant.price
                            endif
                            if opt_price <= 0
                              assign opt_price = block.settings.price | default: 0
                            endif
                            if opt_price <= 0
                              assign opt_price = section.settings.meal_price
                            endif
                          -%}
                          <option value="{{ block.settings.name | escape }}"{% if opt_price > 0 %} data-price="{{ opt_price | money | escape }}" data-price-cents="{{ opt_price }}"{% endif %}{% if meal_variant != blank %} data-variant-id="{{ meal_variant.id }}"{% endif %}>{{ block.settings.name | escape }}</option>
                        {%- endfor -%}
                      {%- endif -%}
                    </select>
                  </label>
                {%- endfor -%}
                <p class="mealplan-menu__order-msg" data-mp-order-msg hidden></p>
                {%- if any_price and picker_count > 0 -%}
                  <div class="mealplan-menu__sum">
                    <span class="mealplan-menu__sum-label">{{ c_total_label | default: 'Plan total' | escape }}</span>
                    <span class="mealplan-menu__sum-value" data-mp-sum data-mp-money="{{ 0 | money | escape }}">{{ 0 | money }}</span>
                  </div>
                {%- endif -%}
                <button type="submit" class="mealplan-menu__cta"{% if section.settings.meals_product == blank and plan_variant != blank and plan_variant.available == false %} disabled{% endif %}>
                  <span>{{ c_menu_button | default: 'Order' | escape }}</span>
                  <svg class="mealplan-menu__cta-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </button>
              </form>
            {%- else -%}
              <ol class="mealplan-menu__full">
                {%- if variant_menu -%}
                  {%- for variant in meals_catalog.variants -%}
                    {%- unless variant.title == 'Default Title' -%}
                      {%- capture row_label -%}{% render 'cm-meal-option-label', variant: variant, base_cents: meal_base_cents %}{%- endcapture -%}
                      <li data-mp-row{% if forloop.first %} class="is-active"{% endif %} data-mp-variant="{{ variant.id }}">{{ row_label | strip | escape }}</li>
                    {%- endunless -%}
                  {%- endfor -%}
                {%- else -%}
                {%- for block in menu_blocks -%}
                  <li data-mp-row{% if forloop.first %} class="is-active"{% endif %}>{{ block.settings.name | escape }}</li>
                {%- endfor -%}
                {%- endif -%}
              </ol>
              <button type="button" class="mealplan-menu__cta" data-mp-open aria-haspopup="dialog">{{ c_menu_button | default: 'See all plans' | escape }}</button>
            {%- endif -%}
          </div>
        </div>
        {%- if show_order_box -%}
          <div class="mealplan-menu__cursor" data-mp-cursor hidden>
            <img src="{{ '10-meal-together.png' | asset_url }}" alt="" width="80" height="80">
          </div>
        {%- endif -%}
        <div class="mealplan-menu__gallery" data-mp-gallery hidden role="dialog" aria-modal="true" aria-label="Meal gallery">
          <button type="button" class="mealplan-menu__gallery-close" data-mp-gallery-close aria-label="Close">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
          </button>
          <button type="button" class="mealplan-menu__gallery-nav mealplan-menu__gallery-nav--prev" data-mp-gallery-prev aria-label="Previous meal">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
          </button>
          <figure class="mealplan-menu__gallery-figure">
            <span class="mealplan-menu__gallery-shot">
              <img data-mp-gallery-img alt="" width="900" height="900">
            </span>
            <figcaption class="mealplan-menu__gallery-caption">
              <span data-mp-gallery-count></span>
              <strong data-mp-gallery-name></strong>
            </figcaption>
          </figure>
          <button type="button" class="mealplan-menu__gallery-nav mealplan-menu__gallery-nav--next" data-mp-gallery-next aria-label="Next meal">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
          </button>
        </div>
        <div class="mealplan-menu__modal" data-mp-modal role="dialog" aria-modal="true" aria-label="This week's menu" hidden>
          <div class="mealplan-menu__modal-backdrop" data-mp-close></div>
          <div class="mealplan-menu__modal-box">
            <header class="mealplan-menu__modal-head">
              <h3>{{ c_menu_modal_heading | escape }}</h3>
              <button type="button" class="mealplan-menu__modal-close" data-mp-close aria-label="Close">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
              </button>
            </header>
            <div class="mealplan-menu__modal-scroll">
              <ul class="mealplan-menu__cards">
                {%- if variant_menu -%}
                  {%- for variant in meals_catalog.variants -%}
                    {%- unless variant.title == 'Default Title' -%}
                      {%- capture dish -%}{% render 'cm-meal-option-label', variant: variant, base_cents: meal_base_cents %}{%- endcapture -%}
                      {%- assign dish = dish | strip -%}
                      {%- assign bits = dish | split: ' with ' -%}
                      <li class="mealplan-menu__card">
                        <div class="mealplan-menu__card-photo">
                          <span class="mealplan-menu__card-num">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
                          <img src="{% if variant.image != blank %}{{ variant.image | image_url: width: 320 }}{% else %}{{ 'mp-food-' | append: forloop.index0 | append: '.jpg' | asset_url }}{% endif %}" alt="{{ dish | escape }}" width="320" height="320" loading="lazy">
                        </div>
                        <h4>{{ bits | first | escape }}</h4>
                        {%- if bits.size > 1 -%}
                          <p>with {{ bits | last | escape }}</p>
                        {%- endif -%}
                      </li>
                    {%- endunless -%}
                  {%- endfor -%}
                {%- endif -%}
                {%- unless variant_menu -%}
                {%- for block in menu_blocks -%}
                  {%- assign full = block.settings.name | default: block.settings.short -%}
                  {%- assign bits = full | split: ' with ' -%}
                  {%- assign dish = bits | first -%}
                  <li class="mealplan-menu__card">
                    <div class="mealplan-menu__card-photo">
                      <span class="mealplan-menu__card-num">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
                      <img src="{{ 'mp-food-' | append: forloop.index0 | append: '.jpg' | asset_url }}" alt="{{ dish | escape }}" width="320" height="320" loading="lazy">
                    </div>
                    <h4>{{ dish | escape }}</h4>
                    {%- if bits.size > 1 -%}
                      <p>with {{ bits | last | escape }}</p>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
                {%- endunless -%}
              </ul>
            </div>
          </div>
        </div>
      </section>
    </div>
  {%- endif -%}

  {%- liquid
    # Show hero when enabled, or always in the theme editor when an area_hero
    # block exists so merchants can click it to open its settings.
    assign show_hero_band = section.settings.show_hero
    if request.design_mode and area_hero != blank
      assign show_hero_band = true
    endif
  -%}
  {%- if show_hero_band -%}
  <section class="mph" {% render 'cm-area-attrs', section: section, type: 'area_hero' %}>
    <div class="mph__inner">
      <div class="mph__copy">
        {%- if c_plan_label != blank -%}
          <p class="mph__plan">{{ c_plan_label | escape }}</p>
        {%- endif -%}
        {%- if c_heading != blank -%}
          <h1 class="mph__title">{{ c_heading | escape | newline_to_br }}</h1>
        {%- endif -%}
        {%- if c_text != blank -%}
          <p class="mph__text">{{ c_text | escape }}</p>
        {%- endif -%}
        <dl class="mph__facts">
          {%- if c_fact_1_label != blank -%}
            <div><dt>{{ c_fact_1_label | escape }}</dt><dd>{{ c_fact_1_value | escape }}</dd></div>
          {%- endif -%}
          {%- if c_fact_2_label != blank -%}
            <div><dt>{{ c_fact_2_label | escape }}</dt><dd>{{ c_fact_2_value | escape }}</dd></div>
          {%- endif -%}
          {%- if c_fact_3_label != blank -%}
            <div><dt>{{ c_fact_3_label | escape }}</dt><dd>{{ c_fact_3_value | escape }}</dd></div>
          {%- endif -%}
        </dl>
        <div class="mph__actions">
          {%- if hero_button_blocks.size > 0 -%}
            {%- for block in hero_button_blocks -%}
              {%- if block.settings.label != blank -%}
                {%- liquid
                  assign mph_btn_link = block.settings.link | default: '#menu'
                  assign mph_btn_style = block.settings.style | default: 'light'
                -%}
                <span class="mph__btn-wrap" {{ block.shopify_attributes }}>
                  {% render 'pm-button', label: block.settings.label, link: mph_btn_link, style: mph_btn_style, text_color: block.settings.text_color, bg_color: block.settings.bg_color, icon_bg: block.settings.icon_bg, icon_color: block.settings.icon_color, font_size: block.settings.font_size, hover_text_color: block.settings.hover_text_color, hover_bg_color: block.settings.hover_bg_color %}
                </span>
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
          {%- if c_button_label != blank -%}
            {%- assign mph_link = section.settings.button_link | default: '#menu' -%}
              {% render 'pm-button', label: c_button_label, link: mph_link, style: 'light', text_color: section.settings.button_text_color, bg_color: section.settings.button_bg_color, icon_bg: section.settings.button_icon_bg, icon_color: section.settings.button_icon_color, font_size: section.settings.button_font_size, hover_text_color: section.settings.button_hover_text_color, hover_bg_color: section.settings.button_hover_bg_color %}
          {%- endif -%}
          {%- if c_button_label_2 != blank -%}
            {%- assign mph_link_2 = section.settings.button_link_2 | default: '#menu' -%}
              {% render 'pm-button', label: c_button_label_2, link: mph_link_2, style: 'brand', text_color: section.settings.button_text_color_2, bg_color: section.settings.button_bg_color_2, icon_bg: section.settings.button_icon_bg_2, icon_color: section.settings.button_icon_color_2, font_size: section.settings.button_font_size_2, hover_text_color: section.settings.button_hover_text_color_2, hover_bg_color: section.settings.button_hover_bg_color_2 %}
            {%- endif -%}
          {%- endif -%}
        </div>
      </div>
      <div class="mph__visual mp-reveal">
        <div class="mph__main mp-float" role="img" aria-label="{{ c_hero_image_1_alt | escape }}">
          {%- if c_hero_image_1 != blank -%}
            {{ c_hero_image_1 | image_url: width: 900 | image_tag: class: 'mp-food', loading: 'eager', widths: '400, 700, 900', sizes: '(min-width: 990px) 40vw, 80vw', alt: c_hero_image_1_alt }}
          {%- else -%}
            <img class="mp-food" data-f="5" alt="{{ c_hero_image_1_alt | escape }}" width="700" height="700" fetchpriority="high">
          {%- endif -%}
        </div>
        <div class="mph__second mp-float mp-float--late" role="img" aria-label="{{ c_hero_image_2_alt | escape }}">
          {%- if c_hero_image_2 != blank -%}
            {{ c_hero_image_2 | image_url: width: 700 | image_tag: class: 'mp-food', loading: 'lazy', widths: '300, 500, 700', sizes: '30vw', alt: c_hero_image_2_alt }}
          {%- else -%}
            <img class="mp-food" data-f="6" alt="{{ c_hero_image_2_alt | escape }}" width="700" height="700">
          {%- endif -%}
        </div>
        <div class="mph__badge mp-badge-bob"><strong>{{ c_badge_value | escape }}</strong><span>{{ c_badge_label | escape }}</span></div>
      </div>
    </div>
  </section>
  {%- endif -%}

  <div class="mealplan-a">
    <section class="ben" {% render 'cm-area-attrs', section: section, type: 'area_benefits' %}>
      <div class="ben__glow" aria-hidden="true"></div>
      {%- liquid
        # Theme Editor Benefit blocks win whenever present so merchants can
        # edit chips without clearing product metafields. Metafield/stat rows
        # are the fallback when no Benefit blocks exist.
        assign use_benefit_blocks = false
        if benefit_blocks.size > 0
          assign use_benefit_blocks = true
        endif
      -%}
      {%- if benefit_rows.size > 0 or use_benefit_blocks -%}
        <div class="ben__marquee">
          <div class="ben__track">
            {%- for pass in (1..4) -%}
              <ul class="ben__group"{% if pass > 1 %} aria-hidden="true"{% endif %}>
                {%- if use_benefit_blocks -%}
                  {%- for block in benefit_blocks -%}
                    <li class="ben__item"{% if pass == 1 %} {{ block.shopify_attributes }}{% endif %}{% render 'pm-area-style', block: block %}>
                      <b>{{ block.settings.title | escape }}</b>
                      <span>{{ block.settings.text | escape }}</span>
                    </li>
                  {%- endfor -%}
                {%- else -%}
                {%- for row in benefit_rows -%}
                  {%- assign cells = row | split: '|' -%}
                  <li class="ben__item">
                    <b>{{ cells[0] | escape }}</b>
                    <span>{{ cells[1] | escape }}</span>
                  </li>
                {%- endfor -%}
                {%- endif -%}
              </ul>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
      <div class="ben__inner">
        {%- if c_ben_eyebrow != blank -%}
          <p class="mp-eye ben__eyebrow">{{ c_ben_eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="big">
          <span>{{ c_ben_line_1 | escape }}</span>
          <span>{{ c_ben_line_2 | escape }}</span>
          <span class="out">{{ c_ben_line_3 | escape }}</span>
        </h2>
        {%- if c_ben_note != blank -%}
          <p class="ben__note">{{ c_ben_note | escape }}</p>
        {%- endif -%}
      </div>
    </section>

    <div class="mp-editor-area" {% render 'cm-area-attrs', section: section, type: 'area_menu' %}>
      <section class="mealplan-menu-grid">
        <div class="wrap">
      <div class="menu-head">
        <h2>{{ c_menu_heading | escape }}</h2>
        <p>{{ c_menu_text | escape }}</p>
      </div>
      <div class="mg" id="menu"></div>
        </div>
      </section>

    <section id="detail"><div class="wrap dt-grid dt">
      <div class="dt-img" id="dImg"></div>
      <div>
        <h2 id="dName"></h2>
        <p id="dDesc"></p>
        <ul class="ing" id="dIng"></ul>
        <div class="nut">
            <div class="ring" id="ring"><div><span id="dCal"></span><small>{{ c_calories_label | escape }}</small></div></div>
          <div class="bars" id="bars"></div>
        </div>
        <div class="mp-detail-notes">
          <div class="mp-detail-note" id="dAllergens" hidden></div>
          <div class="mp-detail-note" id="dReheat" hidden></div>
        </div>
        <p class="note">{{ c_detail_note | escape }}</p>
      </div>
    </div></section>
    </div>

    {%- if section.settings.thali_show or request.design_mode and area_thali != blank -%}
      <div class="mp-editor-area"{% for block in section.blocks %}{% if block.type == 'area_thali' %} {{ block.shopify_attributes }}{% break %}{% endif %}{% endfor %}>
      {{ 'section-cm-thali-story.css' | asset_url | stylesheet_tag }}
        {% render 'cm-thali-story',
          section: section,
          s: section.settings,
          meta: plan_meta,
          features: mo_features,
          stats: mo_stats_thali,
          facts: mo_facts,
          shared: shared_meta,
          area: area_thali,
          card_blocks: thali_card_blocks
        %}
      </div>
    {%- endif -%}

    <section class="ex" {% render 'cm-area-attrs', section: section, type: 'area_explore' %}><div class="wrap">
      <h2>{{ c_explore_heading | escape }}</h2>
      <div class="filters" id="filters" role="group" aria-label="{{ c_filter_label | escape }}"></div>
      <div class="eg" id="grid"></div>
      <div class="more"><button type="button" class="btn" id="more">{{ c_load_more_label | escape }}</button></div>
    </div></section>
  </div>

  <div class="mealplan">
    <section class="mealplan-sec" {% render 'cm-area-attrs', section: section, type: 'area_chef' %}><div class="mealplan-wrap mealplan-chef">
      {%- liquid
        # Chef photos used to be bundled assets picked by index, so they could
        # not be changed from Admin. An image set on the product (or the section)
        # renders here; otherwise the original bundled photo still fills in via
        # the data-p hook the script reads.
        assign chef_image_1 = plan_meta.chef_image_1.value | default: shared_meta.chef_image_1.value | default: section.settings.chef_image_1
        assign chef_image_2 = plan_meta.chef_image_2.value | default: shared_meta.chef_image_2.value | default: section.settings.chef_image_2
      -%}
      <div class="mealplan-img mealplan-big mp-gs mp-reveal mp-float"{% unless chef_image_1 != blank %} data-p="0"{% endunless %}>
        {%- if chef_image_1 != blank -%}
          {{ chef_image_1 | image_url: width: 900 | image_tag: class: 'mp-food mealplan-ph', loading: 'lazy', widths: '400, 700, 900', sizes: '(min-width: 750px) 55vw, 90vw', alt: c_chef_heading }}
        {%- endif -%}
      </div>
      <div class="mealplan-txt mp-gs mp-reveal">
        {%- if c_chef_eyebrow != blank -%}
          <p class="mp-eye">{{ c_chef_eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="mealplan-h">{{ c_chef_heading | escape | newline_to_br }}</h2>
        <p class="mealplan-p">{{ c_chef_text | escape }}</p>
      </div>
      <div class="mealplan-img mealplan-small mp-gs mp-reveal mp-float mp-float--late"{% unless chef_image_2 != blank %} data-p="1"{% endunless %}>
        {%- if chef_image_2 != blank -%}
          {{ chef_image_2 | image_url: width: 700 | image_tag: class: 'mp-food mealplan-ph', loading: 'lazy', widths: '300, 500, 700', sizes: '30vw', alt: c_chef_eyebrow }}
        {%- endif -%}
      </div>
    </div></section>

    <section class="mealplan-sec mealplan-steps" {% render 'cm-area-attrs', section: section, type: 'area_steps' %}><div class="mealplan-wrap">
      {%- if c_steps_eyebrow != blank -%}
        <p class="mp-eye">{{ c_steps_eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="mealplan-h">{{ c_steps_heading | escape }}</h2>
      <ol class="mealplan-list">
        {%- if step_blocks.size > 0 -%}
          {%- for block in step_blocks -%}
            {%- assign step_extra = '--i:' | append: forloop.index0 | append: ';' -%}
            <li class="mp-gs" {{ block.shopify_attributes }}{% render 'pm-area-style', block: block, extra: step_extra %}>
              <span class="mealplan-num">{{ forloop.index }}</span>
              <h3>{{ block.settings.title | escape }}</h3>
              <p>{{ block.settings.text | escape }}</p>
            </li>
          {%- endfor -%}
        {%- else -%}
        {%- for row in step_rows -%}
          {%- assign cells = row | split: '|' -%}
          <li class="mp-gs" style="--i:{{ forloop.index0 }}">
            <span class="mealplan-num">{{ forloop.index }}</span>
            <h3>{{ cells[0] | escape }}</h3>
            <p>{{ cells[1] | escape }}</p>
          </li>
        {%- endfor -%}
        {%- endif -%}
      </ol>
    </div></section>

    {%- if section.settings.show_quality_band and menu_blocks.size == 0 -%}
      <section class="mealplan-sec"><div class="mealplan-wrap mealplan-q">
        <div class="mealplan-img mp-gs" id="qImg" data-p="2" aria-live="polite"></div>
        <div class="mp-gs mealplan-q__copy">
          {%- if c_quality_eyebrow != blank -%}
            <p class="mp-eye">{{ c_quality_eyebrow | escape }}</p>
          {%- endif -%}
          <h2 class="mealplan-h">{{ c_menu_heading | escape }}</h2>
          <div class="mealplan-q__split">
            <ul class="mealplan-terms" id="qTerms">
              {%- for row in quality_rows -%}
                {%- assign cells = row | split: '|' -%}
                <li data-detail="{{ cells[2] | default: cells[1] | escape }}">
                  <b>{{ cells[0] | escape }}</b>
                  <span>{{ cells[1] | escape }}</span>
                </li>
              {%- endfor -%}
            </ul>
            <aside class="mealplan-q__detail" id="qDetail">
              <div class="mealplan-q__note"><b></b><p></p></div>
            </aside>
          </div>
        </div>
      </div></section>
    {%- endif -%}

    {%- if section.settings.show_gallery -%}
    <section class="mealplan-sec" style="padding-inline:0"><div>
      <div class="mealplan-gal-h mealplan-wrap" style="padding-inline:clamp(1.25rem,4vw,4rem)">
        <div>
          {%- if c_gallery_eyebrow != blank -%}
            <p class="mp-eye">{{ c_gallery_eyebrow | escape }}</p>
          {%- endif -%}
          <h2 class="mealplan-h">{{ c_gallery_heading | escape | newline_to_br }}</h2>
        </div>
        <div class="mealplan-arrows">
          <button type="button" aria-label="{{ c_gallery_prev_label | escape }}" data-g="-1">&larr;</button>
          <button type="button" aria-label="{{ c_gallery_next_label | escape }}" data-g="1">&rarr;</button>
        </div>
      </div>
      <div class="mealplan-track" id="gal"></div>
    </div></section>
    {%- endif -%}

    <section class="mealplan-sec" {% render 'cm-area-attrs', section: section, type: 'area_delivery' %}><div class="mealplan-wrap">
      {%- if section.settings.delivery_style == 'plate' -%}
        {% render 'cm-delivery-area', section: section, meta: plan_meta, areas: mo_areas, shared: shared_meta %}
      {%- elsif section.settings.delivery_checker -%}
        {% render 'cm-delivery-checker', section: section, meta: plan_meta, shared: shared_meta, areas: mo_areas %}
      {%- else -%}
        <div class="mealplan-del">
          {%- liquid
            assign map_query = c_delivery_map_query | default: 'Hartland Wisconsin'
            assign map_src = section.settings.map_embed_url
            if map_src == blank
              assign map_q = map_query | url_encode
              assign map_src = 'https://maps.google.com/maps?q=' | append: map_q | append: '&z=15&output=embed'
            endif
          -%}
          <div class="mealplan-map mp-gs">
            <iframe
              class="mealplan-map__frame"
              title="{{ c_delivery_map_title | default: map_query | escape }}"
              src="{{ map_src }}"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
            ></iframe>
            {%- if c_delivery_map_title != blank -%}
              <p class="mealplan-map__label">{{ c_delivery_map_title | escape }}</p>
            {%- endif -%}
          </div>
          <div class="mealplan-del__copy mp-gs">
            {%- if c_delivery_eyebrow != blank -%}
              <p class="mp-eye">{{ c_delivery_eyebrow | escape }}</p>
            {%- endif -%}
            <h2 class="mealplan-h">{{ c_delivery_heading | escape }}</h2>
            <p class="mealplan-p">{{ c_delivery_text | escape }}</p>
            <div class="mealplan-del__actions">
              {%- if c_delivery_areas.size > 0 -%}
                <ul class="mealplan-areas">
                  {%- for area in c_delivery_areas -%}
                    <li>
                      <span class="mealplan-areas__pin" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M12 2C8.1 2 5 5.1 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7zm0 9.5c-1.4 0-2.5-1.1-2.5-2.5S10.6 6.5 12 6.5s2.5 1.1 2.5 2.5S13.4 11.5 12 11.5z"/></svg>
                      </span>
                      {{ area | strip | escape }}
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
              {%- if section.settings.delivery_button_label != blank -%}
                {%- assign delivery_link = section.settings.delivery_button_link | default: '#' -%}
                {% render 'pm-button', label: section.settings.delivery_button_label, link: delivery_link, style: 'brand', text_color: section.settings.delivery_button_text_color, bg_color: section.settings.delivery_button_bg_color, icon_bg: section.settings.delivery_button_icon_bg, icon_color: section.settings.delivery_button_icon_color, font_size: section.settings.delivery_button_font_size, hover_text_color: section.settings.delivery_button_hover_text_color, hover_bg_color: section.settings.delivery_button_hover_bg_color %}
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endif -%}
    </div></section>

    <section class="mealplan-sec mealplan-rev" {% render 'cm-area-attrs', section: section, type: 'area_reviews' %}><div class="mealplan-wrap">
      {%- if c_reviews_eyebrow != blank -%}
        <p class="mp-eye">{{ c_reviews_eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="mealplan-h">{{ c_reviews_heading | escape }}</h2>
      <div class="mealplan-cols" id="rev">
        {%- if review_blocks.size > 0 -%}
          {%- for block in review_blocks -%}
            {%- liquid
              assign review_name = block.settings.name
              assign review_rating = block.settings.rating | default: 5 | plus: 0
              assign review_text = block.settings.review
              assign review_aspect = block.settings.aspect | default: '1'
              assign review_show = '0'
              if block.settings.show_image
                assign review_show = '1'
              endif
              assign review_image = ''
              if block.settings.image != blank
                assign review_image = block.settings.image | image_url: width: 700
              endif
              assign fallback_index = forloop.index0 | modulo: 10
            -%}
            <article class="mealplan-r {% if review_show == '0' %}mealplan-r--text{% endif %} mp-gs" {{ block.shopify_attributes }}{% render 'pm-area-style', block: block %}>
              {%- if review_show != '0' -%}
                <div class="mealplan-img" style="--ar:{{ review_aspect }}">
                  {%- if review_image != blank -%}
                    <img class="mp-food mealplan-ph" src="{{ review_image }}" alt="{{ review_name | escape }}" width="700" height="700" loading="lazy">
                  {%- else -%}
                    <img class="mp-food mealplan-ph" src="{{ 'mp-food-' | append: fallback_index | append: '.jpg' | asset_url }}" alt="{{ review_name | escape }}" width="700" height="700" loading="lazy">
                  {%- endif -%}
                </div>
              {%- endif -%}
              <div>
                <span class="mealplan-stars" aria-label="{{ review_rating }} stars">{%- for i in (1..5) -%}{% if i <= review_rating %}★{% else %}☆{% endif %}{%- endfor -%}</span>
                <q>{{ review_text | escape }}</q>
                <small>{{ review_name | escape }}</small>
              </div>
            </article>
          {%- endfor -%}
        {%- else -%}
        {%- for row in review_rows -%}
          {%- liquid
            assign cells = row | split: '|'
            assign review_name = cells[0]
              assign review_rating = cells[1] | default: 5 | plus: 0
            assign review_text = cells[2]
            assign review_aspect = cells[3] | default: '1'
            assign review_show = cells[4] | default: '1'
            assign review_image = cells[5]
            assign fallback_index = forloop.index0 | modulo: 10
          -%}
          <article class="mealplan-r {% if review_show == '0' %}mealplan-r--text{% endif %} mp-gs">
            {%- if review_show != '0' -%}
              <div class="mealplan-img" style="--ar:{{ review_aspect }}">
                {%- if review_image != blank -%}
                  <img class="mp-food mealplan-ph" src="{{ review_image }}" alt="{{ review_name | escape }}" width="700" height="700" loading="lazy">
                {%- else -%}
                  <img class="mp-food mealplan-ph" src="{{ 'mp-food-' | append: fallback_index | append: '.jpg' | asset_url }}" alt="{{ review_name | escape }}" width="700" height="700" loading="lazy">
                {%- endif -%}
              </div>
            {%- endif -%}
            <div>
                <span class="mealplan-stars" aria-label="{{ review_rating }} stars">{%- for i in (1..5) -%}{% if i <= review_rating %}★{% else %}☆{% endif %}{%- endfor -%}</span>
              <q>{{ review_text | escape }}</q>
              <small>{{ review_name | escape }}</small>
            </div>
          </article>
        {%- endfor -%}
        {%- endif -%}
      </div>
    </div></section>

    <section class="mealplan-sec" {% render 'cm-area-attrs', section: section, type: 'area_faq' %}><div class="mealplan-wrap mealplan-faq">
      <div>
        {%- if c_faq_eyebrow != blank -%}
          <p class="mp-eye">{{ c_faq_eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="mealplan-h">{{ c_faq_heading | escape }}</h2>
      </div>
      <div id="faq">
        {%- if faq_blocks.size > 0 -%}
          {%- for block in faq_blocks -%}
            <div class="mealplan-qi" {{ block.shopify_attributes }}{% render 'pm-area-style', block: block %}>
              <button type="button" class="mealplan-qb" aria-expanded="false" aria-controls="mp-a-{{ section.id }}-{{ forloop.index }}">
                {{ block.settings.question | escape }}<i></i>
              </button>
              <div class="mealplan-qa" id="mp-a-{{ section.id }}-{{ forloop.index }}"><div><p>{{ block.settings.answer | escape }}</p></div></div>
            </div>
          {%- endfor -%}
        {%- else -%}
        {%- for row in faq_rows -%}
          {%- assign cells = row | split: '|' -%}
          <div class="mealplan-qi">
            <button type="button" class="mealplan-qb" aria-expanded="false" aria-controls="mp-a-{{ section.id }}-{{ forloop.index }}">
              {{ cells[0] | escape }}<i></i>
            </button>
            <div class="mealplan-qa" id="mp-a-{{ section.id }}-{{ forloop.index }}"><div><p>{{ cells[1] | escape }}</p></div></div>
          </div>
        {%- endfor -%}
        {%- endif -%}
      </div>
    </div></section>

    <section class="mealplan-sec mealplan-rel" {% render 'cm-area-attrs', section: section, type: 'area_related' %}><div class="mealplan-wrap">
      <div class="mealplan-rel__head" style="margin-bottom:60px">
        {%- if c_related_eyebrow != blank -%}
          <p class="mp-eye">{{ c_related_eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="mealplan-h">{{ c_related_heading | escape }}</h2>
      </div>
      <div class="mealplan-track" id="plans">
        {%- for row in related_rows -%}
          {%- liquid
            assign cells = row | split: '|'
            assign related_title = cells[0]
            assign related_text = cells[1]
            assign related_url = cells[2]
            assign related_button = cells[3] | default: 'View plan'
            assign related_note = cells[4]
            assign related_image = cells[5]
            assign fallback_index = forloop.index | modulo: 10
          -%}
          <article class="mealplan-card">
            <div class="mealplan-img">
              {%- if related_image != blank -%}
                <img class="mp-food mealplan-ph" src="{{ related_image }}" alt="{{ related_title | escape }}" width="700" height="700" loading="lazy">
              {%- else -%}
                <img class="mp-food mealplan-ph" src="{{ 'mp-food-' | append: fallback_index | append: '.jpg' | asset_url }}" alt="{{ related_title | escape }}" width="700" height="700" loading="lazy">
              {%- endif -%}
            </div>
            <h3>{{ related_title | escape }}</h3>
            <p>{{ related_text | escape }}</p>
            {%- if related_note != blank -%}<b>{{ related_note | escape }}</b>{%- endif -%}
            <a class="mealplan-btn" href="{{ related_url | default: '#' }}">{{ related_button | escape }}</a>
          </article>
        {%- endfor -%}
      </div>
    </div></section>

    <section class="mealplan-sec" {% render 'cm-area-attrs', section: section, type: 'area_cta' %}><div class="mealplan-wrap"><div class="mealplan-cta">
      {%- liquid
        assign cta_image = plan_meta.cta_image.value | default: shared_meta.cta_image.value | default: section.settings.cta_image
        if area_cta != blank and area_cta.settings.image != blank
          assign cta_image = area_cta.settings.image
        endif
      -%}
      <div class="mealplan-img mp-reveal mp-ken"{% unless cta_image != blank %} data-p="3"{% endunless %}>
        {%- if cta_image != blank -%}
          {{ cta_image | image_url: width: 1400 | image_tag: class: 'mp-food mealplan-ph', loading: 'lazy', widths: '600, 900, 1400', sizes: '(min-width: 750px) 70vw, 92vw', alt: c_cta_heading }}
        {%- endif -%}
      </div>
      <div class="mealplan-cta-in">
        {%- if c_cta_eyebrow != blank -%}
          <p class="mp-eye mp-eye--dark">{{ c_cta_eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="mealplan-h">{{ c_cta_heading | escape }}</h2>
        <p class="mealplan-p">{{ c_cta_text | escape }}</p>
        {%- if c_cta_button_label != blank -%}
          {%- liquid
            assign cta_btn_link = c_cta_button_link | default: '#'
            assign cta_text_color = section.settings.cta_button_text_color
            assign cta_bg_color = section.settings.cta_button_bg_color
            assign cta_icon_bg = section.settings.cta_button_icon_bg
            assign cta_icon_color = section.settings.cta_button_icon_color
            assign cta_font_size = section.settings.cta_button_font_size
            assign cta_hover_text = section.settings.cta_button_hover_text_color
            assign cta_hover_bg = section.settings.cta_button_hover_bg_color
            if area_cta != blank
              if area_cta.settings.button_text_color != blank
                assign cta_text_color = area_cta.settings.button_text_color
              endif
              if area_cta.settings.button_bg_color != blank
                assign cta_bg_color = area_cta.settings.button_bg_color
              endif
              if area_cta.settings.button_icon_bg != blank
                assign cta_icon_bg = area_cta.settings.button_icon_bg
              endif
              if area_cta.settings.button_icon_color != blank
                assign cta_icon_color = area_cta.settings.button_icon_color
              endif
              if area_cta.settings.button_font_size != blank
                assign cta_font_size = area_cta.settings.button_font_size
              endif
              if area_cta.settings.button_hover_text_color != blank
                assign cta_hover_text = area_cta.settings.button_hover_text_color
              endif
              if area_cta.settings.button_hover_bg_color != blank
                assign cta_hover_bg = area_cta.settings.button_hover_bg_color
              endif
            endif
          -%}
          {% render 'pm-button', label: c_cta_button_label, link: cta_btn_link, style: 'brand', text_color: cta_text_color, bg_color: cta_bg_color, icon_bg: cta_icon_bg, icon_color: cta_icon_color, font_size: cta_font_size, hover_text_color: cta_hover_text, hover_bg_color: cta_hover_bg %}
        {%- endif -%}
      </div>
    </div></div></section>

  </div>
</main>

{% schema %}
{
  "name": "CM meal plan page",
  "tag": "section",
  "class": "section cm-section",
  "settings": [
    { "type": "header", "content": "Easy edit" },
    { "type": "paragraph", "content": "Prefer the separate MP * sections — they can be placed anywhere." },
    { "type": "paragraph", "content": "Prefer the separate MP * sections — they can be placed anywhere. This mega section still works; on the left, open CM meal plan page and click a folder (Hero, Benefits, …) or click that band in the preview." },
    { "type": "checkbox", "id": "show_hero", "label": "Show hero", "default": true },
    { "type": "product", "id": "content_product", "label": "Plan product", "info": "Meals come from this product's variants; page copy can also come from its metafields." },
    { "type": "checkbox", "id": "detail_show_allergens", "label": "Show allergens on the meal detail", "default": true },

    { "type": "header", "content": "Hero fallbacks" },
    { "type": "paragraph", "content": "Used only when the Hero folder fields are empty. Prefer editing the Hero folder on the left." },
    { "type": "text", "id": "plan_label", "label": "Plan label", "default": "5 Meal Plan" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Chef-prepared meals.\\nMade for your week." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Calorie counted. High protein. Low oil. Pick five meals from this week's menu and we cook and deliver them." },
    { "type": "text", "id": "fact_1_label", "label": "Fact 1 label", "default": "Price" },
    { "type": "text", "id": "fact_1_value", "label": "Fact 1 value", "default": "From $00.00" },
    { "type": "text", "id": "fact_2_label", "label": "Fact 2 label", "default": "Meals" },
    { "type": "text", "id": "fact_2_value", "label": "Fact 2 value", "default": "5 per week" },
    { "type": "text", "id": "fact_3_label", "label": "Fact 3 label", "default": "Menu" },
    { "type": "text", "id": "fact_3_value", "label": "Fact 3 value", "default": "10+ options" },
    { "type": "text", "id": "button_label", "label": "Primary button", "default": "Build my 5 meals" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "header", "content": "Button style" },
    { "type": "color", "id": "button_text_color", "label": "Text color" },
    { "type": "color", "id": "button_bg_color", "label": "Background color" }, { "type": "color", "id": "button_hover_text_color", "label": "Hover text color", "info": "Clear to keep the style preset hover." }, { "type": "color", "id": "button_hover_bg_color", "label": "Hover background color", "info": "Clear to keep the style preset hover." },
    { "type": "color", "id": "button_icon_bg", "label": "Icon background" },
    { "type": "color", "id": "button_icon_color", "label": "Icon color" },
    { "type": "range", "id": "button_font_size", "min": 12, "max": 24, "step": 1, "unit": "px", "label": "Font size", "default": 16 },
    { "type": "text", "id": "button_label_2", "label": "Secondary button", "default": "View this week's menu" },
    { "type": "url", "id": "button_link_2", "label": "Secondary button link" },
    { "type": "header", "content": "Button 2 style" },
    { "type": "color", "id": "button_text_color_2", "label": "Text color" },
    { "type": "color", "id": "button_bg_color_2", "label": "Background color" }, { "type": "color", "id": "button_hover_text_color_2", "label": "Hover text color", "info": "Clear to keep the style preset hover." }, { "type": "color", "id": "button_hover_bg_color_2", "label": "Hover background color", "info": "Clear to keep the style preset hover." },
    { "type": "color", "id": "button_icon_bg_2", "label": "Icon background" },
    { "type": "color", "id": "button_icon_color_2", "label": "Icon color" },
    { "type": "range", "id": "button_font_size_2", "min": 12, "max": 24, "step": 1, "unit": "px", "label": "Font size", "default": 16 },
    { "type": "image_picker", "id": "hero_image_1", "label": "Hero image (main)" },
    { "type": "text", "id": "hero_image_1_alt", "label": "Hero image 1 alt", "default": "Chimichurri Steak" },
    { "type": "image_picker", "id": "hero_image_2", "label": "Hero image (secondary)" },
    { "type": "text", "id": "hero_image_2_alt", "label": "Hero image 2 alt", "default": "Orange Basil Salmon" },
    { "type": "text", "id": "badge_value", "label": "Badge value", "default": "10+" },
    { "type": "text", "id": "badge_label", "label": "Badge label", "default": "meal options" },
                { "type": "header", "content": "Band background" },
        { "type": "paragraph", "content": "Color, gradient, and/or image. Leave blank for theme default." },
        { "type": "color", "id": "background_color", "label": "Color" },
        { "type": "color_background", "id": "background_gradient", "label": "Gradient" },
        { "type": "image_picker", "id": "background_image", "label": "Image" },
        { "type": "header", "content": "Image layout" },
        { "type": "select", "id": "background_image_fit", "label": "Size", "options": [
          { "value": "cover", "label": "Cover" },
          { "value": "contain", "label": "Contain" },
          { "value": "auto", "label": "Original" }
        ], "default": "cover" },
        { "type": "select", "id": "background_image_position", "label": "Position", "options": [
          { "value": "center", "label": "Center" },
          { "value": "top", "label": "Top" },
          { "value": "bottom", "label": "Bottom" },
          { "value": "left", "label": "Left" },
          { "value": "right", "label": "Right" }
        ], "default": "center" },
        { "type": "select", "id": "background_repeat", "label": "Repeat", "options": [
          { "value": "no-repeat", "label": "No repeat" },
          { "value": "repeat", "label": "Repeat" },
          { "value": "repeat-x", "label": "Repeat X" },
          { "value": "repeat-y", "label": "Repeat Y" }
        ], "default": "no-repeat" },
        { "type": "select", "id": "background_attachment", "label": "Scroll", "options": [
          { "value": "scroll", "label": "Scroll with page" },
          { "value": "fixed", "label": "Fixed (parallax)" }
        ], "default": "scroll" },
        { "type": "header", "content": "Overlay" },
        { "type": "color", "id": "background_overlay_color", "label": "Color", "default": "#000000" },
        { "type": "range", "id": "background_overlay_opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "label": "Strength", "default": 0 },
        { "type": "header", "content": "Advanced background" },
        { "type": "select", "id": "background_blend_mode", "label": "Blend mode", "options": [
          { "value": "normal", "label": "Normal" },
          { "value": "multiply", "label": "Multiply" },
          { "value": "screen", "label": "Screen" },
          { "value": "overlay", "label": "Overlay" },
          { "value": "soft-light", "label": "Soft light" },
          { "value": "darken", "label": "Darken" },
          { "value": "lighten", "label": "Lighten" }
        ], "default": "normal" },
        { "type": "range", "id": "background_border_radius", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Corner radius", "default": 0 },
        { "type": "range", "id": "background_min_height", "min": 0, "max": 800, "step": 10, "unit": "px", "label": "Min height", "default": 0, "info": "0 = auto" },
        { "type": "header", "content": "Text colors" },
        { "type": "color", "id": "eyebrow_color", "label": "Eyebrow color" },
        { "type": "color", "id": "heading_color", "label": "Heading color" },
        { "type": "color", "id": "text_color", "label": "Text color" }, { "type": "color", "id": "text_hover_color", "label": "Hover text color", "info": "Clear to keep default." },
        { "type": "range", "id": "eyebrow_size", "min": 10, "max": 28, "step": 1, "unit": "px", "label": "Eyebrow size", "default": 14 },
        { "type": "range", "id": "heading_size", "min": 18, "max": 80, "step": 1, "unit": "px", "label": "Heading size", "default": 40 },
        { "type": "range", "id": "text_size", "min": 12, "max": 28, "step": 1, "unit": "px", "label": "Text size", "default": 16 },
        { "type": "select", "id": "heading_weight", "label": "Heading weight", "options": [
          { "value": "", "label": "Theme default" },
          { "value": "400", "label": "Regular" },
          { "value": "500", "label": "Medium" },
          { "value": "600", "label": "Semi-bold" },
          { "value": "700", "label": "Bold" },
          { "value": "800", "label": "Extra-bold" }
        ], "default": "" },
        { "type": "select", "id": "text_align", "label": "Text align", "options": [
          { "value": "", "label": "Theme default" },
          { "value": "left", "label": "Left" },
          { "value": "center", "label": "Center" },
          { "value": "right", "label": "Right" }
        ], "default": "" },

    { "type": "header", "content": "Benefits" },
    { "type": "text", "id": "ben_eyebrow", "label": "Eyebrow", "default": "Hartland's #1 meal prep chef" },
    { "type": "text", "id": "ben_line_1", "label": "Line 1", "default": "5 meals." },
    { "type": "text", "id": "ben_line_2", "label": "Line 2", "default": "1 week." },
    { "type": "text", "id": "ben_line_3", "label": "Line 3 (outline)", "default": "Zero stress." },
    { "type": "textarea", "id": "ben_note", "label": "Note", "default": "Flexible menu: choose any five from 10+ options, and change your picks each week." },

    { "type": "header", "content": "Menu" },
    { "type": "text", "id": "menu_eyebrow", "label": "Menu eyebrow", "default": "This week at ChefMatts" },
    { "type": "text", "id": "menu_heading", "label": "Menu heading", "default": "Pick your flavor" },
    { "type": "textarea", "id": "menu_text", "label": "Menu text", "default": "Featured meals from the weekly rotation. Hover or tap a meal for the details." },
    { "type": "text", "id": "explore_heading", "label": "Explore heading", "default": "À la carte" },

    { "type": "header", "content": "Ghar Ka Khana story" },
    { "type": "checkbox", "id": "thali_show", "label": "Show the Ghar Ka Khana panel", "default": false, "info": "Sits above À la carte. Its text is now read from the plan product's custom.thali_* metafields first, and falls back to the fields here." },
    { "type": "text", "id": "thali_badge", "label": "Badge", "default": "Ghar Ka Khana � Delivered Across the GTA" },
    { "type": "text", "id": "thali_heading", "label": "Heading", "default": "GTA's Best Thalis, Delivered to Your Door" },
    { "type": "textarea", "id": "thali_intro", "label": "Intro", "default": "Fresh Indian homestyle meals made with traditional spices, proper tadka, handmade rotis, and delivered to your door." },
    { "type": "textarea", "id": "thali_stats", "label": "Stats", "info": "One per line as value|label. Example: 5?|Star reviews", "default": "5?|Star reviews\n30|Years of experience\n32oz|Generous portions" },
    { "type": "text", "id": "thali_plate_alt", "label": "Plate image alt text", "default": "A thali with two curries, rice and two rotis" },
    { "type": "image_picker", "id": "thali_image", "label": "Plate photo", "info": "Optional. Blank uses the bundled four-items-plate.webp cut-out. Transparent PNG reads best." },
    { "type": "textarea", "id": "thali_chips", "label": "Plate labels", "info": "One per line. Use exactly four — top-left, top-right, bottom-left, bottom-right.", "default": "Chef-cooked weekly\nNever frozen\n2-3 min to heat\nCalorie counted" },
    { "type": "textarea", "id": "thali_cards", "label": "Cards", "info": "One per line as title|text.", "default": "Crafted by expert chefs|Every thali is prepared fresh by our team of Indian cooks, led by Head Chef Rahul. They bring years of experience and traditional methods to every meal, so you can enjoy the flavours, spices and quality you expect from home.\nHandmade roti|Our signature rotis are all rolled by hand, just like your mom would at home. Soft, fresh, and made by hand, never store-bought or factory-made." },
    { "type": "text", "id": "thali_delivery_heading", "label": "Delivery heading", "default": "We deliver across the GTA" },
    { "type": "textarea", "id": "thali_delivery_text", "label": "Delivery text", "default": "Fresh ghar ka khana delivered every Sunday (10 AM � 2 PM) and Wednesday (5 PM � 9 PM) to homes within 50 km of our kitchen in Midtown Toronto. If your home is within 50 km, we deliver to you." },
    { "type": "textarea", "id": "thali_tickets", "label": "Cutoff tickets", "info": "One per line as day|delivery window|order-by label|order-by value.", "default": "Sunday|Delivery 10 AM � 2 PM|Order by|11:59 PM Friday\nWednesday|Delivery 5 PM � 9 PM|Order by|11:59 PM Monday" },
    { "type": "textarea", "id": "thali_cutoff_note", "label": "Cutoff note", "default": "Every batch is cooked fresh for its delivery day, so orders close at 11:59 PM, two days before delivery. That way we know exactly how much khana to make." },
    { "type": "text", "id": "thali_fresh_heading", "label": "Fresh heading", "default": "Cooked fresh, like home" },
    { "type": "textarea", "id": "thali_fresh_text", "label": "Fresh text", "default": "Miss ghar ka khana? Every thali is made with the care of a homemade meal, with flavourful curries, fresh rotis, sabzis and the perfect tadka in every bite. Prepared fresh for every delivery day, so you can enjoy a complete Indian meal that tastes like it came straight from your own kitchen." },
    { "type": "textarea", "id": "thali_steps", "label": "Steps", "info": "One per line as title|text.", "default": "We cook fresh|A fresh batch made for each delivery day\nWe deliver|Sunday or Wednesday, straight to your door" },
    { "type": "textarea", "id": "thali_towns", "label": "Delivery towns", "info": "Comma separated.", "default": "Newmarket, Vaughan, Brampton, Markham, Oshawa, Scarborough, Mississauga, Milton, Oakville" },
    { "type": "text", "id": "thali_cta_heading", "label": "CTA heading", "default": "Ghar Ka Khana, Delivered" },
    { "type": "textarea", "id": "thali_cta_text", "label": "CTA text", "default": "Every thali comes with curry, sabzi, chawal and roti. Proper portions, proper taste, zero cooking." },
    { "type": "text", "id": "thali_cta_label", "label": "CTA button label", "default": "Order Now" },
    { "type": "url", "id": "thali_cta_link", "label": "CTA button link" },
    { "type": "text", "id": "thali_cta_note", "label": "CTA note", "default": "Har meal ammi ke haath jaisa." },
    { "type": "textarea", "id": "thali_facts", "label": "CTA facts", "info": "One per line as value|label.", "default": "4|Items in every thali\n32 oz|Generous portion\n50 km|Delivery radius\n2�|Deliveries every week" },
    { "type": "color", "id": "thali_bg", "label": "Panel background", "default": "#E3EADF" },
    { "type": "color", "id": "thali_accent", "label": "Panel accent", "default": "#F5A623" },
    { "type": "text", "id": "load_more_label", "label": "Load more label", "default": "Load more" },
    { "type": "range", "id": "menu_count", "min": 3, "max": 12, "step": 1, "label": "Meals in the featured row", "default": 5, "info": "How many meals the \"This week's menu\" strip shows." },
    { "type": "range", "id": "grid_page_size", "min": 3, "max": 12, "step": 1, "label": "Meals per Explore page", "default": 6, "info": "How many cards the Explore grid shows before Load more." },
    { "type": "text", "id": "view_meal_label", "label": "Meal card link label", "default": "View meal" },
    { "type": "text", "id": "filter_all_label", "label": "Filter: all label", "default": "All" },
    { "type": "text", "id": "filter_meals_label", "label": "Filter group: screen reader label", "default": "Filter meals" },
    { "type": "text", "id": "gallery_prev_label", "label": "Gallery: previous button label", "default": "Previous" },
    { "type": "text", "id": "gallery_next_label", "label": "Gallery: next button label", "default": "Next" },
    { "type": "text", "id": "allergen_label", "label": "Meal detail: allergen label", "default": "Contains" },
    { "type": "text", "id": "reheat_label", "label": "Meal detail: heating label", "default": "Heating" },
    { "type": "text", "id": "protein_label", "label": "Nutrition: protein label", "default": "Protein" },
    { "type": "text", "id": "carbs_label", "label": "Nutrition: carbs label", "default": "Carbs" },
    { "type": "text", "id": "fat_label", "label": "Nutrition: fat label", "default": "Fat" },
