{% render 'cm-section-assets', section: section %}
{{ 'section-cm-meal-plan-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cm-meal-plan-page.js' | asset_url }}" defer="defer"></script>
{%- if request.design_mode -%}
  <script src="{{ 'cm-meal-plan-editor.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{% comment %} include (not render) so assigns leak into this section {% endcomment %}
{% include 'cm-mp-context' %}

<div class="mealplan-page" data-mp-page data-cm="meal-plan-explore" data-mp-menu-count="{{ section.settings.menu_count | default: 5 }}"
  data-mp-grid-page="{{ section.settings.grid_page_size | default: 6 }}"
  data-mp-view-label="{{ section.settings.view_meal_label | default: 'View meal' | escape }}"
  data-mp-all-label="{{ section.settings.filter_all_label | default: 'All' | escape }}"
  data-mp-allergen-label="{{ section.settings.allergen_label | default: 'Contains' | escape }}"
  data-mp-reheat-label="{{ section.settings.reheat_label | default: 'Heating' | escape }}"
  data-mp-protein-label="{{ section.settings.protein_label | default: 'Protein' | escape }}"
  data-mp-carbs-label="{{ section.settings.carbs_label | default: 'Carbs' | escape }}"
  data-mp-fat-label="{{ section.settings.fat_label | default: 'Fat' | escape }}"
  data-mp-diet-gluten-label="{{ plan_meta.diet_gluten_label.value | default: 'Gluten free' | escape }}"
  data-mp-diet-dairy-label="{{ plan_meta.diet_dairy_label.value | default: 'Dairy free' | escape }}"
 {% render 'pm-section-style', section: section %}>
  <script type="application/json" data-mp-foods>{{ foods_json }}</script>
  <script type="application/json" data-mp-alts>{{ alts_json }}</script>
  <script type="application/json" data-mp-meals>{{ meals_json }}</script>
  <div class="mealplan-a">
    <section class="ex">
      <div class="wrap">
        <h2>{{ c_explore_heading | escape }}</h2>
        <div class="filters" id="filters" role="group" aria-label="{{ c_filter_label | escape }}"></div>
        <div class="eg" id="grid"></div>
        <div class="more"><button type="button" class="btn" id="more">{{ c_load_more_label | escape }}</button></div>
      </div>
    </section>
  </div>
</div>

{% schema %}
{
  "name": "MP À la carte",
  "tag": "section",
  "class": "section cm-section",
  "settings": [
    {
      "type": "product",
      "id": "content_product",
      "label": "Plan product",
      "info": "Optional. Meals/copy can come from this product's variants and metafields. On a product template the current product is used when blank."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "À la carte"
    },
    {
      "type": "text",
      "id": "load_more_label",
      "label": "Load more label",
      "default": "Load more"
    },
    {
      "type": "range",
      "id": "grid_page_size",
      "min": 3,
      "max": 24,
      "step": 1,
      "label": "Meals per page",
      "default": 6
    },
    {
      "type": "text",
      "id": "filter_all_label",
      "label": "All filter label",
      "default": "All"
    },
    {
      "type": "text",
      "id": "filter_meals_label",
      "label": "Filter aria label",
      "default": "Filter meals"
    },
    {
      "type": "header",
      "content": "Colors & typography"
    },
    {
      "type": "paragraph",
      "content": "Leave blank to keep the theme default. Change any value to override this band like WordPress."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "min": 10,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Eyebrow size",
      "default": 14
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 18,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Heading size",
      "default": 40
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 16
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "options": [
        {
          "value": "",
          "label": "Theme default"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra-bold"
        }
      ],
      "default": ""
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text align",
      "options": [
        {
          "value": "",
          "label": "Theme default"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "MP Explore"
    }
  ]
}
{% endschema %}
