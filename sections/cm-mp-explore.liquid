{% render 'cm-section-assets', section: section %}
{{ 'section-cm-meal-plan-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cm-meal-plan-page.js' | asset_url }}" defer="defer"></script>
{%- if request.design_mode -%}
  <script src="{{ 'cm-meal-plan-editor.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{% comment %} include (not render) so assigns leak into this section {% endcomment %}
{% include 'cm-mp-context' %}
{%- liquid
  assign s = section.settings
-%}
{%- capture mp_eyebrow_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'eyebrow_' -%}
{%- endcapture -%}
{%- capture mp_heading_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'heading_' -%}
{%- endcapture -%}
{%- capture mp_body_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'body_' -%}
{%- endcapture -%}


{%- liquid
  assign explore_meal_blocks = section.blocks | where: 'type', 'meal'
  assign explore_filter_blocks = section.blocks | where: 'type', 'filter'
  assign meals_source = section.settings.meals_source | default: 'blocks_first'
  assign prefer_editor_meals = false
  if meals_source == 'blocks'
    assign prefer_editor_meals = true
  elsif meals_source == 'blocks_first' and explore_meal_blocks.size > 0
    assign prefer_editor_meals = true
  endif
-%}
{%- if prefer_editor_meals and explore_meal_blocks.size > 0 -%}
  {%- capture meals_json -%}
    {%- render 'cm-plan-meals', plan: blank, meals: blank, blocks: explore_meal_blocks, food_count: 10, prefer_blocks: true -%}
  {%- endcapture -%}
{%- endif -%}

<div
  class="mealplan-page"
  data-mp-page
  data-cm="meal-plan-explore"
  data-mp-explore="1"
  data-mp-menu-count="{{ section.settings.menu_count | default: 5 }}"
  data-mp-grid-page="{{ section.settings.grid_page_size | default: 6 }}"
  data-mp-view-label="{{ section.settings.view_meal_label | default: 'View meal' | escape }}"
  data-mp-all-label="{{ section.settings.filter_all_label | default: 'All' | escape }}"
  data-mp-allergen-label="{{ section.settings.allergen_label | default: 'Contains' | escape }}"
  data-mp-reheat-label="{{ section.settings.reheat_label | default: 'Heating' | escape }}"
  data-mp-protein-label="{{ section.settings.protein_label | default: 'Protein' | escape }}"
  data-mp-carbs-label="{{ section.settings.carbs_label | default: 'Carbs' | escape }}"
  data-mp-fat-label="{{ section.settings.fat_label | default: 'Fat' | escape }}"
  data-mp-diet-gluten-label="{{ plan_meta.diet_gluten_label.value | default: 'Gluten free' | escape }}"
  data-mp-diet-dairy-label="{{ plan_meta.diet_dairy_label.value | default: 'Dairy free' | escape }}"
  {% render 'pm-section-style', section: section %}
>
  <script type="application/json" data-mp-foods>{{ foods_json }}</script>
  <script type="application/json" data-mp-alts>{{ alts_json }}</script>
  <script type="application/json" data-mp-meals>{{ meals_json }}</script>
  <div class="mealplan-a">
    <section class="ex">
      <div class="wrap">
        <h2
          {% if mp_heading_style != blank %}
            style="{{ mp_heading_style | strip }}"
          {% endif %}
        >{{ c_explore_heading | escape }}</h2>

        <div class="filters" id="filters" role="group" aria-label="{{ section.settings.filter_meals_label | default: 'Filter meals' | escape }}"{% if explore_filter_blocks.size > 0 %} data-mp-ssr="1"{% endif %}>
          {%- if explore_filter_blocks.size > 0 -%}
            <button type="button" aria-pressed="true" data-t="all">{{ section.settings.filter_all_label | default: 'All' | escape }}</button>
            {%- for block in explore_filter_blocks -%}
              {%- assign filter_slug = block.settings.tag | default: block.settings.label | strip | downcase -%}
              <button type="button" aria-pressed="false" data-t="{{ filter_slug | escape }}" {{ block.shopify_attributes }}>
                {{ block.settings.label | default: block.settings.tag | escape }}
              </button>
            {%- endfor -%}
          {%- endif -%}
        </div>

        <div class="eg" id="grid"{% if explore_meal_blocks.size > 0 and prefer_editor_meals %} data-mp-ssr="1"{% endif %}>
          {%- if explore_meal_blocks.size > 0 and prefer_editor_meals -%}
            {%- for block in explore_meal_blocks -%}
              {%- liquid
                assign tag_bits = block.settings.tags | default: '' | split: ','
                assign tag_data = ''
                for t in tag_bits
                  assign t_clean = t | strip | downcase
                  if t_clean != blank
                    if tag_data != blank
                      assign tag_data = tag_data | append: '|'
                    endif
                    assign tag_data = tag_data | append: t_clean
                  endif
                endfor
                if block.settings.gluten_free
                  unless tag_data contains 'gluten'
                    if tag_data != blank
                      assign tag_data = tag_data | append: '|gluten free'
                    else
                      assign tag_data = 'gluten free'
                    endif
                  endunless
                endif
                if block.settings.dairy_free
                  unless tag_data contains 'dairy'
                    if tag_data != blank
                      assign tag_data = tag_data | append: '|dairy free'
                    else
                      assign tag_data = 'dairy free'
                    endif
                  endunless
                endif
                assign card_name = block.settings.short | default: block.settings.name
              -%}
              <article class="e" data-t="{{ tag_data | escape }}" {{ block.shopify_attributes }}{% render 'pm-area-style', block: block %}>
                <div class="thumb">
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 700 | image_tag: class: 'mp-food mealplan-ph ph', loading: 'lazy', widths: '320,480,700', alt: card_name }}
                  {%- else -%}
                    {%- assign fi = block.settings.image_index | default: forloop.index0 | modulo: 10 -%}
                    <img class="mp-food mealplan-ph ph" src="{{ 'mp-food-' | append: fi | append: '.jpg' | asset_url }}" alt="{{ card_name | escape }}" width="700" height="700" loading="lazy">
                  {%- endif -%}
                </div>
                <h4>{{ card_name | escape }}</h4>
                <small>
                  {%- if block.settings.calories != blank -%}{{ block.settings.calories }} cal{%- else -%}— cal{%- endif -%}
                  ·
                  {%- if block.settings.protein != blank -%}{{ block.settings.protein }}g protein{%- else -%}— protein{%- endif -%}
                </small>
                <button type="button" data-i="{{ forloop.index0 }}">{{ section.settings.view_meal_label | default: 'View meal' | escape }}</button>
              </article>
            {%- endfor -%}
          {%- endif -%}
        </div>
        <div class="more"><button type="button" class="btn" id="more">{{ c_load_more_label | escape }}</button></div>
      </div>
    </section>
  </div>
</div>

