{% render 'cm-section-assets', section: section %}

{%- liquid
  assign s = section.settings
  assign chips = section.blocks | where: 'type', 'chip'
-%}
{%- capture hero_eyebrow_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'eyebrow_' -%}
{%- endcapture -%}
{%- capture hero_heading_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'heading_' -%}
{%- endcapture -%}
{%- capture hero_body_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'body_' -%}
{%- endcapture -%}

{%- if chips.size > 0 -%}
  <script src="{{ 'cm-ticker.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<div class="cm cm-hero" data-cm="hero">
  <div class="cm-hero__glow" aria-hidden="true"></div>
  <div class="page-width section-{{ section.id }}-padding">
    <div class="cm-hero__content">
      {%- if s.eyebrow != blank -%}
        <span
          class="cm-hero__eyebrow"
          {% if hero_eyebrow_style != blank %}
            style="{{ hero_eyebrow_style | strip }}"
          {% endif %}
        >
          {{- s.eyebrow | escape -}}
        </span>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2
          class="cm-hero__heading"
          {% if hero_heading_style != blank %}
            style="{{ hero_heading_style | strip }}"
          {% endif %}
        >
          {{- s.heading | escape | newline_to_br -}}
        </h2>
      {%- endif -%}
      {%- if s.text != blank -%}
        <div
          class="cm-hero__sub"
          {% if hero_body_style != blank %}
            style="{{ hero_body_style | strip }}"
          {% endif %}
        >
          {{ s.text }}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if chips.size > 0 -%}
    <div class="cm-ticker" data-cm-ticker style="--cm-ticker-speed: {{ section.settings.ticker_speed }}s;">
      <div class="cm-ticker__track">
        <div class="cm-ticker__group">
          {%- for block in chips -%}
            {%- capture chip_title_style -%}
              {%- render 'pm-block-type-style', block: block, prefix: 'title_' -%}
            {%- endcapture -%}
            {%- capture chip_body_style -%}
              {%- render 'pm-block-type-style', block: block, prefix: 'body_' -%}
            {%- endcapture -%}
            <div class="cm-chip" {{ block.shopify_attributes }}>
              <span
                class="cm-chip__num"
                {% if chip_title_style != blank %}
                  style="{{ chip_title_style | strip }}"
                {% endif %}
              >
                {{- block.settings.number | escape -}}
              </span>
              <span
                class="cm-chip__label"
                {% if chip_body_style != blank %}
                  style="{{ chip_body_style | strip }}"
                {% endif %}
              >
                {{- block.settings.label | escape -}}
              </span>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}
</div>

