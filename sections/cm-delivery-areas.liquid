{{ 'section-cm-delivery-areas.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cm-da.js' | asset_url }}" defer></script>

{%- liquid
  assign s = section.settings
  assign areas = section.blocks | where: 'type', 'area'
  assign features = section.blocks | where: 'type', 'feature'
-%}

<section class="da" id="DeliveryAreas-{{ section.id }}" aria-labelledby="da-title-{{ section.id }}" {{ section.shopify_attributes }}>
  {%- assign plates = 'tl,tr,bl,br' | split: ',' -%}
  {%- for pos in plates -%}
    {%- assign img_key = 'plate_' | append: pos -%}
    {%- assign alt_key = img_key | append: '_alt' -%}
    {%- assign fallback = 'cm-da-plate-' | append: pos | append: '.webp' -%}
    <div class="da__corner da__corner--{{ pos }}" aria-hidden="true">
      {%- if section.settings[img_key] != blank -%}
        {{ section.settings[img_key] | image_url: width: 800 | image_tag: loading: 'lazy', widths: '260, 400, 600, 800', sizes: '31vw', alt: section.settings[alt_key] }}
      {%- else -%}
        <img src="{{ fallback | asset_url }}" alt="{{ section.settings[alt_key] | escape }}" width="640" height="640" loading="lazy">
      {%- endif -%}
    </div>
  {%- endfor -%}

  <div class="da__stage">
    <div class="da__card">
      <div class="da__deco da__deco--brush-l" aria-hidden="true"><img src="{{ 'cm-da-brush-l.webp' | asset_url }}" alt="" width="200" height="120"></div>
      <div class="da__deco da__deco--brush-r" aria-hidden="true"><img src="{{ 'cm-da-brush-r.webp' | asset_url }}" alt="" width="180" height="110"></div>
      <div class="da__leaf da__leaf--tr" aria-hidden="true"><img src="{{ 'cm-da-leaf-tr.webp' | asset_url }}" alt="" width="54" height="70"></div>
      <div class="da__leaf da__leaf--bl" aria-hidden="true"><img src="{{ 'cm-da-leaf-bl.webp' | asset_url }}" alt="" width="100" height="120"></div>

      {%- if s.eyebrow != blank -%}
        <span class="da__script">
          <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h12M2 26h10M6 32h8"/><path d="M18 14h14l4 12h6"/><path d="M18 14l-2 14h24"/><circle cx="16" cy="36" r="5"/><circle cx="38" cy="36" r="5"/><path d="M26 8h8"/></svg>
          {{ s.eyebrow | escape }}
        </span>
      {%- endif -%}

      {%- if s.heading != blank -%}
        <h2 class="da__title" id="da-title-{{ section.id }}">{{ s.heading | escape }}</h2>
      {%- endif -%}

      {%- if s.subheading != blank or s.subheading_accent != blank -%}
        <p class="da__sub">
          <span>
            {{- s.subheading | escape -}}
            {%- if s.subheading_accent != blank -%}
              <em>{{ s.subheading_accent | escape }}</em>
            {%- endif -%}
          </span>
        </p>
      {%- endif -%}

      {%- if areas.size > 0 -%}
        <ul class="da__areas">
          {%- for block in areas -%}
            <li class="da__pill" style="--i:{{ forloop.index0 }}" {{ block.shopify_attributes }}>
              <svg viewBox="0 0 16 22" aria-hidden="true"><path d="M8 0C3.6 0 0 3.5 0 7.9 0 13.8 8 22 8 22s8-8.2 8-14.1C16 3.5 12.4 0 8 0zm0 11a3.1 3.1 0 110-6.2A3.1 3.1 0 018 11z"/></svg>
              {{ block.settings.name | escape }}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if s.button_label != blank -%}
        <a class="da__cta" href="{{ s.button_link | default: routes.all_products_collection_url }}">
          {{ s.button_label | escape | upcase }}
          <span class="da__cta-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"/></svg>
          </span>
        </a>
      {%- endif -%}
    </div>
    <div class="da__deco da__deco--dots" aria-hidden="true"><img src="{{ 'cm-da-dots.webp' | asset_url }}" alt="" width="105" height="80"></div>
    <div class="da__leaf da__leaf--top" aria-hidden="true"><img src="{{ 'cm-da-leaf-top.webp' | asset_url }}" alt="" width="54" height="70"></div>
    <div class="da__leaf da__leaf--right" aria-hidden="true"><img src="{{ 'cm-da-leaf-right.webp' | asset_url }}" alt="" width="72" height="90"></div>
  </div>

  {%- if features.size > 0 -%}
    <div class="da__bar">
      {%- for block in features -%}
        <div class="da__feat" {{ block.shopify_attributes }}>
          <span class="da__feat-icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'heart' -%}
                <svg viewBox="0 0 48 48"><path class="w" d="M24 41C14 38 8 30 10 23c2-6 9-5 14-1 5-4 12-5 14 1 2 7-4 15-14 18z" stroke-width="2.5"/><path class="w" d="M24 20c-1-5 0-9 4-12 1 4 0 9-4 12zM24 14c-2-3-5-4-8-3 1 3 4 5 8 3z" stroke-width="2"/><path class="o" d="M14 41c6 3 15 3 23-2" stroke-width="4"/></svg>
              {%- when 'map' -%}
                <svg viewBox="0 0 48 48"><path class="w" d="M5 19l12-4 14 4 12-4v24l-12 4-14-4-12 4zM17 15v24M31 19v24" stroke-width="2.5"/><path class="o fo" d="M24 3a6.5 6.5 0 00-6.5 6.5C17.5 15 24 22 24 22s6.5-7 6.5-12.5A6.5 6.5 0 0024 3z" stroke-width="1.5"/><circle cx="24" cy="9.5" r="2.4" fill="#0f1f3d" stroke="none"/></svg>
              {%- when 'love' -%}
                <svg viewBox="0 0 48 48"><path class="w" d="M24 5a19 19 0 1019 19" stroke-width="3"/><path class="o" d="M24 5a19 19 0 0113 5" stroke-width="3"/><path class="o fo" d="M24 33s-9-5.5-9-12a5 5 0 019-3 5 5 0 019 3c0 6.5-9 12-9 12z" stroke-width="2"/></svg>
              {%- else -%}
                <svg viewBox="0 0 48 48"><circle class="o" cx="24" cy="24" r="19" stroke-width="3.5"/><path class="w" d="M24 13v12h10" stroke-width="3.5"/></svg>
            {%- endcase -%}
          </span>
          <span>
            {%- if block.settings.title != blank -%}
              <span class="da__feat-title">{{ block.settings.title | escape }}</span>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <span class="da__feat-text">{{ block.settings.text | escape }}</span>
            {%- endif -%}
          </span>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "CM delivery areas",
  "tag": "section",
  "class": "section cm-section",
  "max_blocks": 40,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Script eyebrow",
      "default": "We Deliver"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Delivery Areas"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Delivering fresh, healthy meals"
    },
    {
      "type": "text",
      "id": "subheading_accent",
      "label": "Subheading accent",
      "default": "to your neighborhood"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Order Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Corner food plates"
    },
    {
      "type": "image_picker",
      "id": "plate_tl",
      "label": "Top-left plate"
    },
    {
      "type": "text",
      "id": "plate_tl_alt",
      "label": "Top-left alt text",
      "default": "Fresh vegetables plate"
    },
    {
      "type": "image_picker",
      "id": "plate_tr",
      "label": "Top-right plate"
    },
    {
      "type": "text",
      "id": "plate_tr_alt",
      "label": "Top-right alt text",
      "default": "Chef prepared meal"
    },
    {
      "type": "image_picker",
      "id": "plate_bl",
      "label": "Bottom-left plate"
    },
    {
      "type": "text",
      "id": "plate_bl_alt",
      "label": "Bottom-left alt text",
      "default": "Chicken and vegetables plate"
    },
    {
      "type": "image_picker",
      "id": "plate_br",
      "label": "Bottom-right plate"
    },
    {
      "type": "text",
      "id": "plate_br_alt",
      "label": "Bottom-right alt text",
      "default": "Salad bowl"
    }
  ],
  "blocks": [
    {
      "type": "area",
      "name": "Delivery area",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Area name",
          "default": "Hartland"
        }
      ]
    },
    {
      "type": "feature",
      "name": "Feature",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "clock", "label": "Clock" },
            { "value": "heart", "label": "Fresh / leaf heart" },
            { "value": "map", "label": "Map coverage" },
            { "value": "love", "label": "Heart" }
          ],
          "default": "clock"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "On Time Delivery"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Always on schedule"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CM delivery areas",
      "blocks": [
        { "type": "area", "settings": { "name": "Hartland" } },
        { "type": "area", "settings": { "name": "Delafield" } },
        { "type": "area", "settings": { "name": "Pewaukee" } },
        { "type": "area", "settings": { "name": "Waukesha" } },
        { "type": "area", "settings": { "name": "Sussex" } },
        { "type": "area", "settings": { "name": "Merton" } },
        { "type": "area", "settings": { "name": "Nashotah" } },
        { "type": "area", "settings": { "name": "Okauchee Lake" } },
        { "type": "area", "settings": { "name": "Oconomowoc" } },
        { "type": "area", "settings": { "name": "Oconomowoc Lake" } },
        { "type": "area", "settings": { "name": "Chenequa" } },
        { "type": "area", "settings": { "name": "Lisbon" } },
        { "type": "area", "settings": { "name": "Lannon" } },
        { "type": "area", "settings": { "name": "Menomonee Falls" } },
        { "type": "area", "settings": { "name": "Brookfield" } },
        { "type": "area", "settings": { "name": "Elm Grove" } },
        { "type": "area", "settings": { "name": "Wales" } },
        { "type": "area", "settings": { "name": "Dousman" } },
        { "type": "area", "settings": { "name": "Summit" } },
        { "type": "area", "settings": { "name": "Lake Country" } },
        { "type": "area", "settings": { "name": "Stone Bank" } },
        { "type": "area", "settings": { "name": "North Lake" } },
        { "type": "area", "settings": { "name": "Mapleton" } },
        { "type": "area", "settings": { "name": "Genesee" } },
        { "type": "area", "settings": { "name": "Mukwonago" } },
        { "type": "feature", "settings": { "icon": "clock", "title": "On Time Delivery", "text": "Always on schedule" } },
        { "type": "feature", "settings": { "icon": "heart", "title": "Fresh & Healthy", "text": "Made with care" } },
        { "type": "feature", "settings": { "icon": "map", "title": "Wide Area Coverage", "text": "Near you always" } },
        { "type": "feature", "settings": { "icon": "love", "title": "Made With Love", "text": "For a healthier you" } }
      ]
    }
  ]
}
{% endschema %}
