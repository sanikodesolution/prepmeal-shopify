{{ 'section-cm-delivery-areas.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign areas = section.blocks | where: 'type', 'area'
  assign features = section.blocks | where: 'type', 'feature'
-%}

<section class="cm-da" id="DeliveryAreas-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="cm-da__bg" aria-hidden="true"></div>
  <span class="cm-da__brush cm-da__brush--1" aria-hidden="true"></span>
  <span class="cm-da__brush cm-da__brush--2" aria-hidden="true"></span>
  <span class="cm-da__leaf cm-da__leaf--1" aria-hidden="true"></span>
  <span class="cm-da__leaf cm-da__leaf--2" aria-hidden="true"></span>
  <span class="cm-da__dot cm-da__dot--1" aria-hidden="true"></span>
  <span class="cm-da__dot cm-da__dot--2" aria-hidden="true"></span>
  <span class="cm-da__dot cm-da__dot--3" aria-hidden="true"></span>

  {%- assign plate_positions = 'tl,tr,bl,br' | split: ',' -%}
  {%- for pos in plate_positions -%}
    {%- assign img_key = 'plate_' | append: pos -%}
    {%- assign alt_key = 'plate_' | append: pos | append: '_alt' -%}
    <div class="cm-da__plate cm-da__plate--{{ pos }}" aria-hidden="true">
      {%- if section.settings[img_key] != blank -%}
        {{ section.settings[img_key] | image_url: width: 600 | image_tag: loading: 'lazy', widths: '200, 400, 600', sizes: '28vw', alt: section.settings[alt_key] }}
      {%- else -%}
        <div class="cm-da__plate-ph">✦</div>
      {%- endif -%}
    </div>
  {%- endfor -%}

  <div class="cm-da__inner">
    <div class="cm-da__card">
      <div class="cm-da__icon" aria-hidden="true">
        <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M6 30h22c1.5 0 2.5-.7 3.2-1.8L36 18h6v10h2v3H8l-2-1z" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/>
          <circle cx="14" cy="36" r="3.5" stroke="currentColor" stroke-width="2.2"/>
          <circle cx="34" cy="36" r="3.5" stroke="currentColor" stroke-width="2.2"/>
          <path d="M8 30V16c0-1.5 1-2.5 2.5-2.5H24" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
          <path d="M28 14h6l3 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>

      {%- if s.eyebrow != blank -%}
        <p class="cm-da__script">{{ s.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if s.heading != blank -%}
        <h2 class="cm-da__title">{{ s.heading | escape }}</h2>
      {%- endif -%}

      {%- if s.subheading != blank or s.subheading_accent != blank -%}
        <p class="cm-da__sub">
          {{- s.subheading | escape -}}
          {%- if s.subheading_accent != blank -%}
            <em>{{ s.subheading_accent | escape }}</em>
          {%- endif -%}
        </p>
      {%- endif -%}

      {%- if areas.size > 0 -%}
        <ul class="cm-da__areas" role="list">
          {%- for block in areas -%}
            <li class="cm-da__area" {{ block.shopify_attributes }}>
              <span class="cm-da__pin" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 2C8.1 2 5 5.1 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7zm0 9.5c-1.4 0-2.5-1.1-2.5-2.5S10.6 6.5 12 6.5s2.5 1.1 2.5 2.5S13.4 11.5 12 11.5z"/>
                </svg>
              </span>
              {{ block.settings.name | escape }}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if s.button_label != blank -%}
        <a class="cm-da__cta" href="{{ s.button_link | default: routes.all_products_collection_url }}">
          <span>{{ s.button_label | escape }}</span>
          <span class="cm-da__cta-arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M7 17L17 7M17 7H9M17 7v8" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      {%- endif -%}
    </div>
  </div>

  {%- if features.size > 0 -%}
    <div class="cm-da__bar-wrap">
      <div class="cm-da__bar">
        {%- for block in features -%}
          <div class="cm-da__feat" {{ block.shopify_attributes }}>
            <span class="cm-da__feat-icon" aria-hidden="true">
              {%- case block.settings.icon -%}
                {%- when 'heart' -%}
                  <svg viewBox="0 0 48 48" fill="none"><path d="M24 40s-14-8.8-14-18a8 8 0 0 1 14-5 8 8 0 0 1 14 5c0 9.2-14 18-14 18z" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/><path d="M18 16c1.5-2 3.5-3 6-3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                {%- when 'map' -%}
                  <svg viewBox="0 0 48 48" fill="none"><path d="M10 14l10-4 10 4 8-3v26l-8 3-10-4-10 4V14z" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/><path d="M20 10v26M30 14v26" stroke="currentColor" stroke-width="2"/><circle cx="34" cy="18" r="4" fill="currentColor"/></svg>
                {%- when 'love' -%}
                  <svg viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="16" stroke="currentColor" stroke-width="2.2"/><path d="M24 33s-8-5-8-10a4.5 4.5 0 0 1 8-2.8A4.5 4.5 0 0 1 32 23c0 5-8 10-8 10z" fill="currentColor"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="15" stroke="currentColor" stroke-width="2.2"/><path d="M24 14v12l7 4" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {%- endcase -%}
            </span>
            {%- if block.settings.title != blank -%}
              <strong>{{ block.settings.title | escape }}</strong>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <span>{{ block.settings.text | escape }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "CM delivery areas",
  "tag": "section",
  "class": "section cm-section",
  "max_blocks": 40,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Script eyebrow",
      "default": "We Deliver"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Delivery Areas"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Delivering fresh, healthy meals"
    },
    {
      "type": "text",
      "id": "subheading_accent",
      "label": "Subheading accent (script)",
      "default": "to your neighborhood"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Order Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Corner food plates"
    },
    {
      "type": "image_picker",
      "id": "plate_tl",
      "label": "Top-left plate"
    },
    {
      "type": "text",
      "id": "plate_tl_alt",
      "label": "Top-left alt text",
      "default": "Fresh vegetables plate"
    },
    {
      "type": "image_picker",
      "id": "plate_tr",
      "label": "Top-right plate"
    },
    {
      "type": "text",
      "id": "plate_tr_alt",
      "label": "Top-right alt text",
      "default": "Chef prepared meal"
    },
    {
      "type": "image_picker",
      "id": "plate_bl",
      "label": "Bottom-left plate"
    },
    {
      "type": "text",
      "id": "plate_bl_alt",
      "label": "Bottom-left alt text",
      "default": "Chicken and vegetables plate"
    },
    {
      "type": "image_picker",
      "id": "plate_br",
      "label": "Bottom-right plate"
    },
    {
      "type": "text",
      "id": "plate_br_alt",
      "label": "Bottom-right alt text",
      "default": "Salad bowl"
    }
  ],
  "blocks": [
    {
      "type": "area",
      "name": "Delivery area",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Area name",
          "default": "Hartland"
        }
      ]
    },
    {
      "type": "feature",
      "name": "Feature",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "clock", "label": "Clock" },
            { "value": "heart", "label": "Fresh / leaf heart" },
            { "value": "map", "label": "Map coverage" },
            { "value": "love", "label": "Heart" }
          ],
          "default": "clock"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "On Time Delivery"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Always on schedule"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CM delivery areas",
      "blocks": [
        { "type": "area", "settings": { "name": "Hartland" } },
        { "type": "area", "settings": { "name": "Delafield" } },
        { "type": "area", "settings": { "name": "Pewaukee" } },
        { "type": "area", "settings": { "name": "Waukesha" } },
        { "type": "area", "settings": { "name": "Sussex" } },
        { "type": "area", "settings": { "name": "Merton" } },
        { "type": "area", "settings": { "name": "Nashotah" } },
        { "type": "area", "settings": { "name": "Okauchee Lake" } },
        { "type": "area", "settings": { "name": "Oconomowoc" } },
        { "type": "area", "settings": { "name": "Oconomowoc Lake" } },
        { "type": "area", "settings": { "name": "Chenequa" } },
        { "type": "area", "settings": { "name": "Lisbon" } },
        { "type": "area", "settings": { "name": "Lannon" } },
        { "type": "area", "settings": { "name": "Menomonee Falls" } },
        { "type": "area", "settings": { "name": "Brookfield" } },
        { "type": "area", "settings": { "name": "Elm Grove" } },
        { "type": "area", "settings": { "name": "Wales" } },
        { "type": "area", "settings": { "name": "Dousman" } },
        { "type": "area", "settings": { "name": "Summit" } },
        { "type": "area", "settings": { "name": "Lake Country" } },
        { "type": "area", "settings": { "name": "Stone Bank" } },
        { "type": "area", "settings": { "name": "North Lake" } },
        { "type": "area", "settings": { "name": "Mapleton" } },
        { "type": "area", "settings": { "name": "Genesee" } },
        { "type": "area", "settings": { "name": "Mukwonago" } },
        {
          "type": "feature",
          "settings": {
            "icon": "clock",
            "title": "On Time Delivery",
            "text": "Always on schedule"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "heart",
            "title": "Fresh & Healthy",
            "text": "Made with care"
          }
        },
        {
