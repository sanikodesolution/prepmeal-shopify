{{ 'section-cm-delivery-areas.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cm-da.js' | asset_url }}" defer></script>
<script src="{{ 'cm-da-map.js' | asset_url }}" defer></script>

{%- liquid
  assign s = section.settings
  assign areas = section.blocks | where: 'type', 'area'
  assign features = section.blocks | where: 'type', 'feature'
-%}
{%- capture da_eyebrow_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'eyebrow_' -%}
{%- endcapture -%}
{%- capture da_heading_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'heading_' -%}
{%- endcapture -%}
{%- capture da_sub_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'sub_' -%}
{%- endcapture -%}
{%- capture da_label_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'label_' -%}
{%- endcapture -%}
{%- capture da_zone_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'zone_' -%}
{%- endcapture -%}

<section class="da" id="DeliveryAreas-{{ section.id }}" aria-labelledby="da-title-{{ section.id }}" {{ section.shopify_attributes }}>
  {%- assign plates = 'tl,tr,bl,br' | split: ',' -%}
  {%- for pos in plates -%}
    {%- assign img_key = 'plate_' | append: pos -%}
    {%- assign alt_key = img_key | append: '_alt' -%}
    {%- assign fallback = 'cm-da-plate-' | append: pos | append: '.webp' -%}
    <div class="da__corner da__corner--{{ pos }}" aria-hidden="true">
      {%- if section.settings[img_key] != blank -%}
        {{ section.settings[img_key] | image_url: width: 800 | image_tag: loading: 'lazy', widths: '260, 400, 600, 800', sizes: '31vw', alt: section.settings[alt_key] }}
      {%- else -%}
        <img src="{{ fallback | asset_url }}" alt="{{ section.settings[alt_key] | escape }}" width="640" height="640" loading="lazy">
      {%- endif -%}
    </div>
  {%- endfor -%}

  <div class="da__stage">
    <div class="da__card">
      <div class="da__deco da__deco--brush-l" aria-hidden="true"><img src="{{ 'cm-da-brush-l.webp' | asset_url }}" alt="" width="200" height="120"></div>
      <div class="da__deco da__deco--brush-r" aria-hidden="true"><img src="{{ 'cm-da-brush-r.webp' | asset_url }}" alt="" width="180" height="110"></div>
      <div class="da__leaf da__leaf--tr" aria-hidden="true"><img src="{{ 'cm-da-leaf-tr.webp' | asset_url }}" alt="" width="54" height="70"></div>
      <div class="da__leaf da__leaf--bl" aria-hidden="true"><img src="{{ 'cm-da-leaf-bl.webp' | asset_url }}" alt="" width="100" height="120"></div>

      {%- if s.eyebrow != blank -%}
        <span
          class="da__kicker"
          {% if da_eyebrow_style != blank %}
            style="{{ da_eyebrow_style | strip }}"
          {% endif %}
        >
          <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h12M2 26h10M6 32h8"/><path d="M18 14h14l4 12h6"/><path d="M18 14l-2 14h24"/><circle cx="16" cy="36" r="5"/><circle cx="38" cy="36" r="5"/><path d="M26 8h8"/></svg>
          {{ s.eyebrow | escape }}
        </span>
      {%- endif -%}

      {%- if s.heading != blank -%}
        <h2
          class="da__title"
          id="da-title-{{ section.id }}"
          {% if da_heading_style != blank %}
            style="{{ da_heading_style | strip }}"
          {% endif %}
        >{{ s.heading | escape }}</h2>
      {%- endif -%}

      {%- if s.subheading != blank or s.subheading_accent != blank -%}
        <p
          class="da__sub"
          {% if da_sub_style != blank %}
            style="{{ da_sub_style | strip }}"
          {% endif %}
        >
          <span>
            {{- s.subheading | escape -}}
            {%- if s.subheading_accent != blank -%}
              <em>{{ s.subheading_accent | escape }}</em>
            {%- endif -%}
          </span>
        </p>
      {%- endif -%}

      <div class="da__deliver" data-da-check>
        <p
          class="da__deliver-label"
          {% if da_label_style != blank %}
            style="{{ da_label_style | strip }}"
          {% endif %}
        >We deliver to</p>
        {%- if areas.size > 0 -%}
          <ul class="da__deliver-pills">
            {%- for block in areas -%}
              <li {{ block.shopify_attributes }}>
                <span
                  class="da__zone"
                  {% if da_zone_style != blank %}
                    style="{{ da_zone_style | strip }}"
                  {% endif %}
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg>
                  {{ block.settings.name | escape }}
                </span>
              </li>
            {%- endfor -%}
            <li class="da__places-more" hidden>
              <button type="button" class="da__places-btn" data-da-places-btn aria-expanded="false">
                <span data-da-places-text>More locations</span>
                <span class="da__places-count" data-da-places-count></span>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
              </button>
            </li>
          </ul>
        {%- endif -%}
        <form class="da__check" data-da-form novalidate>
          <span class="da__check-label">Check your address or postal code</span>
          <div class="da__check-row">
            <div class="da__check-field">
              <input class="da__check-input" type="text" name="address" placeholder="Search a delivery area" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-label="Search a delivery area">
              <ul class="da__suggest" data-da-suggest role="listbox" hidden></ul>
            </div>
            <button class="da__check-btn" type="submit">Check</button>
          </div>
          <div class="da__check-result" data-da-result role="status" aria-live="polite" hidden></div>
        </form>
        <details class="da__more">
          <summary>See every city and neighbourhood we serve <span class="da__more-plus" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg></span></summary>
          <div class="da__more-body">
            <div class="da__more-inner">
            <div class="da__region"><h5>Toronto</h5><p>Downtown Toronto, CityPlace, Liberty Village, King West, Queen West, Financial District, St. Lawrence, Distillery District, Yorkville, The Annex, Little Italy, Parkdale, Roncesvalles, High Park, Bloor West Village, The Junction, Leslieville, Riverdale, The Danforth, The Beaches, East York, Leaside, Thorncliffe Park, Flemingdon Park, Midtown, Davisville, Forest Hill, York, Weston, Mount Dennis</p></div>
            <div class="da__region"><h5>North York</h5><p>North York, Willowdale, Bayview Village, Don Mills, Don Valley Village, Downsview, Yorkdale, Lawrence Heights, Jane and Finch, York Mills, Newtonbrook, Bathurst Manor</p></div>
            <div class="da__region"><h5>Scarborough</h5><p>Scarborough, Agincourt, Malvern, Rouge, Woburn, Morningside, West Hill, Guildwood, Scarborough Village, Birch Cliff, Cliffside, Wexford, Dorset Park, L'Amoreaux, Steeles, Milliken</p></div>
            <div class="da__region"><h5>Etobicoke</h5><p>Etobicoke, Islington-City Centre, Kingsway, Mimico, New Toronto, Long Branch, Alderwood, Humber Bay, Rexdale, Thistletown, Richview, Eatonville</p></div>
            <div class="da__region"><h5>Mississauga</h5><p>Mississauga, City Centre, Square One, Port Credit, Cooksville, Streetsville, Meadowvale, Erin Mills, Churchill Meadows, Malton, Hurontario, Clarkson, Lorne Park, Lisgar</p></div>
            <div class="da__region"><h5>Brampton</h5><p>Brampton, Bramalea, Springdale, Heart Lake, Castlemore, Mount Pleasant, Fletcher's Meadow, Sandringham-Wellington, Gore Meadows</p></div>
            <div class="da__region"><h5>Vaughan</h5><p>Vaughan, Woodbridge, Maple, Concord, Thornhill Woods, Kleinburg, Vellore Village, Vaughan Metropolitan Centre</p></div>
            <div class="da__region"><h5>Markham</h5><p>Markham, Unionville, Cornell, Markham Village, Milliken Mills, Cathedraltown, Berczy Village, Thornhill</p></div>
            <div class="da__region"><h5>Richmond Hill</h5><p>Richmond Hill, Oak Ridges, Bayview Hill, Mill Pond, Jefferson, Langstaff, Elgin Mills</p></div>
            <div class="da__region"><h5>Pickering</h5><p>Pickering, Bay Ridges, Amberlea, Liverpool, Rosebank, Duffin Heights, Seaton</p></div>
            <p class="da__more-note">Don't see your neighbourhood? Call us at (416) 482-3434 or reach out on our contact page and we will let you know if we can deliver to you.</p>
            </div>
          </div>
        </details>
      </div>

      <div class="da__mapwrap">
        <div class="da__map" id="da-map-{{ section.id }}" role="img" aria-label="Delivery areas around Hartland" data-da-map>
          <div class="da__map-fallback">Loading our delivery map...</div>
        </div>
        <div class="da__legend">
          <span><i class="da__dot da__dot--hub"></i> Our kitchen</span>
          <span><i class="da__dot da__dot--city"></i> Delivery areas</span>
          <span><i class="da__dot da__dot--ring"></i> Delivery zone</span>
        </div>
        <script type="application/json" data-da-points>
          [
            {%- for block in areas -%}
              {"n":{{ block.settings.name | json }}}{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ]
        </script>
      </div>

    </div>
    <div class="da__deco da__deco--dots" aria-hidden="true"><img src="{{ 'cm-da-dots.webp' | asset_url }}" alt="" width="105" height="80"></div>
    <div class="da__leaf da__leaf--top" aria-hidden="true"><img src="{{ 'cm-da-leaf-top.webp' | asset_url }}" alt="" width="54" height="70"></div>
    <div class="da__leaf da__leaf--right" aria-hidden="true"><img src="{{ 'cm-da-leaf-right.webp' | asset_url }}" alt="" width="72" height="90"></div>
  </div>

  {%- if features.size > 0 -%}
    <div class="da__bar">
      {%- for block in features -%}
        {%- capture da_feat_title_style -%}
          {%- render 'pm-block-type-style', block: block, prefix: 'title_' -%}
        {%- endcapture -%}
        {%- capture da_feat_body_style -%}
          {%- render 'pm-block-type-style', block: block, prefix: 'body_' -%}
        {%- endcapture -%}
        <div class="da__feat" {{ block.shopify_attributes }}>
          <span class="da__feat-icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'heart' -%}
                <svg viewBox="0 0 48 48"><path class="w" d="M24 41C14 38 8 30 10 23c2-6 9-5 14-1 5-4 12-5 14 1 2 7-4 15-14 18z" stroke-width="2.5"/><path class="w" d="M24 20c-1-5 0-9 4-12 1 4 0 9-4 12zM24 14c-2-3-5-4-8-3 1 3 4 5 8 3z" stroke-width="2"/><path class="o" d="M14 41c6 3 15 3 23-2" stroke-width="4"/></svg>
              {%- when 'map' -%}
                <svg viewBox="0 0 48 48"><path class="w" d="M5 19l12-4 14 4 12-4v24l-12 4-14-4-12 4zM17 15v24M31 19v24" stroke-width="2.5"/><path class="o fo" d="M24 3a6.5 6.5 0 00-6.5 6.5C17.5 15 24 22 24 22s6.5-7 6.5-12.5A6.5 6.5 0 0024 3z" stroke-width="1.5"/><circle cx="24" cy="9.5" r="2.4" fill="#0f1f3d" stroke="none"/></svg>
              {%- when 'love' -%}
                <svg viewBox="0 0 48 48"><path class="w" d="M24 5a19 19 0 1019 19" stroke-width="3"/><path class="o" d="M24 5a19 19 0 0113 5" stroke-width="3"/><path class="o fo" d="M24 33s-9-5.5-9-12a5 5 0 019-3 5 5 0 019 3c0 6.5-9 12-9 12z" stroke-width="2"/></svg>
              {%- else -%}
                <svg viewBox="0 0 48 48"><circle class="o" cx="24" cy="24" r="19" stroke-width="3.5"/><path class="w" d="M24 13v12h10" stroke-width="3.5"/></svg>
            {%- endcase -%}
          </span>
          <span>
            {%- if block.settings.title != blank -%}
              <span
                class="da__feat-title"
                {% if da_feat_title_style != blank %}
                  style="{{ da_feat_title_style | strip }}"
                {% endif %}
              >{{ block.settings.title | escape }}</span>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <span
                class="da__feat-text"
                {% if da_feat_body_style != blank %}
                  style="{{ da_feat_body_style | strip }}"
                {% endif %}
              >{{ block.settings.text | escape }}</span>
            {%- endif -%}
          </span>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "CM delivery areas",
  "tag": "section",
  "class": "section cm-section",
  "max_blocks": 40,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Script eyebrow",
      "default": "We Deliver"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Delivery Areas"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Delivering fresh, healthy meals"
    },
    {
      "type": "text",
      "id": "subheading_accent",
      "label": "Subheading accent",
      "default": "to your neighborhood"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Order Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },

    { "type": "header", "content": "Eyebrow type" },
    { "type": "color", "id": "eyebrow_color", "label": "Text color" }, { "type": "color", "id": "eyebrow_hover_color", "label": "Hover text color", "info": "Clear to keep default." },
    { "type": "range", "id": "eyebrow_font_size", "min": 0, "max": 48, "step": 1, "unit": "px", "label": "Font size", "default": 0, "info": "0 = theme default. Custom sizes start at 14px." },
    {
      "type": "select",
      "id": "eyebrow_font_weight",
      "label": "Font weight",
      "options": [
        { "value": "inherit", "label": "Theme default" },
        { "value": "400", "label": "Regular 400" },
        { "value": "500", "label": "Medium 500" },
        { "value": "600", "label": "Semi-bold 600" },
        { "value": "700", "label": "Bold 700" },
        { "value": "800", "label": "Extra-bold 800" }
      ],
      "default": "inherit"
    },
    { "type": "range", "id": "eyebrow_letter_spacing", "min": -4, "max": 12, "step": 1, "unit": "px", "label": "Letter spacing", "default": 0 },
    { "type": "range", "id": "eyebrow_line_height", "min": 0, "max": 2, "step": 0.1, "label": "Line height", "default": 0, "info": "0 = theme default" },
        { "type": "header", "content": "Eyebrow format" },
        { "type": "select", "id": "eyebrow_font_style", "label": "Font style", "options": [{ "value": "inherit", "label": "Theme default" }, { "value": "normal", "label": "Normal" }, { "value": "italic", "label": "Italic" }], "default": "inherit" },
        { "type": "select", "id": "eyebrow_font_family", "label": "Font family", "options": [{ "value": "inherit", "label": "Theme default" }, { "value": "heading", "label": "Heading font" }, { "value": "body", "label": "Body font" }], "default": "inherit" },
        { "type": "range", "id": "eyebrow_word_spacing", "min": -4, "max": 20, "step": 1, "unit": "px", "label": "Word spacing", "default": 0, "info": "0 = theme default" },
        { "type": "select", "id": "eyebrow_text_transform", "label": "Text transform", "options": [{ "value": "inherit", "label": "Theme default" }, { "value": "none", "label": "None" }, { "value": "uppercase", "label": "Uppercase" }, { "value": "lowercase", "label": "Lowercase" }, { "value": "capitalize", "label": "Capitalize" }], "default": "inherit" },
        { "type": "select", "id": "eyebrow_text_decoration", "label": "Text decoration", "options": [{ "value": "inherit", "label": "Theme default" }, { "value": "none", "label": "None" }, { "value": "underline", "label": "Underline" }, { "value": "line-through", "label": "Line through" }], "default": "inherit" },
        { "type": "select", "id": "eyebrow_text_align", "label": "Text align", "options": [{ "value": "inherit", "label": "Theme default" }, { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "inherit" },
        { "type": "range", "id": "eyebrow_opacity", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Opacity", "default": 100, "info": "100 = fully opaque" },
        { "type": "header", "content": "Eyebrow box" },
        { "type": "range", "id": "eyebrow_max_width", "min": 0, "max": 1000, "step": 10, "unit": "px", "label": "Max width", "default": 0, "info": "0 = no limit" },
        { "type": "range", "id": "eyebrow_border_radius", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Corner radius", "default": 0 },
        { "type": "color", "id": "eyebrow_bg_color", "label": "Background color", "info": "Clear swatch to reset." }, { "type": "color", "id": "eyebrow_hover_bg_color", "label": "Hover background color", "info": "Clear to keep default." },
        { "type": "image_picker", "id": "eyebrow_bg_image", "label": "Background image" },
    { "type": "header", "content": "Eyebrow space" },
    { "type": "range", "id": "eyebrow_padding_top", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Padding top", "default": 0 },
    { "type": "range", "id": "eyebrow_padding_bottom", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Padding bottom", "default": 0 },
    { "type": "range", "id": "eyebrow_padding_left", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Padding left", "default": 0 },
    { "type": "range", "id": "eyebrow_padding_right", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Padding right", "default": 0 },
    { "type": "range", "id": "eyebrow_margin_top", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Margin top", "default": 0 },
    { "type": "range", "id": "eyebrow_margin_bottom", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Margin bottom", "default": 0 },
    { "type": "range", "id": "eyebrow_margin_left", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Margin left", "default": 0 },
    { "type": "range", "id": "eyebrow_margin_right", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Margin right", "default": 0 },
        { "type": "header", "content": "Label mask" },
        { "type": "select", "id": "eyebrow_bg_size", "label": "Image size", "options": [
          { "value": "cover", "label": "Cover" },
          { "value": "contain", "label": "Contain" },
          { "value": "auto", "label": "Auto" }
        ], "default": "cover" },
        { "type": "select", "id": "eyebrow_bg_position", "label": "Image position", "options": [
          { "value": "center", "label": "Center" },
          { "value": "top", "label": "Top" },
          { "value": "bottom", "label": "Bottom" },
          { "value": "left", "label": "Left" },
          { "value": "right", "label": "Right" }
        ], "default": "center" },
        { "type": "select", "id": "eyebrow_bg_mask", "label": "Image mask", "options": [
          { "value": "none", "label": "None" },
          { "value": "fade", "label": "Fade bottom" },
          { "value": "fade_edges", "label": "Fade edges" },
          { "value": "circle", "label": "Circle" },
          { "value": "soft", "label": "Soft vignette" },
          { "value": "rounded", "label": "Rounded box" },
          { "value": "custom", "label": "Custom mask image" }
        ], "default": "none" },
        { "type": "image_picker", "id": "eyebrow_bg_mask_image", "label": "Custom mask image", "info": "Used when Image mask = Custom." },
        { "type": "checkbox", "id": "eyebrow_bg_clip_text", "label": "Clip background to letters", "default": false, "info": "Fills letter shapes with the background color/image." },

    { "type": "header", "content": "Heading type" },
    { "type": "color", "id": "heading_color", "label": "Text color" }, { "type": "color", "id": "heading_hover_color", "label": "Hover text color", "info": "Clear to keep default." },
    { "type": "range", "id": "heading_font_size", "min": 0, "max": 72, "step": 1, "unit": "px", "label": "Font size", "default": 0, "info": "0 = theme default. Custom sizes start at 14px." },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "Font weight",
      "options": [
        { "value": "inherit", "label": "Theme default" },
        { "value": "400", "label": "Regular 400" },
        { "value": "500", "label": "Medium 500" },
        { "value": "600", "label": "Semi-bold 600" },
        { "value": "700", "label": "Bold 700" },
        { "value": "800", "label": "Extra-bold 800" }
      ],
      "default": "inherit"
    },
    { "type": "range", "id": "heading_letter_spacing", "min": -4, "max": 12, "step": 1, "unit": "px", "label": "Letter spacing", "default": 0 },
    { "type": "range", "id": "heading_line_height", "min": 0, "max": 2, "step": 0.1, "label": "Line height", "default": 0, "info": "0 = theme default" },
        { "type": "header", "content": "Heading format" },
        { "type": "select", "id": "heading_font_style", "label": "Font style", "options": [{ "value": "inherit", "label": "Theme default" }, { "value": "normal", "label": "Normal" }, { "value": "italic", "label": "Italic" }], "default": "inherit" },
        { "type": "select", "id": "heading_font_family", "label": "Font family", "options": [{ "value": "inherit", "label": "Theme default" }, { "value": "heading", "label": "Heading font" }, { "value": "body", "label": "Body font" }], "default": "inherit" },
        { "type": "range", "id": "heading_word_spacing", "min": -4, "max": 20, "step": 1, "unit": "px", "label": "Word spacing", "default": 0, "info": "0 = theme default" },
        { "type": "select", "id": "heading_text_transform", "label": "Text transform", "options": [{ "value": "inherit", "label": "Theme default" }, { "value": "none", "label": "None" }, { "value": "uppercase", "label": "Uppercase" }, { "value": "lowercase", "label": "Lowercase" }, { "value": "capitalize", "label": "Capitalize" }], "default": "inherit" },
