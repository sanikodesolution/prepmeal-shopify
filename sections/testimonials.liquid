{{ 'prep-content.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign meta_items = section.settings.testimonials
  assign use_meta = false
  if meta_items != blank and meta_items.size > 0
    assign use_meta = true
  endif
-%}

<section class="prep prep__section section-{{ section.id }}-padding" id="Testimonials-{{ section.id }}">
  <div class="prep__wrap">
    {% render 'section-heading',
      eyebrow: section.settings.eyebrow,
      title: section.settings.heading,
      text: section.settings.text,
      richtext: true,
      align: section.settings.heading_alignment
    %}

    {%- if use_meta -%}
      <ul class="prep__grid prep__grid--{{ section.settings.columns }}" role="list">
        {%- for item in meta_items -%}
          <li>{% render 'testimonial-card', item: item %}</li>
        {%- endfor -%}
      </ul>
    {%- elsif section.blocks.size > 0 -%}
      <ul class="prep__grid prep__grid--{{ section.settings.columns }}" role="list">
        {%- for block in section.blocks -%}
          <li>
            {% render 'testimonial-card',
              customer_name: block.settings.customer_name,
              photo: block.settings.photo,
              review: block.settings.review,
              rating: block.settings.rating,
              rating_max: 5,
              plan_name: block.settings.plan_name,
              shopify_attributes: block.shopify_attributes
            %}
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="prep-empty">{{ 'sections.prep.empty_state' | t }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "metaobject_list",
      "id": "testimonials",
      "label": "Testimonials (Metaobject)",
      "metaobject_type": "testimonial",
      "info": "When set, Metaobject entries replace blocks."
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by busy locals" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Real feedback from customers who stopped cooking every night.</p>"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Desktop columns",
      "default": 3
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "text", "id": "customer_name", "label": "Customer name", "default": "Sarah M." },
        { "type": "image_picker", "id": "photo", "label": "Photo" },
        {
          "type": "textarea",
          "id": "review",
          "label": "Review",
          "default": "These meals made weeknights so much easier. Fresh, filling, and actually delicious."
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Rating",
          "default": 5
        },
        { "type": "text", "id": "plan_name", "label": "Plan name", "default": "Lean 5-Day" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "customer_name": "Sarah M.",
            "review": "These meals made weeknights so much easier. Fresh, filling, and actually delicious.",
            "rating": 5,
            "plan_name": "Lean 5-Day"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "customer_name": "James R.",
            "review": "Macros are clear, portions are solid, and delivery is always on time.",
            "rating": 5,
            "plan_name": "Balance 6-Day"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "customer_name": "Priya K.",
            "review": "I stopped takeout. Heat and eat in two minutes — game changer.",
            "rating": 5,
            "plan_name": "Power 7-Day"
          }
        }
      ]
    }
  ]
}
{% endschema %}
