{{ 'prep-content.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #PrepHero-{{ section.id }} {
    min-height: {{ section.settings.min_height }}vh;
  }
{%- endstyle -%}

<section class="prep prep-hero" id="PrepHero-{{ section.id }}">
  {%- if section.settings.image != blank -%}
    <div class="prep-hero__media" aria-hidden="true">
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '750, 1100, 1500, 1780, 2000, 2400',
          sizes: '100vw',
          alt: ''
      }}
    </div>
  {%- endif -%}
  <div class="prep-hero__shade" aria-hidden="true"></div>

  <div class="prep__wrap">
    <div class="prep-hero__content">
      {% render 'section-heading',
        title: section.settings.heading,
        text: section.settings.subheading,
        richtext: false,
        align: 'left'
      %}

      {%- if section.settings.button_label != blank or section.settings.secondary_label != blank -%}
        <div class="prep-hero__actions">
          {%- if section.settings.button_label != blank -%}
            {%- assign prep_btn_link = section.settings.button_link | default: routes.all_products_collection_url -%}
            {% render 'pm-button',
              label: section.settings.button_label,
              link: prep_btn_link,
              style: 'brand',
              text_color: section.settings.button_text_color,
              bg_color: section.settings.button_bg_color,
              icon_bg: section.settings.button_icon_bg,
              icon_color: section.settings.button_icon_color,
              font_size: section.settings.button_font_size
            %}
          {%- endif -%}
          {%- if section.settings.secondary_label != blank -%}
            {%- assign prep_btn_link_2 = section.settings.secondary_link | default: '#' -%}
            {% render 'pm-button',
              label: section.settings.secondary_label,
              link: prep_btn_link_2,
              style: 'outline',
              text_color: section.settings.button_text_color_2,
              bg_color: section.settings.button_bg_color_2,
              icon_bg: section.settings.button_icon_bg_2,
              icon_color: section.settings.button_icon_color_2,
              font_size: section.settings.button_font_size_2
            %}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Prep hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A week of meals, ready."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Chef-cooked, calorie-counted meals delivered across Hartland."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button label",
      "default": "View plans"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    { "type": "header", "content": "Button style" },
    { "type": "color", "id": "button_text_color", "label": "Text color" },
    { "type": "color", "id": "button_bg_color", "label": "Background color" },
    { "type": "color", "id": "button_icon_bg", "label": "Icon background" },
    { "type": "color", "id": "button_icon_color", "label": "Icon color" },
    { "type": "range", "id": "button_font_size", "min": 12, "max": 24, "step": 1, "unit": "px", "label": "Font size", "default": 16 },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "How it works"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    },
    { "type": "header", "content": "Button 2 style" },
    { "type": "color", "id": "button_text_color_2", "label": "Text color" },
    { "type": "color", "id": "button_bg_color_2", "label": "Background color" },
    { "type": "color", "id": "button_icon_bg_2", "label": "Icon background" },
    { "type": "color", "id": "button_icon_color_2", "label": "Icon color" },
    { "type": "range", "id": "button_font_size_2", "min": 12, "max": 24, "step": 1, "unit": "px", "label": "Font size", "default": 16 },
    {
      "type": "range",
      "id": "min_height",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Minimum height",
      "default": 70
    }
  ],
  "presets": [
    {
      "name": "Prep hero"
    }
  ]
}
{% endschema %}
