{{ 'section-cm-gift-card.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section
  class="cm-gc cm-gc__faq section-{{ section.id }}-padding"
  style="--gc-accent: {{ section.settings.accent }}; --gc-ink: {{ section.settings.ink }}; --gc-paper: {{ section.settings.paper }};"
>
  {%- if section.settings.heading != blank -%}
    <h3 class="cm-gc__t">{{ section.settings.heading | escape }}</h3>
  {%- endif -%}
  {%- for block in section.blocks -%}
    <details {{ block.shopify_attributes }}>
      <summary>{{ block.settings.question | escape }}</summary>
      <div class="cm-gc__answer">{{ block.settings.answer }}</div>
    </details>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "GC FAQ",
  "tag": "section",
  "class": "section cm-section",
  "max_blocks": 20,
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Can they use it on any meal plan?" },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Yes. The balance applies at checkout to any meal plan on the menu.</p>"
        }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Gift card questions" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#f5a623" },
    { "type": "color", "id": "ink", "label": "Ink", "default": "#14213d" },
    { "type": "color", "id": "paper", "label": "Background", "default": "#fffdf8" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 72 }
  ],
  "presets": [
    {
      "name": "GC FAQ",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "Can they use it on any meal plan?",
            "answer": "<p>Yes. The balance applies at checkout to any meal plan on the menu.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How does the recipient get the card?",
            "answer": "<p>By email, on the date you choose. If you pick no date, it is sent right after checkout.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Can I buy more than one?",
            "answer": "<p>Yes. Add as many cards as you like, in any mix of amounts.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
