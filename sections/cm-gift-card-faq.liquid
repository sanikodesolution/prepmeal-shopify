{{ 'section-cm-gift-card.css' | asset_url | stylesheet_tag }}

{%- capture gc_faq_heading_style -%}
  {%- render 'pm-block-type-style', settings: section.settings, prefix: 'heading_' -%}
{%- endcapture -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section
  class="cm-gc cm-gc__faq section-{{ section.id }}-padding"
  style="--gc-accent: {{ section.settings.accent }}; --gc-ink: {{ section.settings.ink }}; --gc-paper: {{ section.settings.paper }};"
>
  {%- if section.settings.heading != blank -%}
    <h3
      class="cm-gc__t"
      {% if gc_faq_heading_style != blank %}
        style="{{ gc_faq_heading_style | strip }}"
      {% endif %}
    >
      {{- section.settings.heading | escape -}}
    </h3>
  {%- endif -%}
  {%- for block in section.blocks -%}
    {%- capture gc_faq_title_style -%}
      {%- render 'pm-block-type-style', block: block, prefix: 'title_' -%}
    {%- endcapture -%}
    {%- capture gc_faq_body_style -%}
      {%- render 'pm-block-type-style', block: block, prefix: 'body_' -%}
    {%- endcapture -%}
    <details {{ block.shopify_attributes }}>
      <summary
        {% if gc_faq_title_style != blank %}
          style="{{ gc_faq_title_style | strip }}"
        {% endif %}
      >
        {{- block.settings.question | escape -}}
      </summary>
      <div
        class="cm-gc__answer"
        {% if gc_faq_body_style != blank %}
          style="{{ gc_faq_body_style | strip }}"
        {% endif %}
      >
        {{ block.settings.answer }}
      </div>
    </details>
  {%- endfor -%}
</section>

