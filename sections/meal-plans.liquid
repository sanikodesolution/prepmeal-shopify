{{ 'prep-content.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign meta_items = section.settings.meal_plans
  assign use_meta = false
  if meta_items != blank and meta_items.size > 0
    assign use_meta = true
  endif
  assign columns = section.settings.columns | default: 3
-%}

<section
  class="prep prep__section section-{{ section.id }}-padding"
  id="MealPlans-{{ section.id }}"
  style="--prep-cream: {% case section.settings.background %}{% when 'warm' %}#f4f2ee{% when 'white' %}#ffffff{% else %}#fafaf8{% endcase %};"
>
  <div class="prep__wrap">
    {% render 'section-heading',
      eyebrow: section.settings.eyebrow,
      title: section.settings.heading,
      text: section.settings.text,
      richtext: true,
      align: section.settings.heading_alignment
    %}

    {%- if use_meta -%}
      <ul class="prep__grid prep__grid--{{ columns }}" role="list">
        {%- for plan in meta_items -%}
          <li>
            {% render 'meal-plan-card', plan: plan, lazy_load: forloop.index0 > 0 %}
          </li>
        {%- endfor -%}
      </ul>
    {%- elsif section.blocks.size > 0 -%}
      <ul class="prep__grid prep__grid--{{ columns }}" role="list">
        {%- for block in section.blocks -%}
          <li>
            {% render 'meal-plan-card',
              name: block.settings.name,
              image: block.settings.image,
              short_description: block.settings.short_description,
              meals_per_week: block.settings.meals_per_week,
              calories_per_meal: block.settings.calories_per_meal,
              protein: block.settings.protein,
              carbs: block.settings.carbs,
              fat: block.settings.fat,
              tags: block.settings.tags,
              product: block.settings.product,
              badge: block.settings.badge,
              shopify_attributes: block.shopify_attributes,
              lazy_load: forloop.index0 > 0
            %}
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="prep-empty">{{ 'sections.prep.empty_state' | t }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Meal plans",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "metaobject_list",
      "id": "meal_plans",
      "label": "Meal plans (Metaobject)",
      "metaobject_type": "meal_plan",
      "info": "When set, Metaobject entries replace blocks."
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Meal plans" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose your weekly plan" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Chef-cooked meals with calories counted. Pick a plan that fits your week.</p>"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Desktop columns",
      "default": 3
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "cream", "label": "Cream" },
        { "value": "warm", "label": "Warm" },
        { "value": "white", "label": "White" }
      ],
      "default": "cream"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ],
  "blocks": [
    {
      "type": "plan",
      "name": "Plan",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Lean 5-Day" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "short_description", "label": "Short description", "default": "High protein meals for busy weeks." },
        { "type": "number", "id": "meals_per_week", "label": "Meals per week", "default": 10 },
        { "type": "number", "id": "calories_per_meal", "label": "Calories per meal", "default": 450 },
        { "type": "number", "id": "protein", "label": "Protein (g)", "default": 35 },
        { "type": "number", "id": "carbs", "label": "Carbs (g)", "default": 30 },
        { "type": "number", "id": "fat", "label": "Fat (g)", "default": 12 },
        { "type": "text", "id": "tags", "label": "Tags", "info": "Comma-separated", "default": "High Protein, Low Oil" },
        { "type": "product", "id": "product", "label": "Linked product" },
        { "type": "text", "id": "badge", "label": "Badge", "default": "Best Seller" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Meal plans",
      "blocks": [
        {
          "type": "plan",
          "settings": {
            "name": "Lean 5-Day",
            "short_description": "High protein meals for busy weeks.",
            "meals_per_week": 10,
            "calories_per_meal": 450,
            "protein": 35,
            "carbs": 30,
            "fat": 12,
            "tags": "High Protein, Low Oil",
            "badge": "Best Seller"
          }
        },
        {
          "type": "plan",
          "settings": {
            "name": "Balance 6-Day",
            "short_description": "Balanced macros, chef-cooked fresh.",
            "meals_per_week": 12,
            "calories_per_meal": 500,
            "protein": 32,
            "carbs": 40,
            "fat": 14,
            "tags": "Balanced",
            "badge": ""
          }
        },
        {
          "type": "plan",
          "settings": {
            "name": "Power 7-Day",
            "short_description": "Full-week fuel with bigger portions.",
            "meals_per_week": 14,
            "calories_per_meal": 550,
            "protein": 40,
            "carbs": 45,
            "fat": 16,
            "tags": "High Protein",
            "badge": ""
          }
        }
      ]
    }
  ]
}
{% endschema %}
