{{ 'section-cm-featured-plan.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
-%}
{%- capture fp_eyebrow_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'eyebrow_' -%}
{%- endcapture -%}
{%- capture fp_heading_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'heading_' -%}
{%- endcapture -%}
{%- capture fp_body_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'body_' -%}
{%- endcapture -%}
{%- capture fp_note_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'note_' -%}
{%- endcapture -%}

<section class="cm-table" id="WeeklyTable-{{ section.id }}">
  <div class="page-width">
    <div class="cm-table__layout">
      <div class="cm-table__stage">
        <span class="cm-table__ring"></span>
        {% render 'asset-image', src: 'cm-usp-portions.jpg', class: 'cm-table__plate cm-table__plate--a', alt: 'Generous chef-prepared portion', width: 1000, height: 1333, widths: '400, 700, 1000', sizes: '18rem' %}
        {% render 'asset-image', src: 'cm-healthy-meals.jpg', class: 'cm-table__plate cm-table__plate--main', alt: 'Chef Matt healthy meal', width: 1400, height: 1400, widths: '500, 800, 1200, 1400', sizes: '(min-width: 990px) 38rem, 70vw' %}
        {% render 'asset-image', src: 'cm-usp-balance.jpg', class: 'cm-table__plate cm-table__plate--b', alt: 'Balanced plated meal', width: 1000, height: 1333, widths: '400, 700, 1000', sizes: '16rem' %}
        {%- if section.settings.stamp_value != blank -%}
          <p class="cm-table__stamp">
            <strong>{{ section.settings.stamp_value | escape }}</strong>
            <span>{{ section.settings.stamp_label | escape }}</span>
          </p>
        {%- endif -%}
      </div>

      <div class="cm-table__copy">
        {%- if s.eyebrow != blank -%}
          <p
            class="cm-table__eyebrow"
            {% if fp_eyebrow_style != blank %}
              style="{{ fp_eyebrow_style | strip }}"
            {% endif %}
          >
            {{- s.eyebrow | escape -}}
          </p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2
            class="cm-table__title"
            {% if fp_heading_style != blank %}
              style="{{ fp_heading_style | strip }}"
            {% endif %}
          >
            {{- s.heading | escape | newline_to_br -}}
          </h2>
        {%- endif -%}
        {%- if s.text != blank -%}
          <div
            class="cm-table__text"
            {% if fp_body_style != blank %}
              style="{{ fp_body_style | strip }}"
            {% endif %}
          >
            {{ s.text }}
          </div>
        {%- endif -%}

        {%- assign dishes = section.blocks | where: 'type', 'dish' -%}
        {%- if dishes.size > 0 -%}
          <ol class="cm-table__menu">
            {%- for block in dishes -%}
              {%- capture dish_title_style -%}
                {%- render 'pm-block-type-style', block: block, prefix: 'title_' -%}
              {%- endcapture -%}
              {%- capture dish_body_style -%}
                {%- render 'pm-block-type-style', block: block, prefix: 'body_' -%}
              {%- endcapture -%}
              <li class="cm-table__dish" {{ block.shopify_attributes }}>
                <span class="cm-table__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                <span>
                  <span
                    class="cm-table__name"
                    {% if dish_title_style != blank %}
                      style="{{ dish_title_style | strip }}"
                    {% endif %}
                  >
                    {{- block.settings.name | escape -}}
                  </span>
                  {%- if block.settings.note != blank -%}
                    <span
                      class="cm-table__note"
                      {% if dish_body_style != blank %}
                        style="{{ dish_body_style | strip }}"
                      {% endif %}
                    >
                      {{- block.settings.note | escape -}}
                    </span>
                  {%- endif -%}
                </span>
                {%- if block.settings.tag != blank -%}
                  <span class="cm-table__tag">{{ block.settings.tag | escape }}</span>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ol>
        {%- endif -%}

        <div class="cm-table__foot">
          {%- if section.settings.meta_title != blank or section.settings.meta_text != blank -%}
            <p
              class="cm-table__meta"
              {% if fp_note_style != blank %}
                style="{{ fp_note_style | strip }}"
              {% endif %}
            >
              {%- if s.meta_title != blank -%}
                <strong>{{ s.meta_title | escape }}</strong>
              {%- endif -%}
              {{ s.meta_text | escape }}
            </p>
          {%- endif -%}
          {%- if section.settings.button_label != blank -%}
            {%- assign featured_btn_link = section.settings.button_link | default: routes.all_products_collection_url -%}
            {% render 'pm-button',
              label: section.settings.button_label,
              link: featured_btn_link,
              style: 'brand',
              class: 'cm-table__cta',
              text_color: section.settings.button_text_color,
              bg_color: section.settings.button_bg_color,
              icon_bg: section.settings.button_icon_bg,
              icon_color: section.settings.button_icon_color,
              font_size: section.settings.button_font_size, hover_text_color: section.settings.button_hover_text_color, hover_bg_color: section.settings.button_hover_bg_color
            %}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

