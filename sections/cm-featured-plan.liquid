{{ 'section-cm-featured-plan.css' | asset_url | stylesheet_tag }}

<section class="cm-table" id="WeeklyTable-{{ section.id }}">
  <div class="page-width">
    <div class="cm-table__layout">
      <div class="cm-table__stage">
        <span class="cm-table__ring"></span>
        {% render 'asset-image', src: 'cm-usp-portions.jpg', class: 'cm-table__plate cm-table__plate--a', alt: 'Generous chef-prepared portion', width: 1000, height: 1333, widths: '400, 700, 1000', sizes: '18rem' %}
        {% render 'asset-image', src: 'cm-healthy-meals.jpg', class: 'cm-table__plate cm-table__plate--main', alt: 'Chef Matt healthy meal', width: 1400, height: 1400, widths: '500, 800, 1200, 1400', sizes: '(min-width: 990px) 38rem, 70vw' %}
        {% render 'asset-image', src: 'cm-usp-balance.jpg', class: 'cm-table__plate cm-table__plate--b', alt: 'Balanced plated meal', width: 1000, height: 1333, widths: '400, 700, 1000', sizes: '16rem' %}
        {%- if section.settings.stamp_value != blank -%}
          <p class="cm-table__stamp">
            <strong>{{ section.settings.stamp_value | escape }}</strong>
            <span>{{ section.settings.stamp_label | escape }}</span>
          </p>
        {%- endif -%}
      </div>

      <div class="cm-table__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="cm-table__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="cm-table__title">{{ section.settings.heading | escape | newline_to_br }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="cm-table__text">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- assign dishes = section.blocks | where: 'type', 'dish' -%}
        {%- if dishes.size > 0 -%}
          <ol class="cm-table__menu">
            {%- for block in dishes -%}
              <li class="cm-table__dish" {{ block.shopify_attributes }}>
                <span class="cm-table__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                <span>
                  <span class="cm-table__name">{{ block.settings.name | escape }}</span>
                  {%- if block.settings.note != blank -%}
                    <span class="cm-table__note">{{ block.settings.note | escape }}</span>
                  {%- endif -%}
                </span>
                {%- if block.settings.tag != blank -%}
                  <span class="cm-table__tag">{{ block.settings.tag | escape }}</span>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ol>
        {%- endif -%}

        <div class="cm-table__foot">
          {%- if section.settings.meta_title != blank or section.settings.meta_text != blank -%}
            <p class="cm-table__meta">
              {%- if section.settings.meta_title != blank -%}
                <strong>{{ section.settings.meta_title | escape }}</strong>
              {%- endif -%}
              {{ section.settings.meta_text | escape }}
            </p>
          {%- endif -%}
          {%- if section.settings.button_label != blank -%}
            <a class="cm-table__cta" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
              {{ section.settings.button_label | escape }}
              <span aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M8 7h9v9"/></svg>
              </span>
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CM weekly table",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "stamp_value", "label": "Badge value", "default": "Week 14" },
    { "type": "text", "id": "stamp_label", "label": "Badge label", "default": "On the pass" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "This week at the table" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Food worth\ncoming home to" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>A short menu, cooked from scratch and packed for the week. Heat, eat, and get on with your evening.</p>" },
    { "type": "text", "id": "meta_title", "label": "Footer title", "default": "From 5 meals" },
    { "type": "text", "id": "meta_text", "label": "Footer text", "default": "No subscription. New menu every week." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "See the menu" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "dish",
      "name": "Dish",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Peri peri chicken" },
        { "type": "text", "id": "note", "label": "Note", "default": "Citrus, chilli, and herbs" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "High protein" }
      ]
    }
  ],
  "presets": [
    { "name": "CM weekly table" }
  ]
}
{% endschema %}
