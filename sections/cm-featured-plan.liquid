{{ 'section-cm-featured-plan.css' | asset_url | stylesheet_tag }}

<section class="cm-fp" id="FeaturedPlan-{{ section.id }}">
  <div class="page-width">
    <div class="cm-fp__card">
      <div class="cm-fp__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 700, 900', sizes: '(min-width: 990px) 40vw, 90vw', alt: section.settings.image_alt }}
        {%- else -%}
          <img
            src="{{ 'cm-da-plate-br.webp' | asset_url }}"
            alt="{{ section.settings.image_alt | escape }}"
            width="640"
            height="640"
            loading="lazy"
          >
        {%- endif -%}
        {%- if section.settings.badge != blank -%}
          <span class="cm-fp__badge">{{ section.settings.badge | escape }}</span>
        {%- endif -%}
      </div>

      <div class="cm-fp__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="cm-fp__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="cm-fp__title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="cm-fp__text">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- assign facts = section.blocks | where: 'type', 'fact' -%}
        {%- if facts.size > 0 -%}
          <ul class="cm-fp__facts">
            {%- for block in facts -%}
              <li {{ block.shopify_attributes }}>
                <strong>{{ block.settings.title | escape }}</strong>
                <span>{{ block.settings.text | escape }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <div class="cm-fp__actions">
          {%- if section.settings.button_label != blank -%}
            <a class="cm-fp__cta" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
              {{ section.settings.button_label | escape }}
              <span aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M8 7h9v9"/></svg>
              </span>
            </a>
          {%- endif -%}
          {%- if section.settings.link_label != blank -%}
            <a class="cm-fp__link" href="{{ section.settings.link_url | default: '/pages/how-it-works' }}">{{ section.settings.link_label | escape }}</a>
          {%- endif -%}
        </div>

        {%- assign plans = section.blocks | where: 'type', 'plan' -%}
        {%- if plans.size > 0 -%}
          <div class="cm-fp__plans">
            {%- for block in plans -%}
              <a class="cm-fp__plan" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
                <em>{{ block.settings.count | escape }}</em>
                {{ block.settings.label | escape }}
              </a>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CM featured plan",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Weekly meal plans" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real meals, ready when you are" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Pick a plan, we cook it from scratch, and it arrives at your door. No subscription.</p>" },
    { "type": "text", "id": "badge", "label": "Image badge", "default": "Delivered fresh" },
    { "type": "image_picker", "id": "image", "label": "Plate image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Chef prepared meal" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Order your plan" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "link_label", "label": "Text link label", "default": "How it works" },
    { "type": "url", "id": "link_url", "label": "Text link" }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Chef-made" },
        { "type": "text", "id": "text", "label": "Text", "default": "Cooked from scratch" }
      ]
    },
    {
      "type": "plan",
      "name": "Plan",
      "settings": [
        { "type": "text", "id": "count", "label": "Count", "default": "5" },
        { "type": "text", "id": "label", "label": "Label", "default": "Meal plan" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    { "name": "CM featured plan" }
  ]
}
{% endschema %}
