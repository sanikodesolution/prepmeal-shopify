{{ 'prep-content.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign meta_items = section.settings.steps
  assign use_meta = false
  if meta_items != blank and meta_items.size > 0
    assign use_meta = true
  endif
-%}

<section class="prep prep__section section-{{ section.id }}-padding" id="HowItWorks-{{ section.id }}">
  <div class="prep__wrap">
    {% render 'section-heading',
      eyebrow: section.settings.eyebrow,
      title: section.settings.heading,
      text: section.settings.text,
      richtext: true,
      align: section.settings.heading_alignment
    %}

    {%- if use_meta -%}
      <ol class="prep__grid prep__grid--{{ section.settings.columns }} list-unstyled" role="list">
        {%- for step in meta_items -%}
          {% render 'how-it-works-step', step: step, index: forloop.index %}
        {%- endfor -%}
      </ol>
    {%- elsif section.blocks.size > 0 -%}
      <ol class="prep__grid prep__grid--{{ section.settings.columns }} list-unstyled" role="list">
        {%- for block in section.blocks -%}
          {% render 'how-it-works-step',
            step_number: block.settings.step_number | default: forloop.index,
            title: block.settings.title,
            description: block.settings.description,
            icon: block.settings.icon,
            index: forloop.index,
            shopify_attributes: block.shopify_attributes
          %}
        {%- endfor -%}
      </ol>
    {%- else -%}
      <p class="prep-empty">{{ 'sections.prep.empty_state' | t }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "metaobject_list",
      "id": "steps",
      "label": "Steps (Metaobject)",
      "metaobject_type": "how_it_works_step",
      "info": "When set, Metaobject entries replace blocks."
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From our kitchen to your fridge" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Four simple steps. Fresh meals without the cooking.</p>"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Desktop columns",
      "default": 4
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "number", "id": "step_number", "label": "Step number", "default": 1 },
        { "type": "text", "id": "title", "label": "Title", "default": "Pick your plan" },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Choose meals that match your goals and schedule."
        },
        { "type": "image_picker", "id": "icon", "label": "Icon / image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "step_number": 1,
            "title": "Pick your plan",
            "description": "Choose meals that match your goals and schedule."
          }
        },
        {
          "type": "step",
          "settings": {
            "step_number": 2,
            "title": "We cook fresh",
            "description": "Chef-prepared meals made from scratch — nothing frozen."
          }
        },
        {
          "type": "step",
          "settings": {
            "step_number": 3,
            "title": "We deliver",
            "description": "Meals arrive at your door on your selected days."
          }
        },
        {
          "type": "step",
          "settings": {
            "step_number": 4,
            "title": "Heat and eat",
            "description": "Two minutes in the microwave. No cooking, no mess."
          }
        }
      ]
    }
  ]
}
{% endschema %}
