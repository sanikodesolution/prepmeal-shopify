{% render 'cm-section-assets', section: section %}
{{ 'section-cm-meal-plan-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cm-meal-plan-page.js' | asset_url }}" defer="defer"></script>
{%- if request.design_mode -%}
  <script src="{{ 'cm-meal-plan-editor.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{% comment %} include (not render) so assigns leak into this section {% endcomment %}
{% include 'cm-mp-context' %}
{%- liquid
  assign s = section.settings
-%}
{%- capture mp_eyebrow_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'eyebrow_' -%}
{%- endcapture -%}
{%- capture mp_heading_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'heading_' -%}
{%- endcapture -%}
{%- capture mp_body_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'body_' -%}
{%- endcapture -%}


<div class="mealplan-page" data-mp-page data-cm="meal-plan-faq" {% render 'pm-section-style', section: section %}>
  <div class="mealplan">
    <section class="mealplan-sec"><div class="mealplan-wrap mealplan-faq">
      <div>
        {%- if c_faq_eyebrow != blank -%}
          <p class="mp-eye"
        {% if mp_eyebrow_style != blank %}
          style="{{ mp_eyebrow_style | strip }}"
        {% endif %}
      >{{ c_faq_eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="mealplan-h"
        {% if mp_heading_style != blank %}
          style="{{ mp_heading_style | strip }}"
        {% endif %}
      >{{ c_faq_heading | escape }}</h2>
      </div>
      <div id="faq">
        {%- if faq_blocks.size > 0 -%}
          {%- for block in faq_blocks -%}
            <div class="mealplan-qi" {{ block.shopify_attributes }}{% render 'pm-area-style', block: block %}>
              {%- capture faq_title_style -%}
                {%- render 'pm-block-type-style', block: block, prefix: 'title_' -%}
              {%- endcapture -%}
              {%- capture faq_body_style -%}
                {%- render 'pm-block-type-style', block: block, prefix: 'body_' -%}
              {%- endcapture -%}
              <button type="button" class="mealplan-qb"
                {% if faq_title_style != blank %}
                  style="{{ faq_title_style | strip }}"
                {% endif %} aria-expanded="false" aria-controls="mp-a-{{ section.id }}-{{ forloop.index }}">
                {{ block.settings.question | escape }}<i></i>
              </button>
              <div class="mealplan-qa" id="mp-a-{{ section.id }}-{{ forloop.index }}"><div><p
                  {% if faq_body_style != blank %}
                    style="{{ faq_body_style | strip }}"
                  {% endif %}
                >{{ block.settings.answer | escape }}</p></div></div>
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for row in faq_rows -%}
            {%- assign cells = row | split: '|' -%}
            <div class="mealplan-qi">
              <button type="button" class="mealplan-qb" aria-expanded="false" aria-controls="mp-a-{{ section.id }}-{{ forloop.index }}">
                {{ cells[0] | escape }}<i></i>
              </button>
              <div class="mealplan-qa" id="mp-a-{{ section.id }}-{{ forloop.index }}"><div><p>{{ cells[1] | escape }}</p></div></div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div></section>
  </div>
</div>

