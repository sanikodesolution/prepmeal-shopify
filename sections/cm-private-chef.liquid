{% render 'cm-section-assets', section: section %}
{{ 'section-cm-private-chef.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign perks = section.blocks | where: 'type', 'perk'
  assign occasions = section.blocks | where: 'type', 'occasion'
  assign expects = section.blocks | where: 'type', 'expect'
  assign steps = section.blocks | where: 'type', 'step'
  assign fields = section.blocks | where: 'type', 'field'
  assign form_id = 'PcQuoteForm-' | append: section.id
  assign phone_digits = section.settings.phone | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', ''
-%}

<div class="cm cm-pc" data-cm="private-chef">
  <header class="cm-pc__hero">
    <div class="cm-pc__wrap cm-pc__hero-grid">
      <div>
        <h1 class="cm-pc__title">
          {{- section.settings.heading | escape -}}
          {%- if section.settings.heading_highlight != blank %}
            <em>{{ section.settings.heading_highlight | escape }}</em>
          {%- endif -%}
        </h1>
        {%- if section.settings.text != blank -%}
          <div class="cm-pc__lead">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a class="cm-btn cm-pc__btn" href="#pc-quote">{{ section.settings.button_label | escape }}</a>
        {%- endif -%}
        {%- if section.settings.quiet != blank or section.settings.phone != blank -%}
          <div class="cm-pc__quiet">
            {%- if section.settings.quiet != blank -%}
              {{ section.settings.quiet | escape }}
            {%- endif -%}
            {%- if section.settings.quiet != blank and section.settings.phone != blank %}
              &middot;
            {%- endif -%}
            {%- if section.settings.phone != blank -%}
              <a href="tel:{{ phone_digits }}">Call {{ section.settings.phone | escape }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <aside class="cm-pc__card" aria-label="{{ section.settings.card_title | default: 'Sample evening' | escape }}">
        {%- if section.settings.card_title != blank -%}
          <h2>{{ section.settings.card_title | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.card_sub != blank -%}
          <div class="cm-pc__card-sub">{{ section.settings.card_sub | escape }}</div>
        {%- endif -%}
        {%- if steps.size > 0 -%}
          <ol>
            {%- for block in steps -%}
              <li {{ block.shopify_attributes }}>
                <span>{{ forloop.index }}</span>
                {{ block.settings.title | escape }}
              </li>
            {%- endfor -%}
          </ol>
        {%- endif -%}
        {%- if section.settings.card_foot != blank -%}
          <p class="cm-pc__card-foot">{{ section.settings.card_foot | escape }}</p>
        {%- endif -%}
      </aside>
    </div>
  </header>

  {%- if section.settings.intro_heading != blank or section.settings.intro_text != blank or perks.size > 0 -%}
    <section class="cm-pc__section">
      <div class="cm-pc__wrap cm-pc__intro">
        {%- if section.settings.intro_heading != blank -%}
          <h2 class="cm-pc__h2">{{ section.settings.intro_heading | escape }}</h2>
        {%- endif -%}
        <div>
          {%- if section.settings.intro_text != blank -%}
            <div class="cm-pc__intro-lead">{{ section.settings.intro_text }}</div>
          {%- endif -%}
          {%- if perks.size > 0 -%}
            <div class="cm-pc__nos">
              {%- for block in perks -%}
                <span {{ block.shopify_attributes }}>
                  {%- if block.settings.title != blank -%}
                    {{ block.settings.title | escape }}
                  {%- else -%}
                    {{ block.settings.text | escape }}
                  {%- endif -%}
                </span>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- if occasions.size > 0 -%}
    <section class="cm-pc__section cm-pc__occ">
      <div class="cm-pc__wrap">
        {%- if section.settings.occasions_heading != blank -%}
          <h2 class="cm-pc__h2">{{ section.settings.occasions_heading | escape }}</h2>
        {%- endif -%}
        <ul class="cm-pc__chips">
          {%- for block in occasions -%}
            <li {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</li>
          {%- endfor -%}
        </ul>
      </div>
    </section>
  {%- endif -%}

  {%- if expects.size > 0 or section.settings.expect_heading != blank or section.settings.quote != blank -%}
    <section class="cm-pc__section cm-pc__exp">
      <div class="cm-pc__wrap cm-pc__exp-grid">
        <div>
          {%- if section.settings.expect_heading != blank -%}
            <h2 class="cm-pc__h2">{{ section.settings.expect_heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.quote != blank -%}
            <p class="cm-pc__exp-text">{{ section.settings.quote | escape }}</p>
          {%- endif -%}
        </div>
        {%- if expects.size > 0 -%}
          <ul class="cm-pc__list">
            {%- for block in expects -%}
              <li {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </section>
  {%- endif -%}

  {%- if steps.size > 0 -%}
    <section class="cm-pc__section cm-pc__how" id="pc-how">
      <div class="cm-pc__wrap">
        {%- if section.settings.steps_heading != blank -%}
          <h2 class="cm-pc__h2">{{ section.settings.steps_heading | escape }}</h2>
        {%- endif -%}
        <ol class="cm-pc__steps">
          {%- for block in steps -%}
            <li {{ block.shopify_attributes }}>
              <h3>{{ block.settings.title | escape }}</h3>
              {%- if block.settings.text != blank -%}
                <p>{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ol>
      </div>
    </section>
  {%- endif -%}

  <section class="cm-pc__section cm-pc__quote" id="pc-quote">
    <div class="cm-pc__wrap cm-pc__form-grid">
      <div class="cm-pc__quote-side">
        {%- if section.settings.form_heading != blank -%}
          <h2 class="cm-pc__h2">{{ section.settings.form_heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.form_text != blank -%}
          <div class="cm-pc__quote-text">{{ section.settings.form_text }}</div>
        {%- endif -%}
        {%- if section.settings.form_note != blank -%}
          <span class="cm-pc__price">{{ section.settings.form_note | escape }}</span>
        {%- endif -%}
      </div>

      {%- form 'contact', id: form_id, class: 'cm-pc__form' -%}
        <input type="hidden" name="contact[Form]" value="{{ section.settings.form_heading | default: 'Private chef quote' | escape }}">
        <div class="cm-form__fields">
          {%- if form.posted_successfully? -%}
            <p class="cm-form__notice cm-form__notice--success" role="status" tabindex="-1" autofocus>
              {{ section.settings.success_message | escape }}
            </p>
          {%- elsif form.errors -%}
            <div class="cm-form__notice cm-form__notice--error" role="alert" tabindex="-1" autofocus>
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          {%- for block in fields -%}
            {%- liquid
              assign field_id = form_id | append: '-' | append: block.id
              assign field_type = block.settings.type
              if field_type == 'email'
                assign field_name = 'contact[email]'
              else
                assign field_name = block.settings.label | escape | prepend: 'contact[' | append: ']'
              endif
            -%}
            <div class="cm-field{% if block.settings.half_width %} cm-field--half{% endif %}" {{ block.shopify_attributes }}>
              <label for="{{ field_id }}">
                {{- block.settings.label | escape -}}
                {%- if block.settings.required -%}
                  <span class="cm-field__req" aria-hidden="true">*</span>
                {%- endif -%}
              </label>
              {%- case field_type -%}
                {%- when 'textarea' -%}
                  <textarea
                    id="{{ field_id }}"
                    name="{{ field_name }}"
                    rows="4"
                    placeholder="{{ block.settings.placeholder | escape }}"
                    {% if block.settings.required %}required aria-required="true"{% endif %}
                  ></textarea>
                {%- when 'select' -%}
                  {%- assign options = block.settings.options | newline_to_br | split: '<br />' -%}
                  <select
                    id="{{ field_id }}"
                    name="{{ field_name }}"
                    {% if block.settings.required %}required aria-required="true"{% endif %}
                  >
                    <option value="">{{ block.settings.placeholder | default: 'Select event type' | escape }}</option>
                    {%- for option in options -%}
                      {%- assign option = option | strip -%}
                      {%- if option != blank -%}
                        <option value="{{ option | escape }}">{{ option | escape }}</option>
                      {%- endif -%}
                    {%- endfor -%}
                  </select>
                {%- else -%}
                  <input
                    type="{{ field_type }}"
                    id="{{ field_id }}"
                    name="{{ field_name }}"
                    placeholder="{{ block.settings.placeholder | escape }}"
                    {% if field_type == 'email' %}autocomplete="email" autocapitalize="off" autocorrect="off"
                    {% elsif field_type == 'tel' %}autocomplete="tel"
                    {% elsif field_type == 'number' %}min="1" inputmode="numeric"
                    {% elsif field_type == 'text' %}autocomplete="name"
                    {% endif %}
                    {% if block.settings.required %}required aria-required="true"{% endif %}
                  >
              {%- endcase -%}
            </div>
          {%- endfor -%}
        </div>

        <button type="submit" class="cm-btn cm-pc__btn cm-form__submit">
          {{- section.settings.form_button_label | escape -}}
        </button>
      {%- endform -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "CM private chef",
  "tag": "section",
  "class": "section cm-section",
  "max_blocks": 50,
  "blocks": [
    {
      "type": "perk",
      "name": "Promise pill",
      "settings": [
        { "type": "text", "id": "title", "label": "Label", "default": "No crowded restaurants" },
        { "type": "text", "id": "text", "label": "Fallback text" }
      ]
    },
    {
      "type": "occasion",
      "name": "Occasion",
      "settings": [{ "type": "text", "id": "label", "label": "Label", "default": "Birthdays" }]
    },
    {
      "type": "expect",
      "name": "Expect item",
      "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Custom-curated menu" }]
    },
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Submit your event details" },
        { "type": "text", "id": "text", "label": "Supporting text (optional)" }
      ]
    },
    {
      "type": "field",
      "name": "Form field",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Name" },
        {
          "type": "select",
          "id": "type",
          "label": "Type",
          "options": [
            { "value": "text", "label": "Text" },
            { "value": "email", "label": "Email" },
            { "value": "tel", "label": "Phone" },
            { "value": "number", "label": "Number" },
            { "value": "date", "label": "Date" },
            { "value": "textarea", "label": "Long text" },
            { "value": "select", "label": "Dropdown" }
          ],
          "default": "text"
        },
        { "type": "text", "id": "placeholder", "label": "Placeholder" },
        {
          "type": "textarea",
          "id": "options",
          "label": "Dropdown options",
          "info": "One option per line. Only used for the Dropdown type."
        },
        { "type": "checkbox", "id": "required", "label": "Required", "default": false },
        { "type": "checkbox", "id": "half_width", "label": "Half width on desktop", "default": true }
      ]
    }
  ],
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Restaurant-level dining," },
    { "type": "text", "id": "heading_highlight", "label": "Heading highlight", "default": "in your own home." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>A private dining experience crafted by a chef with over 40 years of culinary mastery. Chef Matt designs a fully custom menu around your guests, your tastes, and your occasion.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Quote button label", "default": "Request a quote" },
    { "type": "text", "id": "quiet", "label": "Quiet line", "default": "Serving Milwaukee" },
    { "type": "text", "id": "phone", "label": "Phone number", "default": "+1 (920) 355-1137" },
    { "type": "header", "content": "Hero menu card" },
    { "type": "text", "id": "card_title", "label": "Card title", "default": "Tonight, at your table" },
    { "type": "text", "id": "card_sub", "label": "Card subtitle", "default": "Cooked and served in your home" },
    { "type": "text", "id": "card_foot", "label": "Card footer", "default": "Classical French technique, globally inspired flavors" },
    { "type": "header", "content": "Intro" },
    {
      "type": "text",
      "id": "intro_heading",
      "label": "Heading",
      "default": "Your home, your guests, one unforgettable evening."
    },
    {
      "type": "richtext",
      "id": "intro_text",
      "label": "Text",
      "default": "<p>Whether you're celebrating a birthday, anniversary, girls' night, romantic dinner, or hosting a team gathering, the menu is built for you. Just exceptional food, thoughtful presentation, and an evening created exclusively for your table.</p>"
    },
    { "type": "header", "content": "Occasions" },
    { "type": "text", "id": "occasions_heading", "label": "Heading", "default": "Perfect for" },
    { "type": "header", "content": "What to expect" },
    { "type": "text", "id": "expect_heading", "label": "Heading", "default": "What you can expect" },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Supporting text",
      "default": "From classical French techniques to globally inspired flavors, every dish reflects decades of culinary experience."
    },
    { "type": "header", "content": "Steps" },
    { "type": "text", "id": "steps_heading", "label": "Heading", "default": "How it works" },
    { "type": "header", "content": "Quote form" },
    { "type": "text", "id": "form_heading", "label": "Heading", "default": "Let's plan your evening" },
    {
      "type": "richtext",
      "id": "form_text",
      "label": "Text",
      "default": "<p>Exceptional, memorable, custom catered events. Why not stay at home and let me create a special menu for your event?</p>"
    },
    { "type": "text", "id": "form_note", "label": "Price note", "default": "Cost: contact for quotes" },
    { "type": "text", "id": "form_button_label", "label": "Button label", "default": "Request a quote" },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Quote request sent. Chef Matt will contact you with a custom menu plan."
    }
  ],
  "presets": [
    {
      "name": "CM private chef",
      "blocks": [
        { "type": "perk", "settings": { "title": "No crowded restaurants" } },
        { "type": "perk", "settings": { "title": "No rushed service" } },
        { "type": "perk", "settings": { "title": "No cleanup stress" } },
        { "type": "occasion", "settings": { "label": "Birthdays" } },
        { "type": "occasion", "settings": { "label": "Anniversaries" } },
        { "type": "occasion", "settings": { "label": "Date nights" } },
        { "type": "expect", "settings": { "text": "Custom-curated menu" } },
        { "type": "expect", "settings": { "text": "Professional in-home preparation" } },
        { "type": "step", "settings": { "title": "Submit your event details" } },
        { "type": "step", "settings": { "title": "We design your custom menu" } },
        { "type": "field", "settings": { "label": "Name", "type": "text", "required": true } },
        { "type": "field", "settings": { "label": "Email", "type": "email", "required": true } }
      ]
    }
  ]
}
{% endschema %}
