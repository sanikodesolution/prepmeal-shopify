{% render 'cm-section-assets', section: section %}
{{ 'section-cm-private-chef.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign perks = section.blocks | where: 'type', 'perk'
-%}
{%- capture pc_eyebrow_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'eyebrow_' -%}
{%- endcapture -%}
{%- capture pc_heading_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'heading_' -%}
{%- endcapture -%}
{%- capture pc_body_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'body_' -%}
{%- endcapture -%}

<div class="cm cm-pc" data-cm="private-chef">
  <header class="cm-pc__hero">
    <div class="cm-pc__wrap cm-pc__hero-grid">
      <div>
        {%- if s.eyebrow != blank -%}
          <span
            class="cm-label"
            {% if pc_eyebrow_style != blank %}
              style="{{ pc_eyebrow_style | strip }}"
            {% endif %}
          >{{ s.eyebrow | escape }}</span>
        {%- endif -%}
        <h1
          class="cm-pc__title"
          {% if pc_heading_style != blank %}
            style="{{ pc_heading_style | strip }}"
          {% endif %}
        >
          {{- s.heading | escape -}}
          {%- if s.heading_highlight != blank %}
            <em>{{ s.heading_highlight | escape }}</em>
          {%- endif -%}
        </h1>
        {%- if s.text != blank -%}
          <div
            class="cm-pc__lead"
            {% if pc_body_style != blank %}
              style="{{ pc_body_style | strip }}"
            {% endif %}
          >{{ s.text }}</div>
        {%- endif -%}
        <div class="cm-pc__actions">
          {%- if section.settings.button_label != blank -%}
            <a class="cm-btn cm-pc__btn" href="{{ section.settings.button_link | default: '#pc-quote' }}">
              {{- section.settings.button_label | escape -}}
            </a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a class="cm-btn cm-pc__btn cm-pc__btn--ghost" href="{{ section.settings.button_link_2 | default: '#pc-how' }}">
              {{- section.settings.button_label_2 | escape -}}
            </a>
          {%- endif -%}
        </div>
      </div>
      {%- if section.settings.plate_number != blank -%}
        <div class="cm-pc__plate" aria-hidden="true">
          <div>
            <b>{{ section.settings.plate_number | escape }}</b>
            <span>{{ section.settings.plate_label | escape }}</span>
          </div>
        </div>
      {%- endif -%}
    </div>
  </header>

  {%- if perks.size > 0 -%}
    <div class="cm-pc__strip">
      <div class="cm-pc__wrap cm-pc__strip-grid" style="--pc-cols: {{ perks.size | at_most: 4 }};">
        {%- for block in perks -%}
          {%- capture pc_perk_title_style -%}
            {%- render 'pm-block-type-style', block: block, prefix: 'title_' -%}
          {%- endcapture -%}
          {%- capture pc_perk_body_style -%}
            {%- render 'pm-block-type-style', block: block, prefix: 'body_' -%}
          {%- endcapture -%}
          <div {{ block.shopify_attributes }}>
            <strong
              {% if pc_perk_title_style != blank %}
                style="{{ pc_perk_title_style | strip }}"
              {% endif %}
            >{{ block.settings.title | escape }}</strong>
            {%- if block.settings.text != blank -%}
              <span
                {% if pc_perk_body_style != blank %}
                  style="{{ pc_perk_body_style | strip }}"
                {% endif %}
              >{{ block.settings.text | escape }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

