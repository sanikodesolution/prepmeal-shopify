{% render 'cm-section-assets', section: section %}

{%- liquid
  assign layout = section.settings.layout | default: 'grid'
  assign columns = section.blocks.size
  if columns > 4
    assign columns = 4
  endif
-%}

{%- if layout == 'timeline' -%}
  <script src="{{ 'cm-hiw-timeline.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<div
  class="cm cm-steps cm-steps--{{ layout }} cm--{{ section.settings.background }}"
  data-cm="steps"
  {% if layout == 'timeline' %}
    id="cm-hiw-{{ section.id }}"
    data-cm-hiw
    style="--p: 0;"
  {% endif %}
>
  {%- if layout == 'timeline' -%}
    <div class="page-width section-{{ section.id }}-padding">
      <div class="cm-hiw__wrap">
        <div class="cm-hiw__intro">
          {%- if section.settings.label != blank -%}
            <span class="cm-label">{{ section.settings.label | escape }}</span>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="cm-hiw__title" id="cm-hiw-title-{{ section.id }}">
              {{ section.settings.heading | escape | newline_to_br }}
            </h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <div class="cm-hiw__sub cm-body">{{ section.settings.text }}</div>
          {%- elsif section.settings.subheading != blank -%}
            <p class="cm-hiw__sub">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
          {%- if section.settings.button_label != blank -%}
            <a
              class="cm-hiw__cta"
              href="{{ section.settings.button_link | default: '/collections/all' }}"
            >
              {{- section.settings.button_label | escape -}}
            </a>
          {%- endif -%}
        </div>

        {%- if section.blocks.size > 0 -%}
          <ol class="cm-hiw__steps list-unstyled" id="cm-hiw-steps-{{ section.id }}" role="list">
            {%- for block in section.blocks -%}
              <li class="cm-hiw-step" {{ block.shopify_attributes }}>
                <span class="cm-hiw-step__num" aria-hidden="true">{{ forloop.index }}</span>
                <span class="cm-hiw-step__branch" aria-hidden="true"></span>
                <div class="cm-hiw-step__panel">
                  <span class="cm-hiw-step__mark" aria-hidden="true">{{ forloop.index }}</span>
                  {%- case block.settings.icon -%}
                    {%- when 'menu' -%}
                      <svg class="cm-hiw-step__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16M4 12h16M4 19h10"/></svg>
                    {%- when 'cart' -%}
                      <svg class="cm-hiw-step__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2l2.4 11h10.2L20 8H6.2"/><circle cx="9" cy="19.5" r="1.3"/><circle cx="17" cy="19.5" r="1.3"/></svg>
                    {%- when 'calendar' -%}
                      <svg class="cm-hiw-step__icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M4 10h16M9 3v4M15 3v4"/></svg>
                    {%- when 'user' -%}
                      <svg class="cm-hiw-step__icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c1-4 4-6 8-6s7 2 8 6"/></svg>
                    {%- when 'pay' -%}
                      <svg class="cm-hiw-step__icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10.5h18M7 15h4"/></svg>
                    {%- when 'cook' -%}
                      <svg class="cm-hiw-step__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11h16v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-7z"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/><path d="M12 3v2"/></svg>
                    {%- when 'truck' -%}
                      <svg class="cm-hiw-step__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v10H3z"/><path d="M14 10h4l3 3v4h-7v-7z"/><circle cx="7" cy="18.5" r="1.5"/><circle cx="17.5" cy="18.5" r="1.5"/></svg>
                    {%- when 'heat' -%}
                      <svg class="cm-hiw-step__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3c2 3 2 5 0 7 2 0 4 2 4 5a4 4 0 0 1-8 0c0-2 1.2-3.5 2.5-4.5C9 8.5 10 6 12 3z"/></svg>
                  {%- endcase -%}
                  {%- if block.settings.title != blank -%}
                    <h3 class="cm-hiw-step__title">{{ block.settings.title | escape }}</h3>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <p class="cm-hiw-step__text">{{ block.settings.text | escape }}</p>
                  {%- endif -%}
                  {%- if block.settings.chip != blank -%}
                    <span class="cm-hiw-chip cm-hiw-chip--{{ block.settings.chip_style | default: 'brand' }}">
                      {{- block.settings.chip | escape -}}
                    </span>
                  {%- endif -%}
                </div>
              </li>
            {%- endfor -%}
          </ol>
        {%- endif -%}
      </div>
    </div>
  {%- else -%}
    <div class="page-width section-{{ section.id }}-padding">
      <div class="cm-center">
        {%- if section.settings.label != blank -%}
          <span class="cm-label">{{ section.settings.label | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="cm-heading">{{ section.settings.heading | escape | newline_to_br }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="cm-body">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <ol class="cm-steps__grid list-unstyled" role="list" style="--cm-cols: {{ columns }};">
          {%- for block in section.blocks -%}
            <li class="cm-step" {{ block.shopify_attributes }}>
              <span class="cm-step__num" aria-hidden="true">{{ forloop.index }}</span>
              {%- if block.settings.title != blank -%}
                <h3 class="cm-step__title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="cm-step__text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "CM how it works",
  "tag": "section",
  "class": "section cm-section",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "menu", "label": "Menu" },
            { "value": "cart", "label": "Cart" },
            { "value": "calendar", "label": "Calendar" },
            { "value": "user", "label": "User" },
            { "value": "pay", "label": "Pay" },
            { "value": "cook", "label": "Cook" },
            { "value": "truck", "label": "Delivery" },
            { "value": "heat", "label": "Heat" }
          ],
          "default": "none"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Pick Your Meals"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Choose what you want from this week's menu."
        },
        {
          "type": "text",
          "id": "chip",
          "label": "Chip / button label",
          "info": "Optional highlight chip inside the step (timeline layout)."
        },
        {
          "type": "select",
          "id": "chip_style",
          "label": "Chip style",
          "options": [
            { "value": "brand", "label": "Brand orange" },
            { "value": "navy", "label": "Dark" }
          ],
          "default": "brand"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "grid", "label": "Grid cards" },
        { "value": "timeline", "label": "Timeline (sticky intro)" }
      ],
      "default": "grid"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Simple Process"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "How It Works"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "info": "Used in timeline layout when rich text is empty."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "info": "Shown in timeline layout."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "cream", "label": "Cream" },
        { "value": "warm", "label": "Warm" },
        { "value": "white", "label": "White" }
      ],
      "default": "cream"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "CM how it works",
      "blocks": [
        { "type": "step", "settings": { "title": "Pick Your Meals", "text": "Choose what you want from this week's menu." } },
        { "type": "step", "settings": { "title": "We Cook It Fresh", "text": "Chef Matt makes every meal from scratch. Nothing frozen." } },
        { "type": "step", "settings": { "title": "We Deliver It", "text": "Your meals come straight to your door in Hartland." } },
        { "type": "step", "settings": { "title": "Heat and Eat", "text": "2 minutes in the microwave and it's ready. No cooking, no mess." } }
      ]
    }
  ]
}
{% endschema %}
