{% render 'cm-section-assets', section: section %}

{%- liquid
  assign s = section.settings
  assign layout = s.layout | default: 'grid'
  assign columns = section.blocks.size
  if columns > 4
    assign columns = 4
  endif
-%}
{%- capture steps_eyebrow_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'eyebrow_' -%}
{%- endcapture -%}
{%- capture steps_heading_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'heading_' -%}
{%- endcapture -%}
{%- capture steps_body_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'body_' -%}
{%- endcapture -%}
{%- capture steps_sub_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'sub_' -%}
{%- endcapture -%}

{%- if layout == 'timeline' -%}
  <script src="{{ 'cm-hiw-timeline.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<div
  class="cm cm-steps cm-steps--{{ layout }} cm--{{ section.settings.background }}"
  data-cm="steps"
  {% if layout == 'timeline' %}
    id="cm-hiw-{{ section.id }}"
    data-cm-hiw
    style="--p: 0;"
  {% endif %}
>
  {%- if layout == 'timeline' -%}
    <div class="page-width section-{{ section.id }}-padding">
      <div class="cm-hiw__wrap">
        <div class="cm-hiw__intro">
          {%- if s.label != blank -%}
            <span
              class="cm-label"
              {% if steps_eyebrow_style != blank %}
                style="{{ steps_eyebrow_style | strip }}"
              {% endif %}
            >
              {{- s.label | escape -}}
            </span>
          {%- endif -%}
          {%- if s.heading != blank -%}
            <h2
              class="cm-hiw__title"
              id="cm-hiw-title-{{ section.id }}"
              {% if steps_heading_style != blank %}
                style="{{ steps_heading_style | strip }}"
              {% endif %}
            >
              {{- s.heading | escape | newline_to_br -}}
            </h2>
          {%- endif -%}
          {%- if s.text != blank -%}
            <div
              class="cm-hiw__sub cm-body"
              {% if steps_body_style != blank %}
                style="{{ steps_body_style | strip }}"
              {% endif %}
            >
              {{ s.text }}
            </div>
          {%- elsif s.subheading != blank -%}
            <p
              class="cm-hiw__sub"
              {% if steps_sub_style != blank %}
                style="{{ steps_sub_style | strip }}"
              {% endif %}
            >
              {{- s.subheading | escape -}}
            </p>
          {%- endif -%}
          {%- if section.settings.button_label != blank -%}
            {%- assign steps_btn_link = section.settings.button_link | default: '/collections/all' -%}
            {% render 'pm-button',
              label: section.settings.button_label,
              link: steps_btn_link,
              style: 'brand',
              class: 'cm-hiw__cta',
              text_color: section.settings.button_text_color,
              bg_color: section.settings.button_bg_color,
              icon_bg: section.settings.button_icon_bg,
              icon_color: section.settings.button_icon_color,
              font_size: section.settings.button_font_size, hover_text_color: section.settings.button_hover_text_color, hover_bg_color: section.settings.button_hover_bg_color
            %}
          {%- endif -%}
        </div>

        {%- if section.blocks.size > 0 -%}
          <ol class="cm-hiw__steps list-unstyled" id="cm-hiw-steps-{{ section.id }}" role="list">
            {%- for block in section.blocks -%}
              {%- capture step_title_style -%}
                {%- render 'pm-block-type-style', block: block, prefix: 'title_' -%}
              {%- endcapture -%}
              {%- capture step_body_style -%}
                {%- render 'pm-block-type-style', block: block, prefix: 'body_' -%}
              {%- endcapture -%}
              <li class="cm-hiw-step" {{ block.shopify_attributes }}>
                <span class="cm-hiw-step__num" aria-hidden="true">{{ forloop.index }}</span>
                <span class="cm-hiw-step__branch" aria-hidden="true"></span>
                <div class="cm-hiw-step__panel">
                  <span class="cm-hiw-step__mark" aria-hidden="true">{{ forloop.index }}</span>
                  {%- case block.settings.icon -%}
                    {%- when 'menu' -%}
                      <svg class="cm-hiw-step__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16M4 12h16M4 19h10"/></svg>
                    {%- when 'cart' -%}
                      <svg class="cm-hiw-step__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2l2.4 11h10.2L20 8H6.2"/><circle cx="9" cy="19.5" r="1.3"/><circle cx="17" cy="19.5" r="1.3"/></svg>
                    {%- when 'calendar' -%}
                      <svg class="cm-hiw-step__icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M4 10h16M9 3v4M15 3v4"/></svg>
                    {%- when 'user' -%}
                      <svg class="cm-hiw-step__icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c1-4 4-6 8-6s7 2 8 6"/></svg>
                    {%- when 'pay' -%}
                      <svg class="cm-hiw-step__icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10.5h18M7 15h4"/></svg>
                    {%- when 'cook' -%}
                      <svg class="cm-hiw-step__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11h16v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-7z"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/><path d="M12 3v2"/></svg>
                    {%- when 'truck' -%}
                      <svg class="cm-hiw-step__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v10H3z"/><path d="M14 10h4l3 3v4h-7v-7z"/><circle cx="7" cy="18.5" r="1.5"/><circle cx="17.5" cy="18.5" r="1.5"/></svg>
                    {%- when 'heat' -%}
                      <svg class="cm-hiw-step__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3c2 3 2 5 0 7 2 0 4 2 4 5a4 4 0 0 1-8 0c0-2 1.2-3.5 2.5-4.5C9 8.5 10 6 12 3z"/></svg>
                  {%- endcase -%}
                  {%- if block.settings.title != blank -%}
                    <h3
                      class="cm-hiw-step__title"
                      {% if step_title_style != blank %}
                        style="{{ step_title_style | strip }}"
                      {% endif %}
                    >
                      {{- block.settings.title | escape -}}
                    </h3>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <p
                      class="cm-hiw-step__text"
                      {% if step_body_style != blank %}
                        style="{{ step_body_style | strip }}"
                      {% endif %}
                    >
                      {{- block.settings.text | escape -}}
                    </p>
                  {%- endif -%}
                  {%- if block.settings.chip != blank -%}
                    <span class="cm-hiw-chip cm-hiw-chip--{{ block.settings.chip_style | default: 'brand' }}">
                      {{- block.settings.chip | escape -}}
                    </span>
                  {%- endif -%}
                </div>
              </li>
            {%- endfor -%}
          </ol>
        {%- endif -%}
      </div>
    </div>
  {%- else -%}
    <div class="page-width section-{{ section.id }}-padding">
      <div class="cm-center">
        {%- if s.label != blank -%}
          <span
            class="cm-label"
            {% if steps_eyebrow_style != blank %}
              style="{{ steps_eyebrow_style | strip }}"
            {% endif %}
          >
            {{- s.label | escape -}}
          </span>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2
            class="cm-heading"
            {% if steps_heading_style != blank %}
              style="{{ steps_heading_style | strip }}"
            {% endif %}
          >
            {{- s.heading | escape | newline_to_br -}}
          </h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div
            class="cm-body"
            {% if steps_body_style != blank %}
              style="{{ steps_body_style | strip }}"
            {% endif %}
          >
            {{ s.text }}
          </div>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <ol class="cm-steps__grid list-unstyled" role="list" style="--cm-cols: {{ columns }};">
          {%- for block in section.blocks -%}
            {%- capture step_title_style -%}
              {%- render 'pm-block-type-style', block: block, prefix: 'title_' -%}
            {%- endcapture -%}
            {%- capture step_body_style -%}
              {%- render 'pm-block-type-style', block: block, prefix: 'body_' -%}
            {%- endcapture -%}
            <li class="cm-step" {{ block.shopify_attributes }}>
              <span class="cm-step__num" aria-hidden="true">{{ forloop.index }}</span>
              {%- if block.settings.title != blank -%}
                <h3
                  class="cm-step__title"
                  {% if step_title_style != blank %}
                    style="{{ step_title_style | strip }}"
                  {% endif %}
                >
                  {{- block.settings.title | escape -}}
                </h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p
                  class="cm-step__text"
                  {% if step_body_style != blank %}
                    style="{{ step_body_style | strip }}"
                  {% endif %}
                >
                  {{- block.settings.text | escape -}}
                </p>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "CM how it works",
  "tag": "section",
  "class": "section cm-section",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "menu", "label": "Menu" },
            { "value": "cart", "label": "Cart" },
            { "value": "calendar", "label": "Calendar" },
            { "value": "user", "label": "User" },
            { "value": "pay", "label": "Pay" },
            { "value": "cook", "label": "Cook" },
            { "value": "truck", "label": "Delivery" },
            { "value": "heat", "label": "Heat" }
          ],
          "default": "none"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Pick Your Meals"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Choose what you want from this week's menu."
        },
        {
          "type": "text",
          "id": "chip",
          "label": "Chip / button label",
          "info": "Optional highlight chip inside the step (timeline layout)."
        },
        {
          "type": "select",
          "id": "chip_style",
          "label": "Chip style",
          "options": [
            { "value": "brand", "label": "Brand orange" },
            { "value": "navy", "label": "Dark" }
          ],
          "default": "brand"
        },
        { "type": "header", "content": "Title typography" },
        { "type": "color", "id": "title_color", "label": "Text color" },
        { "type": "range", "id": "title_font_size", "min": 0, "max": 48, "step": 1, "unit": "px", "label": "Font size", "default": 0, "info": "0 = theme default. Custom sizes start at 14px." },
        {
          "type": "select",
          "id": "title_font_weight",
          "label": "Font weight",
          "options": [
            { "value": "inherit", "label": "Theme default" },
            { "value": "400", "label": "Regular 400" },
            { "value": "500", "label": "Medium 500" },
            { "value": "600", "label": "Semi-bold 600" },
            { "value": "700", "label": "Bold 700" },
            { "value": "800", "label": "Extra-bold 800" }
          ],
          "default": "inherit"
        },
        { "type": "range", "id": "title_letter_spacing", "min": -4, "max": 12, "step": 1, "unit": "px", "label": "Letter spacing", "default": 0 },
        { "type": "range", "id": "title_line_height", "min": 0, "max": 2, "step": 0.1, "label": "Line height", "default": 0, "info": "0 = theme default" },
        { "type": "header", "content": "Title spacing" },
        { "type": "range", "id": "title_padding_top", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Padding top", "default": 0 },
        { "type": "range", "id": "title_padding_bottom", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Padding bottom", "default": 0 },
        { "type": "range", "id": "title_padding_left", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Padding left", "default": 0 },
        { "type": "range", "id": "title_padding_right", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Padding right", "default": 0 },
        { "type": "range", "id": "title_margin_top", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Margin top", "default": 0 },
        { "type": "range", "id": "title_margin_bottom", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Margin bottom", "default": 0 },
        { "type": "range", "id": "title_margin_left", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Margin left", "default": 0 },
        { "type": "range", "id": "title_margin_right", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Margin right", "default": 0 },
        { "type": "header", "content": "Title background" },
        { "type": "color", "id": "title_bg_color", "label": "Background color", "info": "Clear swatch to reset." },
        { "type": "image_picker", "id": "title_bg_image", "label": "Background image" },
        { "type": "select", "id": "title_bg_size", "label": "Image size", "options": [
          { "value": "cover", "label": "Cover" },
          { "value": "contain", "label": "Contain" },
          { "value": "auto", "label": "Auto" }
        ], "default": "cover" },
        { "type": "select", "id": "title_bg_position", "label": "Image position", "options": [
          { "value": "center", "label": "Center" },
          { "value": "top", "label": "Top" },
          { "value": "bottom", "label": "Bottom" },
          { "value": "left", "label": "Left" },
          { "value": "right", "label": "Right" }
        ], "default": "center" },
        { "type": "select", "id": "title_bg_mask", "label": "Image mask", "options": [
          { "value": "none", "label": "None" },
          { "value": "fade", "label": "Fade bottom" },
          { "value": "fade_edges", "label": "Fade edges" },
          { "value": "circle", "label": "Circle" },
          { "value": "soft", "label": "Soft vignette" },
          { "value": "rounded", "label": "Rounded box" },
          { "value": "custom", "label": "Custom mask image" }
        ], "default": "none" },
        { "type": "image_picker", "id": "title_bg_mask_image", "label": "Custom mask image", "info": "Used when Image mask = Custom." },
        { "type": "checkbox", "id": "title_bg_clip_text", "label": "Clip background to letters", "default": false, "info": "Fills letter shapes with the background color/image." },
        { "type": "header", "content": "Text typography" },
        { "type": "color", "id": "body_color", "label": "Text color" },
        { "type": "range", "id": "body_font_size", "min": 0, "max": 48, "step": 1, "unit": "px", "label": "Font size", "default": 0, "info": "0 = theme default. Custom sizes start at 14px." },
        {
          "type": "select",
          "id": "body_font_weight",
          "label": "Font weight",
          "options": [
            { "value": "inherit", "label": "Theme default" },
            { "value": "400", "label": "Regular 400" },
            { "value": "500", "label": "Medium 500" },
            { "value": "600", "label": "Semi-bold 600" },
            { "value": "700", "label": "Bold 700" },
            { "value": "800", "label": "Extra-bold 800" }
          ],
          "default": "inherit"
        },
        { "type": "range", "id": "body_letter_spacing", "min": -4, "max": 12, "step": 1, "unit": "px", "label": "Letter spacing", "default": 0 },
        { "type": "range", "id": "body_line_height", "min": 0, "max": 2, "step": 0.1, "label": "Line height", "default": 0, "info": "0 = theme default" },
        { "type": "header", "content": "Text spacing" },
        { "type": "range", "id": "body_padding_top", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Padding top", "default": 0 },
        { "type": "range", "id": "body_padding_bottom", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Padding bottom", "default": 0 },
        { "type": "range", "id": "body_padding_left", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Padding left", "default": 0 },
        { "type": "range", "id": "body_padding_right", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Padding right", "default": 0 },
        { "type": "range", "id": "body_margin_top", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Margin top", "default": 0 },
        { "type": "range", "id": "body_margin_bottom", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Margin bottom", "default": 0 },
        { "type": "range", "id": "body_margin_left", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Margin left", "default": 0 },
        { "type": "range", "id": "body_margin_right", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Margin right", "default": 0 },
        { "type": "header", "content": "Text background" },
        { "type": "color", "id": "body_bg_color", "label": "Background color", "info": "Clear swatch to reset." },
        { "type": "image_picker", "id": "body_bg_image", "label": "Background image" },
        { "type": "select", "id": "body_bg_size", "label": "Image size", "options": [
          { "value": "cover", "label": "Cover" },
          { "value": "contain", "label": "Contain" },
          { "value": "auto", "label": "Auto" }
        ], "default": "cover" },
        { "type": "select", "id": "body_bg_position", "label": "Image position", "options": [
          { "value": "center", "label": "Center" },
          { "value": "top", "label": "Top" },
          { "value": "bottom", "label": "Bottom" },
          { "value": "left", "label": "Left" },
          { "value": "right", "label": "Right" }
        ], "default": "center" },
        { "type": "select", "id": "body_bg_mask", "label": "Image mask", "options": [
          { "value": "none", "label": "None" },
          { "value": "fade", "label": "Fade bottom" },
          { "value": "fade_edges", "label": "Fade edges" },
          { "value": "circle", "label": "Circle" },
          { "value": "soft", "label": "Soft vignette" },
          { "value": "rounded", "label": "Rounded box" },
          { "value": "custom", "label": "Custom mask image" }
        ], "default": "none" },
        { "type": "image_picker", "id": "body_bg_mask_image", "label": "Custom mask image", "info": "Used when Image mask = Custom." },
        { "type": "checkbox", "id": "body_bg_clip_text", "label": "Clip background to letters", "default": false, "info": "Fills letter shapes with the background color/image." }
      ]
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "grid", "label": "Grid cards" },
        { "value": "timeline", "label": "Timeline (sticky intro)" }
      ],
      "default": "grid"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Simple Process"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "How It Works"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "info": "Used in timeline layout when rich text is empty."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "info": "Shown in timeline layout."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    { "type": "header", "content": "Button style" },
    { "type": "color", "id": "button_text_color", "label": "Text color" },
    { "type": "color", "id": "button_bg_color", "label": "Background color" }, { "type": "color", "id": "button_hover_text_color", "label": "Hover text color", "info": "Clear to keep the style preset hover." }, { "type": "color", "id": "button_hover_bg_color", "label": "Hover background color", "info": "Clear to keep the style preset hover." },
    { "type": "color", "id": "button_icon_bg", "label": "Icon background" },
    { "type": "color", "id": "button_icon_color", "label": "Icon color" },
    { "type": "range", "id": "button_font_size", "min": 12, "max": 24, "step": 1, "unit": "px", "label": "Font size", "default": 16 },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "cream", "label": "Cream" },
        { "value": "warm", "label": "Warm" },
        { "value": "white", "label": "White" }
      ],
      "default": "cream"
    },
    { "type": "header", "content": "Label typography" },
    { "type": "color", "id": "eyebrow_color", "label": "Text color" },
    { "type": "range", "id": "eyebrow_font_size", "min": 0, "max": 48, "step": 1, "unit": "px", "label": "Font size", "default": 0, "info": "0 = theme default. Custom sizes start at 14px." },
    {
      "type": "select",
      "id": "eyebrow_font_weight",
      "label": "Font weight",
      "options": [
        { "value": "inherit", "label": "Theme default" },
        { "value": "400", "label": "Regular 400" },
        { "value": "500", "label": "Medium 500" },
        { "value": "600", "label": "Semi-bold 600" },
        { "value": "700", "label": "Bold 700" },
        { "value": "800", "label": "Extra-bold 800" }
      ],
      "default": "inherit"
    },
    { "type": "range", "id": "eyebrow_letter_spacing", "min": -4, "max": 12, "step": 1, "unit": "px", "label": "Letter spacing", "default": 0 },
    { "type": "range", "id": "eyebrow_line_height", "min": 0, "max": 2, "step": 0.1, "label": "Line height", "default": 0, "info": "0 = theme default" },
    { "type": "header", "content": "Label spacing" },
    { "type": "range", "id": "eyebrow_padding_top", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Padding top", "default": 0 },
    { "type": "range", "id": "eyebrow_padding_bottom", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Padding bottom", "default": 0 },
