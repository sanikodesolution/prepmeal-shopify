{% render 'cm-section-assets', section: section %}

{%- liquid
  assign s = section.settings
  assign columns = section.blocks.size
  if columns > 5
    assign columns = 5
  endif
-%}
{%- capture plans_eyebrow_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'eyebrow_' -%}
{%- endcapture -%}
{%- capture plans_heading_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'heading_' -%}
{%- endcapture -%}
{%- capture plans_body_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'body_' -%}
{%- endcapture -%}

<div class="cm cm-plans cm--{{ s.background }}" data-cm="plans">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="cm-inner--narrow">
      <div class="cm-center">
        {%- if s.label != blank -%}
          <span
            class="cm-label"
            {% if plans_eyebrow_style != blank %}
              style="{{ plans_eyebrow_style | strip }}"
            {% endif %}
          >
            {{- s.label | escape -}}
          </span>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2
            class="cm-heading"
            {% if plans_heading_style != blank %}
              style="{{ plans_heading_style | strip }}"
            {% endif %}
          >
            {{- s.heading | escape | newline_to_br -}}
          </h2>
        {%- endif -%}
        {%- if s.text != blank -%}
          <div
            class="cm-body"
            {% if plans_body_style != blank %}
              style="{{ plans_body_style | strip }}"
            {% endif %}
          >
            {{ s.text }}
          </div>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="cm-plans__grid" style="--cm-cols: {{ columns }};">
          {%- for block in section.blocks -%}
            {%- capture plan_title_style -%}
              {%- render 'pm-block-type-style', block: block, prefix: 'title_' -%}
            {%- endcapture -%}
            {%- capture plan_label_style -%}
              {%- render 'pm-block-type-style', block: block, prefix: 'label_' -%}
            {%- endcapture -%}
            {%- capture plan_body_style -%}
              {%- render 'pm-block-type-style', block: block, prefix: 'body_' -%}
            {%- endcapture -%}
            <a
              class="cm-plan"
              href="{{ block.settings.link | default: '#' }}"
              {{ block.shopify_attributes }}
            >
              <span
                class="cm-plan__num"
                {% if plan_title_style != blank %}
                  style="{{ plan_title_style | strip }}"
                {% endif %}
              >
                {{- block.settings.number | escape -}}
              </span>
              <span
                class="cm-plan__label"
                {% if plan_label_style != blank %}
                  style="{{ plan_label_style | strip }}"
                {% endif %}
              >
                {{- block.settings.label | escape -}}
              </span>
              {%- if block.settings.button_label != blank -%}
                <span
                  class="cm-plan__cta"
                  {% if plan_body_style != blank %}
                    style="{{ plan_body_style | strip }}"
                  {% endif %}
                >
                  {{- block.settings.button_label | escape -}}
                </span>
              {%- endif -%}
            </a>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

