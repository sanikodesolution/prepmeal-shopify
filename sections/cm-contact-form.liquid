{% render 'cm-section-assets', section: section %}

{%- liquid
  assign s = section.settings
  assign form_id = 'CmContactForm-' | append: section.id
-%}
{%- capture form_eyebrow_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'eyebrow_' -%}
{%- endcapture -%}
{%- capture form_heading_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'heading_' -%}
{%- endcapture -%}
{%- capture form_body_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'body_' -%}
{%- endcapture -%}
{%- capture form_note_style -%}
  {%- render 'pm-block-type-style', settings: s, prefix: 'note_' -%}
{%- endcapture -%}

<div class="cm cm-contact-form cm--{{ section.settings.background }}" data-cm="form">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="cm-form" style="--cm-form-width: {{ section.settings.max_width }}px;">
      <div class="cm-form__header{% if section.settings.alignment == 'center' %} cm-center{% endif %}">
        {%- if s.label != blank -%}
          <span
            class="cm-label"
            {% if form_eyebrow_style != blank %}
              style="{{ form_eyebrow_style | strip }}"
            {% endif %}
          >
            {{- s.label | escape -}}
          </span>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2
            class="cm-heading"
            {% if form_heading_style != blank %}
              style="{{ form_heading_style | strip }}"
            {% endif %}
          >
            {{- s.heading | escape -}}
          </h2>
        {%- endif -%}
        {%- if s.text != blank -%}
          <div
            class="cm-body"
            {% if form_body_style != blank %}
              style="{{ form_body_style | strip }}"
            {% endif %}
          >
            {{ s.text }}
          </div>
        {%- endif -%}
        {%- if s.note != blank -%}
          <span
            class="cm-form__cost"
            {% if form_note_style != blank %}
              style="{{ form_note_style | strip }}"
            {% endif %}
          >
            {{- s.note | escape -}}
          </span>
        {%- endif -%}
      </div>

      {%- form 'contact', id: form_id -%}
        <div class="cm-form__fields">
          {%- if form.posted_successfully? -%}
            <p class="cm-form__notice cm-form__notice--success" role="status" tabindex="-1" autofocus>
              {{ section.settings.success_message | escape }}
            </p>
          {%- elsif form.errors -%}
            <div class="cm-form__notice cm-form__notice--error" role="alert" tabindex="-1" autofocus>
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'group_heading' -%}
                {%- capture group_title_style -%}
                  {%- render 'pm-block-type-style', block: block, prefix: 'title_' -%}
                {%- endcapture -%}
                <h3
                  class="cm-form__group-title"
                  {% if group_title_style != blank %}
                    style="{{ group_title_style | strip }}"
                  {% endif %}
                  {{ block.shopify_attributes }}
                >
                  {{- block.settings.heading | escape -}}
                </h3>
              {%- when 'field' -%}
                {%- liquid
                  assign field_id = form_id | append: '-' | append: block.id
                  assign field_type = block.settings.type
                  if field_type == 'email'
                    assign field_name = 'contact[email]'
                  else
                    assign field_name = block.settings.label | escape | prepend: 'contact[' | append: ']'
                  endif
                -%}
                <div
                  class="cm-field{% if block.settings.half_width %} cm-field--half{% endif %}"
                  {{ block.shopify_attributes }}
                  {% if block.settings.placeholder_color != blank %}
                    style="--pm-field-placeholder:{{ block.settings.placeholder_color }};"
                  {% endif %}
                >
                  <label for="{{ field_id }}">
                    {{- block.settings.label | escape -}}
                    {%- if block.settings.required -%}
                      <span class="cm-field__req" aria-hidden="true">*</span>
                    {%- endif -%}
                  </label>
                  {%- case field_type -%}
                    {%- when 'textarea' -%}
                      <textarea
                        id="{{ field_id }}"
                        name="{{ field_name }}"
                        placeholder="{{ block.settings.placeholder | escape }}"
                        {% if block.settings.required %}
                          required aria-required="true"
                        {% endif %}
                      ></textarea>
                    {%- when 'select' -%}
                      {%- assign options = block.settings.options | newline_to_br | split: '<br />' -%}
                      <select
                        id="{{ field_id }}"
                        name="{{ field_name }}"
                        {% if block.settings.required %}
                          required aria-required="true"
                        {% endif %}
                      >
                        <option value="">{{ block.settings.placeholder | default: '—' | escape }}</option>
                        {%- for option in options -%}
                          {%- assign option = option | strip -%}
                          {%- if option != blank -%}
                            <option value="{{ option | escape }}">{{ option | escape }}</option>
                          {%- endif -%}
                        {%- endfor -%}
                      </select>
                    {%- else -%}
                      <input
                        type="{{ field_type }}"
                        id="{{ field_id }}"
                        name="{{ field_name }}"
                        placeholder="{{ block.settings.placeholder | escape }}"
                        {% if field_type == 'email' %}
                          autocomplete="email" autocapitalize="off" autocorrect="off"
                        {% elsif field_type == 'tel' %}
                          autocomplete="tel"
                        {% elsif field_type == 'number' %}
                          min="1" inputmode="numeric"
                        {% endif %}
                        {% if block.settings.required %}
                          required aria-required="true"
                        {% endif %}
                      >
                  {%- endcase -%}
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>

        <button type="submit" class="cm-btn cm-form__submit">
          {{- section.settings.button_label | escape -}}
        </button>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
