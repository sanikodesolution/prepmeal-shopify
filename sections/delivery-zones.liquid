{{ 'prep-content.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign meta_items = section.settings.delivery_zones
  assign use_meta = false
  if meta_items != blank and meta_items.size > 0
    assign use_meta = true
  endif
-%}

<section class="prep prep__section section-{{ section.id }}-padding" id="DeliveryZones-{{ section.id }}">
  <div class="prep__wrap">
    {% render 'section-heading',
      eyebrow: section.settings.eyebrow,
      title: section.settings.heading,
      text: section.settings.text,
      richtext: true,
      align: section.settings.heading_alignment
    %}

    {%- if use_meta -%}
      <ul class="prep__grid prep__grid--{{ section.settings.columns }}" role="list">
        {%- for zone in meta_items -%}
          <li>{% render 'delivery-zone-card', zone: zone %}</li>
        {%- endfor -%}
      </ul>
    {%- elsif section.blocks.size > 0 -%}
      <ul class="prep__grid prep__grid--{{ section.settings.columns }}" role="list">
        {%- for block in section.blocks -%}
          <li>
            {% render 'delivery-zone-card',
              area_name: block.settings.area_name,
              postcodes: block.settings.postcodes,
              delivery_days: block.settings.delivery_days,
              cut_off_time: block.settings.cut_off_time,
              delivery_fee: block.settings.delivery_fee,
              minimum_order: block.settings.minimum_order,
              shopify_attributes: block.shopify_attributes
            %}
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="prep-empty">{{ 'sections.prep.empty_state' | t }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Delivery zones",
  "tag": "section",
  "class": "section",
  "max_blocks": 24,
  "settings": [
    {
      "type": "metaobject_list",
      "id": "delivery_zones",
      "label": "Delivery zones (Metaobject)",
      "metaobject_type": "delivery_zone",
      "info": "When set, Metaobject entries replace blocks."
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Delivery" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Where we deliver" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Check your area, delivery days, and order cutoff times.</p>"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Desktop columns",
      "default": 3
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ],
  "blocks": [
    {
      "type": "zone",
      "name": "Zone",
      "settings": [
        { "type": "text", "id": "area_name", "label": "Area name", "default": "Hartland" },
        {
          "type": "text",
          "id": "postcodes",
          "label": "Postcodes / areas",
          "info": "Comma-separated",
          "default": "Hartland, Nearby villages"
        },
        {
          "type": "text",
          "id": "delivery_days",
          "label": "Delivery days",
          "info": "Comma-separated",
          "default": "Sunday, Wednesday"
        },
        { "type": "text", "id": "cut_off_time", "label": "Cut-off time", "default": "Friday 8 PM" },
        {
          "type": "text",
          "id": "delivery_fee",
          "label": "Delivery fee",
          "info": "Use 0 for free. Prefer Metaobject money field in Metaobject mode.",
          "default": "0"
        },
        {
          "type": "text",
          "id": "minimum_order",
          "label": "Minimum order",
          "info": "Optional. Prefer Metaobject money field in Metaobject mode."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Delivery zones",
      "blocks": [
        {
          "type": "zone",
          "settings": {
            "area_name": "Hartland",
            "postcodes": "Hartland, Nearby villages",
            "delivery_days": "Sunday, Wednesday",
            "cut_off_time": "Friday 8 PM",
            "delivery_fee": "0"
          }
        },
        {
          "type": "zone",
          "settings": {
            "area_name": "Surrounding areas",
            "postcodes": "Check at checkout",
            "delivery_days": "Sunday",
            "cut_off_time": "Friday 8 PM",
            "delivery_fee": "5"
          }
        }
      ]
    }
  ]
}
{% endschema %}
