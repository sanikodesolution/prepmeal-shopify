{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}
{{ 'section-banner-bistro-split.css' | asset_url | stylesheet_tag }}
{{ 'section-banner-full-bleed.css' | asset_url | stylesheet_tag }}
{{ 'section-banner-editorial-card.css' | asset_url | stylesheet_tag }}
{{ 'section-banner-twin-table.css' | asset_url | stylesheet_tag }}
{{ 'section-home-banner-slider.css' | asset_url | stylesheet_tag }}
<script src="{{ 'home-banner-slider.js' | asset_url }}" defer="defer"></script>

<div
  class="home-banner-slider"
  data-home-banner-slider
  data-autoplay="{{ section.settings.autoplay }}"
  data-interval="{{ section.settings.interval | times: 1000 }}"
  data-progress="{{ section.settings.show_progress }}"
  data-gsap-src="{{ 'gsap.min.js' | asset_url }}"
  role="region"
  aria-roledescription="carousel"
  aria-label="{{ section.settings.accessible_label | escape }}"
>
  <div class="home-banner-slider__viewport" data-hbs-viewport>
    {%- for block in section.blocks -%}
      {%- liquid
        assign slide_style = block.settings.style | default: 'bistro-split'
        assign slide_image = block.settings.image
        assign slide_image_2 = block.settings.image_2
        assign slide_loading = 'lazy'
        assign slide_priority = 'auto'
        if forloop.first
          assign slide_loading = 'eager'
          assign slide_priority = 'high'
        endif
        assign slide_image_alt = block.settings.image_alt | default: slide_image.alt
        assign slide_image_2_alt = block.settings.image_2_alt | default: slide_image_2.alt
      -%}
      <article
        class="banner home-banner-slide banner--{{ slide_style }}{% if forloop.first %} is-active{% endif %}"
        data-hbs-slide
        data-hbs-index="{{ forloop.index0 }}"
        role="group"
        aria-roledescription="slide"
        aria-label="{{ forloop.index }} of {{ section.blocks.size }}"
        aria-hidden="{% unless forloop.first %}true{% else %}false{% endunless %}"
        {% unless forloop.first %}inert{% endunless %}
        {{ block.shopify_attributes }}
      >
        {%- if slide_image != blank -%}
          <div class="banner__media media{% if slide_image_2 != blank %} banner__media-half{% endif %}">
            {{ slide_image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', loading: slide_loading, fetchpriority: slide_priority, alt: slide_image_alt }}
          </div>
        {%- endif -%}
        {%- if slide_image_2 != blank -%}
          <div class="banner__media media banner__media-half">
            {{ slide_image_2 | image_url: width: 1800 | image_tag: widths: '600, 900, 1200, 1800', sizes: '100vw', loading: slide_loading, alt: slide_image_2_alt }}
          </div>
        {%- endif -%}
        <div class="banner__content">
          <div class="banner__box">
            {%- if block.settings.eyebrow != blank -%}
              <div class="banner__text subtitle"><p>{{ block.settings.eyebrow | escape }}</p></div>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <h2 class="banner__heading h0" data-hbs-heading>{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="banner__text rte"><p>{{ block.settings.text | escape }}</p></div>
            {%- endif -%}
            <div class="banner__buttons">
              {%- if block.settings.button_label != blank -%}
                {%- render 'pm-button', label: block.settings.button_label, link: block.settings.button_link, style: 'brand', class: 'home-banner-slider__cta' -%}
              {%- endif -%}
              {%- if block.settings.secondary_label != blank -%}
                {%- liquid
                  assign secondary_style = 'outline'
                  if slide_style == 'full-bleed'
                    assign secondary_style = 'light'
                  endif
                  render 'pm-button', label: block.settings.secondary_label, link: block.settings.secondary_link, style: secondary_style, class: 'home-banner-slider__secondary'
                -%}
              {%- endif -%}
            </div>
          </div>
        </div>
      </article>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="home-banner-slider__controls" data-hbs-controls>
      <button class="home-banner-slider__arrow" type="button" data-hbs-prev aria-label="Previous slide">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5m0 0 7 7m-7-7 7-7"/></svg>
      </button>
      <button class="home-banner-slider__arrow" type="button" data-hbs-next aria-label="Next slide">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m0 0-7-7m7 7-7 7"/></svg>
      </button>
      <button class="home-banner-slider__toggle" type="button" data-hbs-toggle aria-label="Pause automatic slide show" aria-pressed="false">
        <svg class="home-banner-slider__pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14M16 5v14"/></svg>
        <svg class="home-banner-slider__play" viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5 11 7-11 7z"/></svg>
      </button>
      {%- if section.settings.show_progress -%}
        <span class="home-banner-slider__progress" aria-hidden="true"><span data-hbs-progress></span></span>
      {%- endif -%}
    </div>
  {%- endif -%}
  <p class="visually-hidden" data-hbs-status aria-live="polite" aria-atomic="true"></p>
</div>

{% schema %}
{
  "name": "Home banner slider",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "accessible_label", "label": "Accessible label", "default": "Featured meal plans" },
    { "type": "checkbox", "id": "autoplay", "label": "Automatically advance slides", "default": true },
    { "type": "range", "id": "interval", "min": 4, "max": 10, "step": 1, "unit": "s", "label": "Time per slide", "default": 7 },
    { "type": "checkbox", "id": "show_progress", "label": "Show slide progress", "default": true }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Banner slide",
      "settings": [
        { "type": "select", "id": "style", "label": "Design", "options": [
          { "value": "bistro-split", "label": "Bistro Split" },
          { "value": "full-bleed", "label": "Full Bleed" },
          { "value": "editorial-card", "label": "Editorial Card" },
          { "value": "twin-table", "label": "Twin Table" }
        ], "default": "bistro-split" },
        { "type": "image_picker", "id": "image", "label": "Main image" },
        { "type": "text", "id": "image_alt", "label": "Main image alt text" },
        { "type": "image_picker", "id": "image_2", "label": "Second image (Twin Table)" },
        { "type": "text", "id": "image_2_alt", "label": "Second image alt text" },
        { "type": "text", "id": "eyebrow", "label": "Intro text" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "textarea", "id": "text", "label": "Description" },
        { "type": "text", "id": "button_label", "label": "Main button label" },
        { "type": "url", "id": "button_link", "label": "Main button link" },
        { "type": "text", "id": "secondary_label", "label": "Second button label" },
        { "type": "url", "id": "secondary_link", "label": "Second button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home banner slider",
      "blocks": [
        { "type": "slide", "settings": { "style": "bistro-split", "eyebrow": "Global flavors. Chef-crafted. Delivered fresh.", "heading": "Healthy gourmet meal prep you can feel good about", "text": "Chef-crafted meals from around the world, delivered fresh to your door every week.", "button_label": "Order your meal plan", "button_link": "shopify://collections/meal-plans", "secondary_label": "How it works", "secondary_link": "shopify://pages/how-it-works" } },
        { "type": "slide", "settings": { "style": "full-bleed", "eyebrow": "Global flavors. Chef-crafted. Delivered fresh.", "heading": "Healthy gourmet meal prep you can feel good about", "text": "Chef-crafted meals from around the world, delivered fresh to your door every week.", "button_label": "Order your meal plan", "button_link": "shopify://collections/meal-plans", "secondary_label": "How it works", "secondary_link": "shopify://pages/how-it-works" } },
        { "type": "slide", "settings": { "style": "editorial-card", "eyebrow": "Global flavors. Chef-crafted. Delivered fresh.", "heading": "Healthy gourmet meal prep you can feel good about", "text": "Chef-crafted meals from around the world, delivered fresh to your door every week.", "button_label": "Order your meal plan", "button_link": "shopify://collections/meal-plans", "secondary_label": "How it works", "secondary_link": "shopify://pages/how-it-works" } },
        { "type": "slide", "settings": { "style": "twin-table", "eyebrow": "Global flavors. Chef-crafted. Delivered fresh.", "heading": "Healthy gourmet meal prep you can feel good about", "text": "Chef-crafted meals from around the world, delivered fresh to your door every week.", "button_label": "Order your meal plan", "button_link": "shopify://collections/meal-plans", "secondary_label": "How it works", "secondary_link": "shopify://pages/how-it-works" } }
      ]
    }
  ]
}
{% endschema %}
