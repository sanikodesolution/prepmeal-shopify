{% render 'cm-section-assets', section: section %}

<div
  class="cm cm-pg cm--{{ section.settings.background }}{% if section.settings.grayscale %} cm-pg--grayscale{% endif %}"
  data-cm="gallery"
  style="--cm-pg-ratio: {{ section.settings.aspect_ratio }};"
>
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.label != blank or section.settings.heading != blank or section.settings.text != blank -%}
      <div class="cm-center cm-pg__intro">
        {%- if section.settings.label != blank -%}
          <span class="cm-label">{{ section.settings.label | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="cm-heading">{{ section.settings.heading | escape | newline_to_br }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="cm-body">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="cm-pg__items">
      {%- for block in section.blocks -%}
        {%- liquid
          assign number = forloop.index | plus: section.settings.start_number | minus: 1
          if number < 10
            assign number = number | prepend: '0'
          endif
          assign alt = block.settings.image_alt | default: block.settings.title
        -%}
        <article class="cm-pg__item" {{ block.shopify_attributes }}>
          <div class="cm-pg__media">
            <span class="cm-pg__num" aria-hidden="true">{{ number }}</span>
            <div class="cm-pg__frame">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1800
                  | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 60vw, 100vw', alt: alt
                }}
              {%- elsif block.settings.image_asset != blank -%}
                {%- render 'asset-image',
                  src: block.settings.image_asset,
                  widths: '375, 750, 1100, 1500',
                  sizes: '(min-width: 990px) 60vw, 100vw',
                  alt: alt,
                  width: block.settings.image_width,
                  height: block.settings.image_height
                -%}
              {%- else -%}
                {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
          </div>

          {%- if block.settings.title != blank or block.settings.text != blank or block.settings.link_label != blank -%}
            <div class="cm-pg__text">
              {%- capture pg_title_style -%}
                {%- render 'pm-block-type-style', block: block, prefix: 'title_' -%}
              {%- endcapture -%}
              {%- capture pg_body_style -%}
                {%- render 'pm-block-type-style', block: block, prefix: 'body_' -%}
              {%- endcapture -%}
              {%- if block.settings.title != blank -%}
                <h4
                  class="cm-pg__title"
                  {% if pg_title_style != blank %}
                    style="{{ pg_title_style | strip }}"
                  {% endif %}
                >
                  {{ block.settings.title | escape }}
                </h4>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div
                  class="cm-body"
                  {% if pg_body_style != blank %}
                    style="{{ pg_body_style | strip }}"
                  {% endif %}
                >
                  {{ block.settings.text }}
                </div>
              {%- endif -%}
              {%- if block.settings.link_label != blank -%}
                <div class="cm-pg__btn">
                  {% render 'pm-button',
                    label: block.settings.link_label,
                    link: block.settings.link,
                    style: 'light',
                    text_color: block.settings.button_text_color,
                    bg_color: block.settings.button_bg_color,
                    icon_bg: block.settings.button_icon_bg,
                    icon_color: block.settings.button_icon_color,
                    font_size: block.settings.button_font_size
                  %}
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CM parallax gallery",
  "tag": "section",
  "class": "section cm-section",
  "max_blocks": 12,
  "blocks": [
    {
      "type": "item",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Theme asset image",
          "info": "Filename in the theme assets folder, used when no image is picked."
        },
        { "type": "number", "id": "image_width", "label": "Asset image width", "default": 1800 },
        { "type": "number", "id": "image_height", "label": "Asset image height", "default": 800 },
        { "type": "text", "id": "image_alt", "label": "Image alt text" },
        { "type": "text", "id": "title", "label": "Heading", "default": "Chef-Crafted Flavors" },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Global flavors crafted with classical French technique.</p>"
        },
        { "type": "header", "content": "Heading typography" },
        { "type": "color", "id": "title_color", "label": "Text color" },
        {
          "type": "range",
          "id": "title_font_size",
          "min": 0,
          "max": 48,
          "step": 1,
          "unit": "px",
          "label": "Font size",
          "default": 0,
          "info": "0 = theme default. Custom sizes start at 14px."
        },
        {
          "type": "select",
          "id": "title_font_weight",
          "label": "Font weight",
          "options": [
            { "value": "inherit", "label": "Theme default" },
            { "value": "400", "label": "Regular 400" },
            { "value": "500", "label": "Medium 500" },
            { "value": "600", "label": "Semi-bold 600" },
            { "value": "700", "label": "Bold 700" },
            { "value": "800", "label": "Extra-bold 800" },
            { "value": "900", "label": "Black 900" }
          ],
          "default": "inherit"
        },
        { "type": "range", "id": "title_letter_spacing", "min": -4, "max": 12, "step": 1, "unit": "px", "label": "Letter spacing", "default": 0 },
        {
          "type": "range",
          "id": "title_line_height",
          "min": 0,
          "max": 2,
          "step": 0.1,
          "label": "Line height",
          "default": 0,
          "info": "0 = theme default"
        },
        { "type": "header", "content": "Heading spacing" },
        { "type": "range", "id": "title_padding_top", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Padding top", "default": 0 },
        { "type": "range", "id": "title_padding_bottom", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Padding bottom", "default": 0 },
        { "type": "range", "id": "title_padding_left", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Padding left", "default": 0 },
        { "type": "range", "id": "title_padding_right", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Padding right", "default": 0 },
        { "type": "range", "id": "title_margin_top", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Margin top", "default": 0 },
        { "type": "range", "id": "title_margin_bottom", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Margin bottom", "default": 0 },
        { "type": "range", "id": "title_margin_left", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Margin left", "default": 0 },
        { "type": "range", "id": "title_margin_right", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Margin right", "default": 0 },
        { "type": "header", "content": "Title background" },
        { "type": "color", "id": "title_bg_color", "label": "Background color", "info": "Clear swatch to reset." },
        { "type": "image_picker", "id": "title_bg_image", "label": "Background image" },
        { "type": "select", "id": "title_bg_size", "label": "Image size", "options": [
          { "value": "cover", "label": "Cover" },
          { "value": "contain", "label": "Contain" },
          { "value": "auto", "label": "Auto" }
        ], "default": "cover" },
        { "type": "select", "id": "title_bg_position", "label": "Image position", "options": [
          { "value": "center", "label": "Center" },
          { "value": "top", "label": "Top" },
          { "value": "bottom", "label": "Bottom" },
          { "value": "left", "label": "Left" },
          { "value": "right", "label": "Right" }
        ], "default": "center" },
        { "type": "select", "id": "title_bg_mask", "label": "Image mask", "options": [
          { "value": "none", "label": "None" },
          { "value": "fade", "label": "Fade bottom" },
          { "value": "fade_edges", "label": "Fade edges" },
          { "value": "circle", "label": "Circle" },
          { "value": "soft", "label": "Soft vignette" },
          { "value": "rounded", "label": "Rounded box" },
          { "value": "custom", "label": "Custom mask image" }
        ], "default": "none" },
        { "type": "image_picker", "id": "title_bg_mask_image", "label": "Custom mask image", "info": "Used when Image mask = Custom." },
        { "type": "checkbox", "id": "title_bg_clip_text", "label": "Clip background to letters", "default": false, "info": "Fills letter shapes with the background color/image." },
        { "type": "header", "content": "Text typography" },
        { "type": "color", "id": "body_color", "label": "Text color" },
        {
          "type": "range",
          "id": "body_font_size",
          "min": 0,
          "max": 48,
          "step": 1,
          "unit": "px",
          "label": "Font size",
          "default": 0,
          "info": "0 = theme default. Custom sizes start at 14px."
        },
        {
          "type": "select",
          "id": "body_font_weight",
          "label": "Font weight",
          "options": [
            { "value": "inherit", "label": "Theme default" },
            { "value": "300", "label": "Light 300" },
            { "value": "400", "label": "Regular 400" },
            { "value": "500", "label": "Medium 500" },
            { "value": "600", "label": "Semi-bold 600" },
            { "value": "700", "label": "Bold 700" }
          ],
          "default": "inherit"
        },
        { "type": "range", "id": "body_letter_spacing", "min": -4, "max": 12, "step": 1, "unit": "px", "label": "Letter spacing", "default": 0 },
        {
          "type": "range",
          "id": "body_line_height",
          "min": 0,
          "max": 2,
          "step": 0.1,
          "label": "Line height",
          "default": 0,
          "info": "0 = theme default"
        },
        { "type": "header", "content": "Text spacing" },
        { "type": "range", "id": "body_padding_top", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Padding top", "default": 0 },
        { "type": "range", "id": "body_padding_bottom", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Padding bottom", "default": 0 },
        { "type": "range", "id": "body_padding_left", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Padding left", "default": 0 },
        { "type": "range", "id": "body_padding_right", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Padding right", "default": 0 },
        { "type": "range", "id": "body_margin_top", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Margin top", "default": 0 },
        { "type": "range", "id": "body_margin_bottom", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Margin bottom", "default": 0 },
        { "type": "range", "id": "body_margin_left", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Margin left", "default": 0 },
        { "type": "range", "id": "body_margin_right", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Margin right", "default": 0 },
        { "type": "header", "content": "Text background" },
        { "type": "color", "id": "body_bg_color", "label": "Background color", "info": "Clear swatch to reset." },
        { "type": "image_picker", "id": "body_bg_image", "label": "Background image" },
        { "type": "select", "id": "body_bg_size", "label": "Image size", "options": [
          { "value": "cover", "label": "Cover" },
          { "value": "contain", "label": "Contain" },
          { "value": "auto", "label": "Auto" }
        ], "default": "cover" },
        { "type": "select", "id": "body_bg_position", "label": "Image position", "options": [
          { "value": "center", "label": "Center" },
          { "value": "top", "label": "Top" },
          { "value": "bottom", "label": "Bottom" },
          { "value": "left", "label": "Left" },
          { "value": "right", "label": "Right" }
        ], "default": "center" },
        { "type": "select", "id": "body_bg_mask", "label": "Image mask", "options": [
          { "value": "none", "label": "None" },
          { "value": "fade", "label": "Fade bottom" },
          { "value": "fade_edges", "label": "Fade edges" },
          { "value": "circle", "label": "Circle" },
          { "value": "soft", "label": "Soft vignette" },
          { "value": "rounded", "label": "Rounded box" },
          { "value": "custom", "label": "Custom mask image" }
        ], "default": "none" },
        { "type": "image_picker", "id": "body_bg_mask_image", "label": "Custom mask image", "info": "Used when Image mask = Custom." },
        { "type": "checkbox", "id": "body_bg_clip_text", "label": "Clip background to letters", "default": false, "info": "Fills letter shapes with the background color/image." },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "header", "content": "Button style" },
        { "type": "color", "id": "button_text_color", "label": "Text color" },
        { "type": "color", "id": "button_bg_color", "label": "Background color" },
        { "type": "color", "id": "button_icon_bg", "label": "Icon background" },
        { "type": "color", "id": "button_icon_color", "label": "Icon color" },
        { "type": "range", "id": "button_font_size", "min": 12, "max": 24, "step": 1, "unit": "px", "label": "Font size", "default": 16 }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "The Chef Matt Way" },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Crafted with purpose,\nfrom kitchen to door."
    },
    { "type": "richtext", "id": "text", "label": "Text" },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Image shape",
      "options": [
        { "value": "16 / 10", "label": "Landscape" },
        { "value": "16 / 9", "label": "Wide" },
        { "value": "4 / 3", "label": "Classic" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait" }
      ],
      "default": "16 / 10"
    },
    { "type": "range", "id": "start_number", "min": 1, "max": 20, "step": 1, "label": "Start numbering at", "default": 1 },
    { "type": "checkbox", "id": "grayscale", "label": "Black and white images (color on hover)", "default": false },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "beige", "label": "Beige" },
        { "value": "cream", "label": "Cream" },
        { "value": "warm", "label": "Warm" },
        { "value": "white", "label": "White" }
      ],
      "default": "beige"
    },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 80 }
  ],
  "presets": [
    {
      "name": "CM parallax gallery",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "image_asset": "cm-hero-banner.jpg",
            "image_width": 1800,
            "image_height": 800,
            "title": "Chef-Crafted Flavors",
            "text": "<p>Classical French training and 40 years in the kitchen go into every container.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "image_asset": "cm-usp-eco.jpg",
            "image_width": 1000,
            "image_height": 1333,
            "title": "Clean Food, Clean Packaging",
            "text": "<p>Every meal is packed in environmentally friendly containers.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "image_asset": "cm-delivery-banner.jpg",
            "image_width": 1800,
            "image_height": 800,
            "title": "Delivered Fresh",
            "text": "<p>Fresh, never frozen meals delivered across Hartland and Lake Country.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
