{%- comment -%}
  Delivery area — stylised SVG "plate" map, town chips and a postal code checker.
  Rendered by sections/cm-meal-plan-page.liquid (delivery_style = 'plate').

  Towns come from the "Delivery towns" setting, one per line:
    Name|ZIP,ZIP|left%|top%|kitchen|lat|lng
  Only the name is required. Rows without lat|lng are looked up by name in the
  browser, so a merchant can type places instead of coordinates.
  The "kitchen" fifth column marks the single kitchen pin.
  A block per town is not used here because the parent section already sits
  near Shopify's 50-block ceiling.
{%- endcomment -%}

{{ 'section-cm-mealplan-delivery.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cm-geocode.js' | asset_url }}" defer="defer"></script>

{%- comment -%}
  Fallback town list. Format: Name|ZIP,ZIP|left%|top%|kitchen
  (Liquid string literals cannot span lines, so this is captured instead.)
{%- endcomment -%}
{%- capture plate_default_towns -%}
Hartland|53029|41|29|kitchen
Delafield|53018|34.5|35.5
Pewaukee|53072|49.3|32.6
Waukesha|53186, 53188, 53189|50.3|40.2
Sussex|53089|52|25.3
Merton|53056|44.8|22.9
Nashotah|53058|33.3|31.8
Okauchee Lake|53069|34.6|26.9
Oconomowoc|53066|27.4|27.3
Oconomowoc Lake||30|30.1
Chenequa||37.6|24.7
Lisbon||48.4|22.5
Lannon|53046|56|24.8
Menomonee Falls|53051|58.1|20.7
Brookfield|53005, 53045|58.7|33
Elm Grove|53122|60.2|36.7
Wales|53183|38.4|42.3
Dousman|53118|30.4|39.6
Summit||30.9|35.3
Lake Country||30.9|23.7
Stone Bank||35.1|21.4
North Lake|53064|38.7|19.1
Mapleton||25.4|30.7
Genesee|53127|42|44.2
Mukwonago|53149|41.9|51.6
{%- endcapture -%}

{%- liquid
  assign s = section.settings
  assign towns_raw = s.plate_towns | strip
  if towns_raw == blank
    assign towns_raw = plate_default_towns | strip
  endif
  assign lines = towns_raw | newline_to_br | split: '<br />'

  # Kitchen position and town count in one pass.
  assign kx = 41
  assign ky = 29
  assign has_kitchen = false
  assign town_count = 0
  for line in lines
    assign p = line | split: '|'
    assign name = p[0] | strip
    if name != blank
      assign town_count = town_count | plus: 1
      assign flag = p[4] | default: '' | strip | downcase
      if has_kitchen == false and flag == 'kitchen'
        assign kx = p[2] | strip | plus: 0
        assign ky = p[3] | strip | plus: 0
        assign has_kitchen = true
      endif
    endif
  endfor

  assign cx = kx | times: 10
  assign cy = ky | times: 9
  assign zr = s.plate_zone_radius | default: 22 | times: 10
  assign zr_in = zr | minus: 24
  # Kitchen coordinates for the live map. The street-map checker uses these
  # settings too, so both delivery styles move together.
  assign kitchen_lat = s.delivery_kitchen_lat | default: '43.1051'
  assign kitchen_lng = s.delivery_kitchen_lng | default: '-88.3420'
  # A place name may replace the numbers; the browser resolves it.
  assign kitchen_place = ''
  assign kl_num = kitchen_lat | plus: 0
  assign kn_num = kitchen_lng | plus: 0
  if kl_num == 0
    assign kitchen_place = kitchen_lat
  elsif kn_num == 0
    assign kitchen_place = kitchen_lng
  endif
  assign geo_country = s.delivery_country | default: ''
  assign limit = s.plate_visible | default: 12

  assign placeholder = s.delivery_placeholder | default: 'Postal code or town'
  assign button = s.delivery_button | default: 'Check my area'
  assign kitchen_label = s.plate_kitchen_label | default: 'Our kitchen'
  assign more_label = s.plate_more_label | default: 'Show all {count} areas'
  assign less_label = s.plate_less_label | default: 'Show fewer'
  # Precompute: a quoted literal containing braces inside a tag breaks Shopify's lexer.
  assign more_label_done = more_label | replace: '{count}', town_count
  assign msg_yes = s.plate_msg_yes | default: 'Good news, we deliver to {area}.'
  assign msg_no = s.plate_msg_no | default: 'We do not deliver to {query} yet. Check the list below or contact us.'
  assign msg_empty = s.plate_msg_empty | default: 'Type a postal code or town first.'
  assign uid = section.id
-%}

<section
  id="mealplan-dl-{{ uid }}"
  class="mealplan-dl"
  aria-labelledby="mealplan-dl-h-{{ uid }}"
  data-mpdl
>
  <div class="mealplan-dl__inner">

    <header class="mealplan-dl__head">
      {%- if s.delivery_eyebrow != blank -%}
        <p class="mp-eye">{{ s.delivery_eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="mealplan-h mealplan-dl__title" id="mealplan-dl-h-{{ uid }}">{{ s.delivery_heading | escape }}</h2>
      {%- if s.delivery_text != blank -%}
        <p class="mealplan-p mealplan-dl__text">{{ s.delivery_text | escape }}</p>
      {%- endif -%}
    </header>

    <div class="mealplan-dl__check">
      <form class="mealplan-dl__form" data-mpdl-form novalidate>
        <label class="visually-hidden" for="mealplan-dl-q-{{ uid }}">{{ placeholder | escape }}</label>
        <input
          id="mealplan-dl-q-{{ uid }}"
          class="mealplan-dl__input"
          type="text"
          name="area"
          autocomplete="postal-code"
          placeholder="{{ placeholder | escape }}"
        >
        <button class="mealplan-dl__btn" type="submit">{{ button | escape }}</button>
      </form>
      <p class="mealplan-dl__result" data-mpdl-result role="status" aria-live="polite"></p>
    </div>

    <div class="mealplan-dl__areas">
      {%- if s.plate_areas_title != blank -%}
        <p class="mealplan-dl__areas-title">{{ s.plate_areas_title | escape }}</p>
      {%- endif -%}
      <div class="mealplan-dl__chips">
        {%- assign i = 0 -%}
        {%- for line in lines -%}
          {%- assign p = line | split: '|' -%}
          {%- assign name = p[0] | strip -%}
          {%- if name != blank -%}
            {%- assign flag = p[4] | default: '' | strip | downcase -%}
            <button
              type="button"
              class="mealplan-dl__chip{% if flag == 'kitchen' %} is-kitchen{% endif %}"
              data-chip="{{ i }}"
              data-name="{{ name | escape }}"
              data-zip="{{ p[1] | default: '' | strip | escape }}"
              {% if i >= limit %}hidden data-extra{% endif %}
            >
              <span class="mealplan-dl__chip-dot" aria-hidden="true"></span>
              {{ name | escape }}
            </button>
            {%- assign i = i | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- if town_count > limit -%}
        <button
          type="button"
          class="mealplan-dl__more"
          aria-expanded="false"
          data-mpdl-more
          data-label-more="{{ more_label_done | escape }}"
          data-label-less="{{ less_label | escape }}"
        >{{ more_label_done }}</button>
      {%- endif -%}
    </div>

    <div class="mealplan-dl__map" role="region" aria-label="{{ s.plate_map_label | default: 'Map of our delivery area' | escape }}">
      <div class="mealplan-dl__canvas" data-mpdl-canvas data-kitchen="{{ kitchen_label | escape }}" data-klat="{{ kitchen_lat | escape }}" data-klng="{{ kitchen_lng | escape }}" data-kplace="{{ kitchen_place | escape }}" data-country="{{ geo_country | escape }}"></div>
      <script type="application/json" data-mpdl-points>
        [
        {%- assign point_first = true -%}
        {%- for line in lines -%}
          {%- assign p = line | split: '|' -%}
          {%- assign name = p[0] | strip -%}
          {%- if name != blank -%}
            {%- unless point_first -%},{%- endunless -%}
            {%- assign point_first = false -%}
            {%- assign flag = p[4] | default: '' | strip | downcase -%}
            {%- assign lat_raw = p[5] | default: '' | strip -%}
            {%- assign lng_raw = p[6] | default: '' | strip -%}
            {%- assign lat_num = lat_raw | plus: 0 -%}
            {%- assign lng_num = lng_raw | plus: 0 -%}
            {%- comment -%}
              The lookup query carries the first ZIP when one exists, which
              disambiguates towns that share a name across states.
            {%- endcomment -%}
            {%- assign zips_raw = p[1] | default: '' | strip -%}
            {%- assign first_zip = zips_raw | split: ',' | first | strip -%}
            {%- assign lookup_q = name -%}
            {%- if first_zip != blank -%}
              {%- assign lookup_q = name | append: ' ' | append: first_zip -%}
            {%- endif -%}
            {%- if lat_num == 0 and lng_num == 0 -%}
              {"n":{{ name | json }},"z":{{ zips_raw | json }},"k":{% if flag == 'kitchen' %}true{% else %}false{% endif %},"q":{{ lookup_q | json }}}
            {%- else -%}
              {"n":{{ name | json }},"z":{{ zips_raw | json }},"k":{% if flag == 'kitchen' %}true{% else %}false{% endif %},"lat":{{ lat_num }},"lng":{{ lng_num }}}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        ]
      </script>

      <div class="mealplan-dl__card">
        <p class="mealplan-dl__card-name">{{ kitchen_label | escape }}</p>
        {%- if s.plate_kitchen_address != blank -%}
          <p class="mealplan-dl__card-addr">{{ s.plate_kitchen_address | escape }}</p>
        {%- endif -%}
        {%- if s.plate_maps_url != blank -%}
          <a class="mealplan-dl__card-link" href="{{ s.plate_maps_url }}" target="_blank" rel="noopener">{{ s.plate_maps_label | default: 'Open in Maps' | escape }}</a>
        {%- endif -%}
      </div>

      <ul class="mealplan-dl__legend">
        <li><span class="mealplan-dl__sw is-kitchen"></span>{{ s.plate_legend_kitchen | default: 'Our kitchen' | escape }}</li>
        <li><span class="mealplan-dl__sw is-area"></span>{{ s.plate_legend_area | default: 'Delivery areas' | escape }}</li>
        <li><span class="mealplan-dl__sw is-zone"></span>{{ s.plate_legend_zone | default: 'Delivery zone' | escape }}</li>
      </ul>
    </div>

  </div>

  <script type="application/json" data-mpdl-copy>
    {"yes":{{ msg_yes | json }},"no":{{ msg_no | json }},"empty":{{ msg_empty | json }}}
  </script>

  <script>
    (function () {
      var root = document.getElementById('mealplan-dl-{{ uid }}');
      if (!root || root.dataset.mpdlReady === '1') return;
      root.dataset.mpdlReady = '1';

      var copy = {};
      try { copy = JSON.parse(root.querySelector('[data-mpdl-copy]').textContent); } catch (e) {}

      var chips = [].slice.call(root.querySelectorAll('[data-chip]'));
      var form = root.querySelector('[data-mpdl-form]');
      var input = root.querySelector('.mealplan-dl__input');
      var result = root.querySelector('[data-mpdl-result]');
      var more = root.querySelector('[data-mpdl-more]');
      var canvas = root.querySelector('[data-mpdl-canvas]');
      var pinned = null;
      var map = null;
      var zone = null;
      var markers = [];
      var COORDS = {
        hartland: [43.1051, -88.342],
        delafield: [43.0608, -88.4037],
        pewaukee: [43.0806, -88.2612],
        waukesha: [43.0117, -88.2315],
        sussex: [43.1336, -88.2223],
        merton: [43.1422, -88.3107],
        nashotah: [43.0961, -88.4018],
        'okauchee lake': [43.1136, -88.4401],
        oconomowoc: [43.1117, -88.4993],
        'oconomowoc lake': [43.0947, -88.4576],
        chenequa: [43.1236, -88.3815],
        lisbon: [43.155, -88.2501],
        lannon: [43.1492, -88.1626],
        'menomonee falls': [43.1789, -88.1173],
        brookfield: [43.0606, -88.1065],
        'elm grove': [43.0431, -88.0787],
        wales: [43.0042, -88.377],
        dousman: [43.0136, -88.4723],
        summit: [43.0578, -88.4612],
        'lake country': [43.08, -88.45],
        'stone bank': [43.1306, -88.4701],
        'north lake': [43.1503, -88.3712],
        mapleton: [43.068, -88.42],
        genesee: [42.9689, -88.3654],
        mukwonago: [42.8667, -88.3334]
      };

      function normName(value) {
        return String(value || '').toLowerCase().replace(/[^a-z0-9]+/g, ' ').replace(/\s+/g, ' ').trim();
      }

      function metres(a, b) {
        var R = 6371000;
        var rad = Math.PI / 180;
        var dLat = (b[0] - a[0]) * rad;
        var dLng = (b[1] - a[1]) * rad;
        var h = Math.sin(dLat / 2) * Math.sin(dLat / 2) + Math.cos(a[0] * rad) * Math.cos(b[0] * rad) * Math.sin(dLng / 2) * Math.sin(dLng / 2);
        return 2 * R * Math.asin(Math.min(1, Math.sqrt(h)));
      }

      function paint(id) {
        markers.forEach(function (item, i) {
          if (!item || item.kitchen) return;
          var on = String(i) === String(id);
          item.marker.setStyle({ fillColor: on ? '#14231b' : '#f5a623', radius: on ? 8 : 6 });
          if (on) item.marker.openTooltip();
          else item.marker.closeTooltip();
        });
      }

      function fitOutside(animate) {
        if (!map || !zone) return;
        var bounds = zone.getBounds().pad(0.95);
        if (animate) map.flyToBounds(bounds, { padding: [36, 36], duration: 0.6 });
        else map.fitBounds(bounds, { padding: [36, 36], animate: false });
      }

      function focusTown(id, animate) {
        var item = markers[id];
        if (!map || !item) return;
        var zoom = Math.max(map.getZoom(), 12);
        if (animate) map.flyTo(item.marker.getLatLng(), zoom, { duration: 0.6 });
        else map.setView(item.marker.getLatLng(), zoom);
      }

      function setActive(id) {
        chips.forEach(function (c) { c.classList.toggle('is-active', c.getAttribute('data-chip') === id); });
        paint(id);
      }

      function loadLeaflet() {
        if (window.L && window.L.map) return Promise.resolve(window.L);
        if (window.__mpdlLeaflet) return window.__mpdlLeaflet;
        function tag(name, attrs) {
          return new Promise(function (resolve, reject) {
            var el = document.createElement(name);
            Object.keys(attrs).forEach(function (key) { el[key] = attrs[key]; });
            el.onload = resolve;
            el.onerror = reject;
            document.head.appendChild(el);
          });
        }
        window.__mpdlLeaflet = Promise.all([
          tag('link', { rel: 'stylesheet', href: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css' }),
          tag('script', { src: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js', async: true })
        ]).then(function () {
          if (!window.L) throw new Error('Leaflet missing');
          return window.L;
        }).catch(function (err) {
          window.__mpdlLeaflet = null;
          throw err;
        });
        return window.__mpdlLeaflet;
      }

      function buildMap() {
        if (!canvas || canvas.dataset.ready === '1') return;
        canvas.dataset.ready = '1';
        var points = [];
        try { points = JSON.parse(root.querySelector('[data-mpdl-points]').textContent); } catch (e) { points = []; }

        var geo = window.CMGeocode || null;
        var country = canvas.getAttribute('data-country') || '';
        var kitchenPlace = (canvas.getAttribute('data-kplace') || '').trim();
        var kitchenFromPlace = null;

        // This inline script runs before the deferred geocoder loads, so give
        // it a moment to appear. Without a geocoder the map still renders,
        // using whatever coordinates were typed.
        var waitForGeo = function () {
          if (window.CMGeocode) return Promise.resolve(window.CMGeocode);
          return new Promise(function (resolve) {
            var tries = 0;
            var tick = setInterval(function () {
              if (window.CMGeocode || ++tries > 40) {
                clearInterval(tick);
                resolve(window.CMGeocode || null);
              }
            }, 100);
          });
        };

        // Places typed by name get their coordinates before the map is drawn.
        // Anything that cannot be resolved simply keeps its chip but gets no pin.
        var resolve = function () {
          return waitForGeo().then(function (api) {
            geo = api;
            if (!geo) return;
            var jobs = [];
            if (kitchenPlace) {
              jobs.push(
                geo.lookup(kitchenPlace, { country: country }).then(function (hit) {
                  if (hit) kitchenFromPlace = [hit.lat, hit.lng];
                }).catch(function () {})
              );
            }
            points.forEach(function (point) {
              var has = point.lat != null && point.lng != null && isFinite(parseFloat(point.lat)) && isFinite(parseFloat(point.lng));
              if (has) return;
              // The built-in coordinate table already knows this town, so no
              // network call is needed. Only genuinely unknown places are looked up.
              if (COORDS[normName(point.n)]) return;
              point.resolved = null;
              jobs.push(
                geo.lookup(point.q || point.n, { country: country }).then(function (hit) {
                  if (hit) point.resolved = hit;
                }).catch(function () {})
              );
            });
            return Promise.all(jobs).catch(function () {});
          });
        };

        resolve().then(function () {
        loadLeaflet().then(function (L) {
          var kitchenSetting = [
            parseFloat(canvas.getAttribute('data-klat')),
            parseFloat(canvas.getAttribute('data-klng'))
          ];
          var kitchen = (isFinite(kitchenSetting[0]) && isFinite(kitchenSetting[1])) ? kitchenSetting : [43.1051, -88.342];
          if (kitchenFromPlace) kitchen = kitchenFromPlace;
          points.forEach(function (point) {
            if (point.resolved) {
              COORDS[normName(point.n)] = [point.resolved.lat, point.resolved.lng];
            } else if (point.lat !== '' && point.lng !== '' && isFinite(parseFloat(point.lat)) && isFinite(parseFloat(point.lng))) {
              COORDS[normName(point.n)] = [parseFloat(point.lat), parseFloat(point.lng)];
            }
            if (point.k && COORDS[normName(point.n)]) kitchen = COORDS[normName(point.n)];
          });
          var radius = 8000;
          points.forEach(function (point) {
            var ll = COORDS[normName(point.n)];
            if (ll) radius = Math.max(radius, metres(kitchen, ll) + 2200);
          });

          map = L.map(canvas, {
            center: kitchen,
            zoom: 9,
            scrollWheelZoom: false,
            zoomControl: false,
            attributionControl: true,
            zoomSnap: 0.25
          });
          L.control.zoom({ position: 'topleft' }).addTo(map);
          map.attributionControl.setPosition('bottomleft');
          L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
          }).addTo(map);

          zone = L.circle(kitchen, {
            radius: radius,
            color: '#e8941a',
            weight: 2,
            opacity: 0.95,
            fillColor: '#f5a623',
            fillOpacity: 0.14,
            interactive: false
          }).addTo(map);

          var kitchenLabel = canvas.getAttribute('data-kitchen') || 'Our kitchen';
          var hub = L.divIcon({
            className: 'mealplan-dl__hub-wrap',
            html: '<div class="mealplan-dl__hub" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20"><path d="M3 12h18a9 9 0 0 1-18 0z" fill="currentColor"/><path d="M8 8.5c0-1.6 1.5-1.6 1.5-3.2M12 8.5c0-1.6 1.5-1.6 1.5-3.2M16 8.5c0-1.6 1.5-1.6 1.5-3.2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></div>',
            iconSize: [46, 46],
            iconAnchor: [23, 23]
          });

          points.forEach(function (point, i) {
            var ll = COORDS[normName(point.n)];
            if (!ll) { markers[i] = null; return; }
            if (point.k) {
              var kitchenMarker = L.marker(ll, { icon: hub, keyboard: false, zIndexOffset: 800 }).addTo(map);
              kitchenMarker.bindTooltip(kitchenLabel, { permanent: true, direction: 'top', offset: [0, -16], className: 'mealplan-dl__tip-live' });
              markers[i] = { marker: kitchenMarker, kitchen: true };
              return;
            }
            var dot = L.circleMarker(ll, {
              radius: 6,
              color: '#ffffff',
              weight: 2,
              fillColor: '#f5a623',
              fillOpacity: 1
            }).addTo(map);
            dot.bindTooltip(point.n, { direction: 'top', offset: [0, -8], className: 'mealplan-dl__tip-live' });
            dot.on('click', function () {
              pinned = String(i);
              setActive(pinned);
              focusTown(i, true);
            });
            markers[i] = { marker: dot, kitchen: false };
          });

          map.on('click', function () { map.scrollWheelZoom.enable(); });
          map.invalidateSize();
          fitOutside(false);
          setTimeout(function () { if (map) { map.invalidateSize(); fitOutside(false); } }, 250);
        });
        });
      }

      function expand(open) {
        if (!more) return;
        chips.forEach(function (c) { if (c.hasAttribute('data-extra')) c.hidden = !open; });
        more.setAttribute('aria-expanded', open ? 'true' : 'false');
        more.textContent = open ? more.getAttribute('data-label-less') : more.getAttribute('data-label-more');
      }

      if (more) {
        more.addEventListener('click', function () {
          expand(more.getAttribute('aria-expanded') !== 'true');
        });
      }

      function bind(el, id) {
        el.addEventListener('mouseenter', function () { setActive(id); });
        el.addEventListener('focus', function () { setActive(id); });
        el.addEventListener('mouseleave', function () { setActive(pinned); });
        el.addEventListener('blur', function () { setActive(pinned); });
        el.addEventListener('click', function () {
          pinned = pinned === id ? null : id;
          setActive(pinned);
          if (pinned == null) fitOutside(true);
          else focusTown(pinned, true);
        });
      }
      chips.forEach(function (c) { bind(c, c.getAttribute('data-chip')); });

      function show(text, ok) {
        if (!result) return;
        result.textContent = text;
        result.classList.remove('is-yes', 'is-no');
        if (text) result.classList.add(ok ? 'is-yes' : 'is-no');
      }

      function find(q) {
        var zip = (q.match(/\b\d{4,6}\b/) || [])[0];
        var i, c, zips;
        if (zip) {
          for (i = 0; i < chips.length; i++) {
            c = chips[i];
            zips = (c.getAttribute('data-zip') || '').split(',').map(function (z) { return z.trim(); });
            if (zips.indexOf(zip) > -1) return c;
          }
        }
        var best = null;
        chips.forEach(function (c) {
          var n = (c.getAttribute('data-name') || '').toLowerCase();
          if (n.length >= 3 && q.indexOf(n) > -1 && (!best || n.length > best.len)) best = { c: c, len: n.length };
        });
        if (best) return best.c;
        if (q.length >= 4) {
          for (i = 0; i < chips.length; i++) {
            if ((chips[i].getAttribute('data-name') || '').toLowerCase().indexOf(q) === 0) return chips[i];
          }
        }
        return null;
      }

      if (form) {
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          var raw = input.value.trim();
          if (!raw) { show(copy.empty, false); setActive(pinned); return; }
          var hit = find(raw.toLowerCase());
          if (hit) {
            var id = hit.getAttribute('data-chip');
            if (hit.hidden) expand(true);
            pinned = id;
            setActive(id);
            focusTown(id, true);
            show(String(copy.yes || '').replace('{area}', hit.getAttribute('data-name')), true);
          } else {
            pinned = null;
            setActive(null);
            fitOutside(true);
            show(String(copy.no || '').replace('{query}', raw), false);
          }
        });
      }

      if (input) {
        input.addEventListener('input', function () { if (!input.value) show('', true); });
      }

      var mapCard = root.querySelector('.mealplan-dl__map');
      buildMap();
      if ('IntersectionObserver' in window && mapCard) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting) {
              root.classList.add('is-live');
              if (map) map.invalidateSize();
              io.disconnect();
            }
          });
        }, { threshold: 0.2 });
        io.observe(mapCard);
      } else {
        root.classList.add('is-live');
      }
    })();
  </script>
</section>
