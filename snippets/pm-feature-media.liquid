{%- comment -%}
  Renders a feature icon or image.
  Params:
    - image: image_picker object (optional if asset is set)
    - asset: theme assets filename, e.g. "icon.gif" (best for animated GIFs)
    - alt: optional alt text
    - lazy: lazy-load (default true; pass false to disable)
{%- endcomment -%}

{%- liquid
  assign pm_lazy = true
  if lazy == false
    assign pm_lazy = false
  endif

  assign pm_alt = alt | default: ''
  if pm_alt == blank and image != blank
    assign pm_alt = image.alt | default: ''
  endif

  assign pm_asset = asset | default: '' | strip
  assign pm_asset_ext = ''
  if pm_asset != blank
    assign pm_asset_ext = pm_asset | split: '.' | last | downcase
  endif

  assign pm_is_gif = false
  if pm_asset_ext == 'gif'
    assign pm_is_gif = true
  elsif image != blank
    assign pm_src_check = image.src | split: '?' | first | downcase
    if pm_src_check contains '.gif'
      assign pm_is_gif = true
    endif
  endif
-%}

{%- if pm_asset != blank and pm_is_gif -%}
  <img
    class="pm-ft__img"
    src="{{ pm_asset | asset_url }}"
    alt="{{ pm_alt | escape }}"
    width="400"
    height="400"
    {% if pm_lazy %}loading="lazy"{% endif %}
  >
{%- elsif image != blank and pm_is_gif -%}
  <img
    class="pm-ft__img"
    src="{{ image | image_url: width: image.width }}"
    alt="{{ pm_alt | escape }}"
    width="{{ image.width | default: 400 }}"
    height="{{ image.height | default: 400 }}"
    {% if pm_lazy %}loading="lazy"{% endif %}
  >
{%- elsif pm_asset != blank %}
  <img
    class="pm-ft__img"
    src="{{ pm_asset | asset_img_url: '400x' }}"
    alt="{{ pm_alt | escape }}"
    width="400"
    height="400"
    {% if pm_lazy %}loading="lazy"{% endif %}
  >
{%- elsif image != blank -%}
  <img
    class="pm-ft__img"
    src="{{ image | image_url: width: 480 }}"
    alt="{{ pm_alt | escape }}"
    width="{{ image.width | default: 480 }}"
    height="{{ image.height | default: 480 }}"
    {% if pm_lazy %}loading="lazy"{% endif %}
  >
{%- endif -%}
