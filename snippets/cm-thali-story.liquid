{%- comment -%}
  Ghar Ka Khana story — light "one panel" layout.
  Rendered inside the meal plan page, directly above the Explore all meals grid.

  Accepts:
  - s: {Object} section.settings drop
  - meta: {Object} the plan product's custom.* metafields, used first
  - shared: {Object} shop.metafields.custom, used when the product is blank
  - features: {Array} feature_card metaobjects for the two story cards
  - stats: {Array} stat_item metaobjects for the hero numbers
  - facts: {Array} stat_item metaobjects for the closing numbers

  Everything below is optional; a blank value simply drops that line.
  Line-based settings use the form "value|label" or "day|time|order by|cutoff".
  Each value resolves metafield-first, theme-setting-second, so the panel can be
  edited from the plan product in Admin without touching the theme editor.

  Plate media: `thali_image` (metafield or image_picker) when set, otherwise the
  bundled four-items-plate.webp — a transparent cut-out of a real thali with its
  four components. Transparent, so the plate reads as floating on the panel.
{%- endcomment -%}
{%- liquid
  # A metafield list is already an array; a theme setting is one string with
  # newlines. Both end up as an array of rows so one loop path serves each.
  assign gkk_chips = meta.thali_chips.value
  if gkk_chips == blank
    assign gkk_chips = s.thali_chips | newline_to_br | split: '<br />'
  endif
  assign gkk_tickets = meta.thali_tickets.value
  if gkk_tickets == blank
    assign gkk_tickets = s.thali_tickets | newline_to_br | split: '<br />'
  endif
  assign gkk_steps = meta.thali_steps.value
  if gkk_steps == blank
    assign gkk_steps = s.thali_steps | newline_to_br | split: '<br />'
  endif
  assign gkk_towns = meta.thali_towns.value
  if gkk_towns == blank
    assign gkk_towns = s.thali_towns | split: ','
  endif

  # The two feature cards read a feature_card metaobject list first, so each
  # card can carry its own photo and link. Without it the pipe-delimited
  # thali_cards rows (title|text) still fill the same two slots.
  assign gkk_cards = ''
  if features != blank and features.size > 0
    capture gkk_cards
      for item in features
        assign card_title = item.title.value | strip
        if card_title != blank
          echo card_title | append: '|'
          echo item.text.value | strip_newlines
          echo newline
        endif
      endfor
    endcapture
    assign gkk_cards = gkk_cards | newline_to_br | split: '<br />'
  endif
  if gkk_cards == blank
    assign gkk_cards = meta.thali_cards.value
    if gkk_cards == blank
      assign gkk_cards = s.thali_cards | newline_to_br | split: '<br />'
    endif
  endif

  # The hero stats and the closing facts are stat_item objects, so the same
  # numbers can be reused by the stats strip at the top of the page.
  assign gkk_stats = ''
  if stats != blank and stats.size > 0
    capture gkk_stats
      for item in stats
        assign stat_value = item.value.value | default: item.title.value | strip
        if stat_value != blank
          echo stat_value | append: '|'
          echo item.label.value | default: item.text.value | strip_newlines
          echo newline
        endif
      endfor
    endcapture
    assign gkk_stats = gkk_stats | newline_to_br | split: '<br />'
  endif
  if gkk_stats == blank
    assign gkk_stats = meta.thali_stats.value
    if gkk_stats == blank
      assign gkk_stats = s.thali_stats | newline_to_br | split: '<br />'
    endif
  endif

  assign gkk_facts = ''
  if facts != blank and facts.size > 0
    capture gkk_facts
      for item in facts
        assign fact_value = item.value.value | default: item.title.value | strip
        if fact_value != blank
          echo fact_value | append: '|'
          echo item.label.value | default: item.text.value | strip_newlines
          echo newline
        endif
      endfor
    endcapture
    assign gkk_facts = gkk_facts | newline_to_br | split: '<br />'
  endif
  if gkk_facts == blank
    assign gkk_facts = meta.thali_facts.value
    if gkk_facts == blank
      assign gkk_facts = s.thali_facts | newline_to_br | split: '<br />'
    endif
  endif

  # Single-value copy: product metafield first, then the shop-level shared
  # value, then the theme setting, so the chef story and delivery copy can be
  # written once for every plan.
  assign gkk_badge = meta.thali_badge.value | default: shared.thali_badge.value | default: s.thali_badge
  assign gkk_heading = meta.thali_heading.value | default: shared.thali_heading.value | default: s.thali_heading
  assign gkk_intro = meta.thali_intro.value | default: shared.thali_intro.value | default: s.thali_intro
  assign gkk_plate_alt = meta.thali_plate_alt.value | default: s.thali_plate_alt
  assign gkk_image = meta.thali_image.value | default: s.thali_image
  assign gkk_delivery_heading = meta.thali_delivery_heading.value | default: shared.thali_delivery_heading.value | default: s.thali_delivery_heading
  assign gkk_delivery_text = meta.thali_delivery_text.value | default: shared.thali_delivery_text.value | default: s.thali_delivery_text
  assign gkk_cutoff_note = meta.thali_cutoff_note.value | default: shared.thali_cutoff_note.value | default: s.thali_cutoff_note
  assign gkk_fresh_heading = meta.thali_fresh_heading.value | default: shared.thali_fresh_heading.value | default: s.thali_fresh_heading
  assign gkk_fresh_text = meta.thali_fresh_text.value | default: shared.thali_fresh_text.value | default: s.thali_fresh_text
  assign gkk_cta_heading = meta.thali_cta_heading.value | default: shared.thali_cta_heading.value | default: s.thali_cta_heading
  assign gkk_cta_text = meta.thali_cta_text.value | default: shared.thali_cta_text.value | default: s.thali_cta_text
  assign gkk_cta_label = meta.thali_cta_label.value | default: s.thali_cta_label
  assign gkk_cta_link = meta.thali_cta_link.value | default: s.thali_cta_link
  assign gkk_cta_note = meta.thali_cta_note.value | default: s.thali_cta_note
-%}
<section
  class="gkk"
  data-gkk
  id="GkkStory-{{ section.id }}"
  style="--gkk-bg:{{ s.thali_bg | default: '#E3EADF' }};--gkk-accent:{{ s.thali_accent | default: '#F5A623' }};"
>
  <div class="gkk__wrap">

    <div class="gkk__hero">
      <div>
        {%- if gkk_badge != blank -%}
          <span class="cm-label gkk__badge">{{ gkk_badge | escape }}</span>
        {%- endif -%}
        {%- if gkk_heading != blank -%}
          <h2>{{ gkk_heading | escape }}</h2>
        {%- endif -%}
        {%- if gkk_intro != blank -%}
          <p>{{ gkk_intro | escape }}</p>
        {%- endif -%}
        {%- if gkk_stats.size > 0 -%}
          <div class="gkk__stats">
            {%- for line in gkk_stats -%}
              {%- assign stat = line | strip | split: '|' -%}
              {%- if stat.first != blank -%}
                <div>
                  <b>{{ stat[0] | strip | escape }}</b>
                  <span>{{ stat[1] | strip | escape }}</span>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="gkk__plate" data-gkk-plate>
        {%- if gkk_image != blank -%}
          <img
            src="{{ gkk_image | image_url: width: 840 }}"
            srcset="{{ gkk_image | image_url: width: 420 }} 420w, {{ gkk_image | image_url: width: 840 }} 840w"
            sizes="(min-width: 992px) 420px, 90vw"
            alt="{{ gkk_plate_alt | default: 'A thali with two curries, rice and two rotis' | escape }}"
            width="420" height="420" loading="lazy"
          >
        {%- else -%}
          <img
            src="{{ 'four-items-plate.webp' | asset_url }}"
            alt="{{ gkk_plate_alt | default: 'A thali with two curries, rice and two rotis' | escape }}"
            width="860" height="860" loading="lazy"
          >
        {%- endif -%}
        {%- if gkk_chips.size > 0 -%}
          {%- for line in gkk_chips -%}
            {%- assign chip = line | strip -%}
            {%- if chip != blank -%}<span class="gkk__chip">{{ chip | escape }}</span>{%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    {%- if gkk_cards.size > 0 -%}
      <div class="gkk__trio">
        {%- assign card_i = 0 -%}
        {%- for line in gkk_cards -%}
          {%- assign card = line | strip | split: '|' -%}
          {%- if card[0] != blank -%}
            {%- assign card_i = card_i | plus: 1 -%}
            <div class="gkk__card">
              {%- if card_i == 1 -%}
                <svg viewBox="0 0 240 170" aria-hidden="true"><rect width="240" height="170" rx="6" fill="#15251C"/><path d="M60 40q-8-18 4-26M90 36q-8-18 4-26M120 40q-8-18 4-26" stroke="#F5A623" stroke-width="2" fill="none" opacity=".6"/><circle cx="120" cy="64" r="22" fill="#e0a77a"/><circle cx="102" cy="44" r="14" fill="#fff"/><circle cx="120" cy="38" r="16" fill="#fff"/><circle cx="138" cy="44" r="14" fill="#fff"/><rect x="100" y="46" width="40" height="10" fill="#fff"/><circle cx="112" cy="66" r="2.5" fill="#15251C"/><circle cx="128" cy="66" r="2.5" fill="#15251C"/><path d="M110 74q10 8 20 0" stroke="#15251C" stroke-width="2" fill="none"/><path d="M70 170q4-70 50-76 46 6 50 76z" fill="#fff"/><g fill="#d9d2c4"><circle cx="120" cy="116" r="3"/><circle cx="120" cy="134" r="3"/></g><path d="M20 150h200v20H20z" fill="#0F1A13"/><ellipse cx="190" cy="140" rx="34" ry="10" fill="#F5A623"/><path d="M156 140h68v14q-34 12-68 0z" fill="#8f98a3"/></svg>
              {%- else -%}
                <svg viewBox="0 0 240 170" aria-hidden="true"><rect x="30" y="20" width="180" height="130" rx="10" fill="#15251C" transform="rotate(-6 120 85)"/><g fill="#ffffff" opacity=".55"><circle cx="60" cy="48" r="3"/><circle cx="90" cy="40" r="3"/><circle cx="130" cy="36" r="3"/><circle cx="170" cy="30" r="3"/><circle cx="195" cy="120" r="3"/></g><circle cx="120" cy="92" r="58" fill="#c98c45"/><circle cx="112" cy="84" r="56" fill="#dfae6c"/><circle cx="106" cy="76" r="52" fill="#e9c386"/><g fill="#8a4a1c" opacity=".7"><circle cx="86" cy="64" r="5"/><circle cx="118" cy="90" r="4"/><circle cx="100" cy="100" r="3"/><circle cx="130" cy="60" r="4"/></g></svg>
              {%- endif -%}
              <h4>{{ card[0] | strip | escape }}</h4>
              {%- if card[1] != blank -%}<p>{{ card[1] | strip | escape }}</p>{%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="gkk__deliver">
      <div>
        {%- if gkk_delivery_heading != blank -%}
          <h4>{{ gkk_delivery_heading | escape }}</h4>
        {%- endif -%}
        {%- if gkk_delivery_text != blank -%}
          <p>{{ gkk_delivery_text | escape }}</p>
        {%- endif -%}
        {%- if gkk_tickets.size > 0 -%}
          {%- for line in gkk_tickets -%}
            {%- assign t = line | strip | split: '|' -%}
            {%- if t[0] != blank -%}
              <div class="gkk__ticket">
                <div>
                  <h4>{{ t[0] | strip | escape }}</h4>
                  {%- if t[1] != blank -%}<small>{{ t[1] | strip | escape }}</small>{%- endif -%}
                </div>
                <div>
                  {%- if t[2] != blank -%}<small>{{ t[2] | strip | escape }}</small>{%- endif -%}
                  {%- if t[3] != blank -%}<b>{{ t[3] | strip | escape }}</b>{%- endif -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- if gkk_cutoff_note != blank -%}
          <p class="gkk__note">{{ gkk_cutoff_note | escape }}</p>
        {%- endif -%}
      </div>

      <div class="gkk__fresh">
        {%- if gkk_fresh_heading != blank -%}
          <h4>{{ gkk_fresh_heading | escape }}</h4>
        {%- endif -%}
        {%- if gkk_fresh_text != blank -%}
          <p>{{ gkk_fresh_text | escape }}</p>
        {%- endif -%}
        {%- if gkk_steps.size > 0 -%}
          <ol class="gkk__steps">
            {%- for line in gkk_steps -%}
              {%- assign step = line | strip | split: '|' -%}
              {%- if step[0] != blank -%}
                <li>
                  <i>{{ forloop.index }}</i>
                  <div>
                    <b>{{ step[0] | strip | escape }}</b>
                    {%- if step[1] != blank -%}<span>{{ step[1] | strip | escape }}</span>{%- endif -%}
                  </div>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ol>
        {%- endif -%}
        {%- if gkk_towns.size > 0 -%}
          <div class="gkk__towns">
            {%- for town in gkk_towns -%}
              {%- assign town_name = town | strip -%}
              {%- if town_name != blank -%}<span>{{ town_name | escape }}</span>{%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="gkk__cta">
      <div>
        {%- if gkk_cta_heading != blank -%}
          <h4>{{ gkk_cta_heading | escape }}</h4>
        {%- endif -%}
        {%- if gkk_cta_text != blank -%}
          <p>{{ gkk_cta_text | escape }}</p>
        {%- endif -%}
        {%- if gkk_cta_label != blank -%}
          <a class="gkk__btn" href="{{ gkk_cta_link | default: '#' }}">{{ gkk_cta_label | escape }}</a>
        {%- endif -%}
        {%- if gkk_cta_note != blank -%}
          <p class="gkk__note">{{ gkk_cta_note | escape }}</p>
        {%- endif -%}
      </div>
      {%- if gkk_facts.size > 0 -%}
        <div class="gkk__facts">
          {%- for line in gkk_facts -%}
            {%- assign fact = line | strip | split: '|' -%}
            {%- if fact[0] != blank -%}
              <div>
                <b>{{ fact[0] | strip | escape }}</b>
                <span>{{ fact[1] | strip | escape }}</span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('GkkStory-{{ section.id }}');
    if (!root) return;

    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    var plate = root.querySelector('[data-gkk-plate]');

    /* Reveal: one observer on the whole panel (not just the plate), so the copy
       blocks animate as the section enters the viewport. It plays once and then
       disconnects — re-triggering on every scroll pass would feel noisy. */
    if (reduce.matches || !('IntersectionObserver' in window)) {
      root.classList.add('is-in');
    } else {
      root.classList.add('gkk--ready');
      var io = new IntersectionObserver(function (entries) {
        if (entries[0].isIntersecting) {
          root.classList.add('is-in');
          io.disconnect();
        }
      }, { threshold: 0.18, rootMargin: '0px 0px -8% 0px' });
      io.observe(root);
    }

    /* Pointer parallax on the plate. Values are eased towards their target on
       rAF so the tilt trails the cursor instead of jittering with it, and the
       loop parks itself as soon as the plate has settled — no idle CPU. */
    if (!plate || reduce.matches || !window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;

    var MAX_TILT = 7;      // degrees of tilt at the very edge of the plate
    var EASE = 0.09;       // 0-1: lower is smoother, higher is more responsive
    var tx = 0, ty = 0;    // current (eased) tilt
    var gx = 0, gy = 0;    // target tilt
    var mx = 50, my = 50;  // highlight position, in %
    var raf = null;

    function render() {
      tx += (gx - tx) * EASE;
      ty += (gy - ty) * EASE;
      plate.style.setProperty('--gkk-tilt-x', tx.toFixed(3) + 'deg');
      plate.style.setProperty('--gkk-tilt-y', ty.toFixed(3) + 'deg');
      plate.style.setProperty('--gkk-mx', mx.toFixed(2) + '%');
      plate.style.setProperty('--gkk-my', my.toFixed(2) + '%');
      if (Math.abs(gx - tx) > 0.01 || Math.abs(gy - ty) > 0.01) {
        raf = requestAnimationFrame(render);
      } else {
        tx = gx; ty = gy; raf = null;
      }
    }

    function kick() {
      if (raf === null) raf = requestAnimationFrame(render);
    }

    plate.addEventListener('pointermove', function (e) {
      var r = plate.getBoundingClientRect();
      if (!r.width || !r.height) return;
      var nx = (e.clientX - r.left) / r.width;   // 0 .. 1
      var ny = (e.clientY - r.top) / r.height;
      /* Y follows the horizontal axis (leaning left/right) and X the vertical
         one, which is how a physical plate would tip under a hand. */
      gy = (nx - 0.5) * MAX_TILT * 2;
      gx = -(ny - 0.5) * MAX_TILT * 2;
      mx = nx * 100;
      my = ny * 100;
      kick();
    });

    plate.addEventListener('pointerleave', function () {
      gx = 0; gy = 0;
      kick();
    });
  })();
</script>
