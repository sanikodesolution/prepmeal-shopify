{%- comment -%}
  Ghar Ka Khana story — light "one panel" layout.
  Rendered inside the meal plan page, directly above the Explore all meals grid.

  Accepts:
  - s: {Object} section.settings drop

  Everything below is optional; a blank setting simply drops that line.
  Line-based settings use the form "value|label" or "day|time|order by|cutoff".
{%- endcomment -%}
{%- liquid
  assign gkk_badge = s.thali_badge
  assign gkk_heading = s.thali_heading
  assign gkk_intro = s.thali_intro
  assign gkk_stats = s.thali_stats | newline_to_br | split: '<br />'
  assign gkk_chips = s.thali_chips | newline_to_br | split: '<br />'
  assign gkk_cards = s.thali_cards | newline_to_br | split: '<br />'
  assign gkk_tickets = s.thali_tickets | newline_to_br | split: '<br />'
  assign gkk_steps = s.thali_steps | newline_to_br | split: '<br />'
  assign gkk_towns = s.thali_towns | split: ','
  assign gkk_facts = s.thali_facts | newline_to_br | split: '<br />'
-%}
<section
  class="gkk"
  data-gkk
  id="GkkStory-{{ section.id }}"
  style="--gkk-bg:{{ s.thali_bg | default: '#fdf8ef' }};--gkk-accent:{{ s.thali_accent | default: '#f0a81c' }};"
>
  <div class="gkk__wrap">

    <div class="gkk__hero">
      <div>
        {%- if gkk_badge != blank -%}
          <span class="cm-label gkk__badge">{{ gkk_badge | escape }}</span>
        {%- endif -%}
        {%- if gkk_heading != blank -%}
          <h2>{{ gkk_heading | escape }}</h2>
        {%- endif -%}
        {%- if gkk_intro != blank -%}
          <p>{{ gkk_intro | escape }}</p>
        {%- endif -%}
        {%- if s.thali_stats != blank -%}
          <div class="gkk__stats">
            {%- for line in gkk_stats -%}
              {%- assign stat = line | strip | split: '|' -%}
              {%- if stat.first != blank -%}
                <div>
                  <b>{{ stat[0] | strip | escape }}</b>
                  <span>{{ stat[1] | strip | escape }}</span>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="gkk__plate" data-gkk-plate>
        <svg viewBox="0 0 420 420" role="img" aria-label="{{ s.thali_plate_alt | default: 'A thali with two curries, rice and two rotis' | escape }}">
          <defs>
            <radialGradient id="gkkb-{{ section.id }}" cx=".35" cy=".3">
              <stop offset="0" stop-color="#f6e2a0"/>
              <stop offset=".6" stop-color="#cfa13a"/>
              <stop offset="1" stop-color="#8a6416"/>
            </radialGradient>
          </defs>
          <circle cx="210" cy="210" r="200" fill="url(#gkkb-{{ section.id }})"/>
          <circle cx="210" cy="210" r="180" fill="#e9c767" stroke="#8a6416" stroke-width="2"/>
          <circle cx="210" cy="210" r="168" fill="none" stroke="#a97c1f" stroke-width="1.5" stroke-dasharray="3 7"/>
          <circle cx="140" cy="145" r="62" fill="url(#gkkb-{{ section.id }})"/>
          <circle cx="140" cy="145" r="50" fill="#c4521a"/>
          <circle cx="140" cy="145" r="50" fill="none" stroke="#7d2d0a" stroke-width="3"/>
          <g fill="#f0a81c"><circle cx="125" cy="135" r="9"/><circle cx="150" cy="158" r="10"/><circle cx="152" cy="128" r="7"/></g>
          <path d="M115 160q20 12 40-6" stroke="#fbf1df" stroke-width="3" fill="none"/>
          <circle cx="140" cy="285" r="58" fill="url(#gkkb-{{ section.id }})"/>
          <circle cx="140" cy="285" r="47" fill="#d9a01e"/>
          <circle cx="140" cy="285" r="47" fill="none" stroke="#8a5c0a" stroke-width="3"/>
          <g fill="#4f7a2b">
            <rect x="118" y="268" width="14" height="10" rx="3"/>
            <rect x="146" y="290" width="16" height="10" rx="3" transform="rotate(25 154 295)"/>
            <rect x="124" y="298" width="12" height="9" rx="3"/>
          </g>
          <g fill="#c4521a"><circle cx="152" cy="272" r="6"/><circle cx="128" cy="288" r="5"/></g>
          <ellipse cx="290" cy="300" rx="72" ry="56" fill="#fffaf0"/>
          <g fill="#efe3c8">
            <ellipse cx="270" cy="285" rx="22" ry="7" transform="rotate(-20 270 285)"/>
            <ellipse cx="305" cy="310" rx="24" ry="7" transform="rotate(15 305 310)"/>
            <ellipse cx="290" cy="330" rx="20" ry="6"/>
          </g>
          <circle cx="300" cy="150" r="70" fill="#d6a05a"/>
          <circle cx="278" cy="132" r="68" fill="#e2b571"/>
          <g fill="#8a4a1c" opacity=".75">
            <circle cx="262" cy="118" r="6"/><circle cx="296" cy="140" r="5"/>
            <circle cx="270" cy="156" r="4"/><circle cx="305" cy="108" r="4"/>
            <circle cx="244" cy="140" r="3"/>
          </g>
        </svg>
        {%- if s.thali_chips != blank -%}
          {%- for line in gkk_chips -%}
            {%- assign chip = line | strip -%}
            {%- if chip != blank -%}<span class="gkk__chip">{{ chip | escape }}</span>{%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    {%- if s.thali_cards != blank -%}
      <div class="gkk__trio">
        {%- assign card_i = 0 -%}
        {%- for line in gkk_cards -%}
          {%- assign card = line | strip | split: '|' -%}
          {%- if card[0] != blank -%}
            {%- assign card_i = card_i | plus: 1 -%}
            <div class="gkk__card">
              {%- if card_i == 1 -%}
                <svg viewBox="0 0 240 170" aria-hidden="true"><rect width="240" height="170" rx="6" fill="#5e1124"/><path d="M60 40q-8-18 4-26M90 36q-8-18 4-26M120 40q-8-18 4-26" stroke="#f0a81c" stroke-width="2" fill="none" opacity=".6"/><circle cx="120" cy="64" r="22" fill="#e0a77a"/><circle cx="102" cy="44" r="14" fill="#fff"/><circle cx="120" cy="38" r="16" fill="#fff"/><circle cx="138" cy="44" r="14" fill="#fff"/><rect x="100" y="46" width="40" height="10" fill="#fff"/><circle cx="112" cy="66" r="2.5" fill="#2a0f14"/><circle cx="128" cy="66" r="2.5" fill="#2a0f14"/><path d="M110 74q10 8 20 0" stroke="#2a0f14" stroke-width="2" fill="none"/><path d="M70 170q4-70 50-76 46 6 50 76z" fill="#fff"/><g fill="#d9d2c4"><circle cx="120" cy="116" r="3"/><circle cx="120" cy="134" r="3"/></g><path d="M20 150h200v20H20z" fill="#2e0c14"/><ellipse cx="190" cy="140" rx="34" ry="10" fill="#c4521a"/><path d="M156 140h68v14q-34 12-68 0z" fill="#8f98a3"/></svg>
              {%- else -%}
                <svg viewBox="0 0 240 170" aria-hidden="true"><rect x="30" y="20" width="180" height="130" rx="10" fill="#7b1730" transform="rotate(-6 120 85)"/><g fill="#fbf1df" opacity=".7"><circle cx="60" cy="48" r="3"/><circle cx="90" cy="40" r="3"/><circle cx="130" cy="36" r="3"/><circle cx="170" cy="30" r="3"/><circle cx="195" cy="120" r="3"/></g><circle cx="120" cy="92" r="58" fill="#c98c45"/><circle cx="112" cy="84" r="56" fill="#dfae6c"/><circle cx="106" cy="76" r="52" fill="#e9c386"/><g fill="#8a4a1c" opacity=".7"><circle cx="86" cy="64" r="5"/><circle cx="118" cy="90" r="4"/><circle cx="100" cy="100" r="3"/><circle cx="130" cy="60" r="4"/></g></svg>
              {%- endif -%}
              <h4>{{ card[0] | strip | escape }}</h4>
              {%- if card[1] != blank -%}<p>{{ card[1] | strip | escape }}</p>{%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="gkk__deliver">
      <div>
        {%- if s.thali_delivery_heading != blank -%}
          <h4>{{ s.thali_delivery_heading | escape }}</h4>
        {%- endif -%}
        {%- if s.thali_delivery_text != blank -%}
          <p>{{ s.thali_delivery_text | escape }}</p>
        {%- endif -%}
        {%- if s.thali_tickets != blank -%}
          {%- for line in gkk_tickets -%}
            {%- assign t = line | strip | split: '|' -%}
            {%- if t[0] != blank -%}
              <div class="gkk__ticket">
                <div>
                  <h4>{{ t[0] | strip | escape }}</h4>
                  {%- if t[1] != blank -%}<small>{{ t[1] | strip | escape }}</small>{%- endif -%}
                </div>
                <div>
                  {%- if t[2] != blank -%}<small>{{ t[2] | strip | escape }}</small>{%- endif -%}
                  {%- if t[3] != blank -%}<b>{{ t[3] | strip | escape }}</b>{%- endif -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- if s.thali_cutoff_note != blank -%}
          <p class="gkk__note">{{ s.thali_cutoff_note | escape }}</p>
        {%- endif -%}
      </div>

      <div class="gkk__fresh">
        {%- if s.thali_fresh_heading != blank -%}
          <h4>{{ s.thali_fresh_heading | escape }}</h4>
        {%- endif -%}
        {%- if s.thali_fresh_text != blank -%}
          <p>{{ s.thali_fresh_text | escape }}</p>
        {%- endif -%}
        {%- if s.thali_steps != blank -%}
          <ol class="gkk__steps">
            {%- for line in gkk_steps -%}
              {%- assign step = line | strip | split: '|' -%}
              {%- if step[0] != blank -%}
                <li>
                  <i>{{ forloop.index }}</i>
                  <div>
                    <b>{{ step[0] | strip | escape }}</b>
                    {%- if step[1] != blank -%}<span>{{ step[1] | strip | escape }}</span>{%- endif -%}
                  </div>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ol>
        {%- endif -%}
        {%- if s.thali_towns != blank -%}
          <div class="gkk__towns">
            {%- for town in gkk_towns -%}
              {%- assign town_name = town | strip -%}
              {%- if town_name != blank -%}<span>{{ town_name | escape }}</span>{%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="gkk__cta">
      <div>
        {%- if s.thali_cta_heading != blank -%}
          <h4>{{ s.thali_cta_heading | escape }}</h4>
        {%- endif -%}
        {%- if s.thali_cta_text != blank -%}
          <p>{{ s.thali_cta_text | escape }}</p>
        {%- endif -%}
        {%- if s.thali_cta_label != blank -%}
          <a class="gkk__btn" href="{{ s.thali_cta_link | default: '#' }}">{{ s.thali_cta_label | escape }}</a>
        {%- endif -%}
        {%- if s.thali_cta_note != blank -%}
          <p class="gkk__note">{{ s.thali_cta_note | escape }}</p>
        {%- endif -%}
      </div>
      {%- if s.thali_facts != blank -%}
        <div class="gkk__facts">
          {%- for line in gkk_facts -%}
            {%- assign fact = line | strip | split: '|' -%}
            {%- if fact[0] != blank -%}
              <div>
                <b>{{ fact[0] | strip | escape }}</b>
                <span>{{ fact[1] | strip | escape }}</span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('GkkStory-{{ section.id }}');
    if (!root || !('IntersectionObserver' in window)) return;
    var plate = root.querySelector('[data-gkk-plate]');
    if (!plate) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      root.classList.add('is-in');
      return;
    }
    root.classList.add('gkk--ready');
    var io = new IntersectionObserver(function (entries) {
      if (entries[0].isIntersecting) {
        root.classList.add('is-in');
        io.disconnect();
      }
    }, { threshold: 0.25 });
    io.observe(plate);
  })();
</script>
