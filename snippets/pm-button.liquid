{%- comment -%}
  Animated pill button — theme-wide shared control.

  Accepts:
  - label: {String} Button text
  - link: {String} Button URL (renders a disabled link when blank)
  - style: {String} 'brand' (default), 'light', 'ink', 'outline'
  - class: {String} Extra class names
  - hidden: {Boolean} Start hidden
  - tag: {String} 'a' (default) or 'button'
  - type: {String} Button type when tag is 'button' (default: 'button')
  - attributes: {String} Extra HTML attributes (e.g. data-gc-add)
  - css: {String} Extra inline CSS (merged after color params)
  - text_color, bg_color, icon_bg, icon_color: {Color} Theme Editor overrides
  - hover_text_color, hover_bg_color: {Color} Hover overrides (falls back to Theme settings → Buttons)
  - font_size: {Number} px font size from Theme Editor
  - open_in_new_tab: {Boolean} target=_blank + rel
  - icon: {Image} optional custom icon image
  - icon_position: {String} 'left' or 'right' (default: 'left' when icon set)
  - size: {String} 'small' | 'medium' | 'large' (omit = legacy default)
  - full_width: {Boolean}
  - border_radius, border_width: {Number} px overrides (omit = style default)
  - border_color: {Color}
  - aria_label: {String} accessible name (esp. icon-only)

  Schema fields to add next to any button label/link (copy-paste):
    { "type": "header", "content": "Button style" },
    { "type": "color", "id": "button_text_color", "label": "Text color" },
    { "type": "color", "id": "button_bg_color", "label": "Background color" },
    { "type": "color", "id": "button_hover_text_color", "label": "Hover text color", "info": "Clear to keep the style preset hover." },
    { "type": "color", "id": "button_hover_bg_color", "label": "Hover background color", "info": "Clear to keep the style preset hover." },
    { "type": "color", "id": "button_icon_bg", "label": "Icon background" },
    { "type": "color", "id": "button_icon_color", "label": "Icon color" },
    { "type": "range", "id": "button_font_size", "min": 12, "max": 24, "step": 1, "unit": "px", "label": "Font size", "default": 16 }
{%- endcomment -%}
{{ 'component-pm-button.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign pm_class = 'pm pm-a pm--brand'
  case style
    when 'light'
      assign pm_class = 'pm pm-a pm--light'
    when 'ink'
      assign pm_class = 'pm pm-a pm--ink'
    when 'dark'
      assign pm_class = 'pm pm-a pm--brand'
    when 'brand'
      assign pm_class = 'pm pm-a pm--brand'
    when 'outline'
      assign pm_class = 'pm pm-s'
  endcase
  assign pm_tag = tag | default: 'a'
  assign pm_type = type | default: 'button'

  assign pm_hover_text = hover_text_color | default: settings.pm_button_hover_text
  assign pm_hover_bg = hover_bg_color | default: settings.pm_button_hover_bg

  assign pm_icon_pos = icon_position | default: 'left'

  if size == 'small'
    assign pm_class = pm_class | append: ' pm--size-sm'
  elsif size == 'large'
    assign pm_class = pm_class | append: ' pm--size-lg'
  elsif size == 'medium'
    assign pm_class = pm_class | append: ' pm--size-md'
  endif

  if full_width
    assign pm_class = pm_class | append: ' pm--full'
  endif

  assign pm_css = css | default: ''
  if bg_color != blank
    assign pm_css = pm_css | append: '--pm-bg:' | append: bg_color | append: ';background-color:' | append: bg_color | append: ';'
  endif
  if text_color != blank
    assign pm_css = pm_css | append: '--pm-text:' | append: text_color | append: ';--pm-accent-text:' | append: text_color | append: ';color:' | append: text_color | append: ';'
  endif
  if icon_bg != blank
    assign pm_css = pm_css | append: '--pm-icon-bg:' | append: icon_bg | append: ';'
  endif
  if icon_color != blank
    assign pm_css = pm_css | append: '--pm-icon-text:' | append: icon_color | append: ';'
  endif
  if pm_hover_bg != blank
    assign pm_css = pm_css | append: '--pm-hover-bg:' | append: pm_hover_bg | append: ';'
  endif
  if pm_hover_text != blank
    assign pm_css = pm_css | append: '--pm-hover-text:' | append: pm_hover_text | append: ';'
  endif
  if border_color != blank
    assign pm_css = pm_css | append: '--pm-border:' | append: border_color | append: ';border-color:' | append: border_color | append: ';'
  endif
  if border_width != blank and border_width > 0
    assign pm_css = pm_css | append: 'border-style:solid;border-width:' | append: border_width | append: 'px;'
  endif
  if border_radius != blank
    assign pm_css = pm_css | append: 'border-radius:' | append: border_radius | append: 'px;'
  endif
  if font_size != blank and font_size >= 12
    assign pm_css = pm_css | append: 'font-size:' | append: font_size | append: 'px;'
  endif

  assign pm_has_custom_icon = false
  if icon != blank
    assign pm_has_custom_icon = true
  endif

  assign pm_aria = ''
  if aria_label != blank
    assign pm_aria = aria_label
  elsif pm_has_custom_icon and label == blank
    assign pm_aria = 'Button'
  endif
-%}
{%- capture pm_custom_icon -%}
  {%- if pm_has_custom_icon -%}
    <span class="pm-custom-icon" aria-hidden="true">
      {{
        icon
        | image_url: width: 48
        | image_tag: loading: 'lazy', widths: '24,36,48', sizes: '24px', alt: ''
      }}
    </span>
  {%- endif -%}
{%- endcapture -%}
{%- capture pm_label_html -%}
  {%- if label != blank -%}
    {{ label | escape }}
  {%- endif -%}
{%- endcapture -%}
{%- capture pm_inner -%}
  {%- if style == 'outline' -%}
    {%- if pm_has_custom_icon -%}
      <span class="pm-z pm-z--has-icon pm-z--icon-{{ pm_icon_pos }}">
        {%- if pm_icon_pos == 'left' -%}{{ pm_custom_icon }}{%- endif -%}
        {%- if pm_label_html != blank -%}<span class="pm-z__label">{{ pm_label_html }}</span>{%- endif -%}
        {%- if pm_icon_pos == 'right' -%}{{ pm_custom_icon }}{%- endif -%}
      </span>
    {%- else -%}
      <span class="pm-z">{{ label | escape }}</span>
    {%- endif -%}
  {%- else -%}
    {%- if pm_has_custom_icon -%}
      <span class="pm-roll pm-roll--has-icon pm-roll--icon-{{ pm_icon_pos }}">
        <span class="pm-roll__row">
          {%- if pm_icon_pos == 'left' -%}{{ pm_custom_icon }}{%- endif -%}
          {%- if pm_label_html != blank -%}<span class="pm-roll__label">{{ pm_label_html }}</span>{%- endif -%}
          {%- if pm_icon_pos == 'right' -%}{{ pm_custom_icon }}{%- endif -%}
        </span>
        <span class="pm-roll__row" aria-hidden="true">
          {%- if pm_icon_pos == 'left' -%}{{ pm_custom_icon }}{%- endif -%}
          {%- if pm_label_html != blank -%}<span class="pm-roll__label">{{ pm_label_html }}</span>{%- endif -%}
          {%- if pm_icon_pos == 'right' -%}{{ pm_custom_icon }}{%- endif -%}
        </span>
      </span>
    {%- else -%}
      <span class="pm-roll">
        <span>{{ label | escape }}</span>
        <span aria-hidden="true">{{ label | escape }}</span>
      </span>
    {%- endif -%}
    <span class="pm-dot" aria-hidden="true">
      <span class="pm-bg"></span>
      <span class="pm-clip">
        {%- for i in (1..2) -%}
          <span class="pm-ic">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M8 7h9v9"/></svg>
          </span>
        {%- endfor -%}
      </span>
    </span>
  {%- endif -%}
{%- endcapture -%}
{%- if pm_tag == 'button' -%}
  <button
    type="{{ pm_type }}"
    class="{{ pm_class }}{% if class != blank %} {{ class }}{% endif %}"
    {% if pm_css != blank %}
      style="{{ pm_css }}"
    {% endif %}
    {% if hidden %}
      hidden
    {% endif %}
    {% if pm_aria != blank %}
      aria-label="{{ pm_aria | escape }}"
    {% endif %}
    {{ attributes }}
  >
    {{ pm_inner }}
  </button>
{%- else -%}
  <a
    {% if link != blank %}
      href="{{ link }}"
      {% if open_in_new_tab %}
        target="_blank" rel="noopener noreferrer"
      {% endif %}
    {% else %}
      role="link" aria-disabled="true"
    {% endif %}
    class="{{ pm_class }}{% if class != blank %} {{ class }}{% endif %}"
    {% if pm_css != blank %}
      style="{{ pm_css }}"
    {% endif %}
    {% if hidden %}
      hidden
    {% endif %}
    {% if pm_aria != blank %}
      aria-label="{{ pm_aria | escape }}"
    {% endif %}
    {{ attributes }}
  >
    {{ pm_inner }}
  </a>
{%- endif -%}
