    assign area_ben_line_1 = section.settings.line_1 | default: section.settings.ben_line_1
    assign area_ben_line_2 = section.settings.line_2 | default: section.settings.ben_line_2
    assign area_ben_line_3 = section.settings.line_3 | default: section.settings.ben_line_3
    assign area_ben_note = section.settings.note | default: section.settings.ben_note
