{%- comment -%}
  Outputs inline CSS for text typography + spacing + background + hover.
  Usage:
    {% render 'pm-block-type-style', block: block %}
    {% render 'pm-block-type-style', block: block, prefix: 'title_' %}
    {% render 'pm-block-type-style', settings: section.settings, prefix: 'heading_' %}
  With prefix blank, reads: text_color, text_hover_color, bg_color, hover_bg_color, ...
  With prefix 'title_', reads: title_color, title_hover_color, title_bg_color, title_hover_bg_color, ...
  Prefer block.settings when block is passed (global theme settings is always present).
{%- endcomment -%}
{%- liquid
  assign p = prefix | default: ''
  if block != blank
    assign src = block.settings
  else
    assign src = settings
  endif
  if p == blank
    assign key_color = 'text_color'
    assign key_hover_color = 'text_hover_color'
    assign key_size = 'font_size'
    assign key_weight = 'font_weight'
    assign key_track = 'letter_spacing'
    assign key_leading = 'line_height'
    assign key_pt = 'padding_top'
    assign key_pb = 'padding_bottom'
    assign key_pl = 'padding_left'
    assign key_pr = 'padding_right'
    assign key_mt = 'margin_top'
    assign key_mb = 'margin_bottom'
    assign key_ml = 'margin_left'
    assign key_mr = 'margin_right'
    assign key_bg_color = 'bg_color'
    assign key_hover_bg = 'hover_bg_color'
    assign key_bg_color_alt = 'background_color'
    assign key_bg_image = 'bg_image'
    assign key_bg_size = 'bg_size'
    assign key_bg_position = 'bg_position'
    assign key_bg_mask = 'bg_mask'
    assign key_bg_mask_image = 'bg_mask_image'
    assign key_bg_clip_text = 'bg_clip_text'
  else
    assign key_color = p | append: 'color'
    assign key_hover_color = p | append: 'hover_color'
    assign key_size = p | append: 'font_size'
    assign key_weight = p | append: 'font_weight'
    assign key_track = p | append: 'letter_spacing'
    assign key_leading = p | append: 'line_height'
    assign key_pt = p | append: 'padding_top'
    assign key_pb = p | append: 'padding_bottom'
    assign key_pl = p | append: 'padding_left'
    assign key_pr = p | append: 'padding_right'
    assign key_mt = p | append: 'margin_top'
    assign key_mb = p | append: 'margin_bottom'
    assign key_ml = p | append: 'margin_left'
    assign key_mr = p | append: 'margin_right'
    assign key_bg_color = p | append: 'bg_color'
    assign key_hover_bg = p | append: 'hover_bg_color'
    assign key_bg_color_alt = p | append: 'background_color'
    assign key_bg_image = p | append: 'bg_image'
    assign key_bg_size = p | append: 'bg_size'
    assign key_bg_position = p | append: 'bg_position'
    assign key_bg_mask = p | append: 'bg_mask'
    assign key_bg_mask_image = p | append: 'bg_mask_image'
    assign key_bg_clip_text = p | append: 'bg_clip_text'
  endif

  assign val_color = src[key_color]
  assign val_hover_color = src[key_hover_color]
  assign val_size = src[key_size]
  assign val_weight = src[key_weight]
  assign val_track = src[key_track]
  assign val_leading = src[key_leading]
  assign val_pt = src[key_pt]
  assign val_pb = src[key_pb]
  assign val_pl = src[key_pl]
  assign val_pr = src[key_pr]
  assign val_mt = src[key_mt]
  assign val_mb = src[key_mb]
  assign val_ml = src[key_ml]
  assign val_mr = src[key_mr]
  assign val_bg_color = src[key_bg_color]
  if val_bg_color == blank
    assign val_bg_color = src[key_bg_color_alt]
  endif
  assign val_hover_bg = src[key_hover_bg]
  assign val_bg_image = src[key_bg_image]
  assign val_bg_size = src[key_bg_size] | default: 'cover'
  assign val_bg_position = src[key_bg_position] | default: 'center'
  assign val_bg_mask = src[key_bg_mask] | default: 'none'
  assign val_bg_mask_image = src[key_bg_mask_image]
  assign val_bg_clip_text = src[key_bg_clip_text]
-%}
{%- if val_color != blank and val_bg_clip_text != true -%}
  color:{{ val_color }};
{%- endif -%}
{%- if val_hover_color != blank -%}
  --pm-hover-color:{{ val_hover_color }};
{%- endif -%}
{%- if val_hover_bg != blank -%}
  --pm-hover-bg:{{ val_hover_bg }};
{%- endif -%}
{%- liquid
  if val_size >= 14
    echo 'font-size:' | append: val_size | append: 'px;'
  endif
  if val_weight != blank and val_weight != 'inherit'
    echo 'font-weight:' | append: val_weight | append: ';'
  endif
  if val_track != blank and val_track != 0
    echo 'letter-spacing:' | append: val_track | append: 'px;'
  endif
  if val_leading != blank and val_leading != 0
    echo 'line-height:' | append: val_leading | append: ';'
  endif
  if val_pt > 0
    echo 'padding-top:' | append: val_pt | append: 'px;'
  endif
  if val_pb > 0
    echo 'padding-bottom:' | append: val_pb | append: 'px;'
  endif
  if val_pl > 0
    echo 'padding-left:' | append: val_pl | append: 'px;'
  endif
  if val_pr > 0
    echo 'padding-right:' | append: val_pr | append: 'px;'
  endif
  if val_mt > 0
    echo 'margin-top:' | append: val_mt | append: 'px;'
  endif
  if val_mb > 0
    echo 'margin-bottom:' | append: val_mb | append: 'px;'
  endif
  if val_ml > 0
    echo 'margin-left:' | append: val_ml | append: 'px;'
  endif
  if val_mr > 0
    echo 'margin-right:' | append: val_mr | append: 'px;'
  endif
-%}
{%- if val_bg_color != blank -%}
  background-color:{{ val_bg_color }};
{%- endif -%}
{%- if val_bg_image != blank -%}
  background-image:url({{ val_bg_image | image_url: width: 2000 }});
  background-size:{{ val_bg_size }};
  background-position:{{ val_bg_position }};
{%- endif -%}
{%- if val_bg_color != blank or val_bg_image != blank -%}
  background-repeat:no-repeat;
{%- endif -%}
{%- if val_bg_clip_text == true -%}
  {%- if val_bg_image != blank or val_bg_color != blank -%}
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
    -webkit-text-fill-color:transparent;
  {%- endif -%}
{%- endif -%}
{%- if val_bg_mask == 'fade' -%}
  -webkit-mask-image:linear-gradient(180deg,#000 0%,#000 55%,transparent 100%);
  mask-image:linear-gradient(180deg,#000 0%,#000 55%,transparent 100%);
  -webkit-mask-size:cover;
  mask-size:cover;
  -webkit-mask-repeat:no-repeat;
  mask-repeat:no-repeat;
{%- elsif val_bg_mask == 'fade_edges' -%}
  -webkit-mask-image:linear-gradient(90deg,transparent 0%,#000 12%,#000 88%,transparent 100%);
  mask-image:linear-gradient(90deg,transparent 0%,#000 12%,#000 88%,transparent 100%);
  -webkit-mask-size:cover;
  mask-size:cover;
  -webkit-mask-repeat:no-repeat;
  mask-repeat:no-repeat;
{%- elsif val_bg_mask == 'circle' -%}
  -webkit-mask-image:radial-gradient(circle at center,#000 58%,transparent 72%);
  mask-image:radial-gradient(circle at center,#000 58%,transparent 72%);
  -webkit-mask-size:cover;
  mask-size:cover;
  -webkit-mask-repeat:no-repeat;
  mask-repeat:no-repeat;
{%- elsif val_bg_mask == 'soft' -%}
  -webkit-mask-image:radial-gradient(ellipse at center,#000 35%,transparent 75%);
  mask-image:radial-gradient(ellipse at center,#000 35%,transparent 75%);
  -webkit-mask-size:cover;
  mask-size:cover;
  -webkit-mask-repeat:no-repeat;
  mask-repeat:no-repeat;
{%- elsif val_bg_mask == 'rounded' -%}
  border-radius:12px;
  overflow:hidden;
{%- elsif val_bg_mask == 'custom' and val_bg_mask_image != blank -%}
  -webkit-mask-image:url({{ val_bg_mask_image | image_url: width: 1600 }});
  mask-image:url({{ val_bg_mask_image | image_url: width: 1600 }});
  -webkit-mask-size:{{ val_bg_size }};
  mask-size:{{ val_bg_size }};
  -webkit-mask-position:{{ val_bg_position }};
  mask-position:{{ val_bg_position }};
  -webkit-mask-repeat:no-repeat;
  mask-repeat:no-repeat;
{%- endif -%}
