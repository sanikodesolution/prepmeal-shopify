{%- comment -%}
  Outputs shopify_attributes (+ optional Color & typography style) for the first
  block of the given type. Use inside the opening tag:
  <section class="mph" {% render 'cm-area-attrs', section: section, type: 'area_hero' %}>
{%- endcomment -%}
{%- liquid
  assign _type = type | default: ''
-%}
{%- if _type != blank -%}
  {%- for block in section.blocks -%}
    {%- if block.type == _type -%}
      {{ block.shopify_attributes }}
      {% render 'pm-area-style', block: block %}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
