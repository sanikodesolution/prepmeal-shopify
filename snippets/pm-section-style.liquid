{%- comment -%}
  Outputs style="" for section Color / Background settings.
  Use CSS attribute selectors on --pm-bg / --pm-bg-image (no extra class= —
  wrappers already have class="mealplan-page").
  Optional: extra — raw CSS declarations to merge.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign css = extra | default: ''

  if s.background_color != blank
    assign css = css | append: '--pm-bg:' | append: s.background_color | append: ';background-color:' | append: s.background_color | append: ';'
  endif

  if s.background_image != blank
    assign bg_url = s.background_image | image_url: width: 2400
    assign bg_fit = s.background_image_fit | default: 'cover'
    assign bg_pos = s.background_image_position | default: 'center'
    assign css = css | append: '--pm-bg-image:url(' | append: bg_url | append: ');background-image:url(' | append: bg_url | append: ');'
    assign css = css | append: '--pm-bg-size:' | append: bg_fit | append: ';background-size:' | append: bg_fit | append: ';'
    assign css = css | append: '--pm-bg-position:' | append: bg_pos | append: ';background-position:' | append: bg_pos | append: ';'
    assign css = css | append: 'background-repeat:no-repeat;'
  endif

  if s.background_overlay_opacity != blank and s.background_overlay_opacity > 0
    assign ov_color = s.background_overlay_color | default: '#000000'
    assign ov_alpha = s.background_overlay_opacity | times: 0.01
    assign css = css | append: '--pm-overlay-color:' | append: ov_color | append: ';--pm-overlay-opacity:' | append: ov_alpha | append: ';'
  endif

  if s.eyebrow_color != blank
    assign css = css | append: '--pm-eyebrow:' | append: s.eyebrow_color | append: ';'
  endif
  if s.heading_color != blank
    assign css = css | append: '--pm-heading:' | append: s.heading_color | append: ';'
  endif
  if s.title_color != blank
    assign css = css | append: '--pm-title:' | append: s.title_color | append: ';'
  endif
  if s.text_color != blank
    assign css = css | append: '--pm-text:' | append: s.text_color | append: ';color:' | append: s.text_color | append: ';'
  endif
  if s.eyebrow_size != blank and s.eyebrow_size > 0
    assign css = css | append: '--pm-eyebrow-size:' | append: s.eyebrow_size | append: 'px;'
  endif
  if s.heading_size != blank and s.heading_size > 0
    assign css = css | append: '--pm-heading-size:' | append: s.heading_size | append: 'px;'
  endif
  if s.title_size != blank and s.title_size > 0
    assign css = css | append: '--pm-title-size:' | append: s.title_size | append: 'px;'
  endif
  if s.text_size != blank and s.text_size > 0
    assign css = css | append: '--pm-text-size:' | append: s.text_size | append: 'px;'
  endif
  if s.heading_weight != blank
    assign css = css | append: '--pm-heading-weight:' | append: s.heading_weight | append: ';'
  endif
  if s.text_align != blank
    assign css = css | append: '--pm-align:' | append: s.text_align | append: ';text-align:' | append: s.text_align | append: ';'
  endif
-%}
{%- if css != blank -%} style="{{ css }}"{%- endif -%}
