{%- comment -%}
  Delivery area checker — Leaflet map, town / ZIP search and town chips.
  Rendered by sections/cm-meal-plan-page.liquid when "delivery_checker" is on.

  Settings live on the parent cm-meal-plan-page section so the copy, the town
  list and the map stay editable from the theme editor.
{%- endcomment -%}

{{ 'section-cm-delivery-checker.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cm-geocode.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'cm-delivery-checker.js' | asset_url }}" defer="defer"></script>

