{%- liquid
  assign s = section.settings
  assign towns_raw = s.delivery_towns | strip
  if towns_raw == blank
    assign towns_raw = mpd_default_towns | strip
  endif
  assign lines = towns_raw | newline_to_br | split: '<br />'

  assign initial = s.delivery_initial_chips | default: 10
  assign total = 0
  for line in lines
    assign name = line | split: '|' | first | strip
    if name != blank
      assign total = total | plus: 1
    endif
  endfor

  assign kitchen_lat = s.delivery_kitchen_lat | default: '43.1051'
  assign kitchen_lng = s.delivery_kitchen_lng | default: '-88.3420'
  # Either value may be a place name instead of a number ("Waukesha").
  # The map resolves place names with the geocoder at run time.
  assign kitchen_place = ''
  assign kl_num = kitchen_lat | plus: 0
  assign kn_num = kitchen_lng | plus: 0
  if kl_num == 0
    assign kitchen_place = kitchen_lat
  elsif kn_num == 0
    assign kitchen_place = kitchen_lng
  endif
  assign geo_country = s.delivery_country | default: ''
  assign radius = s.delivery_radius_km | default: 0
  assign show_all = s.delivery_show_all | default: 'Show all'
  assign show_less = s.delivery_show_less | default: 'Show less'
  assign placeholder = s.delivery_placeholder | default: 'Enter your town or ZIP code'
  assign button = s.delivery_button | default: 'Check my area'
  assign legend_kitchen = s.delivery_legend_kitchen | default: 'Our kitchen'
  assign legend_areas = s.delivery_legend_areas | default: 'Delivery areas'
  assign legend_zone = s.delivery_legend_zone | default: 'Delivery zone'
  assign reset_label = s.delivery_reset_label | default: 'Show full zone'
-%}

{%- capture mpd_primary -%}
  {%- assign i = 0 -%}
  {%- for line in lines -%}
    {%- assign p = line | split: '|' -%}
    {%- assign name = p[0] | strip -%}
    {%- if name != blank -%}
      {%- if i < initial -%}
        <li><button type="button" class="mpd__chip" data-mpd-i="{{ i }}" aria-pressed="false">{{ name | escape }}</button></li>
      {%- endif -%}
      {%- assign i = i | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- capture mpd_extra -%}
  {%- assign j = 0 -%}
  {%- for line in lines -%}
    {%- assign p = line | split: '|' -%}
    {%- assign name = p[0] | strip -%}
    {%- if name != blank -%}
      {%- if j >= initial -%}
        <li><button type="button" class="mpd__chip" data-mpd-i="{{ j }}" aria-pressed="false">{{ name | escape }}</button></li>
      {%- endif -%}
      {%- assign j = j | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- capture mpd_towns_json -%}
[
{%- assign first = true -%}
{%- for line in lines -%}
  {%- assign p = line | split: '|' -%}
  {%- assign name = p[0] | strip -%}
  {%- if name != blank -%}
    {%- unless first -%},{%- endunless -%}
    {%- assign first = false -%}
    {%- comment -%}
      Column count decides the row type, so a ZIP is never mistaken for a
      coordinate:
        1  Name                 -> geocoded
        2  Name|ZIP,ZIP          -> geocoded, ZIPs searchable
        3  Name|lat|lng          -> exact
        4  Name|lat|lng|ZIP,ZIP  -> exact, ZIPs searchable
    {%- endcomment -%}
    {%- assign col_count = p.size -%}
    {%- assign town_lat = p[1] | default: '' | strip -%}
    {%- assign town_lng = p[2] | default: '' | strip -%}
    {%- assign town_zips = p[3] | default: '' | strip -%}
    {%- if col_count >= 3 and town_lat != blank and town_lng != blank -%}
      {"n":{{ name | json }},"lat":{{ town_lat | plus: 0 }},"lng":{{ town_lng | plus: 0 }},"z":{{ town_zips | json }}}
    {%- else -%}
      {%- assign town_zips = p[1] | default: '' | strip -%}
      {%- assign first_zip = town_zips | split: ',' | first | strip -%}
      {%- assign lookup_q = name -%}
      {%- if first_zip != blank -%}
        {%- assign lookup_q = name | append: ' ' | append: first_zip -%}
      {%- endif -%}
      {"n":{{ name | json }},"q":{{ lookup_q | json }},"z":{{ town_zips | json }}}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
]
{%- endcapture -%}

{%- liquid
  assign po = '{'
  assign pc = '}'
  assign msg_yes = s.delivery_msg_yes
  if msg_yes == blank
    assign msg_yes = 'Yes, we deliver to ' | append: po | append: 'town' | append: pc | append: '.'
  endif
  assign msg_no = s.delivery_msg_no
  if msg_no == blank
    assign msg_no = 'We do not deliver to "' | append: po | append: 'query' | append: pc | append: '" yet.'
  endif
  assign msg_yes2 = s.delivery_msg_yes_sub | default: 'Add your plan and confirm your address at checkout.'
  assign msg_contact = s.delivery_contact_url | default: ''
  assign msg_contact_label = s.delivery_contact_label | default: 'Ask us about your area'
  assign msg_lookup_yes = s.delivery_msg_lookup_yes
  if msg_lookup_yes == blank
    assign msg_lookup_yes = po | append: 'place' | append: pc | append: ' sits inside our delivery zone.'
  endif
  assign msg_lookup_no = s.delivery_msg_lookup_no
  if msg_lookup_no == blank
    assign msg_lookup_no = po | append: 'place' | append: pc | append: ' is about ' | append: po | append: 'distance' | append: pc | append: ' from our kitchen, outside the delivery zone.'
  endif
  assign msg_lookup_fail = s.delivery_msg_lookup_fail
  if msg_lookup_fail == blank
    assign msg_lookup_fail = 'We could not find "' | append: po | append: 'query' | append: pc | append: '". Try a town, a ZIP code or a nearby landmark.'
  endif
  assign msg_lookup_row = s.delivery_lookup_row
  if msg_lookup_row == blank
    assign msg_lookup_row = 'Look up "' | append: po | append: 'query' | append: pc | append: '" on the map'
  endif
  assign msg_lookup_loading = s.delivery_lookup_loading
  if msg_lookup_loading == blank
    assign msg_lookup_loading = 'Looking up "' | append: po | append: 'query' | append: pc | append: '"…'
  endif
-%}
{%- capture mpd_copy_json -%}
{"yes":{{ msg_yes | json }},"yes2":{{ msg_yes2 | json }},"no":{{ msg_no | json }},"contact":{{ msg_contact | json }},"contactLabel":{{ msg_contact_label | json }},"lookupYes":{{ msg_lookup_yes | json }},"lookupNo":{{ msg_lookup_no | json }},"lookupFail":{{ msg_lookup_fail | json }},"lookupRow":{{ msg_lookup_row | json }},"lookupLoading":{{ msg_lookup_loading | json }}}
{%- endcapture -%}

<section
  class="mpd"
  id="mpd-{{ section.id }}"
  data-mpd
  data-klat="{{ kitchen_lat | escape }}"
  data-klng="{{ kitchen_lng | escape }}"
  data-kplace="{{ kitchen_place | escape }}"
  data-country="{{ geo_country | escape }}"
  data-radius="{{ radius }}"
  aria-labelledby="mpd-h-{{ section.id }}"
>
  <div class="mpd__map">
    <div class="mpd__canvas" data-mpd-canvas></div>
    <div class="mpd__legend">
      <span><i class="mpd__key mpd__key--kitchen" aria-hidden="true"></i>{{ legend_kitchen | escape }}</span>
      <span><i class="mpd__key mpd__key--area" aria-hidden="true"></i>{{ legend_areas | escape }}</span>
      <span><i class="mpd__key mpd__key--zone" aria-hidden="true"></i>{{ legend_zone | escape }}</span>
      <button type="button" class="mpd__reset" data-mpd-reset>{{ reset_label | escape }}</button>
    </div>
  </div>

  <div class="mpd__copy">
    {%- if s.delivery_eyebrow != blank -%}
      <p class="mp-eye">{{ s.delivery_eyebrow | escape }}</p>
    {%- endif -%}
    <h2 class="mealplan-h mpd__title" id="mpd-h-{{ section.id }}">{{ s.delivery_heading | escape }}</h2>
    {%- if s.delivery_text != blank -%}
      <p class="mealplan-p mpd__lead">{{ s.delivery_text | escape }}</p>
    {%- endif -%}

    <div class="mpd__search">
      <form class="mpd__form" data-mpd-form role="search" autocomplete="off">
        <label class="visually-hidden" for="mpd-q-{{ section.id }}">{{ placeholder | escape }}</label>
        <input
          id="mpd-q-{{ section.id }}"
          type="text"
          name="q"
          placeholder="{{ placeholder | escape }}"
          autocomplete="off"
          spellcheck="false"
          role="combobox"
          aria-autocomplete="list"
          aria-expanded="false"
          aria-controls="mpd-list-{{ section.id }}"
        >
        <button type="submit">{{ button | escape }}</button>
      </form>
      <ul class="mpd__suggest" id="mpd-list-{{ section.id }}" data-mpd-suggest role="listbox" aria-label="Delivery towns" hidden></ul>
    </div>

    <p class="mpd__result" data-mpd-result role="status" aria-live="polite"></p>

    <ul class="mpd__chips">
      {{ mpd_primary }}
      {%- if total > initial -%}
        <li>
          <button
            type="button"
            class="mpd__chip mpd__chip--more"
            data-mpd-more
            aria-expanded="false"
            aria-controls="mpd-extras-{{ section.id }}"
            data-more-all="{{ show_all | escape }} ({{ total }})"
            data-more-less="{{ show_less | escape }}"
          >
            <span data-mpd-more-label>{{ show_all | escape }} ({{ total }})</span>
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9.5 12 15.5 18 9.5"/></svg>
          </button>
        </li>
      {%- endif -%}
    </ul>

    {%- if total > initial -%}
      <div class="mpd__extras" id="mpd-extras-{{ section.id }}" data-mpd-extras>
        <div class="mpd__extras-in">
          <ul class="mpd__chips">{{ mpd_extra }}</ul>
        </div>
      </div>
    {%- endif -%}
  </div>

  <script type="application/json" data-mpd-towns>{{ mpd_towns_json }}</script>
  <script type="application/json" data-mpd-copy>{{ mpd_copy_json }}</script>
</section>
